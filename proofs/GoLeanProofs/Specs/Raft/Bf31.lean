/-! ## The allocation-symbolic equation (PRIMARY; placement LIVE) -/

/-- **THE RE-SITED ALLOCATION-SYMBOLIC becomeFollower EQUATION** (the
U3 flagship, placement-quantified at a fixture where the quantifier is
genuinely live). Side conditions as in the shipped form: `hvote`/
`hlead` — the surviving symbolic scalars' range facts. -/
theorem becomeFollower_handler_eq_alloc31 (ρ : Valuation) (σ : ExecState)
    (hag : bfTB.Agrees σ)
    (hvote : IntKind.normalize .uint64 (ρ.ints 1) = ρ.ints 1)
    (hlead : IntKind.normalize .uint64 (ρ.ints 9) = ρ.ints 9)
    (c₁ c₂ c₃ c₄ : Nat) (ch : Choices)
    {r : Nat → Nat} {na₀ na : Nat} {fr : Heap} {σF : ExecState}
    (hF : FrameSim r na₀ na fr (γS ρ σ bf31S0) σF) :
    ∃ σFfin,
      stepFnIter 3234 σF (renameConfig r (γC ρ bf31C0))
        (c₁ :: c₂ :: c₃ :: c₄ :: ch)
        = .ok (.next .stop, σFfin, ch)
      ∧ FrameSim r na₀ na fr (γS (uρ' ρ c₁ c₂ c₃) σ bf31S13) σFfin
      ∧ absRaftNode σF ⟨r 31⟩
          = some ⟨0, ρ.ints 1, ρ.ints 2, ρ.ints 3, 1, 1⟩
      ∧ absRaftNode σFfin ⟨r 31⟩
          = some (specBecomeFollower
              ⟨0, ρ.ints 1, ρ.ints 2, ρ.ints 3, 1, 1⟩ 0 (ρ.ints 9)) := by
  have hpre : γS ρ σ bf31S0 = γS (uρ' ρ c₁ c₂ c₃) σ bf31S0 := by
    kernel_rfl
  have hpreC : γC ρ bf31C0 = γC (uρ' ρ c₁ c₂ c₃) bf31C0 := by
    kernel_rfl
  have hrun : stepFnIter 3234 (γS ρ σ bf31S0) (γC ρ bf31C0)
      (c₁ :: c₂ :: c₃ :: c₄ :: ch)
      = .ok (.next .stop, γS (uρ' ρ c₁ c₂ c₃) σ bf31S13, ch) := by
    rw [hpre, hpreC]
    exact bf31_full_span ρ σ hag c₁ c₂ c₃ c₄ ch
  have hsim := stepFnIter_sim (na₀ := na₀) (na := na) 3234 hF
    (γC ρ bf31C0) (c₁ :: c₂ :: c₃ :: c₄ :: ch)
  obtain ⟨tF, htF, htrip⟩ := hsim.ok_inv hrun
  obtain ⟨cF, σFfin, chF⟩ := tF
  obtain ⟨hc, hs, hch⟩ := htrip
  dsimp only at hc hs hch
  subst hch
  have hcstop : renameConfig r (Machine.Config.next .stop)
      = Machine.Config.next .stop := rfl
  rw [hcstop] at hc
  subst hc
  refine ⟨σFfin, htF, hs, ?_, ?_⟩
  · have hpre0 : absRaftNode (γS ρ σ bf31S0) ⟨31⟩
        = some ⟨0, ρ.ints 1, ρ.ints 2, ρ.ints 3, 1, 1⟩ := by kernel_rfl
    exact absRaftNode_ren hF hpre0
  · have hproj : absRaftNode (γS (uρ' ρ c₁ c₂ c₃) σ bf31S13) ⟨31⟩
        = some ⟨0, unrm 13 (ρ.ints 1), unrm 3 (ρ.ints 9), 0, 1, 1⟩ := by
      kernel_rfl
    have hpost : absRaftNode (γS (uρ' ρ c₁ c₂ c₃) σ bf31S13) ⟨31⟩
        = some (specBecomeFollower
            ⟨0, ρ.ints 1, ρ.ints 2, ρ.ints 3, 1, 1⟩ 0 (ρ.ints 9)) := by
      rw [hproj, unrm_id hvote 13, unrm_id hlead 3]
      with_unfolding_all rfl
    exact absRaftNode_ren hs hpost

/-- The identity-placement corollary (the re-sited fixture's concrete
equation, `becomeFollower_handler_eq`'s exact shape at the new
placement). -/
theorem becomeFollower_handler_eq31 (ρ : Valuation) (σ : ExecState)
    (hag : bfTB.Agrees σ)
    (hvote : IntKind.normalize .uint64 (ρ.ints 1) = ρ.ints 1)
    (hlead : IntKind.normalize .uint64 (ρ.ints 9) = ρ.ints 9)
    (c₁ c₂ c₃ c₄ : Nat) (ch : Choices) :
    ∃ σfin,
      stepFnIter 3234 (γS ρ σ bf31S0) (γC ρ bf31C0)
        (c₁ :: c₂ :: c₃ :: c₄ :: ch)
        = .ok (.next .stop, σfin, ch)
      ∧ absRaftNode (γS ρ σ bf31S0) ⟨31⟩
          = some ⟨0, ρ.ints 1, ρ.ints 2, ρ.ints 3, 1, 1⟩
      ∧ absRaftNode σfin ⟨31⟩
          = some (specBecomeFollower
              ⟨0, ρ.ints 1, ρ.ints 2, ρ.ints 3, 1, 1⟩ 0 (ρ.ints 9)) := by
  have hF : FrameSim (ρT 52 0) 52 52 [] (γS ρ σ bf31S0) (γS ρ σ bf31S0) :=
    frameSim_seed rfl (fun f _ => renameStmt_ρT_zero 52 f.body)
  obtain ⟨σfin, hrun, _, hpre, hpost⟩ :=
    becomeFollower_handler_eq_alloc31 ρ σ hag hvote hlead c₁ c₂ c₃ c₄ ch hF
  have hcall : renameConfig (ρT 52 0) (γC ρ bf31C0) = γC ρ bf31C0 := by
    with_unfolding_all rfl
  rw [hcall] at hrun
  have haddr : (⟨ρT 52 0 31⟩ : Addr) = ⟨31⟩ := rfl
  rw [haddr] at hpre hpost
  exact ⟨σfin, hrun, hpre, hpost⟩

/-- Discharge witness (§3.3): the probe's valuation and stream. -/
theorem becomeFollower_handler_eq31_witness :
    ∃ σfin,
      stepFnIter 3234 (γS uρw wBase bf31S0) (γC uρw bf31C0) [3, 1, 0, 0]
        = .ok (.next .stop, σfin, [])
      ∧ absRaftNode (γS uρw wBase bf31S0) ⟨31⟩ = some ⟨0, 7, 2, 1, 1, 1⟩
      ∧ absRaftNode σfin ⟨31⟩
          = some (specBecomeFollower ⟨0, 7, 2, 1, 1, 1⟩ 0 4) :=
  becomeFollower_handler_eq31 uρw wBase ⟨rfl, rfl, rfl, rfl⟩
    (by decide) (by decide) 3 1 0 0 []

/-! ## The NON-identity witness (the flagship's liveness
demonstration — the BpcResite pattern at the full choice-crossing
handler: the raft cell genuinely at base 32 via `swap31_32`, the
`FrameSim` premise discharged by `frameSim_relocate`; NO closed
re-evaluation — the span is consumed as a proved fact). -/

def bf31σF : ExecState := renameState swap31_32 (γS uρw wBase bf31S0)

theorem bf31_relocSim :
    FrameSim swap31_32 33 33 [] (γS uρw wBase bf31S0) bf31σF :=
  frameSim_relocate swap31_32_spec (by show 33 ≤ 52; decide)
    (wBase_bodies_inv (fun x hx => by
      simp only [swap31_32]
      rw [if_neg (by omega), if_neg (by omega)]))

theorem becomeFollower_handler_eq_alloc31_witness_shifted :
    ∃ σfin,
      stepFnIter 3234 bf31σF
        (renameConfig swap31_32 (γC uρw bf31C0)) [3, 1, 0, 0]
        = .ok (.next .stop, σfin, [])
      ∧ absRaftNode bf31σF ⟨32⟩ = some ⟨0, 7, 2, 1, 1, 1⟩
      ∧ absRaftNode σfin ⟨32⟩
          = some (specBecomeFollower ⟨0, 7, 2, 1, 1, 1⟩ 0 4) := by
  obtain ⟨σfin, hrun, _, hpre, hpost⟩ :=
    becomeFollower_handler_eq_alloc31 uρw wBase ⟨rfl, rfl, rfl, rfl⟩
      (by decide) (by decide) 3 1 0 0 [] bf31_relocSim
  have haddr : (⟨swap31_32 31⟩ : Addr) = ⟨32⟩ := by
    simp [swap31_32]
  rw [haddr] at hpre hpost
  exact ⟨σfin, hrun, hpre, hpost⟩

