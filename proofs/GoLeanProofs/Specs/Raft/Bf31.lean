/-- The composed 3,234-step span at the prefix-derived valuation. -/
theorem bf31_full_span (ρ : Valuation) (σ : ExecState) (hag : bfTB.Agrees σ)
    (c₁ c₂ c₃ c₄ : Nat) (ch : Choices) :
    stepFnIter 3234 (γS (uρ' ρ c₁ c₂ c₃) σ bf31S0) (γC (uρ' ρ c₁ c₂ c₃) bf31C0)
      (c₁ :: c₂ :: c₃ :: c₄ :: ch)
      = .ok (.next .stop, γS (uρ' ρ c₁ c₂ c₃) σ bf31S13, ch) := by
  have w1 := fun chx => bf31Win1 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w2 := fun chx => bf31Win2 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w3 := fun chx => bf31Win3 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w4 := fun chx => bf31Win4 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w5 := fun chx => bf31Win5 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w6 := fun chx => bf31Win6 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w7 := fun chx => bf31Win7 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have p1 := bf31Pick1_step ρ σ hag (uKey1 c₂) (uKey2 c₂ c₃) (uKey3 c₂ c₃)
    c₁ (c₂ :: c₃ :: c₄ :: ch)
  have p2 := bf31Pick2_step ρ σ ((c₁ % 10 : Nat) : Int) (uKey2 c₂ c₃)
    (uKey3 c₂ c₃) c₂ (c₃ :: c₄ :: ch)
  have p3 := bf31Pick3_step ρ σ ((c₁ % 10 : Nat) : Int) (uKey3 c₂ c₃)
    c₂ c₃ (c₄ :: ch)
  have p4 := bf31Pick4_step ρ σ ((c₁ % 10 : Nat) : Int) c₂ c₃ c₄ ch
  have pstop := bf31Stop_step ρ σ ((c₁ % 10 : Nat) : Int) c₂ c₃ ch
  have psort := bf31Sort_step ρ σ ((c₁ % 10 : Nat) : Int) c₂ c₃ ch
  have h := GoLean.Surface.stepFnIter_chain
    (GoLean.Surface.stepFnIter_chain
      (GoLean.Surface.stepFnIter_chain
        (GoLean.Surface.stepFnIter_chain
          (GoLean.Surface.stepFnIter_chain
            (GoLean.Surface.stepFnIter_chain
              (GoLean.Surface.stepFnIter_chain
                (GoLean.Surface.stepFnIter_chain
                  (GoLean.Surface.stepFnIter_chain
                    (GoLean.Surface.stepFnIter_chain
                      (GoLean.Surface.stepFnIter_chain
                        (GoLean.Surface.stepFnIter_chain
                          (w1 (c₁ :: c₂ :: c₃ :: c₄ :: ch))
                          (GoLean.Surface.stepFnIter_one p1))
                        (w2 (c₂ :: c₃ :: c₄ :: ch)))
                      (GoLean.Surface.stepFnIter_one p2))
                    (w3 (c₃ :: c₄ :: ch)))
                  (GoLean.Surface.stepFnIter_one p3))
                (w4 (c₄ :: ch)))
              (GoLean.Surface.stepFnIter_one p4))
            (w5 ch))
          (GoLean.Surface.stepFnIter_one pstop))
        (w6 ch))
      (GoLean.Surface.stepFnIter_one psort))
    (w7 ch)
  have hstop : γC (uρ' ρ c₁ c₂ c₃) bf31C13 = .next .stop := by
    rw [bf31C13_stop]
    rfl
