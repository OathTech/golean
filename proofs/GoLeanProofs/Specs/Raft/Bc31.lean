set_option maxRecDepth 8000000
set_option maxHeartbeats 64000000
set_option smartUnfolding false

/-- The RE-SITED symbolic fixture (A4-U8 part 2: every cell `+31`
except the true statics 18/19 — globalRand, which reset's Intn path
reads through a body locLit; the probe `Bc31Gen` validated the run
end-to-end at this placement): state CONCRETE 0, Vote/lead/ldT
symbolic. -/
def shBfc : Nat → Nat := fun x => if x == 18 || x == 19 then x else x + 31

def bc31SymRaft : SymValue :=
  setSymField (setSymField (setSymField
    (embedGo (renameValue shBfc (uRaftVal 0 0 0 0)))
    "Vote" (.int (.var 1) .uint64))
    "lead" (.int (.var 2) .uint64))
    "leadTransferee" (.int (.var 4) .uint64)

def bc31SymHeap : List (Loc × GoLean.Sym.HeapCell symDom) :=
  (uHeap 0 0 0 0).map (fun (l, c) =>
    if l == .base ⟨0⟩ then (renameLoc shBfc l, .mk c.declaredTy bc31SymRaft)
    else (renameLoc shBfc l,
      .mk c.declaredTy (embedGo (renameValue shBfc c.value))))

def bc31S0 : SymState := { heap := bc31SymHeap, nextAddr := 52 }

/-- The drained call configuration of `becomeCandidate()` (receiver
only, at the re-sited raft cell 31). -/
def bc31C0 : SymConfig :=
  .retV (.addr (.base ⟨31⟩))
    (.callArgsK ⟨"raft.raft.becomeCandidate"⟩ [] [] [] [] .stop)

