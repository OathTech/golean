/-- The composed 3,282-step span at the prefix-derived valuation. -/
theorem bc31_full_span (ρ : Valuation) (σ : ExecState) (hag : bfTB.Agrees σ)
    (c₁ c₂ c₃ c₄ : Nat) (ch : Choices) :
    stepFnIter 3282 (γS (uρ' ρ c₁ c₂ c₃) σ bc31S0) (γC (uρ' ρ c₁ c₂ c₃) bc31C0)
      (c₁ :: c₂ :: c₃ :: c₄ :: ch)
      = .ok (.next .stop, γS (uρ' ρ c₁ c₂ c₃) σ bc31S13, ch) := by
  have w1 := fun chx => bc31Win1 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w2 := fun chx => bc31Win2 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w3 := fun chx => bc31Win3 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w4 := fun chx => bc31Win4 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w5 := fun chx => bc31Win5 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w6 := fun chx => bc31Win6 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have w7 := fun chx => bc31Win7 (uρ' ρ c₁ c₂ c₃) σ chx hag
  have p1 := bc31Pick1_step ρ σ hag (uKey1 c₂) (uKey2 c₂ c₃) (uKey3 c₂ c₃)
    c₁ (c₂ :: c₃ :: c₄ :: ch)
  have p2 := bc31Pick2_step ρ σ ((c₁ % 10 : Nat) : Int) (uKey2 c₂ c₃)
    (uKey3 c₂ c₃) c₂ (c₃ :: c₄ :: ch)
  have p3 := bc31Pick3_step ρ σ ((c₁ % 10 : Nat) : Int) (uKey3 c₂ c₃)
    c₂ c₃ (c₄ :: ch)
  have p4 := bc31Pick4_step ρ σ ((c₁ % 10 : Nat) : Int) c₂ c₃ c₄ ch
  have pstop := bc31Stop_step ρ σ ((c₁ % 10 : Nat) : Int) c₂ c₃ ch
  have psort := bc31Sort_step ρ σ ((c₁ % 10 : Nat) : Int) c₂ c₃ ch
  have h := GoLean.Surface.stepFnIter_chain
    (GoLean.Surface.stepFnIter_chain
      (GoLean.Surface.stepFnIter_chain
        (GoLean.Surface.stepFnIter_chain
          (GoLean.Surface.stepFnIter_chain
            (GoLean.Surface.stepFnIter_chain
              (GoLean.Surface.stepFnIter_chain
                (GoLean.Surface.stepFnIter_chain
                  (GoLean.Surface.stepFnIter_chain
                    (GoLean.Surface.stepFnIter_chain
                      (GoLean.Surface.stepFnIter_chain
                        (GoLean.Surface.stepFnIter_chain
                          (w1 (c₁ :: c₂ :: c₃ :: c₄ :: ch))
                          (GoLean.Surface.stepFnIter_one p1))
                        (w2 (c₂ :: c₃ :: c₄ :: ch)))
                      (GoLean.Surface.stepFnIter_one p2))
                    (w3 (c₃ :: c₄ :: ch)))
                  (GoLean.Surface.stepFnIter_one p3))
                (w4 (c₄ :: ch)))
              (GoLean.Surface.stepFnIter_one p4))
            (w5 ch))
          (GoLean.Surface.stepFnIter_one pstop))
        (w6 ch))
      (GoLean.Surface.stepFnIter_one psort))
    (w7 ch)
  have hstop : γC (uρ' ρ c₁ c₂ c₃) bc31C13 = .next .stop := by
    rw [bc31C13_stop]
    rfl
  rw [← hstop]
  exact h

/-- **THE HANDLER EQUATION**: from the drained `becomeCandidate()`
call at any γ-extension of the fixture (state 0) with projection
`some n`, over every consumed choice prefix, the run returns with
projection `specBecomeCandidate n 1` — no side conditions. -/
theorem becomeCandidate_handler_eq31 (ρ : Valuation) (σ : ExecState)
    (hag : bfTB.Agrees σ)
    (c₁ c₂ c₃ c₄ : Nat) (ch : Choices) :
    ∃ σfin,
      stepFnIter 3282 (γS ρ σ bc31S0) (γC ρ bc31C0)
        (c₁ :: c₂ :: c₃ :: c₄ :: ch)
        = .ok (.next .stop, σfin, ch)
      ∧ absRaftNode (γS ρ σ bc31S0) ⟨31⟩
          = some ⟨0, ρ.ints 1, ρ.ints 2, 0, 1, 1⟩
      ∧ absRaftNode σfin ⟨31⟩
          = some (specBecomeCandidate
              ⟨0, ρ.ints 1, ρ.ints 2, 0, 1, 1⟩ 1) := by
  have hpre : γS ρ σ bc31S0 = γS (uρ' ρ c₁ c₂ c₃) σ bc31S0 := by
    kernel_rfl
  have hpreC : γC ρ bc31C0 = γC (uρ' ρ c₁ c₂ c₃) bc31C0 := by
    kernel_rfl
  refine ⟨γS (uρ' ρ c₁ c₂ c₃) σ bc31S13, ?_, ?_, ?_⟩
  · rw [hpre, hpreC]
    exact bc31_full_span ρ σ hag c₁ c₂ c₃ c₄ ch
  · kernel_rfl
  · kernel_rfl

/-! ## Discharge witness (constitution §3.3): every premise at
concrete values — `wBase` tables, Vote 7 / lead 2 / leadTransferee 5,
the probe's stream `[3, 1, 0, 0]`. -/

theorem becomeCandidate_handler_eq31_witness :
    ∃ σfin,
      stepFnIter 3282 (γS bcρw wBase bc31S0) (γC bcρw bc31C0) [3, 1, 0, 0]
        = .ok (.next .stop, σfin, [])
      ∧ absRaftNode (γS bcρw wBase bc31S0) ⟨31⟩ = some ⟨0, 7, 2, 0, 1, 1⟩
      ∧ absRaftNode σfin ⟨31⟩
          = some (specBecomeCandidate ⟨0, 7, 2, 0, 1, 1⟩ 1) :=
  becomeCandidate_handler_eq31 bcρw wBase ⟨rfl, rfl, rfl, rfl⟩ 3 1 0 0 []


/-! ## The allocation-symbolic equation (PRIMARY; placement LIVE) -/

/-- **THE RE-SITED ALLOCATION-SYMBOLIC becomeCandidate EQUATION** —
no side conditions (every pre-symbolic scalar is overwritten). -/
theorem becomeCandidate_handler_eq_alloc31 (ρ : Valuation) (σ : ExecState)
    (hag : bfTB.Agrees σ)
    (c₁ c₂ c₃ c₄ : Nat) (ch : Choices)
    {r : Nat → Nat} {na₀ na : Nat} {fr : Heap} {σF : ExecState}
    (hF : FrameSim r na₀ na fr (γS ρ σ bc31S0) σF) :
    ∃ σFfin,
      stepFnIter 3282 σF (renameConfig r (γC ρ bc31C0))
        (c₁ :: c₂ :: c₃ :: c₄ :: ch)
        = .ok (.next .stop, σFfin, ch)
      ∧ FrameSim r na₀ na fr (γS (uρ' ρ c₁ c₂ c₃) σ bc31S13) σFfin
      ∧ absRaftNode σF ⟨r 31⟩ = some ⟨0, ρ.ints 1, ρ.ints 2, 0, 1, 1⟩
      ∧ absRaftNode σFfin ⟨r 31⟩
          = some (specBecomeCandidate ⟨0, ρ.ints 1, ρ.ints 2, 0, 1, 1⟩ 1) := by
  have hpre : γS ρ σ bc31S0 = γS (uρ' ρ c₁ c₂ c₃) σ bc31S0 := by
    kernel_rfl
  have hpreC : γC ρ bc31C0 = γC (uρ' ρ c₁ c₂ c₃) bc31C0 := by
    kernel_rfl
  have hrun : stepFnIter 3282 (γS ρ σ bc31S0) (γC ρ bc31C0)
      (c₁ :: c₂ :: c₃ :: c₄ :: ch)
      = .ok (.next .stop, γS (uρ' ρ c₁ c₂ c₃) σ bc31S13, ch) := by
    rw [hpre, hpreC]
    exact bc31_full_span ρ σ hag c₁ c₂ c₃ c₄ ch
  have hsim := stepFnIter_sim (na₀ := na₀) (na := na) 3282 hF
    (γC ρ bc31C0) (c₁ :: c₂ :: c₃ :: c₄ :: ch)
  obtain ⟨tF, htF, htrip⟩ := hsim.ok_inv hrun
  obtain ⟨cF, σFfin, chF⟩ := tF
  obtain ⟨hc, hs, hch⟩ := htrip
  dsimp only at hc hs hch
  subst hch
  have hcstop : renameConfig r (Machine.Config.next .stop)
      = Machine.Config.next .stop := rfl
  rw [hcstop] at hc
  subst hc
  refine ⟨σFfin, htF, hs, ?_, ?_⟩
  · have hpre0 : absRaftNode (γS ρ σ bc31S0) ⟨31⟩
        = some ⟨0, ρ.ints 1, ρ.ints 2, 0, 1, 1⟩ := by kernel_rfl
    exact absRaftNode_ren hF hpre0
  · have hpost : absRaftNode (γS (uρ' ρ c₁ c₂ c₃) σ bc31S13) ⟨31⟩
        = some (specBecomeCandidate ⟨0, ρ.ints 1, ρ.ints 2, 0, 1, 1⟩ 1) := by
      kernel_rfl
    exact absRaftNode_ren hs hpost

end GoLean.RaftSeam
