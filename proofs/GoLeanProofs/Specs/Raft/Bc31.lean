/-- The re-sited Visit candidate snapshot (Progress cells 38/39/40 —
the U3 `uCands3` at the `+31` placement). -/
def bc31Cands3 : Array (GoValue × GoValue) :=
  #[(.int 1 .uint64, .addr (.base ⟨38⟩)),
    (.int 2 .uint64, .addr (.base ⟨39⟩)),
    (.int 3 .uint64, .addr (.base ⟨40⟩))]

theorem bc31Cands3_get (i : Nat) (h : i < 3) :
    bc31Cands3[i]? = some (.int ((i : Int) + 1) .uint64,
      .addr (.base ⟨38 + i⟩)) := by
  have hd : i = 0 ∨ i = 1 ∨ i = 2 := by omega
  rcases hd with h | h | h <;> subst h <;> rfl

/-! ## Site 1 — the Intn pick (map keys 0..9 at base 30, `x₅ = ↑(c₁ % 10)`) -/

def bc31B1 : Stmt := match bc31C1 with
  | .next (.mapIterK _ _ _ _ b _ _ _ _ _) => b
  | _ => .seqn #[]
def bc31E1 : LocalEnv := match bc31C1 with
  | .next (.mapIterK _ _ _ _ _ _ _ _ e _) => e
  | _ => []
def bc31K1 : GoLean.Sym.Cont symDom := match bc31C1 with
  | .next (.mapIterK _ _ _ _ _ _ _ _ _ k) => k
  | _ => .stop
def bc31Start1 : Array SymValue := match bc31C1 with
  | .next (.mapIterK _ _ _ _ _ _ _ st _ _) => st
  | _ => #[]

theorem bc31C1_shape : bc31C1 = .next (.mapIterK (some "k") none uTyU uTySt
    bc31B1 (some (.base ⟨61⟩)) #[] bc31Start1 bc31E1 bc31K1) := by
  kernel_rfl

theorem bc31S2_eq : bc31S2 = (bc31S1.alloc uKeyV1 (some uTyU)).2 := by
  unfold bc31S2 bc31P2
  rw [bc31C1_shape]
  rfl

theorem bc31C2_eq : bc31C2 = .exec bc31B1
    ((bc31E1.pushScope).declare "k" (bc31S1.alloc uKeyV1 (some uTyU)).1)
    (.mapIterK (some "k") none uTyU uTySt bc31B1 (some (.base ⟨61⟩))
      (Array.push #[] uKeyV1) bc31Start1 bc31E1 bc31K1) := by
  unfold bc31C2 bc31P2
  rw [bc31C1_shape]
  rfl

theorem bc31Entries1 (ρ : Valuation) (σ : ExecState) :
    mapIterLiveEntries (γS ρ σ bc31S1) (some (.base ⟨61⟩))
      = .ok uCands1 := by
  kernel_rfl

theorem bc31Cands1_fact (ρ : Valuation) (σ : ExecState)
    (hag : bfTB.Agrees σ) :
    mapIterCandidates (γS ρ σ bc31S1) uTyU uTySt (some (.base ⟨61⟩))
      (Array.map (concV (symInterp ρ)) #[]) = .ok uCands1 := by
  have ht : (γS ρ σ bc31S1).types = bfTB.types := hag.1
  simp only [mapIterCandidates, bc31Entries1 ρ σ, Bind.bind, Except.bind, ht]
  with_unfolding_all rfl

theorem bc31Pick1_step (ρ : Valuation) (σ : ExecState)
    (hag : bfTB.Agrees σ) (b c d : Int) (c₁ : Nat) (rest : Choices) :
    stepFn (γS (uρ ρ ((c₁ % 10 : Nat) : Int) b c d) σ bc31S1)
      (γC (uρ ρ ((c₁ % 10 : Nat) : Int) b c d) bc31C1) (c₁ :: rest)
      = .ok (γC (uρ ρ ((c₁ % 10 : Nat) : Int) b c d) bc31C2,
          γS (uρ ρ ((c₁ % 10 : Nat) : Int) b c d) σ bc31S2, rest) := by
  have h10 : c₁ % 10 < 10 := Nat.mod_lt _ (by decide)
  rw [bc31C1_shape, bc31C2_eq, bc31S2_eq]
  refine stepFn_pick_transport _ σ (bc31Cands1_fact _ σ hag)
    (by with_unfolding_all rfl) (by with_unfolding_all rfl)
    ?_ (uCands1_get _ h10) (by with_unfolding_all rfl) ?_
  · show Choices.consume (c₁ :: rest) (uCands1.size + _) = _
    simp only [Choices.consume]
    rfl
  · have hn := normalize_small .int ((c₁ : Int) % 10)
      (by omega) (by omega)
    simp only [normalizeValueForTy]
    rw [show typeResolutionFuel = 1023 + 1 from rfl]
    simp [normalizeValueForTyFuel, hn, uTyU]

