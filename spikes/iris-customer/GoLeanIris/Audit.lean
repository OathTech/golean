    ``GoLean.IrisCustomer.shared_program,
    ``GoLean.IrisCustomer.shared_program_result,
    ``GoLean.IrisCustomer.full_root_exclusive,
    ``GoLean.IrisCustomer.shared_result_challenges_all_choices,
    ``GoLean.GoCore.RecoveryRuntime.callEnv_result,
    ``GoLean.GoCore.RecoveryRuntime.callEnv_pins,
    ``GoLean.GoCore.RecoveryRuntime.enterFrame_layout,
    ``GoLean.GoCore.RecoveryRuntime.enterFramePick_layout,
    ``GoLean.GoCore.RecoveryRuntime.setup_layout,
    ``GoLean.GoCore.RecoveryRuntime.Control.not_blocked,
    ``GoLean.GoCore.RecoveryRuntime.ValueCont.no_spawn,
    ``GoLean.GoCore.RecoveryRuntime.ValueCont.no_select,
    ``GoLean.GoCore.RecoveryRuntime.ValueCont.no_registry,
    ``GoLean.GoCore.RecoveryRuntime.Control.no_spawn,
    ``GoLean.GoCore.RecoveryRuntime.Control.no_select,
    ``GoLean.GoCore.RecoveryRuntime.Control.no_registry,
    ``GoLean.GoCore.RecoveryRuntime.Control.no_flag,
    ``GoLean.GoCore.RecoveryRuntime.Control.terminal_iff,
    ``GoLean.GoCore.RecoveryRuntime.Control.main_outcome,
    ``GoLean.GoCore.RecoveryRuntime.Control.runConfig_zero,
    ``GoLean.GoCore.RecoveryRuntime.Control.singleton_thread,
    ``GoLean.GoCore.RecoveryRuntime.Control.singleton_step,
    ``GoLean.GoCore.RecoveryRuntime.singleton_abort_step,
    ``GoLean.GoCore.RecoveryRuntime.stepFn_success_no_abort,
    ``GoLean.GoCore.RecoveryRuntime.singleton_abort_driver,
    ``GoLean.GoCore.RecoveryRuntime.Inv.pool_eq_runConfig,
    ``GoLean.GoCore.RecoveryRuntime.runProgramPool_eq_sequential,
    ``GoLean.GoCore.RecoveryRuntime.setup_result_inv,
    ``GoLean.GoCore.RecoveryRuntime.entryConsult_no_methods,
    ``GoLean.GoCore.RecoveryRuntime.entryConsult_match_no_methods,
    ``GoLean.GoCore.RecoveryRuntime.ValueCont.no_seq_consumption,
    ``GoLean.GoCore.RecoveryRuntime.UnwindCont.no_seq_consumption,
    ``GoLean.GoCore.RecoveryRuntime.Control.no_seq_consumption,
    ``GoLean.GoCore.RecoveryRuntime.Inv.no_seq_consumption,
    ``GoLean.GoCore.RecoveryRuntime.Inv.loop_all_choices]
  for n in exports do
    let some (.thmInfo _) := env.find? n
      | throwError "Iris customer: missing theorem {n}"
  let ours := env.header.moduleNames.map
    (fun n => [`GoLeanIris, `GateA1, `GoLean, `Tests].contains n.getRoot)
  let mut checked := 0
  for (n, _) in env.constants.toList do
    let localModule := match env.getModuleIdxFor? n with
      | some i => ours[i.toNat]!
      | none => true
    unless localModule do continue
    for ax in (← collectAxioms n) do
      unless allowed.contains ax do
        throwError "Iris customer: {n} depends on forbidden axiom {ax}"
    checked := checked + 1
  logInfo s!"Iris customer: {exports.length} required exports present; {checked} constants' axiom dependencies checked (classical trio only)"
