import GoLeanIris.OwnershipTests
import GoLeanIris.Terminal
import GateA1
import Lean

/-! Invoked only by an external harness after all complete customer modules
are imported. Module-origin selection includes private, generated, aggregate
and trailing declarations. A1's complete adapter is swept as well. -/
open Lean

def GoLeanIrisAudit.run : CoreM Unit := do
  let env ← getEnv
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let modules : List Name := [
    `GoLeanIris.Heap,
    `GoLeanIris.Ghost,
    `GoLeanIris.Lifting,
    `GoLeanIris.Rules,
    `GoLeanIris.Adequacy,
    `GoLeanIris.Program,
    `GoLeanIris.Admission,
    `GoLeanIris.Allocation,
    `GoLeanIris.Call,
    `GoLeanIris.Unwind,
    `GoLeanIris.Return,
    `GoLeanIris.Examples,
    `GoLeanIris.Readout,
    `GoLeanIris.Driver,
    `GoLeanIris.SharedProgram,
    `GoLeanIris.SharedHelpers,
    `GoLeanIris.SharedRecovery,
    `GoLeanIris.SharedDrain,
    `GoLeanIris.Shared,
    `GoLeanIris.SharedReadout,
    `GoLeanIris.SharedDriver,
    `GoLeanIris.OwnershipTests,
    `GoLeanIris.Terminal,
    `GoLeanIris.Audit,
    `GoLean.GoCore.RecoveryCallLayout,
    `GoLean.GoCore.RecoverySingleton,
    `GoLean.GoCore.RecoveryPool,
    `GoLean.GoCore.RecoveryChoices,
    `GoLean.GoCore.StringPanic,
    `GoLean.GoCore.RecoveryTerminal,
    `GoLean.GoCore.RecoveryPoolObservationTyped]
  for m in modules do
    unless env.header.moduleNames.contains m do
      throwError "Iris customer: missing supporting module {m}"
  let exports : List Name := [
    ``GoLean.IrisCustomer.observed_normal_of_program,
    ``GoLean.IrisCustomer.recovered_observed_all_choices,
    ``GoLean.IrisCustomer.normal_observed_all_choices,
    ``GoLean.IrisCustomer.shared_observed_all_choices,
    ``GoLean.IrisCustomer.uncaught_has_actual_record,
    ``GoLean.IrisCustomer.a2_entries_refusal_named,
    ``GoLean.IrisCustomer.shared_refusal_named,
    ``GoLean.IrisCustomer.fixtures_not_refused_at_fuel,
    ``GoLean.IrisCustomer.cellsToMap_below,
    ``GoLean.IrisCustomer.get?_cellsToMap,
    ``GoLean.IrisCustomer.get?_heapToMap,
    ``GoLean.IrisCustomer.heapToMap_set,
    ``GoLean.IrisCustomer.heapToMap_push,
    ``GoLean.IrisCustomer.heapToMap_fresh,
    ``GoLean.IrisCustomer.ContextEq.heap,
    ``GoLean.IrisCustomer.step_unique,
    ``GoLean.IrisCustomer.wp_context_step,
    ``GoLean.IrisCustomer.wp_read_step,
    ``GoLean.IrisCustomer.wp_write_step,
    ``GoLean.IrisCustomer.wp_alloc_step,
    ``GoLean.IrisCustomer.loadLoc_cell,
    ``GoLean.IrisCustomer.storeLoc_cell,
    ``GoLean.IrisCustomer.wp_recover_assignment,
    ``GoLean.IrisCustomer.wp_initialize,
    ``GoLean.IrisCustomer.wp_neq_interface_nil,
    ``GoLean.IrisCustomer.wp_load_var,
    ``GoLean.IrisCustomer.wp_store_cell,
    ``GoLean.IrisCustomer.wp_consequence,
    ``GoLean.IrisCustomer.wp_frame,
    ``GoLean.IrisCustomer.steps_erased,
    ``GoLean.IrisCustomer.heap_adequacy,
    ``GoLean.IrisCustomer.adequate_execStmtLoop,
    ``GoLean.IrisCustomer.recovery_admitted,
    ``GoLean.IrisCustomer.recovery_typed,
    ``GoLean.IrisCustomer.normal_admitted,
    ``GoLean.IrisCustomer.uncaught_admitted,
    ``GoLean.IrisCustomer.heap_alloc_cells,
    ``GoLean.IrisCustomer.wp_alloc_cells_step,
    ``GoLean.IrisCustomer.CallSite.not_value,
    ``GoLean.IrisCustomer.CallSite.step,
    ``GoLean.IrisCustomer.ContextEq.sameContext,
    ``GoLean.IrisCustomer.wp_call,
    ``GoLean.IrisCustomer.wp_recover,
    ``GoLean.IrisCustomer.wp_recover_direct,
    ``GoLean.IrisCustomer.wp_recover_indirect,
    ``GoLean.IrisCustomer.wp_recover_rhs,
    ``GoLean.IrisCustomer.wp_defer_register,
    ``GoLean.IrisCustomer.wp_recover_rhs_nil,
    ``GoLean.IrisCustomer.wp_recover_rhs_frame,
    ``GoLean.IrisCustomer.wp_defer_register_args,
    ``GoLean.IrisCustomer.wp_panic_payload,
    ``GoLean.IrisCustomer.wp_panic_strip,
    ``GoLean.IrisCustomer.wp_panic_frame,
    ``GoLean.IrisCustomer.wp_panic_merge,
    ``GoLean.IrisCustomer.wp_resume_recovered,
    ``GoLean.IrisCustomer.wp_resume_panic,
    ``GoLean.IrisCustomer.FrameExitSite.not_value,
    ``GoLean.IrisCustomer.FrameExitSite.step,
    ``GoLean.IrisCustomer.wp_frame_empty,
    ``GoLean.IrisCustomer.wp_frame_result,
    ``GoLean.IrisCustomer.wp_deref_cell,
