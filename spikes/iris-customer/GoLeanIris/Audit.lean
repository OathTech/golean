    ``GoLean.IrisCustomer.cell_adequacy,
    ``GoLean.IrisCustomer.recovered_adequate,
    ``GoLean.IrisCustomer.normal_adequate,
    ``GoLean.IrisCustomer.wp_recovered_framed,
    ``GoLean.IrisCustomer.framed_normal_adequate,
    ``GoLean.IrisCustomer.adequate_program_result,
    ``GoLean.IrisCustomer.adequate_typed_program_result,
    ``GoLean.IrisCustomer.adequate_typed_program_all_choices,
    ``GoLean.IrisCustomer.recovered_setup_general,
    ``GoLean.IrisCustomer.recovered_setup,
    ``GoLean.IrisCustomer.successful_iff,
    ``GoLean.IrisCustomer.recovered_terminates,
    ``GoLean.IrisCustomer.recovered_no_registry_boundaries,
    ``GoLean.IrisCustomer.recovered_program_all_choices,
    ``GoLean.IrisCustomer.recovered_program_exact,
    ``GoLean.IrisCustomer.recovered_program_result,
    ``GoLean.IrisCustomer.recovered_silent,
    ``GoLean.IrisCustomer.recovered_program,
    ``GoLean.IrisCustomer.normal_setup_general,
    ``GoLean.IrisCustomer.normal_setup,
    ``GoLean.IrisCustomer.normal_terminates,
    ``GoLean.IrisCustomer.normal_no_registry_boundaries,
    ``GoLean.IrisCustomer.normal_program_all_choices,
    ``GoLean.IrisCustomer.normal_program_exact,
    ``GoLean.IrisCustomer.normal_program_result,
    ``GoLean.IrisCustomer.uncaught_program,
    ``GoLean.IrisCustomer.shared_admitted,
    ``GoLean.IrisCustomer.shared_typed,
    ``GoLean.IrisCustomer.wp_flip_body,
    ``GoLean.IrisCustomer.wp_shared_flip_handler,
    ``GoLean.IrisCustomer.wp_indirect_body,
    ``GoLean.IrisCustomer.wp_shared_recover_handler,
    ``GoLean.IrisCustomer.wp_shared_last_handler,
    ``GoLean.IrisCustomer.drain_frame_recovery,
    ``GoLean.IrisCustomer.wp_shared_drain,
