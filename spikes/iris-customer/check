#!/usr/bin/env bash
# Dedicated opt-in customer gate; never part of the semantics default build.
set -euo pipefail
CUSTOMER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$CUSTOMER_ROOT/../.." && pwd -P)"
cd "$REPO_ROOT"
python3 "$CUSTOMER_ROOT/gate_checks.py" preflight
"$REPO_ROOT/scripts/capped" lake build
cd "$CUSTOMER_ROOT"
"$REPO_ROOT/scripts/capped" lake build
python3 gate_checks.py dependencies
for module in RecoveryCallLayout RecoverySingleton RecoveryPool RecoveryChoices; do
  sha256sum "$REPO_ROOT/GoLean/GoCore/$module.lean"
  "$REPO_ROOT/scripts/capped" lake env lean "$REPO_ROOT/GoLean/GoCore/$module.lean"
done
for module in Heap Ghost Lifting Rules Adequacy Program Admission Allocation Call Unwind Return Examples Readout Driver SharedProgram SharedHelpers SharedRecovery SharedDrain Shared SharedReadout SharedDriver OwnershipTests Audit; do
  sha256sum "GoLeanIris/$module.lean"
  "$REPO_ROOT/scripts/capped" lake env lean "GoLeanIris/$module.lean"
done
"$REPO_ROOT/scripts/capped" lake env lean GoLeanIris.lean
"$REPO_ROOT/scripts/capped" lake env python3 gate_checks.py audit
"$REPO_ROOT/scripts/capped" lake env python3 gate_checks.py artifact
cd "$REPO_ROOT"
GOLEAN_COVERAGE_ARTIFACTS=artifacts/iris-customer \
  scripts/diff-coverage spikes/iris-customer/fixtures/manifest.tsv
GOLEAN_COVERAGE_ARTIFACTS=artifacts/recovery-typing/differential \
  scripts/diff-coverage Tests/recovery-typing-fixture/manifest.tsv
printf '%s\n' 'Iris customer: PASS'
