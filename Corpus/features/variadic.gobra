package pkg;

func sum(xs ...int) (t int) {
	i := 0;
	for i < len(xs) {
		t = t + xs[i];
		i = i + 1;
	};
};

func isNilArgs(xs ...int) (r bool) {
	var ys []int;
	ys = xs;
	r = ys == nil;
	return;
};

func variadic() (z int) {
	var nilSlice []int;
	parts := []int{4, 5};
	merged := append([]int{1, 2, 3}, parts...);
	noArgsNil := 0;
	if isNilArgs() {
		noArgsNil = 1;
	};
	oneArgNil := 0;
	if isNilArgs(1) {
		oneArgNil = 1;
	};
	z = noArgsNil * 100000 + oneArgNil * 10000 + sum(nilSlice...) * 1000 + sum(1, 2, 3) * 100 + len(merged) * 10 + merged[4];
};
