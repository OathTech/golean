package pkg;

type point struct {
	x int
}

func rangeStructCopy() (z int) {
	pts := []point{point{1}, point{2}, point{3}};
	for _, p := range pts {
		p.x = 99;
	};
	pre := pts[0].x * 100 + pts[1].x * 10 + pts[2].x;

	for i := range pts {
		pts[i].x = 99;
	};
	post := pts[0].x * 10000 + pts[1].x * 100 + pts[2].x;
	z = pre * 1000000 + post;
};
