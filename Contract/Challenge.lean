theorem GoLean.Contract.GoCore.Machine.seqOut_of_prefix :
    ∀ {ctx : ProgramCtx} {n : Nat} {σ sf : Store} {c cf : Config} {ch chf : Choices}
      {ls : List StepLabel},
      Prefix ctx n σ c ch ls sf cf chf →
        ∀ {fuel : Nat} {acc : GoString},
          n ≤ fuel →
