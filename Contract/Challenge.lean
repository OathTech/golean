set_option warn.sorry false in
/-- `GoLean.GoCore.ExecutionStatement.runInitConfig_unfold` (GoLean.GoCore.InitDriverFacts) -/
-- Stated through the original's matcher constants (`pp.match false`): a `match` in a
-- statement mints a matcher per module, so the challenge names the kept theorem's own.
theorem GoLean.Contract.GoCore.ExecutionStatement.runInitConfig_unfold :
    (∀ (ctx : ProgramCtx) (fuel : Nat) (s : Store) (c : Config) (ch : Choices),
           runInitConfig ctx fuel s c ch =
             runInitConfig_unfold.match_7 (fun (c : Config) => Except Stop (Store × Choices)) c
               (fun (_ : Unit) => Except.ok (s, ch))
               (fun (ch : Option Loc) (v : GoValue) (k : Cont) => throw Stop.deadlock)
               (fun (ch : Option Loc) (targets : List Assignee) (elem : Ty) (env : LocalEnv) (k : Cont) =>
                 throw Stop.deadlock)
               (fun (clauses : List EvClause) (env : LocalEnv) (k : Cont) => throw Stop.deadlock)
               (fun (op : SyncOp) (loc : Loc) (env : LocalEnv) (k : Cont) => throw Stop.deadlock)
               fun (c : Config) =>
               runInitConfig_unfold.match_5 (fun (x : Option Stop) => Except Stop (Store × Choices))
                 (initPrintRefusal? c) (fun (e : Stop) => throw e) fun (_ : Unit) =>
                 runInitConfig_unfold.match_3 (fun (fuel : Nat) => Except Stop (Store × Choices)) fuel
                   (fun (_ : Unit) => throw Stop.fuelOut) fun (fuel : Nat) => do
                   let __x ← stepFn ctx s c ch
                   runInitConfig_unfold.match_1
                       (fun (x : Config × Store × Choices × StepLabel) => Except Stop (Store × Choices)) __x
                       fun (c' : Config) (s' : Store) (choices' : Choices) (snd : StepLabel) =>
                       runInitConfig ctx fuel s' c' choices')
    := sorry

