/-- `GoLean.GoCore.Machine.execProgLoopOut_single_prefix` (GoLean.GoCore.PoolProjection) -/
theorem GoLean.Contract.GoCore.Machine.execProgLoopOut_single_prefix :
    ∀ {ctx : ProgramCtx} {fuel n : Nat} {σ sf : Store} {c cf : Config} {ch chf : Choices}
      {ls : List StepLabel} {rs : RaceState} {acc : GoString} {r : Except Stop (Store × Choices)},
      execStmtLoop ctx fuel σ c ch = r →
        transferable r →
          Prefix ctx n σ c ch ls sf cf chf →
            n ≤ fuel →
              (n = fuel ∨ ZeroCost cf ∨ ∃ (e : Stop), stepFn ctx sf cf chf = Except.error e) →
                execProgLoopOut ctx (fuel + seqOpCount ctx fuel σ c ch)
                    { threads := #[Thread.running c none], shared := σ } rs ch acc =
                  (outFold ls acc, r)
    := sorry

