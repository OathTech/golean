#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

MANIFEST="${1:-}"
OUT="${GOLEAN_COVERAGE_ARTIFACTS:-artifacts/coverage}"
RESULTS_TSV="${GOLEAN_NEGATIVE_RESULTS:-$OUT/negative-latest.tsv}"
META_TSV="${GOLEAN_NEGATIVE_META:-$OUT/negative-latest.meta.tsv}"
GO_BUILD_CACHE="$ROOT/artifacts/go-build-cache"
GO_TIMEOUT_SECONDS="${GO_TIMEOUT_SECONDS:-30}"
BUILD_OUT="$(mktemp -d "${TMPDIR:-/tmp}/golean-negative-build.XXXXXX")"

# GATE INTEGRITY (exec-lane pattern, scaled down — fidelity work
# program 2026-08-31, item 1 / assessment D-5; rationale as in
# scripts/diff-coverage): invalidate the previous run's published
# results FIRST, so a run that dies before publish leaves NO readable
# results/meta pair for a consumer to judge as fresh. Exit discipline
# mirrors the exec lane: 1 = FAIL rows exist and published results ARE
# authoritative; >= 2 = infrastructure, nothing published.
rm -f "$RESULTS_TSV" "$META_TSV"

# Timeout knob must be a positive integer (exec-lane audit F1 pattern:
# perl numifies a non-numeric string to 0 and `alarm 0` CANCELS the
# guard — a value like "20m" would silently disable it).
if [[ ! "$GO_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
  echo "coverage-negative: GO_TIMEOUT_SECONDS must be a positive integer (seconds), got '$GO_TIMEOUT_SECONDS' — refusing to run with a disabled or malformed timeout" >&2
  exit 2
fi

run_with_timeout() {
  local seconds="$1"
  shift
  perl -e 'my $t = shift @ARGV; my $pid = fork(); die "fork failed\n" unless defined $pid; if ($pid == 0) { exec @ARGV; exit 127 } $SIG{ALRM} = sub { kill "TERM", $pid; select undef, undef, undef, 1; kill "KILL", $pid; exit 124 }; alarm $t; waitpid $pid, 0; my $s = $?; exit($s == -1 ? 127 : ($s & 127 ? 128 + ($s & 127) : $s >> 8));' "$seconds" "$@"
}

if ! command -v go >/dev/null 2>&1; then
  echo "go not found on PATH; install Go or expose it in the shell to run negative coverage" >&2
  exit 2
fi

# THE ORACLE-ONLY TOOLCHAIN SWITCH (release-readiness item 32; the
# rationale, the [USER] ruling and the measured reason it is PATH/GOROOT
# and not GOTOOLCHAIN — GOPATH mode ignores GOTOOLCHAIN — are
# scripts/diff-coverage's twin block). GOLEAN_ORACLE_GOTOOLCHAIN=goX.Y.Z
# runs ONLY gc's per-row `go build` (the rejection oracle) under that
# toolchain; the frontend's build and run stay on the live toolchain, which
# must be the pin. A canary checks the switch took. Unset: nothing here
# runs. A gc that ACCEPTS a row under the alternate is a finding for the
# caller (a FAIL row, stage go-compile), never a re-pin.
ORACLE_GOTOOLCHAIN="${GOLEAN_ORACLE_GOTOOLCHAIN:-}"
oracle_toolchain_env=()
if [[ -n "$ORACLE_GOTOOLCHAIN" ]]; then
  if [[ ! "$ORACLE_GOTOOLCHAIN" =~ ^go[0-9]+\.[0-9]+(\.[0-9]+)?((rc|beta)[0-9]+)?$ ]]; then
    echo "coverage-negative: GOLEAN_ORACLE_GOTOOLCHAIN='$ORACLE_GOTOOLCHAIN' is not a toolchain name (goX.Y.Z); refusing" >&2
    exit 2
  fi
  _pin="$(head -1 "$ROOT/baselines/go-oracle-pin" 2>/dev/null | tr -d '[:space:]')"
  _fe_tc="$(go version 2>/dev/null | awk '{print $3}')"
  if [[ -z "$_pin" || "$_fe_tc" != "$_pin" ]]; then
    echo "coverage-negative: GOLEAN_ORACLE_GOTOOLCHAIN: the frontend side's toolchain '${_fe_tc:-<go version failed>}' is not the pin '${_pin:-<baselines/go-oracle-pin unreadable>}'; refusing" >&2
    exit 2
  fi
  if ! ORACLE_GOROOT="$(env -u GOROOT GO111MODULE=on GOFLAGS= GOTOOLCHAIN="$ORACLE_GOTOOLCHAIN" go env GOROOT 2>&1)" \
      || [[ ! -x "$ORACLE_GOROOT/bin/go" ]]; then
    echo "coverage-negative: GOLEAN_ORACLE_GOTOOLCHAIN=$ORACLE_GOTOOLCHAIN does not resolve to a runnable toolchain here ($(printf '%s' "$ORACLE_GOROOT" | head -c 300)); refusing" >&2
    exit 2
  fi
  oracle_toolchain_env=(PATH="$ORACLE_GOROOT/bin:$PATH" GOROOT="$ORACLE_GOROOT" GOTOOLCHAIN=local)
  mkdir -p "$GO_BUILD_CACHE"
  _canary="$(mktemp -d "${TMPDIR:-/tmp}/golean-oracle-canary.XXXXXX")"
  printf 'package main\n\nimport (\n\t"fmt"\n\t"runtime"\n)\n\nfunc main() { fmt.Print(runtime.Version()) }\n' > "$_canary/main.go"
  _said="$(cd "$_canary" && env GO111MODULE=off GOFLAGS= GOCACHE="$GO_BUILD_CACHE" "${oracle_toolchain_env[@]}" go run . 2>&1)"
  rm -rf "$_canary"
  if [[ "$_said" != "$ORACLE_GOTOOLCHAIN" ]]; then
    echo "coverage-negative: GOLEAN_ORACLE_GOTOOLCHAIN canary reports runtime.Version()='$(printf '%s' "$_said" | head -c 300)', not $ORACLE_GOTOOLCHAIN — the switch did not take; refusing" >&2
    exit 2
  fi
  unset _pin _fe_tc _canary _said
  echo "coverage-negative: ORACLE toolchain $ORACLE_GOTOOLCHAIN ($ORACLE_GOROOT; canary ok); frontend on $(go version | awk '{print $3}')" >&2
fi

# ORACLE VERSION PIN (exec-lane pattern, diff-coverage's block verbatim
# in miniature — assessment D-5: the negative lane previously held the
# pin only transitively, when invoked under ci after its step 0c; a
# standalone run against a drifted toolchain recorded silently).
GO_PIN_FILE="$ROOT/baselines/go-oracle-pin"
if [[ -f "$GO_PIN_FILE" ]]; then
  go_pin="$(head -1 "$GO_PIN_FILE" | tr -d '[:space:]')"
  go_live="$(go version | awk '{print $3}')"
  go_oracle="${ORACLE_GOTOOLCHAIN:-$go_live}"
  if [[ "$go_oracle" != "$go_pin" ]]; then
    if [[ "${GOLEAN_ALLOW_GO_DRIFT:-0}" = 1 ]]; then
      echo "WARNING: live toolchain $go_oracle != pinned oracle $go_pin (GOLEAN_ALLOW_GO_DRIFT=1 — this run is NOT against the oracle of record)" >&2
    else
      echo "coverage-negative: live toolchain $go_oracle != pinned oracle $go_pin (baselines/go-oracle-pin); refusing — set GOLEAN_ALLOW_GO_DRIFT=1 to probe a non-oracle toolchain loudly" >&2
      exit 2
    fi
  fi
else
  echo "coverage-negative: baselines/go-oracle-pin missing — the oracle pin is unverifiable; refusing" >&2
  exit 2
fi

GENERATED_MANIFEST=""
if [[ -z "$MANIFEST" ]]; then
  GENERATED_MANIFEST="$(mktemp "${TMPDIR:-/tmp}/golean-negative-coverage.XXXXXX")"
  if ! scripts/coverage-negative-manifest > "$GENERATED_MANIFEST"; then
    exit 2
  fi
  MANIFEST="$GENERATED_MANIFEST"
fi

if [[ ! -f "$MANIFEST" ]]; then
  echo "negative coverage manifest not found: $MANIFEST" >&2
  exit 2
fi

mkdir -p artifacts "$OUT" "$GO_BUILD_CACHE"

# THE FRONTEND LEG (refusal-cause pinning, release-readiness item 8 / D3 —
# [USER] Mike 2026-10-12 approved items 1 and 3-6, relayed: a row passes only
# if the native frontend exits 1 at type-check, parse or file selection;
# docs/2026-10-12_refusal-cause-pinning-design.md §3). gc's rejection
# alone tested the oracle, never GoLean: this is the check that the
# trusted frontend does not LOWER a program gc rejects. The frontend is
# built here from the tree under test (never a stale binary from another
# run); a build failure is an infrastructure refusal (exit 2, nothing
# published), never a skipped leg.
FRONTEND_BIN="$BUILD_OUT/nativefrontend"
if ! fe_build="$(env GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" go build -o "$FRONTEND_BIN" ./tools/nativefrontend 2>&1)"; then
  printf '%s\n' "$fe_build" >&2
  echo "coverage-negative: tools/nativefrontend does not build — the frontend leg cannot run; refusing (nothing published)" >&2
  exit 2
fi

# ATOMIC PUBLISH (exec-lane pattern): rows accumulate in a same-dir
# tmp pair and land at the published paths in one mv each, only after
# the whole run classified. A killed run leaves nothing readable.
RESULTS_DIR="$(dirname "$RESULTS_TSV")"
META_DIR="$(dirname "$META_TSV")"
mkdir -p "$RESULTS_DIR" "$META_DIR"
RESULTS_TMP="$(mktemp "$RESULTS_DIR/.$(basename "$RESULTS_TSV").XXXXXX")"
META_TMP="$(mktemp "$META_DIR/.$(basename "$META_TSV").XXXXXX")"
printf 'result\tid\tfeatures\tstage\tdetail\n' > "$RESULTS_TMP"

# PUBLISHED META (exec-lane pattern, the same key set the fast gate's
# attribution check reads: which case set, which commit, which oracle,
# drifted or not). The manifest sha covers ids, dirs, expected
# substrings and feature tags — a silent case-set/expectation edit is
# visible against a cached record.
manifest_sha="$(sha256sum "$MANIFEST" | awk '{ print $1 }')"
manifest_cases="$(awk -F $'\t' 'NF > 0 && $1 !~ /^#/ { count += 1 } END { print count + 0 }' "$MANIFEST")"
git_commit="$(git rev-parse HEAD 2>/dev/null || printf 'unknown')"
# Untracked files count as dirty (audit T3-7): `git diff` sees only
# tracked content, so a run with an untracked corpus dir/case recorded
# git_dirty=false. Porcelain -unormal covers tracked AND untracked;
# a failed git probe records dirty (fail closed).
if _gstatus="$(git status --porcelain -unormal -- . 2>/dev/null)" && [[ -z "$_gstatus" ]]; then
  git_dirty=false
else
  git_dirty=true
fi
unset _gstatus
# go_drift_allowed = the GOLEAN_ALLOW_GO_DRIFT escape FLAG at run time;
# go_drift_actual = the MEASURED live-vs-pin bit (audit T3-6: the old
# single go_drift field recorded the flag, so an allowed-but-undrifted
# run read as drifted and an actual drift was only inferable). Readers
# (scripts/ci) prefer go_drift_actual, falling back to the legacy
# go_drift field on pre-T3-6 records.
go_drift_actual=false
if [[ "$go_live" != "$go_pin" || "$go_oracle" != "$go_pin" ]]; then
  go_drift_actual=true
fi
{
  printf 'key\tvalue\n'
  printf 'lane\tnegative\n'
  printf 'manifest\t%s\n' "$MANIFEST"
  printf 'manifest_sha256\t%s\n' "$manifest_sha"
  printf 'manifest_cases\t%s\n' "$manifest_cases"
  printf 'git_commit\t%s\n' "$git_commit"
  printf 'git_dirty\t%s\n' "$git_dirty"
  if [[ -n "$ORACLE_GOTOOLCHAIN" ]]; then
    printf 'go_toolchain\t%s\n' "$ORACLE_GOTOOLCHAIN"
  else
    printf 'go_toolchain\t%s\n' "$(go version 2>/dev/null | awk '{print $3}' || printf 'unknown')"
  fi
  printf 'go_toolchain_frontend\t%s\n' "$go_live"
  printf 'go_toolchain_oracle\t%s\n' "$go_oracle"
  printf 'go_drift_allowed\t%s\n' "${GOLEAN_ALLOW_GO_DRIFT:-0}"
  printf 'go_drift_actual\t%s\n' "$go_drift_actual"
} > "$META_TMP"

cleanup() {
  rm -f "$RESULTS_TMP" "$META_TMP"
  if [[ -n "$GENERATED_MANIFEST" ]]; then
    rm -f "$GENERATED_MANIFEST"
  fi
  rm -rf "$BUILD_OUT"
}
trap cleanup EXIT

publish_results() {
  # Meta FIRST (audit T3-5). The invariant consumers rely on is
  # "results present ⇒ attributable meta present": each mv is atomic
  # but the pair is two of them, and the old results-first order had a
  # kill window that left results WITHOUT meta — exactly the
  # unattributable state scripts/ci refuses. Meta-first leaves at worst
  # meta-without-results, which no consumer reads as a run.
  mv "$META_TMP" "$META_TSV"
  mv "$RESULTS_TMP" "$RESULTS_TSV"
}

case_count=0
pass_count=0
fail_count=0

one_line() {
  local value="$1"
  value="${value//$'\t'/ }"
  value="${value//$'\r'/\\r}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

report_negative_fail() {
  local id="$1"
  local features="$2"
  local stage="$3"
  local detail="$4"
  local flat_detail
  flat_detail="$(one_line "$detail")"
  printf 'FAIL\t%s\t%s\tstage=%s\tdetail=%s\n' "$id" "$features" "$stage" "$flat_detail"
  printf 'FAIL\t%s\t%s\t%s\t%s\n' "$id" "$features" "$stage" "$flat_detail" >> "$RESULTS_TMP"
  fail_count=$((fail_count + 1))
}

report_negative_pass() {
  local id="$1"
  local features="$2"
  local detail="$3"
  printf 'PASS\t%s\t%s\t%s\n' "$id" "$features" "$detail"
  printf 'PASS\t%s\t%s\t-\t%s\n' "$id" "$features" "$detail" >> "$RESULTS_TMP"
  pass_count=$((pass_count + 1))
}

# The frontend leg's verdict on one gc-rejected row. Sets fe_stage (empty =
# the row passes) and fe_detail. The frontend's only deliberate exit is 1
# (tools/nativefrontend/main.go: `nativefrontend: <error>`); its first
# line is classed:
#   type-check      `nativefrontend: type-check: …` (go/types, load.go) —
#                   but NOT an importer failure (`could not import`)
#   parse           `nativefrontend: <go_dir>/<file>.go:L:C: …` (go/parser
#                   via fileselect.go — gc's syntax errors)
#   file-selection  `nativefrontend: native frontend unsupported: file
#                   selection …` (the BUG-108 boundary, fileselect.go)
# Anything else FAILS under its own stage: frontend-accepts (exit 0 — it
# lowered a program gc rejects), frontend-crash (a timeout, a signal, a Go
# panic's exit 2 or any other code), frontend-reason (exit 1 for another
# reason — e.g. a coverage refusal that would start LOWERING the program
# once its feature lands).
# The leg passes NO --subject (BUG-125, tools/nativefrontend/entrymode.go):
# it judges the WHOLE PROGRAM, under gc's rule that a `package main` declares
# func main — the frontend's default.
FE_PARSE_RE='^nativefrontend: ([^:]+)\.go:[0-9]+:[0-9]+: '
frontend_leg() {
  local go_dir="$1" out rc=0 first
  out="$(run_with_timeout "$GO_TIMEOUT_SECONDS" "$FRONTEND_BIN" --dir "$go_dir" --out "$BUILD_OUT/wire.json" 2>&1)" || rc=$?
  rm -f "$BUILD_OUT/wire.json"
  first="${out%%$'\n'*}"
  fe_stage=""
  case "$rc" in
    0)   fe_stage="frontend-accepts"; fe_detail="the native frontend LOWERED a program gc rejects (exit 0): $out"; return ;;
    1)   ;;
    124) fe_stage="frontend-crash"; fe_detail="native frontend TIMED OUT after ${GO_TIMEOUT_SECONDS}s (GO_TIMEOUT_SECONDS): $out"; return ;;
    *)   fe_stage="frontend-crash"; fe_detail="native frontend (exit $rc) — not its refusal exit 1: $out"; return ;;
  esac
  # An IMPORTER failure surfaces as `type-check: … could not import X` — it
  # is not the program's rejection (an import-cycle row would pass for an
  # unrelated reason; a broken stdlib importer would pass every importing
  # row vacuously): frontend-reason (fix round, review MEDIUM-2).
  if [[ "$first" == "nativefrontend: type-check: "* && "$first" != *"could not import"* ]]; then
    fe_detail="frontend=type-check"
  elif [[ "$first" == "nativefrontend: native frontend unsupported: file selection "* ]]; then
    fe_detail="frontend=file-selection"
  elif [[ "$first" =~ $FE_PARSE_RE ]] && [[ "${BASH_REMATCH[1]}" == "$go_dir"/* ]]; then
    fe_detail="frontend=parse"
  else
    fe_stage="frontend-reason"; fe_detail="the native frontend refused (exit 1) but not as a rejection (type-check / parse / file selection): $out"
  fi
}

while IFS=$'\t' read -r id go_dir expected_substring features extra || [[ -n "${id:-}" ]]; do
  if [[ -z "${id:-}" || "$id" == \#* ]]; then
    continue
  fi
  case_count=$((case_count + 1))

  if [[ -n "${extra:-}" ]]; then
    report_negative_fail "$id" "${features:-unknown}" "manifest" "too many tab-separated fields"
    continue
  fi
  if [[ -z "${go_dir:-}" || -z "${expected_substring:-}" || -z "${features:-}" ]]; then
    report_negative_fail "$id" "${features:-unknown}" "manifest" "expected 4 tab-separated fields"
    continue
  fi
  if [[ ! -f "$go_dir/main.go" ]]; then
    report_negative_fail "$id" "$features" "go-source" "missing $go_dir/main.go"
    continue
  fi

  binary="$BUILD_OUT/${id//\//__}"
  if output="$(run_with_timeout "$GO_TIMEOUT_SECONDS" env GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" ${oracle_toolchain_env[@]+"${oracle_toolchain_env[@]}"} go build -o "$binary" "./$go_dir" 2>&1)"; then
    report_negative_fail "$id" "$features" "go-compile" "program unexpectedly compiled"
    continue
  fi

  if [[ "$output" != *"$expected_substring"* ]]; then
    report_negative_fail "$id" "$features" "go-compile" "expected substring '$expected_substring' in '$output'"
    continue
  fi
  frontend_leg "$go_dir"
  if [[ -n "$fe_stage" ]]; then
    report_negative_fail "$id" "$features" "$fe_stage" "$fe_detail"
  else
    report_negative_pass "$id" "$features" "$fe_detail"
  fi
done < "$MANIFEST"

if [[ "$case_count" -eq 0 ]]; then
  # Infra refusal, nothing published (the tmp pair dies with the trap).
  echo "no negative coverage cases found in $MANIFEST (nothing published)" >&2
  exit 2
fi

publish_results

echo
echo "negative coverage summary: cases=$case_count pass=$pass_count fail=$fail_count"
echo "results: $RESULTS_TSV"
echo "meta: $META_TSV"

if [[ "$fail_count" -ne 0 ]]; then
  exit 1
fi
