#!/usr/bin/env bash
# The kernel replay gate (lane gate/kernel-replay-1013, 2026-10-13; the
# zero-context review docs/2026-10-13_codex-zero-context-pass.md F4;
# release-readiness row 40, [USER] Mike 2026-10-13, relayed: the user ruled
# item 4 a critical finding and a core trust gap, to be fixed).
#
# The toolchain's `leanchecker` (src/lean/LeanChecker.lean, `replayFromImports`)
# re-reads every built olean whose module name starts with `GoLean`, imports
# the module's own imports, and replays the module's declarations into that
# environment THROUGH THE KERNEL. That catches environment tampering by
# metaprograms — `debug.skipKernelTC`, `addDeclWithoutChecking`, a constant
# added behind the elaborator's back — which neither the build (the tamperer
# ran inside it), the escape-hatch text scan, nor the post-import axiom audit
# (it reads the tampered environment as given) can see. It is the same kernel,
# not an independent verifier. Since the 4.35 pin (lane toolchain/lean-4.35-1020,
# 2026-10-21) the toolchain's `lake check` is the stronger form — export, kernel
# replay of the export, non-standard axioms refused, `--paranoid` external
# kernels — and since the library-only default targets ([USER] 2026-10-21,
# release-readiness row 42) it runs on this project: the `--diff` tier's
# report-only speedbump (scripts/check-lake-check, about four minutes) and the
# owner's gate outside the sandbox at claim points. BOTH stay, one reason each:
# this script replays the ON-DISK olean set and checks it equal to the module
# set (an unbuilt or stale olean is named; `lake check` exports only what the
# default targets import), needs no bwrap, and costs 9.1 s at 4 threads (6.8 s at 8) in the fast tier;
# `lake check` covers the default test libraries' modules (the pins in
# Tests/GoCoreContract.lean, the audit harness, the admission facts), which
# this `GoLean`-prefix replay does not, and adds the export path and, under
# `--paranoid`, the external kernels.
#
# Fail closed, four ways, and never a skip:
#   * BEFORE the replay, the set of GoLean oleans on disk must EQUAL the set of
#     GoLean modules on disk (GoLean.lean + GoLean/**/*.lean): Lake never deletes
#     the olean of a removed module, and the checker replays whatever it finds,
#     so a stale olean of a deleted module would otherwise surface as a kernel
#     rejection of its first importer («unknown constant …», the 2026-10-21
#     retirement rebase) instead of being named with its remedy; an unbuilt
#     module would be skipped in silence.
#   * ANY nonzero exit of the checker fails — a kernel rejection («leanchecker
#     found a problem in <module>»), a missing build tree, a cgroup kill: the
#     checker's exit 137 reaches this script (GNU time says «Command terminated
#     by signal 9»), and this script's own FAIL line is the signal — it exits 1,
#     so the box tool's KILLED banner does not print on this path (fix round F4a).
#     A killed replay has checked nothing.
#   * AFTER the replay, the set of modules replayed (the checker's `--verbose`
#     lines) must EQUAL the same on-disk module set: what the checker chose to
#     replay is checked, not only what was on disk. An empty source set is a
#     refusal too.
#   * A PASS line is printed only after both checks, and names the count.
#
# Cost (docs/operational-lessons.md, «The kernel replay gate»): the checker
# replays every module as a task on Lean's thread pool, so peak RSS is the SUM
# of the concurrent modules' import closures. Measured 2026-10-13 on the 68
# modules: at the toolchain default (32 workers on this box) 27 s wall and
# 31.2 GB peak — 2 GiB under the 32 G box cap; at LEAN_NUM_THREADS=4 18 s and
# 6.7 GB; at 8, 14 s and 11.2 GB. scripts/ci exports LEAN_NUM_THREADS scaled
# to the cap (cap/8G, so 4 under 32 G); run by hand with it unset, this script
# sets 4 ([AGENT] 2026-10-13: both faster and five times lighter than the
# default) and always prints the value it ran with. A caller's value is honoured.
set -uo pipefail
# One collation and byte-wise character classes for every comparison, sort and pattern here
# (deep-clean review DC19, 2026-10-26): the gate's verdict must not depend on the caller's locale.
export LC_ALL=C
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$ROOT/scripts/cap.sh"
cd "$ROOT" || { echo "check-kernel-replay: cannot cd to $ROOT" >&2; exit 1; }
[[ $# = 0 ]] || { echo 'check-kernel-replay: expected no arguments' >&2; exit 2; }

# Scratch under this checkout's own .tmp (the sibling gate scripts' convention,
# scripts/typed-gate-scratch.sh): a failed run's log stays where it ran.
export TMPDIR="$ROOT/.tmp"
mkdir -p "$TMPDIR"
scratch="$(mktemp -d "$TMPDIR/kernel-replay.XXXXXX")"
log="$scratch/leanchecker.log"
refuse() { # <message>: fail by name, keep the log, exit 1
  echo "check-kernel-replay: FAIL — $*" >&2
  echo "check-kernel-replay: the checker's log is kept at $log" >&2
  exit 1
}

# The on-disk module set (the same enumeration the escape-hatch scan and the
# core totality audit walk). Fail if it is empty: the gate would be vacuous.
want="$scratch/modules.want"
{ find GoLean -name '*.lean' -not -path '*/.lake/*' | sed 's|\.lean$||; s|/|.|g'
  [ -f GoLean.lean ] && echo GoLean; } | LC_ALL=C sort -u > "$want"
n_want="$(wc -l < "$want" | tr -d ' ')"
[ "$n_want" -gt 0 ] || refuse "no GoLean module found on disk (GoLean.lean / GoLean/**/*.lean) — nothing to replay"

# name_differences <diff file>: each line of a `diff -u want got` names its olean
# and the remedy (fix round F3, 2026-10-13): a `+` module was found but has no
# source (stale), a `-` module is on disk but was not found or replayed.
name_differences() {
  while IFS= read -r line; do
    m="${line:1}"; p=".lake/build/lib/lean/$(printf '%s' "$m" | tr . /).olean"
    case "$line" in
      +*) echo "  STALE olean $p — module $m has no source: remove it (with its .ilean/.hash/.trace siblings), or restore the source" >&2 ;;
      -*) echo "  MISSING olean $p — module $m is on disk but has no olean / was not replayed: the build produced no olean for it (a module not imported from GoLean.lean is not built; a symlinked olean is invisible to the checker)" >&2 ;;
    esac
  done < <(grep -E '^[-+][^-+]' "$1")
}

# The oleans on disk, compared with the module set BEFORE the replay: a stale
# olean of a deleted module is named here with its remedy, not as the kernel's
# rejection of the first module that imported it.
have="$scratch/modules.have"
{ [ -d .lake/build/lib/lean/GoLean ] && find .lake/build/lib/lean/GoLean -name '*.olean' | sed 's|^\.lake/build/lib/lean/||; s|\.olean$||; s|/|.|g'
  [ -f .lake/build/lib/lean/GoLean.olean ] && echo GoLean; } | LC_ALL=C sort -u > "$have"
n_have="$(wc -l < "$have" | tr -d ' ')"
if ! diff -u "$want" "$have" > "$scratch/modules.pre.diff"; then
  name_differences "$scratch/modules.pre.diff"
  refuse "the GoLean oleans on disk ($n_have) are not the on-disk GoLean module set ($n_want) — checked before the replay; each difference and its remedy is named above"
fi

if [ -n "${LEAN_NUM_THREADS:-}" ]; then thr_note="LEAN_NUM_THREADS=$LEAN_NUM_THREADS (caller's)"
else export LEAN_NUM_THREADS=4; thr_note="LEAN_NUM_THREADS=4 (this script's default; the toolchain default peaks at 31 GB)"; fi

# Peak RSS from the kernel's rusage of the checker process (`/usr/bin/time`
# wraps leanchecker directly, under `lake env` for the search path). Where GNU
# time is absent the replay still runs and is judged; the line says so.
timer=()
if [ -x /usr/bin/time ]; then timer=(/usr/bin/time -f 'leanchecker-rusage wall=%e s maxrss=%M KB'); fi

started=$SECONDS
cap lake env "${timer[@]+"${timer[@]}"}" leanchecker --verbose GoLean > "$log" 2>&1; rc=$?
wall=$((SECONDS - started))
rusage="$(grep -m1 '^leanchecker-rusage ' "$log" || true)"
if [ -n "$rusage" ]; then
  kb="$(printf '%s\n' "$rusage" | sed -n 's/.*maxrss=\([0-9][0-9]*\) KB.*/\1/p')"
  cost="wall $(printf '%s\n' "$rusage" | sed -n 's/.*wall=\([0-9.]*\) s.*/\1/p') s; peak RSS $((kb / 1024)) MB"
else
  cost="wall ${wall} s; peak RSS unmeasured (/usr/bin/time absent)"
fi
echo "kernel replay: lake env leanchecker --verbose GoLean; $thr_note; exit $rc; $cost"

if [ "$rc" -ne 0 ]; then
  grep -v '^replaying ' "$log" | tail -15 | sed 's/^/  /' >&2
  case "$rc" in
    137|143) refuse "the checker was KILLED (exit $rc — the cgroup cap or a signal); a killed replay has checked nothing" ;;
    *)       refuse "leanchecker exited $rc (a kernel rejection names its module above; a missing olean or build tree is also a refusal)" ;;
  esac
fi

got="$scratch/modules.got"
grep '^replaying ' "$log" | sed 's/^replaying //' | LC_ALL=C sort -u > "$got"
n_got="$(wc -l < "$got" | tr -d ' ')"
if ! diff -u "$want" "$got" > "$scratch/modules.diff"; then
  name_differences "$scratch/modules.diff"
  refuse "the replayed set ($n_got modules) is not the on-disk GoLean module set ($n_want); each difference and its remedy is named above"
fi

rm -rf "$scratch"
printf 'Kernel replay gate: PASS — %s GoLean modules replayed through the kernel into a fresh environment of their imports by leanchecker (= the %s modules on disk, = the %s oleans on disk)\n' "$n_got" "$n_want" "$n_have"
