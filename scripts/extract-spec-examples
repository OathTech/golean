#!/usr/bin/env bash
# extract-spec-examples — inventory every <pre> block of the PINNED Go
# spec with its enclosing anchor and an AUTO classification (spec-truth
# campaign P3, mechanism 4.2; SpecTec applicability-accounting pattern:
# every block classified, excluded classes listed with reasons, nothing
# silently dropped).
#
# Output (tracked, regenerable): docs/spec-archaeology/spec-examples-inventory.tsv
#   block_id  anchor  class  lines  curated  note
# block_id = <anchor>-<ordinal>-<8-hex content hash> — content-keyed,
# so a re-pin that edits a block visibly retires its id (covmap-adjacent
# identity, same philosophy as segment hashes).
#
# Classes (AUTO heuristics — curation upgrades happen in the corpus
# cases.tsv rows, never by editing this generated file):
#   ebnf, grammar       formal-grammar blocks: classify, never run
#   program             contains `package main` — runnable as-is
#   decl-fragment       declaration-led (func/type/var/const/import)
#   token-examples      lexical example lists (identifiers, literals)
#   contains-illegal    mixes legal and `// illegal`-marked lines —
#                       negative-case material (must-not-compile)
#   stmt-expr-fragment  statement/expression material needing a wrapper
#   non-code            prose/output/layout exhibits
# The `curated` column is emitted as '-' here; the corpus join marks
# blocks that have landed as cases (scripts/ci's coverage machinery is
# the authority on case status — this inventory is the DENOMINATOR).
#
# Fail closed: deps/go must be present at the recorded pin.
set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

pin="$(sed -n '/^PINS=/,/^TABLE$/p' scripts/setup-deps | awk '$1 == "go" { print $2 }')"
have="$(git -C deps/go rev-parse HEAD 2>/dev/null || true)"
if [[ -z "$pin" || -z "$have" || "$have" != "$pin"* ]]; then
  echo "extract-spec-examples: FAIL — deps/go missing/off-pin or pin row unreadable (have ${have:0:9}, pin ${pin:0:9}); scripts/setup-deps --only go" >&2
  exit 1
fi

mkdir -p docs/spec-archaeology
exec python3 - "$pin" <<'PYEOF'
import re, sys, html, hashlib, collections

PIN = sys.argv[1]
src = open('deps/go/doc/go_spec.html').read()

# Anchors with their positions, for enclosing-section lookup.
anchors = [(m.start(), m.group(1))
           for m in re.finditer(r'<h[234][^>]*id="([^"]+)"', src)]
def enclosing(pos):
    name = '(preamble)'
    for p, n in anchors:
        if p <= pos: name = n
        else: break
    return name

def unhtml(b):
    return html.unescape(re.sub(r'<[^>]+>', '', b))

def classify(cls, text):
    if cls in ('ebnf', 'grammar'):
        return cls
    t = text.strip()
    if 'package main' in t:
        return 'program'
    if re.search(r'//\s*(illegal|invalid|ERROR)', t):
        return 'contains-illegal'
    if re.search(r'^\s*(func|type|var|const|import|package)\b', t, re.M):
        return 'decl-fragment'
    # Token-example lists: short lines, no statement punctuation beyond
    # comments — identifiers/literals shown one per line.
    lines = [l for l in t.split('\n') if l.strip()]
    if lines and all(len(l) < 90 and not re.search(r'[;{}=]|:=', re.sub(r'//.*', '', l))
                     for l in lines):
        # Distinguish code-token lists from prose/layout exhibits:
        # token lines have no spaces outside comments (mostly).
        toks = [re.sub(r'//.*', '', l).strip() for l in lines]
        if all(len(x.split()) <= 2 for x in toks):
            return 'token-examples'
        return 'non-code'
    if re.search(r':=|;|\breturn\b|\bfor\b|\bif\b|\bgo\b|\bselect\b|<-', t):
        return 'stmt-expr-fragment'
    return 'non-code'

rows = []
ordinals = collections.Counter()
for m in re.finditer(r'<pre(?:\s+class="([^"]*)")?\s*>(.*?)</pre>', src, re.S):
    cls, body = m.group(1), m.group(2)
    text = unhtml(body)
    anchor = enclosing(m.start())
    ordinals[anchor] += 1
    h = hashlib.sha256(text.encode()).hexdigest()[:8]
    kind = classify(cls or '', text)
    nlines = len([l for l in text.split('\n') if l.strip()])
    rows.append((f"{anchor}-{ordinals[anchor]}-{h}", anchor, kind, nlines))

counts = collections.Counter(r[2] for r in rows)
with open('docs/spec-archaeology/spec-examples-inventory.tsv', 'w') as f:
    f.write(f"# spec <pre>-block inventory — the P3 denominator (campaign 4.2)\n"
            f"# regenerated by scripts/extract-spec-examples from deps/go @ {PIN[:12]}\n"
            f"# blocks: {len(rows)} total; by AUTO class: "
            f"{', '.join(f'{k}={v}' for k, v in sorted(counts.items()))}\n"
            f"# classes ebnf/grammar/non-code are excluded from the runnable\n"
            f"# denominator BY CLASS with the reason in the script header —\n"
            f"# never silently (SpecTec pass=0,0 pattern). CURATION STATUS\n"
            f"# lives in docs/spec-archaeology/spec-examples-dispositions.tsv\n"
            f"# (SKIPs and handovers exist ONLY there) plus the corpus itself,\n"
            f"# keyed by block_id. KNOWN AUTO-CLASS MISFILES (P3 audit F5),\n"
            f"# corrected in the dispositions, not here (this file is\n"
            f"# regenerated): Goto_statements-3/-4 are negative material\n"
            f"# classed stmt-expr-fragment; Selectors-4 is negative material\n"
            f"# classed token-examples; For_clause-5 is an output exhibit\n"
            f"# classed token-examples.\n"
            f"block_id\tanchor\tclass\tlines\tcurated\tnote\n")
    for bid, anchor, kind, nlines in rows:
        f.write(f"{bid}\t{anchor}\t{kind}\t{nlines}\t-\t-\n")
print(f"blocks: {len(rows)}  " + '  '.join(f"{k}={v}" for k, v in sorted(counts.items())))
PYEOF
