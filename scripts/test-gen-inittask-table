#!/usr/bin/env bash
# Self-test for scripts/gen-inittask-table's FAIL-CLOSED paths (FR-37 lane
# audit, 2026-10-07: a failing `go tool nm` and any `go list` package error
# used to become a silent `?` row). The generator is run against a FAKE `go`
# on PATH (scratch under the checkout's .tmp/, never /tmp) that serves canned
# `go list -json` listings and canned `go tool nm` output, so no toolchain or
# build cache is touched. Every case asserts the exit code AND that the verdict
# names its cause; the positive controls assert the rows. The scratch dir is
# left in place for inspection (no rm).
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
GEN="$ROOT/scripts/gen-inittask-table"
mkdir -p "$ROOT/.tmp"
SCRATCH="$(mktemp -d "$ROOT/.tmp/gen-inittask-test.XXXXXX")" || { echo "self-test: cannot create scratch dir under $ROOT/.tmp" >&2; exit 2; }
mkdir -p "$SCRATCH/bin" "$SCRATCH/gocache" || exit 2
cat > "$SCRATCH/bin/go" <<'FAKE'
#!/usr/bin/env bash
# fake go: $FAKE_LISTING is the canned `go list` stdout; $FAKE_NM selects nm.
case "$1" in
  version) echo "go version go0.0-fake linux/amd64" ;;
  list)
    if [[ "${FAKE_LIST_FAIL:-}" = 1 ]]; then echo "go: fake list failure" >&2; exit 1; fi
    cat "$FAKE_LISTING" ;;
  tool)
    [[ "$2" = nm ]] || { echo "fake go: unexpected tool $2" >&2; exit 3; }
    if [[ "${FAKE_NM:-ok}" = fail ]]; then echo "nm: fake corrupt archive $3" >&2; exit 2; fi
    case "$3" in
      /fake/a.a) printf '  1000 D a..inittask\n  1008 T a.f\n' ;;
      *) echo "fake go: unknown archive $3" >&2; exit 3 ;;
    esac ;;
  *) echo "fake go: unexpected command $*" >&2; exit 3 ;;
esac
FAKE
chmod +x "$SCRATCH/bin/go" || exit 2

listing() { # listing <name> <json-lines...>
  local f="$SCRATCH/$1.json"; shift; printf '%s\n' "$@" > "$f"; echo "$f"
}
A_OK='{"ImportPath":"a","Export":"/fake/a.a","GoFiles":["a.go"]}'
TESTONLY='{"ImportPath":"testonly"}'
UNSAFE='{"ImportPath":"unsafe","GoFiles":["unsafe.go"]}'

pass=0; fail=0
# expect <exit> <label> <must-contain|-> <listing> [ENV=VAL...]
expect() {
  local want="$1" label="$2" must="$3" lst="$4"; shift 4
  local out="$SCRATCH/$label.tsv" log rc=0
  log="$(env PATH="$SCRATCH/bin:$PATH" GOCACHE="$SCRATCH/gocache" FAKE_LISTING="$lst" "$@" \
    "$GEN" -o "$out" 2>&1)" || rc=$?
  if [[ "$rc" != "$want" ]]; then
    echo "FAIL $label: exit $rc, want $want"; printf '%s\n' "$log" | sed 's/^/    /'; fail=$((fail+1)); return 1
  fi
  if [[ "$must" != "-" ]] && ! grep -qF -- "$must" <<<"$log"; then
    echo "FAIL $label: output lacks '$must'"; printf '%s\n' "$log" | sed 's/^/    /'; fail=$((fail+1)); return 1
  fi
  pass=$((pass+1))
}
rows_are() { # rows_are <label> <expected rows, one per line>
  local got; got="$(grep -v '^#' "$SCRATCH/$1.tsv")"
  if [[ "$got" != "$2" ]]; then
    echo "FAIL $1: rows"; diff <(printf '%s\n' "$2") <(printf '%s\n' "$got") | sed 's/^/    /'
    fail=$((fail+1)); pass=$((pass-1))
  fi
}
WANT_ROWS="$(printf 'a\t1\t\t\ntestonly\t?\t\t\nunsafe\t0\t\t')"

# 1. positive control: a node, a test-only directory (no error) => ?, unsafe => 0
expect 0 ok "3 rows, 1 nodes, 1 unknown" "$(listing ok "$A_OK" "$TESTONLY" "$UNSAFE")" &&
  rows_are ok "$WANT_ROWS"
# 2. positive control: the NoGoError class on a source-less directory is still ?
expect 0 nogo-error "1 unknown" "$(listing nogo "$A_OK" \
  '{"ImportPath":"testonly","Error":{"Err":"no non-test Go files in /fake/testonly"}}' "$UNSAFE")" &&
  rows_are nogo-error "$WANT_ROWS"
# 3. a failing `go tool nm` dies naming the package and nm's stderr
expect 1 nm-fail "go tool nm failed (exit 2) for a" "$(listing nmfail "$A_OK" "$UNSAFE")" FAKE_NM=fail
expect 1 nm-fail-stderr "fake corrupt archive" "$(listing nmfail2 "$A_OK" "$UNSAFE")" FAKE_NM=fail
# 4. any other package error dies naming the package and the error
expect 1 list-error "go list reports an error for a: a.go:1:1: expected 'package'" "$(listing listerr \
  '{"ImportPath":"a","GoFiles":["a.go"],"Error":{"Err":"a.go:1:1: expected '"'"'package'"'"'"}}' "$UNSAFE")"
# 5. the NoGoError text on a package WITH Go files is not the benign class
expect 1 nogo-but-buildable "go list reports an error for a" "$(listing nogobuild \
  '{"ImportPath":"a","GoFiles":["a.go"],"Error":{"Err":"build constraints exclude all Go files in /fake/a"}}')"
# 6. dependency errors die
expect 1 deps-error "go list reports dependency errors for a: cannot find package" "$(listing depserr \
  '{"ImportPath":"a","Export":"/fake/a.a","GoFiles":["a.go"],"DepsErrors":[{"Err":"cannot find package"}]}')"
# 7. buildable Go files but no archive and no error is unexplained: die
expect 1 no-export "a has buildable Go files but no export archive" "$(listing noexport \
  '{"ImportPath":"a","GoFiles":["a.go"]}' "$UNSAFE")"
# 8. `go list` itself failing dies
expect 1 list-fail "go list std failed" "$(listing listfail "$A_OK")" FAKE_LIST_FAIL=1
# 9. malformed listing dies
expect 1 bad-json "cannot parse go list output" "$(listing badjson '{"ImportPath":')"

echo "test-gen-inittask-table: $pass passed, $fail failed (scratch: ${SCRATCH#"$ROOT"/})"
[[ "$fail" = 0 ]]
