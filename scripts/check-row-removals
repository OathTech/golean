#!/usr/bin/env bash
# Row REMOVALS across a baseline re-pin (refusal-cause lane, confirmation
# pass LOW, 2026-10-12). scripts/ci's re-pin guard caught a vanished PASS id
# (as a flip) and a dropped alternation, but a FAIL row deleted together with
# its fixture went unnoticed (probed: BUG-125's row dropped — silent). Rule:
# every id with a data row in OLD must have one in NEW, unless a header line
# of NEW names its removal: `# removed: <id> — <why>` (the
# `# alternation removed:` convention of scripts/check-alternation-survival).
# PASS and FAIL alike; a vanished PASS row ALSO still needs its BUGS.md Cases
# line (the guard's flip rule, unchanged).
#
# Usage: scripts/check-row-removals <old> <new>
#   <old>/<new> are a file path or `git:<rev>:<path>`.
# Exit 0 = none removed silently (each named removal printed as a note);
#   1 = at least one removed silently (ids printed); 2 = unreadable input.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
[ $# -eq 2 ] || { echo "usage: $0 <old> <new>   (file path or git:<rev>:<path>)" >&2; exit 2; }

slurp() {
  case "$1" in
    git:*) git show "${1#git:}" 2>/dev/null || { echo "check-row-removals: cannot read $1" >&2; exit 2; } ;;
    *)     [ -f "$1" ] || { echo "check-row-removals: no file $1" >&2; exit 2; }; cat "$1" ;;
  esac
}
old="$(slurp "$1")"; new="$(slurp "$2")"

rc=0
out="$(printf '===OLD===\n%s\n===NEW===\n%s\n' "$old" "$new" | awk -F'\t' '
  /^===OLD===$/ { sec = 1; next }
  /^===NEW===$/ { sec = 2; next }
  sec == 2 && /^# removed: / { id = substr($0, 12); sub(/[ \t].*$/, "", id); if (id != "") named[id] = $0; next }
  /^#/ || $1 == "result" || NF < 2 { next }
  sec == 1 { oldrow[$2] = $1 "/" $3 }
  sec == 2 { newrow[$2] = 1 }
  END {
    for (id in oldrow) {
      if (id in newrow) continue
      if (id in named) { print "NOTE\t" id "\trow [" oldrow[id] "] removed, named by the header: " named[id]; continue }
      print "REMOVED\t" id "\trow [" oldrow[id] "] is absent from the new baseline and no `# removed: " id " — <why>` header line names it"
      bad = 1
    }
    if (bad) exit 1
  }')" || rc=$?
if [ "$rc" -ge 2 ]; then
  echo "check-row-removals: internal comparison error (awk rc=$rc) — refusing to certify" >&2
  { printf '%s\n' "$out" | grep . >&2; } || true
  exit 2
fi
{ printf '%s\n' "$out" | grep . | LC_ALL=C sort; } || true
if [ "$rc" -eq 1 ]; then
  echo "check-row-removals: FAIL — baseline row(s) removed without a \`# removed: <id> — <why>\` header line"
  exit 1
fi
exit 0
