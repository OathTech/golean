#!/usr/bin/env bash
# proof-lint — the STORM LINT: a syntax-level speedbump for the proof-cost
# shapes this project has already PAID for.
#
#   scripts/proof-lint             list every note, then the summary
#   scripts/proof-lint --summary   the one-line summary only (what ci prints)
#   scripts/proof-lint --rule L5   restrict to one rule
#
# DO NOT HARDEN THIS INTO A GATE. It reports; it never blocks, never fails a
# build, and its absence is never an error. Exit is 0 except on an argument
# typo. Same standing policy as scripts/proof-costs: gates are speedbumps —
# a legitimate violation (a shape that is genuinely right here) must not have
# to argue with a gate, and every rule below is a HEURISTIC over syntax, so a
# blocking version would be wrong before it was useful. The repo's gates are
# for claims that must be true; this one makes a known cost shape VISIBLE at
# the moment someone writes it.
#
# THE RULES — each one is a MEASURED pathology, not a style opinion:
#
#   L1  unqualified `.base ⟨…⟩` inside a theorem STATEMENT
#       StepKit rule 5. Measured: 502k `BEq.beq` unfoldings, a 50-minute
#       storm → 12 s after writing `Loc.base` (WordFreq route finding 2).
#   L2  full-heap `Heap.lookup (front ++ D) …` hypothesis in a signature
#       StepKit rule 4. Measured: every instantiation re-traverses the
#       concrete front; cost the WordFreq route two honest parks.
#   L3  `have h := <step-lemma application>` with NO type ascription
#       StepKit rule 3 (the E-form). Measured: ~2^N in the front length,
#       52 GB at N = 16, vs instant with the full result type pinned.
#   L4  a long `stepFnIter` window over a PROGRAM-EMBEDDING state
#       StepKit §"Long CONCRETE runs". Measured: `wc_empty_run` 82 s /
#       50.8 GiB, superlinear in the pinned program → ~86 s / 1.9 GiB and
#       program-size-independent when restated over an abstract `σ`.
#   L5  a long concrete `with_unfolding_all rfl` window in a file that
#       carries NEITHER `set_option smartUnfolding false` NOR an evaluator
#       transport (WP arc slice 5, 2026-08-18 — the newest rule).
#       Measured on the reconstructed S4.3(b) accumulation window (752
#       steps): DID NOT COMPLETE in 620 s under default elaboration;
#       0.94 s (575 ms tactic + 362 ms kernel) under
#       `set_option smartUnfolding false`. The cost class the arc chased is
#       an elaborator-side smart-unfolding pathology; the kernel re-checks
#       these proofs in milliseconds either way.
#
#       THE COUNTER-NOTE, measured the same day and printed with the rule:
#       the option is NOT globally free. On the same fixture it inverted the
#       EVALUATOR-TRANSPORT landing (`with_unfolding_all exact` through
#       `symEvalWindow_refines'`): 64 ms → 13.7 s at a 32-step window, and
#       > 320 s (no completion) at 752 steps, while the landed
#       `Examples/MatMul.lean` trio is unaffected (5.56 s vs 6.29 s for the
#       same file prefix). So L5 says "carry the option OR transport" — it
#       never says "put the option on every file", and a file that adopts it
#       beside transported windows must re-measure. Full record:
#       docs/wp-arc-log/s4.md §S4.12, docs/wp-arc-log/s5.md.
#
# HONEST LIMITS (read before believing a count): every rule is a regex over
# source text with a crude statement/proof split (a statement runs from
# `theorem`/`lemma` to the first top-level `:= by`). It cannot see
# elaboration, so L1/L3 in particular have a real false-positive class
# (a small state, a `have` whose expected type is already pinned by the
# surrounding `refine`). L4 reads STATEMENTS, so the known-good exemplar of
# its own fix — `Examples/WordCount/EmptyRun.lean`, whose statement stays
# byte-identical to the monolithic form while the PROOF is program-generic —
# is flagged and is not a defect. Counts are a trend line to look at, never a
# verdict — investigate a note, do not obey it.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

MODE=list
RULE=all
while [ $# -gt 0 ]; do
  case "$1" in
    --summary) MODE=summary ;;
    --rule) shift; RULE="${1:-}" ;;
    *) echo "scripts/proof-lint: unknown argument '$1' (expected --summary or --rule Lx)" >&2; exit 2 ;;
  esac
  shift
done

python3 - "$MODE" "$RULE" <<'PY'
import os, re, sys

mode, rule = sys.argv[1], sys.argv[2]

# Window length above which a raw rfl / stepFnIter window counts as "long".
# 40 steps: the S4.3 crossover measurement puts the evaluator/raw crossover at
# "a few dozen steps", and every measured storm in the ledger is far above it.
LONG = 40

ROOTS = ["proofs/GoLeanProofs", "proofs/Audit", "proofs/Audit.lean",
         "proofs/GoLeanProofs.lean", "proofs/Challenge.lean",
         "proofs/SliceSpike.lean"]

files = []
for r in ROOTS:
    if os.path.isfile(r):
        files.append(r)
    for dirpath, _, names in os.walk(r):
        for n in sorted(names):
            if n.endswith(".lean"):
                files.append(os.path.join(dirpath, n))
files = sorted(set(files))

DECL = re.compile(r'^\s*(?:@\[[^\]]*\]\s*)?(?:private\s+|protected\s+|nonrec\s+)*(theorem|lemma|example)\b')
ITER = re.compile(r'stepFnIter\s+(\d+)')
BASE_UNQUAL = re.compile(r'(?<![A-Za-z0-9_.])\.base\s+[⟨(]')
LOOKUP_APPEND = re.compile(r'Heap\.lookup\s+\([^)]*\+\+')
HAVE_UNASCRIBED = re.compile(r'^\s*have\s+[A-Za-z_][A-Za-z0-9_\'!?]*\s*:=')
STEP_LEMMA = re.compile(r'\b(stepFn_[A-Za-z0-9_]+|stepFnIter_[A-Za-z0-9_]+|applyStrictOp[A-Za-z0-9_]*|storeTarget[A-Za-z0-9_]*|Heap\.lookup)\b')
PROGRAMISH = re.compile(r'\b[A-Za-z][A-Za-z0-9_]*(Prog|Lowered)\b')
# A "big concrete state" at an application site: a heap-front constant, an
# explicit `{ σ with heap := … }`, or a front `++` tail split.
BIG_STATE = re.compile(r'(heap\s*:=|[A-Za-z0-9_]*Heap[A-Za-z0-9_]*\s|\+\+)')

notes = []
counts = {k: 0 for k in ("L1", "L2", "L3", "L4", "L5")}

def add(rid, path, lineno, msg):
    counts[rid] += 1
    notes.append("  note %s %s:%d %s" % (rid, path, lineno, msg))

for path in files:
    try:
        src = open(path, encoding="utf-8").read()
    except OSError:
        continue
    lines = src.split("\n")
    file_has_option = any(l.strip() == "set_option smartUnfolding false" for l in lines)
    file_has_transport = "symEvalWindow_refines" in src

    # Split the file into declarations; for each, the STATEMENT is everything
    # up to the first `:= by` / `:=` at the end of a line, and the PROOF is the
    # rest (crude, documented in the header).
    decl_starts = [i for i, l in enumerate(lines) if DECL.match(l)]
    decl_starts.append(len(lines))
    for k in range(len(decl_starts) - 1):
        s, e = decl_starts[k], decl_starts[k + 1]
        body = lines[s:e]
        split = len(body)
        for i, l in enumerate(body):
            if re.search(r':=\s*(by)?\s*$', l) or ' := by ' in l:
                split = i + 1
                break
        stmt, proof = body[:split], body[split:]
        stmt_txt = "\n".join(stmt)

        # L1 — unqualified `.base` inside a BIG positional argument. The rule
        # is about big arguments, so the trigger is ≥3 on one line (a heap
        # front / environment literal written positionally), not any `.base`:
        # the tree has ~9,000 lines with one, and one is not the shape that
        # storms.
        for i, l in enumerate(stmt):
            if "--" in l:
                l = l.split("--")[0]
            if len(BASE_UNQUAL.findall(l)) >= 3:
                add("L1", path, s + i + 1,
                    "unqualified `.base` ×%d in one statement argument — write `Loc.base ⟨…⟩` (StepKit rule 5)"
                    % len(BASE_UNQUAL.findall(l)))
                break

        # L2 — full-heap lookup hypothesis in a signature.
        for i, l in enumerate(stmt):
            if LOOKUP_APPEND.search(l):
                add("L2", path, s + i + 1,
                    "full-heap `Heap.lookup (… ++ …)` in a signature — D-relative instead (StepKit rule 4)")
                break

        # L3 — unascribed `have` applying a step lemma AT A SITE THAT MENTIONS
        # A BIG CONCRETE STATE (the E-form's own scope: "at every application
        # site that mentions a big concrete state"). The application's
        # continuation lines are scanned for a state/heap term; a `have :=`
        # over abstract arguments is exactly the safe case and is not flagged.
        for i, l in enumerate(proof):
            if HAVE_UNASCRIBED.match(l) and STEP_LEMMA.search(l):
                app = "\n".join(proof[i:i + 6])
                if BIG_STATE.search(app):
                    add("L3", path, s + split + i + 1,
                        "unascribed `have :=` applying a step lemma at a concrete-state site — pin the full result type (StepKit rule 3, E-form)")

        # L4 / L5 — long windows.
        m = ITER.search(stmt_txt)
        if m and int(m.group(1)) >= LONG:
            n = int(m.group(1))
            if PROGRAMISH.search(stmt_txt):
                add("L4", path, s + 1,
                    "%d-step window whose STATEMENT embeds the pinned program — check the proof is program-generic (conditioned `enterFrame`), not just that it elaborates (StepKit §Long CONCRETE runs)" % n)
            proof_txt = "\n".join(proof)
            if "with_unfolding_all rfl" in proof_txt and not file_has_option and not file_has_transport:
                add("L5", path, s + 1,
                    "%d-step raw `with_unfolding_all rfl` window in a file with neither `set_option smartUnfolding false` nor an evaluator transport" % n)

# L3 is a CENSUS, not a note stream — measured 2026-08-18: 552 hits on a tree
# whose every module elaborates within budget, because the shipped sites pin
# their arguments by name (`(σ := …)`) even where the `have` carries no result
# type. Keeping it in the headline count would drown the four rules that do
# discriminate. Its per-site list is one flag away (`--rule L3`).
ACTIONABLE = ("L1", "L2", "L4", "L5")
total = sum(counts[k] for k in ACTIONABLE)
if mode != "summary":
    for n in notes:
        if n.startswith("  note L3") and rule != "L3":
            continue
        if rule != "all" and not n.startswith("  note " + rule):
            continue
        print(n)
print("proof-lint: %d file(s), %d note(s) [%s] + L3 census %d (report-only, never blocks)"
      % (len(files), total, " ".join("%s=%d" % (k, counts[k]) for k in ACTIONABLE),
         counts["L3"]))
PY
exit 0
