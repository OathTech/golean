#!/usr/bin/env python3
"""Feature-coverage guard (S0/S1 omission resistance).

Cross-checks the canonical feature vocabulary (Corpus/coverage/tags.tsv) against
what the differential corpus actually *exercises*, using the recorded baseline
(baselines/native-full.tsv) for pass/fail. Complements the manifest's existing
"every used tag is canonical" validation with the reverse + a pass check:

  FAIL  a canonical tag exercised by NO case            (declared, never tested)
  WARN  a canonical tag with cases but ZERO passing     (feature claimed but
        nothing green exercises it — wholesale-broken, or legitimately
        unsupported; review / pin to a BUG)

So "green implies covered" gets closer to true: a feature can't sit in the
vocabulary with no living, passing witness without being surfaced.

Usage: scripts/check-coverage [--strict]
  --strict  treat the all-failing WARN category as a failure too.
Exit 0 = ok (dead tags outside the reserved allowlist are always fatal).
Exit 1 = a dead tag (or, under --strict, an all-failing tag).
"""
import subprocess, sys, os

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(ROOT)
strict = "--strict" in sys.argv[1:]

TAGS = "Corpus/coverage/tags.tsv"
BASE = "baselines/native-full.tsv"

# Canonical tags that legitimately have no default-lane case. Each needs a reason.
# (Empty since 2026-08-05: the membership lane made `nondet` a live tag —
# lane=membership rows carry it, run in the default manifest, and are
# oracled by set membership. Keep the set for future genuinely
# default-lane-untestable tags; each entry needs a reason.)
RESERVED = set()

# Canonical vocabulary.
with open(TAGS) as f:
    vocab = [l.strip() for l in f if l.strip() and not l.startswith("#")]

# Baseline: id -> result.
result = {}
with open(BASE) as f:
    for l in f:
        if l.startswith("#"):
            continue
        p = l.rstrip("\n").split("\t")
        if len(p) >= 2 and p[0] != "result":
            result[p[1]] = p[0]

# Manifest: id -> features (regenerated, ground truth).
man = subprocess.run(["./scripts/coverage-manifest"], capture_output=True, text=True)
if man.returncode != 0:
    sys.stderr.write("check-coverage: coverage-manifest failed:\n" + man.stderr)
    sys.exit(2)

cases = {t: 0 for t in vocab}    # EXEC-lane case count (has pass/fail)
passes = {t: 0 for t in vocab}   # EXEC-lane passing count
used = set()                     # exercised in EITHER lane
for l in man.stdout.splitlines():
    p = l.split("\t")
    if len(p) < 6:
        continue
    cid, feats = p[0], p[5]
    for t in feats.split(","):
        used.add(t)
        if t in cases:
            cases[t] += 1
            if result.get(cid) == "PASS":
                passes[t] += 1

# Negative-compile lane: case.tsv (singular), features in column 2. These cases
# are compile-rejection witnesses (no exec pass/fail), but they DO exercise tags.
import glob
for cf in glob.glob("Corpus/coverage/negative/**/case.tsv", recursive=True):
    with open(cf) as f:
        for l in f:
            if l.startswith("#"):
                continue
            cols = l.rstrip("\n").split("\t")
            if len(cols) >= 2:
                for t in cols[1].split(","):
                    used.add(t)

# DEAD = canonical tag exercised in NEITHER lane and not reserved. ALL-FAILING =
# used in the exec lane but with zero passing baseline cases.
# Husk case-directories (structure audit P1-2): a directory under the corpus
# roots with no metadata file anywhere beneath it is INVISIBLE to case
# discovery — silently skipped, contra fail-closed. Hard-fail on any
# (dot-directories excluded: tool droppings, not case dirs).
# EXEMPTION (multi-package cases, raft W1.1, identity note §7): a case
# directory's IMPORTED source-package subdirs carry .go files and no
# metadata BY DESIGN (import path = case-relative subdir path; import-
# driven discovery on both pipeline legs). A dir is exempt iff it lies
# on the path to a subdir that (a) holds non-test .go files and (b) is
# named verbatim as a quoted import path by a .go file in the case's
# package tree — mirroring the pipeline's own discovery rule, so a
# FORGOTTEN nested case (go files, no metadata, never imported) still
# husks loudly.
import re
def _go_files(d):
    try:
        return [os.path.join(d, f) for f in os.listdir(d)
                if f.endswith(".go") and not f.endswith("_test.go")
                and os.path.isfile(os.path.join(d, f))]
    except OSError:
        return []
def _imported_pkg_dirs(case_dir):
    """Transitively imported local package dirs of a case dir."""
    exempt, pending = set(), [case_dir]
    while pending:
        d = pending.pop()
        for gf in _go_files(d):
            try:
                with open(gf, encoding="utf-8", errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            for m in re.finditer(r'"([a-z0-9_\-/]+)"', text):
                p = os.path.normpath(os.path.join(case_dir, m.group(1)))
                if p.startswith(case_dir + os.sep) and os.path.isdir(p) \
                        and _go_files(p) and p not in exempt:
                    exempt.add(p)
                    pending.append(p)
    return exempt

case_dirs = set()
for root in ("Corpus/coverage/exec", "Corpus/coverage/negative"):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        if any(f in ("cases.tsv", "case.tsv") for f in filenames):
            case_dirs.add(dirpath)
pkg_exempt = set()
for cd in case_dirs:
    for p in _imported_pkg_dirs(cd):
        # The package dir and every intermediate dir down to it.
        while p != cd:
            pkg_exempt.add(p)
            p = os.path.dirname(p)

husks = []
for root in ("Corpus/coverage/exec", "Corpus/coverage/negative"):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        if dirpath in pkg_exempt:
            continue
        has_meta = any(
            f in ("cases.tsv", "case.tsv")
            for _, _, fs in os.walk(dirpath) for f in fs
        )
        if not has_meta:
            husks.append(dirpath)
if husks:
    print(f"FAIL: {len(husks)} husk case-director(ies) — no metadata file beneath, invisible to discovery:")
    for h in sorted(husks):
        print(f"  {h}")
    sys.exit(1)

dead = sorted(t for t in vocab if t not in used and t not in RESERVED)
reserved_unused = sorted(t for t in RESERVED if t not in used)
allfail = sorted(t for t in vocab if cases[t] > 0 and passes[t] == 0)

if dead:
    print(f"FAIL: {len(dead)} canonical tag(s) exercised by NO case (declared, never tested):")
    print("  " + ", ".join(dead))
    print("  → add a case exercising each, remove it from tags.tsv, or (if legitimately")
    print("    untestable in the default lane) add it to RESERVED in scripts/check-coverage.")
if allfail:
    print(f"WARN: {len(allfail)} canonical tag(s) with cases but ZERO passing "
          f"(unimplemented feature, or a wholesale-broken one — review / pin to a BUG):")
    print("  " + ", ".join(allfail))
if reserved_unused:
    print(f"note: {len(reserved_unused)} reserved tag(s) unused by design: {', '.join(reserved_unused)}")

bad = bool(dead) or (strict and bool(allfail))
if not dead:
    print(f"check-coverage: ok ({len(vocab)} canonical tags; no dead tags"
          + (f"; {len(allfail)} all-failing (warn)" if allfail else "") + ")")
sys.exit(1 if bad else 0)
