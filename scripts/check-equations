#!/usr/bin/env bash
# The semantic-EQUATION gate (window packet D, 2026-10-03; charter row 7's second and third
# checks beside BridgeSet's statements): (a) the equation file GoLean/GoCore/Equations.lean —
# one PROVED lemma per `stepFn` arm, the `stepFn_eqns` rewrite set — builds with the toy client
# library; (b) the client Tests/EquationClient.lean runs and reports PASS — its facts are proved
# by the equation set alone, and its in-file `#eval` checks EXHAUSTIVE enrollment (every theorem
# of namespace GoLean.GoCore.Equations has a `Pin.<name>` whose type IS the theorem's); (c) the
# NO-UNFOLD guard — a cheap regex PRE-FILTER (the client never spells `unfold stepFn`, `simp [... stepFn
# ...]`, `cbv` or `decide`); the LOAD-BEARING check is the client's own Lean-level proof-term check
# (packet D audit F2: no `stepFn.*` constant, no reflexivity on `stepFn`, the term re-type-checked with
# `stepFn` irreducible), whose failure is (b)'s failure; (d) the enrollment check's failure is (b)'s
# failure; (e) SELF-TESTS, fail closed: an `unfold stepFn` mutant trips the regex; a pin-deleted mutant
# fails (d) naming the equation; each of the audit's seven unfolding spellings at the anchored fact is
# REFUSED by name by the proof-term check, and so is an unfolding hidden in a private helper the fact
# `exact`s (the window review's F2: the check covers the proof-dependency closure up to the PUBLISHED API —
# the audit's R1: an imported rfl-theorem over stepFn and a foreign test-support module are both refused; the
# client's imports are whitelisted). Every step fails closed.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
[[ $# = 0 ]] || { echo 'check-equations: expected no arguments' >&2; exit 2; }
. "$ROOT/scripts/typed-gate-scratch.sh"

CLIENT=Tests/EquationClient.lean
GUARD='unfold stepFn|simp \[[^]]*stepFn|cbv|decide'

# (a) the equation file and the client library build
scripts/capped lake build GoLean EquationTests

# (b) + (d) the client runs — its `#eval` enrollment check elaborates first — and reports PASS
scripts/capped lake env lean --run "$CLIENT" | tee "$gate_scratch/client.log"
grep -q '^Equation client: PASS' "$gate_scratch/client.log"
grep -q 'enrollment complete' "$gate_scratch/client.log" || {
  echo "check-equations: FAIL — the client's enrollment check did not report completion" >&2; exit 1; }

# (c) the NO-UNFOLD guard over the tracked client
if git grep -n -E "$GUARD" -- "$CLIENT"; then
  echo "check-equations: FAIL — $CLIENT re-unfolds stepFn (or spells cbv/decide): see the lines above" >&2
  exit 1
fi
echo "ok [no-unfold] $CLIENT never unfolds stepFn"

# (c') the IMPORT WHITELIST pre-filter (audit re-verification R1): every `import` line of the client names a toolchain
# root or a published API module; the load-bearing check is the client's own (`checkEnrollment` reads the environment
# header), this is the cheap textual twin. Fail closed on any other import.
import_whitelist='Init Std Lean GoLean.GoCore.Equations GoLean.GoCore.EquationsAttr GoLean.GoCore.Prefix GoLean.GoCore.ExecutionStatement GoLean.GoCore.PoolProjection GoLean.GoCore.BridgeSet'
while IFS= read -r impline; do
  mod="${impline#import }"; mod="${mod%% *}"
  ok_import=0
  for w in $import_whitelist; do [[ "$mod" == "$w" ]] && ok_import=1; done
  [[ $ok_import -eq 1 ]] || { echo "check-equations: FAIL — $CLIENT imports '$mod', which is not a toolchain root or a published API module ($import_whitelist)" >&2; exit 1; }
done < <(grep -E '^import ' "$CLIENT")
echo "ok [imports] every import of $CLIENT is a toolchain root or a published API module"

# (e1) self-test: one `simp only [stepFn_eqns]` replaced by `unfold stepFn` must trip the guard
mut1="$gate_scratch/mut-unfold.lean"
grep -q 'simp only \[stepFn_eqns\]' "$CLIENT" || { echo "check-equations: FAIL — the client has no stepFn_eqns rewrite to mutate" >&2; exit 1; }
sed '0,/simp only \[stepFn_eqns\]/s//unfold stepFn/' "$CLIENT" > "$mut1"
if grep -q -E "$GUARD" "$mut1"; then
  echo "ok [self-test unfold] the guard fires on a client that unfolds stepFn"
else
  echo "check-equations: FAIL — self-test: the guard did NOT fire on the unfold mutant" >&2; exit 1
fi

# (e2) self-test: one pin deleted must fail the enrollment check, naming the equation
mut2="$gate_scratch/mut-pin.lean"
victim="$(grep -m1 -o '^theorem Pin\.[A-Za-z0-9_'"'"'?]*' "$CLIENT" | sed 's/^theorem Pin\.//')"
[[ -n "$victim" ]] || { echo "check-equations: FAIL — no pin found to delete for the self-test" >&2; exit 1; }
awk -v v="theorem Pin.$victim :" 'BEGIN{skip=0} $0 ~ "^"v{skip=1} skip && /^$/{skip=0; next} !skip' "$CLIENT" > "$mut2"
if grep -q "theorem Pin.$victim :" "$mut2"; then
  echo "check-equations: FAIL — self-test: the pin $victim was not removed from the mutant" >&2; exit 1
fi
set +e
scripts/capped lake env lean "$mut2" > "$gate_scratch/mut-pin.log" 2>&1
rc=$?
set -e
if [[ $rc -eq 0 ]]; then
  echo "check-equations: FAIL — self-test: the client with pin $victim deleted still elaborated" >&2; exit 1
fi
grep -q "UNENROLLED equation GoLean.GoCore.Equations.$victim" "$gate_scratch/mut-pin.log" || {
  echo "check-equations: FAIL — self-test: the mutant failed but did not name the unenrolled equation $victim" >&2
  tail -20 "$gate_scratch/mut-pin.log" >&2; exit 1; }
echo "ok [self-test pin] deleting Pin.$victim fails the enrollment check by name"

# (e3) self-tests: the audit's UNFOLDING spellings (packet D audit F2), each replacing the anchored proof of
# `fact_usage_simp_set`, must be REFUSED by the client's Lean-level proof-term check, naming the fact. The
# mutants drop the pins (the facts are checked first; a pin-less mutant is fast) — the refusal is the Lean
# check's, not the regex's (none of these spellings except `unfold …stepFn` matches the regex).
anchor='  simp only \[stepFn_eqns\]  -- BYPASS-ANCHOR'
grep -q -- "$anchor" "$CLIENT" || { echo "check-equations: FAIL — the bypass anchor is missing from $CLIENT" >&2; exit 1; }
base3="$gate_scratch/mut-base.lean"
awk '/^-- PINS-BEGIN$/{print; skip=1; next} /^-- PINS-END$/{skip=0} !skip' "$CLIENT" > "$base3"
n3=0
while IFS= read -r spelling; do
  [[ -n "$spelling" ]] || continue
  n3=$((n3+1))
  mut3="$gate_scratch/mut-bypass-$n3.lean"
  sed "s|^$anchor\$|  $spelling|" "$base3" > "$mut3"
  grep -q -- "$anchor" "$mut3" && { echo "check-equations: FAIL — self-test: the anchor was not replaced for '$spelling'" >&2; exit 1; }
  set +e
  scripts/capped lake env lean "$mut3" > "$gate_scratch/mut-bypass-$n3.log" 2>&1
  rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    echo "check-equations: FAIL — self-test: the client with '$spelling' at the anchor still elaborated" >&2; exit 1
  fi
  grep -q "fact Tests.EquationClient.fact_usage_simp_set REFUSED — its proof unfolds stepFn" "$gate_scratch/mut-bypass-$n3.log" || {
    echo "check-equations: FAIL — self-test: '$spelling' failed but was not REFUSED as an unfolding of stepFn" >&2
    grep -E "error" "$gate_scratch/mut-bypass-$n3.log" | head -5 >&2; exit 1; }
  echo "ok [self-test bypass $n3] '$spelling' is refused by the proof-term check"
done <<'SPELLINGS'
exact rfl
simp only [stepFn]; rfl
delta stepFn; rfl
simp_all [stepFn]
simpa [stepFn]
rw [stepFn]; rfl
unfold GoLean.GoCore.Machine.stepFn; rfl
SPELLINGS
[[ $n3 -eq 7 ]] || { echo "check-equations: FAIL — expected 7 bypass self-tests, ran $n3" >&2; exit 1; }

# (e4) self-test: the INDIRECT unfolding (window review F2) — a private helper of the client proved by `rfl` on a
# `stepFn`-headed equation, `exact`ed from the anchored fact. Neither the regex nor a per-fact check sees it; the
# closure check must REFUSE the fact by name AND name the helper.
mut4="$gate_scratch/mut-indirect.lean"
helper_decl='private theorem returnViaReduction (s : Store) (env : LocalEnv) (k : Cont) (ch : Choices) :\n    stepFn ctx s (.exec .returnStmt env k) ch = .ok (.signal .ret k, s, ch, silent) := by rfl\n'
awk -v helper="$helper_decl" '/^\/-- FACT 8 /{printf "%s\n", helper} {print}' "$base3" \
  | sed "s|^$anchor\$|  exact returnViaReduction s env k ch|" > "$mut4"
grep -q "^private theorem returnViaReduction" "$mut4" || { echo "check-equations: FAIL — self-test: the indirect helper was not inserted" >&2; exit 1; }
grep -q -- "$anchor" "$mut4" && { echo "check-equations: FAIL — self-test: the anchor was not replaced for the indirect helper" >&2; exit 1; }
set +e
scripts/capped lake env lean "$mut4" > "$gate_scratch/mut-indirect.log" 2>&1
rc=$?
set -e
if [[ $rc -eq 0 ]]; then
  echo "check-equations: FAIL — self-test: the client with the indirect helper still elaborated" >&2; exit 1
fi
grep -q "fact Tests.EquationClient.fact_usage_simp_set REFUSED — its proof unfolds stepFn in its helper .*returnViaReduction" "$gate_scratch/mut-indirect.log" || {
  echo "check-equations: FAIL — self-test: the indirect helper failed but was not REFUSED naming the fact and the helper" >&2
  grep -E "error" "$gate_scratch/mut-indirect.log" | head -5 >&2; exit 1; }
echo "ok [self-test indirect] a private helper proved by rfl on stepFn, exact-ed from a fact, is refused naming fact and helper"

# (e5) self-test: witness A of the audit's re-verification (R1) — a NEW fact proved by the IMPORTED `rfl`-theorem
# `GoLean.GoCore.Machine.stepFn_next_frame` (the interpreter's own module `StepFn`, outside the published API). The
# closure must traverse the imported theorem and REFUSE the fact naming it.
mut5="$gate_scratch/mut-imported-rfl.lean"
fact_a='theorem fact_via_imported_rfl (s : Store) (targets : List (TargetShape × List Expr)) (tenv : LocalEnv)\n    (results : List Loc) (ds : List (GoValue × List GoValue)) (fr : FuncId) (k'"'"' : Cont) (ch : Choices) :\n    stepFn ctx s (.next (Frame.frame targets tenv results ds fr :: k'"'"')) ch\n      = stepFrameExit ctx s targets tenv results ds k'"'"' fr ch :=\n  stepFn_next_frame s targets tenv results ds fr k'"'"' ch\n'
awk -v fact="$fact_a" '/^\/-- FACT 8 /{printf "%s\n", fact} {print}' "$base3" \
  | sed 's|^def factCount : Nat := 12$|def factCount : Nat := 13|' > "$mut5"
grep -q "^theorem fact_via_imported_rfl" "$mut5" || { echo "check-equations: FAIL — self-test: witness A was not inserted" >&2; exit 1; }
grep -q "^def factCount : Nat := 13$" "$mut5" || { echo "check-equations: FAIL — self-test: witness A's factCount was not bumped" >&2; exit 1; }
set +e
scripts/capped lake env lean "$mut5" > "$gate_scratch/mut-imported-rfl.log" 2>&1
rc=$?
set -e
if [[ $rc -eq 0 ]]; then
  echo "check-equations: FAIL — self-test: the client with witness A (an imported rfl-theorem over stepFn) still elaborated" >&2; exit 1
fi
grep -q "fact Tests.EquationClient.fact_via_imported_rfl REFUSED — its proof unfolds stepFn in its helper GoLean.GoCore.Machine.stepFn_next_frame" "$gate_scratch/mut-imported-rfl.log" || {
  echo "check-equations: FAIL — self-test: witness A failed but was not REFUSED naming the fact and the imported theorem" >&2
  grep -E "error" "$gate_scratch/mut-imported-rfl.log" | head -5 >&2; exit 1; }
echo "ok [self-test imported-rfl] a fact proved by the interpreter's own rfl-theorem stepFn_next_frame is refused naming fact and theorem"

# (e6) self-test: witness B of the re-verification (R1) — a FOREIGN test-support module with a `rfl`-on-`stepFn` helper,
# compiled to an olean on an extended LEAN_PATH, imported by the client and `exact`-ed from the anchored fact. The
# import whitelist must REFUSE the import by name (before any fact is looked at).
support_src="$gate_scratch/AuditSupport.lean"
cat > "$support_src" <<'SUPPORT'
import GoLean.GoCore.Equations
open GoLean GoLean.GoCore GoLean.GoCore.Machine
namespace AuditSupport
theorem helper {ctx : ProgramCtx} (s : Store) (env : LocalEnv) (k : Cont) (ch : Choices) :
    stepFn ctx s (.exec .returnStmt env k) ch = .ok (.signal .ret k, s, ch, ⟨[], [], []⟩) := rfl
end AuditSupport
SUPPORT
scripts/capped lake env lean -o "$gate_scratch/AuditSupport.olean" "$support_src" > "$gate_scratch/AuditSupport.log" 2>&1 || {
  echo "check-equations: FAIL — self-test: the foreign support module did not compile (the control cannot run)" >&2
  tail -5 "$gate_scratch/AuditSupport.log" >&2; exit 1; }
mut6="$gate_scratch/mut-foreign-import.lean"
sed 's|^import GoLean.GoCore.Prefix$|import GoLean.GoCore.Prefix\nimport AuditSupport|' "$base3" \
  | sed "s|^$anchor\$|  exact AuditSupport.helper s env k ch|" > "$mut6"
grep -q "^import AuditSupport$" "$mut6" || { echo "check-equations: FAIL — self-test: the foreign import was not inserted" >&2; exit 1; }
lake_lean_path="$(scripts/capped lake env printenv LEAN_PATH)"
set +e
LEAN_PATH="$gate_scratch:$lake_lean_path" scripts/capped lean "$mut6" > "$gate_scratch/mut-foreign-import.log" 2>&1
rc=$?
set -e
if [[ $rc -eq 0 ]]; then
  echo "check-equations: FAIL — self-test: the client importing a foreign rfl-on-stepFn helper still elaborated" >&2; exit 1
fi
grep -q "Equation client: import AuditSupport is NOT WHITELISTED" "$gate_scratch/mut-foreign-import.log" || {
  echo "check-equations: FAIL — self-test: the foreign import failed but was not REFUSED by the import whitelist by name" >&2
  grep -E "error" "$gate_scratch/mut-foreign-import.log" | head -5 >&2; exit 1; }
echo "ok [self-test foreign-import] importing a test-support module with a rfl-on-stepFn helper is refused by the import whitelist by name"

printf '%s\n' "Equation gate: PASS (client PASS, exhaustive enrollment, the Lean-level no-unfold check over the closure up to the published API, the import whitelist, the regex pre-filter, 12 self-tests)"
