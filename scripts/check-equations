#!/usr/bin/env bash
# The semantic-EQUATION gate (window packet D, 2026-10-03; charter row 7's second and third
# checks — BridgeSet's statements left the build with the relational layer 2026-10-20, this
# library stays on main for the raft-proofs customer): (a) the equation file GoLean/GoCore/Equations.lean —
# one PROVED lemma per `stepFn` arm, the `stepFn_eqns` rewrite set — builds with the toy client
# library; (b) the client Tests/EquationClient.lean BUILDS and its build-time `#eval` reports PASS
# — its facts are proved by the equation set alone, and the `#eval` checks EXHAUSTIVE enrollment
# (every theorem of namespace GoLean.GoCore.Equations has a `Pin.<name>` whose type IS the
# theorem's). Since 2026-10-25 (lane gate/contract-pins-1025, release-readiness row 42's
# follow-up) the client has NO `main`: the check is the module's elaboration, so the library
# `EquationTests` is a default target and `lake check` exports and kernel-replays its pins and
# facts; this script reads the `#eval`'s two lines from the BUILD output — printed fresh when the
# module is rebuilt, REPLAYED by Lake from the module's saved log when it is cached (`Replayed
# Tests.EquationClient`; measured 2026-10-25 at 4.35) — and FAILS when either line is missing,
# whatever the build's exit. The lines alone are NOT the guard: Lean continues past an error, so
# a module with one broken pin still logs both lines beside `error:` lines and exits nonzero
# (seen by the review, fix round F5). The load-bearing guards, in order: `set -Eeuo pipefail` on
# the `tee` pipeline fails the script on the build's exit FIRST; then any `^error:` line in the
# output is refused; then the two lines are required; (c) the
# NO-UNFOLD guard — a cheap regex PRE-FILTER (the client never spells `unfold stepFn`, `simp [... stepFn
# ...]`, `cbv` or `decide`); the LOAD-BEARING check is the client's own Lean-level proof-term check
# (packet D audit F2: no `stepFn.*` constant, no reflexivity on `stepFn`, the term re-type-checked with
# `stepFn` irreducible), whose failure is (b)'s failure; (d) the enrollment check's failure is (b)'s
# failure. (The twelve mutant SELF-TESTS of packet D — unfold / pin-deleted / seven bypass spellings /
# indirect helper / imported rfl / foreign import — were removed in the 2026-10-12 gate cull, D3/D4:
# adversarial-grade controls on a checker, 43 s warm and 3912 s cold; the load-bearing check is the
# client's own Lean-level proof-term check, which (b) runs.) Every step fails closed.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$ROOT/scripts/cap.sh"
cd "$ROOT"
[[ $# = 0 ]] || { echo 'check-equations: expected no arguments' >&2; exit 2; }
. "$ROOT/scripts/typed-gate-scratch.sh"

CLIENT=Tests/EquationClient.lean
# The tactic words are word-bounded (lane core/g16-raise-mark-1023, review fix round F3, 2026-10-23):
# `by decide` and `decide +kernel` still match; an identifier merely CONTAINING the substring
# (`hdecide`, `strEntryDecided`, `Rewrite.undecided`) does not. The pre-filter is cheap and
# case-sensitive; the load-bearing check is the client's own Lean-level proof-term check ((b) above).
GUARD='unfold stepFn|simp \[[^]]*stepFn|\b(cbv|decide)\b'

# (a) + (b) + (d) the equation file and the client library build; the client's build-time `#eval`
# (the facts' no-unfold check, the exhaustive enrollment) reports in the build output — fresh or
# replayed from the module's saved log — and BOTH its lines must be there. `set -o pipefail`
# makes a failed build the exit of the pipeline; the two greps then fail closed on their own.
cap lake build GoLean EquationTests 2>&1 | tee "$gate_scratch/client.log"
! grep -qE '^error: ' "$gate_scratch/client.log" || {
  echo "check-equations: FAIL — the build output carries an error line" >&2; exit 1; }
grep -q 'Equation client: PASS — ' "$gate_scratch/client.log" || {
  echo "check-equations: FAIL — the build output carries no 'Equation client: PASS' line (the client's build-time check did not pass, or its log was neither printed nor replayed)" >&2; exit 1; }
grep -q 'Equation client: enrollment complete — ' "$gate_scratch/client.log" || {
  echo "check-equations: FAIL — the client's enrollment check did not report completion" >&2; exit 1; }
echo "ok [build-time checks] $(grep -o 'Equation client: PASS.*' "$gate_scratch/client.log" | head -1)"

# (c) the NO-UNFOLD guard over the tracked client
if git --no-pager grep -n -E "$GUARD" -- "$CLIENT"; then
  echo "check-equations: FAIL — $CLIENT re-unfolds stepFn (or spells cbv/decide): see the lines above" >&2
  exit 1
fi
echo "ok [no-unfold] $CLIENT never unfolds stepFn"

# (c') the IMPORT WHITELIST pre-filter (audit re-verification R1): every `import` line of the client names a toolchain
# root or a published API module; the load-bearing check is the client's own (`checkEnrollment` reads the environment
# header), this is the cheap textual twin. Fail closed on any other import.
import_whitelist='Init Std Lean GoLean.GoCore.Equations GoLean.GoCore.EquationsAttr GoLean.GoCore.Prefix GoLean.GoCore.ExecutionStatement GoLean.GoCore.PoolProjection'
while IFS= read -r impline; do
  mod="${impline#import }"; mod="${mod%% *}"
  ok_import=0
  for w in $import_whitelist; do [[ "$mod" == "$w" ]] && ok_import=1; done
  [[ $ok_import -eq 1 ]] || { echo "check-equations: FAIL — $CLIENT imports '$mod', which is not a toolchain root or a published API module ($import_whitelist)" >&2; exit 1; }
done < <(grep -E '^import ' "$CLIENT")
echo "ok [imports] every import of $CLIENT is a toolchain root or a published API module"

printf '%s\n' "Equation gate: PASS (client PASS at build time, exhaustive enrollment, the Lean-level no-unfold check over the closure up to the published API, the import whitelist, the regex pre-filter)"
