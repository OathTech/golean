#!/usr/bin/env python3
"""The pool/registry half's FROZEN-SURFACE + STAGED-DISCHARGE check (spec packet, 2026-10-04;
milestone staging and the `scripts/ci` step added 2026-10-05 by the [AGENT] tooling worker on the
coordinator's brief, after the grind's M1 report named the all-or-nothing discharge as a blocker).

Two files are the frozen surface — `GoLean/GoCore/PoolStep.lean` (the definitions) and
`GoLean/GoCore/PoolStatement.lean` (every `def <name>_stmt : Prop`, the glue definitions beside
them — `poolOut`, `DriverEvent.events`, `PoolClass*` — and the controls). This script

  (a) hashes BOTH files whole with comments stripped and whitespace normalized (keys `defs` and
      `stmts-file`), and every `_stmt` body the same way (keys `stmt <name>`, for naming), and
      compares them with `docs/specs/pool-relation/FROZEN.sha256` (written by `--freeze`): ANY
      drift — a changed body, a changed glue definition, a renamed/added/removed statement — FAILS
      by name. A `_stmt` body runs from its `def` line to the next column-0 command token (blank
      lines inside a body do NOT end it); a column-0 line that is not a known command token FAILS
      (fail closed). A bounded-zone adjustment (grind brief §5) re-freezes with a written reason.
  (b) checks the MILESTONE MAP `docs/specs/pool-relation/MILESTONES` (`<M1..M5> <name>_stmt` per
      line) covers EXACTLY the frozen `_stmt` names — a missing, extra or duplicated name, or a
      malformed line, FAILS.
  (c) checks the STAGED DISCHARGE against the landed level `L` — read from
      `docs/specs/pool-relation/LANDED` (one tag `M0`..`M5`; the landing TRAIN bumps it), or
      overridden locally by `--landed Mk` (the grinder's spelling for the milestone it is
      finishing; `--statements-only` is kept as the spelling of `--landed M0`, the spec phase):
        * `L = M0`: `GoLean/GoCore/PoolSound.lean` must be ABSENT (present FAILS — bump LANDED);
        * `L >= M1`: it must be PRESENT (absent FAILS), and every statement mapped to a milestone
          `<= L` must be DISCHARGED as `theorem <name> : <name>_stmt` in it — a missing one FAILS
          by name; statements of LATER milestones discharged early are REPORTED, never failed;
          the still-owed later statements are listed. At `L = M5` this is the full check.
  (d) SELF-TESTS first, on every invocation (`--freeze` included): negative controls on scratch
      copies under `.tmp/check-pool-spec-selftest/` — a glue definition rewritten to `True`, and
      `∨ True` appended to a `_stmt` body after a blank line — must each be DETECTED, the comment
      stripper must keep `--` and `/-` inside string and char literals, an incomplete / padded /
      duplicated / mis-tagged milestone map must be DETECTED, and the staged discharge must detect
      a missing M1 theorem at `L = M1`, PoolSound present at `M0` and absent at `M1`, while passing
      (and reporting) an early M2 discharge. A self-test that does not detect its mutation FAILS.

Exit 0 only when every check passes. No allowlist.
"""
import hashlib
import pathlib
import re
import shutil
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
DEFS = ROOT / "GoLean/GoCore/PoolStep.lean"
STMT = ROOT / "GoLean/GoCore/PoolStatement.lean"
SOUND = ROOT / "GoLean/GoCore/PoolSound.lean"
FREEZE = ROOT / "docs/specs/pool-relation/FROZEN.sha256"
SCRATCH = ROOT / ".tmp/check-pool-spec-selftest"
MILESTONES = ROOT / "docs/specs/pool-relation/MILESTONES"
LANDED = ROOT / "docs/specs/pool-relation/LANDED"
LEVELS = ("M0", "M1", "M2", "M3", "M4", "M5")  # M0 = nothing landed; statements map to M1..M5

# Column-0 tokens that may follow a `_stmt` body (after comment stripping). Anything else at
# column 0 is an unrecognised shape and FAILS rather than being silently absorbed or cut.
COMMAND_TOKENS = {
    "def", "theorem", "lemma", "example", "abbrev", "instance", "structure", "inductive", "class",
    "end", "section", "namespace", "open", "variable", "set_option", "attribute", "noncomputable",
    "private", "protected", "opaque", "axiom", "macro", "macro_rules", "syntax", "universe",
    "mutual", "local", "scoped", "import", "notation", "infix", "infixl", "infixr", "prefix",
    "postfix", "deriving", "elab", "initialize", "#eval", "#check", "#print", "#reduce", "@[",
}

_CHAR_LIT = re.compile(r"'(\\.|[^\\'\n])'")


class SpecError(Exception):
    pass


def strip_comments(text: str) -> str:
    """Drop `/- … -/` blocks (nesting-aware) and `--` line comments. String literals `"…"`
    (with `\\` escapes) and char literals `'c'` are copied verbatim at depth 0, so a `--` or `/-`
    inside them is NOT a comment (review M4)."""
    out = []
    depth = 0
    i = 0
    n = len(text)
    while i < n:
        two = text[i:i + 2]
        if two == "/-":
            depth += 1
            i += 2
            continue
        if two == "-/" and depth > 0:
            depth -= 1
            i += 2
            continue
        if depth == 0:
            ch = text[i]
            if two == "--":
                while i < n and text[i] != "\n":
                    i += 1
                continue
            if ch == '"':
                j = i + 1
                while j < n and text[j] != '"':
                    j += 2 if text[j] == "\\" else 1
                if j >= n:
                    raise SpecError("unterminated string literal")
                out.append(text[i:j + 1])
                i = j + 1
                continue
            if ch == "'" and (i == 0 or not (text[i - 1].isalnum() or text[i - 1] in "_'.!?")):
                m = _CHAR_LIT.match(text, i)
                if m:
                    out.append(m.group(0))
                    i = m.end()
                    continue
            out.append(ch)
        i += 1
    if depth != 0:
        raise SpecError("unterminated block comment")
    return "".join(out)


def norm(s: str) -> str:
    return " ".join(s.split())


def sha(s: str) -> str:
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def stmt_bodies(text: str) -> dict:
    """`def <name>_stmt : Prop :=` up to the next column-0 command token, comments stripped,
    normalized. Blank lines inside a body are part of it (review B2)."""
    lines = strip_comments(text).splitlines()
    bodies = {}
    i = 0
    while i < len(lines):
        m = re.match(r"^def (\w+_stmt) : Prop :=\s*$", lines[i])
        if not m:
            i += 1
            continue
        name = m.group(1)
        j = i + 1
        body = []
        while j < len(lines):
            line = lines[j]
            if line.strip() and not line[0].isspace():
                tok = "@[" if line.startswith("@[") else line.split()[0]
                if tok not in COMMAND_TOKENS:
                    raise SpecError(f"{name}: column-0 line {j + 1} is not a known command token "
                                    f"({line.strip()[:40]!r}) — refusing to guess where the body ends")
                break
            body.append(line)
            j += 1
        if name in bodies:
            raise SpecError(f"duplicate statement {name}")
        bodies[name] = norm(" ".join(body))
        i = j
    if not bodies:
        raise SpecError("no `_stmt` found in PoolStatement.lean (a vacuous check is refused)")
    return bodies


def hashes(defs_path: pathlib.Path, stmt_path: pathlib.Path) -> dict:
    stmt_text = stmt_path.read_text()
    cur = {"defs": sha(norm(strip_comments(defs_path.read_text()))),
           "stmts-file": sha(norm(strip_comments(stmt_text)))}
    for name, body in stmt_bodies(stmt_text).items():
        cur[f"stmt {name}"] = sha(body)
    return cur


def drift(frozen: dict, cur: dict) -> list:
    bad = []
    for k in sorted(set(frozen) | set(cur)):
        if k not in cur:
            bad.append(f"REMOVED or RENAMED: {k}")
        elif k not in frozen:
            bad.append(f"ADDED (not frozen): {k}")
        elif frozen[k] != cur[k]:
            bad.append(f"CHANGED: {k}")
    return bad


def self_tests(base: dict) -> list:
    """Negative controls; returns the list of FAILED self-tests (empty = all detected)."""
    failures = []
    text = STMT.read_text()
    if SCRATCH.exists():
        shutil.rmtree(SCRATCH)
    SCRATCH.mkdir(parents=True)
    try:
        # (a) a glue definition (not a `_stmt`) rewritten to `True` — review B1.
        m = re.search(r"^def PoolClassOk\b[\s\S]*?:\s*Prop\s*:=\n(?:[ \t]+.*\n)+", text, re.M)
        if not m:
            failures.append("(a) PoolClassOk definition not found in PoolStatement.lean")
        else:
            head = m.group(0).split(":=\n", 1)[0]
            mut = text[:m.start()] + head + ":=\n  True\n" + text[m.end():]
            p = SCRATCH / "a_glue_true.lean"
            p.write_text(mut)
            got = drift(base, hashes(DEFS, p))
            if "CHANGED: stmts-file" not in got:
                failures.append(f"(a) `PoolClassOk … := True` NOT detected (drift: {got})")
        # (b) `\n\n    ∨ True` appended to a `_stmt` body — review B2 (the blank-line hole).
        m = re.search(r"^def (\w+_stmt) : Prop :=\n(?:[ \t]+.*\n)+", text, re.M)
        if not m:
            failures.append("(b) no `_stmt` body found to mutate")
        else:
            name = m.group(1)
            mut = text[:m.end()].rstrip("\n") + "\n\n    ∨ True\n" + text[m.end():]
            p = SCRATCH / "b_blankline_disjunct.lean"
            p.write_text(mut)
            got = drift(base, hashes(DEFS, p))
            for key in ("stmts-file", f"stmt {name}"):
                if f"CHANGED: {key}" not in got:
                    failures.append(f"(b) `∨ True` after a blank line in {name} NOT detected by `{key}` "
                                    f"(drift: {got})")
        # (c) the stripper keeps `--` / `/-` inside string and char literals — review M4.
        cases = [
            ('def s := "a--b" -- gone\n', 'def s := "a--b" \n'),
            ('def s := "x/-y" /- gone -/ z\n', 'def s := "x/-y"  z\n'),
            ('def s := "q\\"--r" -- gone\n', 'def s := "q\\"--r" \n'),
            ("def c := '-' -- gone\n", "def c := '-' \n"),
            ("def c := '\"' -- \"\n", "def c := '\"' \n"),
            ("def m' := m'' -- gone\n", "def m' := m'' \n"),
            ("a /- x /- y -/ z -/ b\n", "a  b\n"),
        ]
        for src, want in cases:
            try:
                got_s = strip_comments(src)
            except SpecError as e:
                got_s = f"<SpecError: {e}>"
            if got_s != want:
                failures.append(f"(c) strip_comments({src!r}) = {got_s!r}, expected {want!r}")
    finally:
        if SCRATCH.exists() and SCRATCH.is_relative_to(ROOT / ".tmp"):
            shutil.rmtree(SCRATCH)
    return failures


def parse_milestones(text: str, names: list) -> dict:
    """The milestone map: `<M1..M5> <name>_stmt` per line (`#` comments, blank lines ignored).
    Raises SpecError unless it covers EXACTLY `names` — no missing, extra or duplicate entry."""
    mmap = {}
    errors = []
    for i, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) != 2 or parts[0] not in LEVELS[1:] or not re.fullmatch(r"\w+_stmt", parts[1]):
            errors.append(f"line {i}: malformed entry {raw.strip()!r} (want `<M1..M5> <name>_stmt`)")
            continue
        tag, name = parts
        if name in mmap:
            errors.append(f"line {i}: DUPLICATE {name} (already {mmap[name]})")
            continue
        mmap[name] = tag
    want = set(names)
    for name in sorted(want - set(mmap)):
        errors.append(f"MISSING from the map: {name}")
    for name in sorted(set(mmap) - want):
        errors.append(f"EXTRA in the map (not a frozen statement): {name}")
    if errors:
        raise SpecError("milestone map does not cover exactly the frozen statements:\n  "
                        + "\n  ".join(errors))
    return mmap


def parse_landed(text: str, origin: str) -> str:
    tags = [l.strip() for l in text.splitlines() if l.strip() and not l.strip().startswith("#")]
    if len(tags) != 1 or tags[0] not in LEVELS:
        raise SpecError(f"{origin}: want exactly one tag of {'/'.join(LEVELS)}, got {tags!r}")
    return tags[0]


def discharged(sound_text: str, name: str) -> bool:
    base = name[: -len("_stmt")]
    return re.search(rf"^theorem {re.escape(base)}\s*:\s*(\S+\.)?{re.escape(name)}\b",
                     sound_text, re.M) is not None


def staged_verdict(landed: str, mmap: dict, sound_text) -> tuple:
    """The staged discharge at landed level `landed`. `sound_text` is PoolSound.lean with comments
    stripped, or None when the file is absent. Returns (failures, required_ok, early, owed): the
    failure lines (empty = pass), the required statements discharged, the later-milestone
    statements discharged early, and the later-milestone statements still owed."""
    lvl = LEVELS.index(landed)
    if sound_text is None:
        if lvl == 0:
            return [], [], [], sorted(mmap)
        return [f"PoolSound.lean absent at LANDED={landed} — the discharge check cannot run"], [], [], []
    if lvl == 0:
        return ["PoolSound.lean present at LANDED=M0 — the grind has landed something: bump "
                "docs/specs/pool-relation/LANDED (train) or pass --landed Mk (grinder)"], [], [], []
    failures, required_ok, early, owed = [], [], [], []
    for name in sorted(mmap, key=lambda n: (mmap[n], n)):
        req = LEVELS.index(mmap[name]) <= lvl
        done = discharged(sound_text, name)
        if req and done:
            required_ok.append(name)
        elif req:
            failures.append(f"{mmap[name]} {name}: no `theorem {name[:-5]} : {name}` in PoolSound.lean")
        elif done:
            early.append(name)
        else:
            owed.append(name)
    return failures, required_ok, early, owed


def staged_self_tests(names: list) -> list:
    """Negative/positive controls of the milestone map and the staged discharge, in memory."""
    failures = []
    if len(names) < 2:
        return ["(d) fewer than two frozen statements — the staging self-tests cannot run"]
    a, b = names[0], names[1]
    good = f"M1 {a}\nM2 {b}\n" + "".join(f"M5 {n}\n" for n in names[2:])

    def map_rejects(text, label, needle):
        try:
            parse_milestones(text, names)
        except SpecError as e:
            if needle not in str(e):
                failures.append(f"(d) {label}: rejected, but without naming {needle!r}: {e}")
            return
        failures.append(f"(d) {label} NOT detected")
    try:
        mm = parse_milestones(good, names)
    except SpecError as e:
        failures.append(f"(d) a complete map was rejected: {e}")
        return failures
    map_rejects(good.replace(f"M1 {a}\n", ""), "a map missing a statement", f"MISSING from the map: {a}")
    map_rejects(good + "M3 bogus_extra_stmt\n", "a map with an extra name", "EXTRA in the map")
    map_rejects(good + f"M3 {a}\n", "a duplicated map entry", f"DUPLICATE {a}")
    map_rejects(good.replace(f"M1 {a}", f"M6 {a}"), "an out-of-range tag", "malformed entry")
    map_rejects(good.replace(f"M1 {a}", f"M0 {a}"), "a statement mapped to M0", "malformed entry")
    for bad in ("", "M1\nM2\n", "M9\n", "m1\n"):
        try:
            parse_landed(bad, "selftest")
            failures.append(f"(e) LANDED {bad!r} NOT rejected")
        except SpecError:
            pass
    th = lambda n: f"theorem {n[:-5]} : {n} := by\n  trivial\n"
    # (e1) a missing M1 theorem at LANDED=M1 is detected, by name.
    f, _, _, _ = staged_verdict("M1", mm, th(b))
    if not any(a in x for x in f):
        failures.append(f"(e1) missing M1 theorem {a} at LANDED=M1 NOT detected ({f})")
    # (e2) all M1 discharged + an M2 early: passes, and reports the early one.
    f, ok_, early, owed = staged_verdict("M1", mm, th(a) + th(b))
    if f or ok_ != [a] or early != [b] or len(owed) != len(names) - 2:
        failures.append(f"(e2) M1 complete + early M2 misjudged (fail={f}, ok={ok_}, early={early})")
    # (e3) the same file at LANDED=M5 fails naming the M5 statements.
    f, _, _, _ = staged_verdict("M5", mm, th(a) + th(b))
    if len(f) != len(names) - 2:
        failures.append(f"(e3) LANDED=M5 with M5 statements missing NOT detected ({len(f)} failures)")
    # (e4) PoolSound present at M0, absent at M1: both FAIL; absent at M0 passes.
    if not staged_verdict("M0", mm, th(a))[0]:
        failures.append("(e4) PoolSound present at LANDED=M0 NOT detected")
    if not staged_verdict("M1", mm, None)[0]:
        failures.append("(e4) PoolSound absent at LANDED=M1 NOT detected")
    if staged_verdict("M0", mm, None)[0]:
        failures.append("(e4) PoolSound absent at LANDED=M0 wrongly failed")
    # (e5) a near-miss theorem (wrong statement, comment-only) does not count as discharged.
    near = f"theorem {a[:-5]} : {b} := sorry\n" + strip_comments(f"-- {th(a)}")
    if not staged_verdict("M1", mm, strip_comments(near))[0]:
        failures.append("(e5) a mis-typed / commented-out theorem counted as a discharge")
    return failures


def read_freeze() -> dict:
    if not FREEZE.exists():
        raise SpecError(f"{FREEZE.relative_to(ROOT)} missing (run --freeze once, deliberately)")
    frozen = {}
    for line in FREEZE.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, _, h = line.rpartition(" ")
        if not key or not re.fullmatch(r"[0-9a-f]{64}", h):
            raise SpecError(f"malformed line in {FREEZE.relative_to(ROOT)}: {line!r}")
        frozen[key] = h
    return frozen


def main(argv) -> int:
    freeze = False
    landed_override = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--freeze":
            freeze = True
        elif a in ("--statements-only", "--landed"):
            if landed_override is not None:
                print("check-pool-spec: give --landed / --statements-only at most once", file=sys.stderr)
                return 2
            if a == "--statements-only":
                landed_override = "M0"
            else:
                if i + 1 >= len(argv) or argv[i + 1] not in LEVELS:
                    print(f"check-pool-spec: --landed needs one of {'/'.join(LEVELS)}", file=sys.stderr)
                    return 2
                i += 1
                landed_override = argv[i]
        else:
            print(f"check-pool-spec: unknown argument {a!r}", file=sys.stderr)
            return 2
        i += 1
    cur = hashes(DEFS, STMT)
    names = [k.split(" ", 1)[1] for k in cur if k.startswith("stmt ")]
    nstmts = len(names)
    failures = self_tests(cur) + staged_self_tests(names)
    if failures:
        print("check-pool-spec: FAIL — a self-test did not detect its mutation:", file=sys.stderr)
        for f in failures:
            print(f"  {f}", file=sys.stderr)
        return 1
    print("ok [self-tests] (a) glue `:= True` detected; (b) blank-line `∨ True` detected by the file "
          "and statement keys; (c) literals survive comment stripping; (d) incomplete/padded/duplicated/"
          "mis-tagged milestone maps detected; (e) staged discharge: missing M1 theorem at M1, PoolSound "
          "present at M0 / absent at M1 detected, early M2 reported not failed")
    if freeze:
        FREEZE.parent.mkdir(parents=True, exist_ok=True)
        body = ["# FROZEN SURFACE of the pool/registry half (scripts/check-pool-spec --freeze).",
                "# `defs` = GoLean/GoCore/PoolStep.lean, comments stripped, whitespace normalized;",
                "# `stmts-file` = GoLean/GoCore/PoolStatement.lean whole (glue defs, statements, controls), likewise;",
                "# `stmt <name>` = that statement's body (to the next column-0 command token), likewise.",
                "# Re-freezing is a bounded-zone act: the grind brief requires a written reason per line."]
        body += [f"{k} {v}" for k, v in sorted(cur.items())]
        FREEZE.write_text("\n".join(body) + "\n")
        print(f"check-pool-spec: froze {nstmts} statements + both files into {FREEZE.relative_to(ROOT)}")
        return 0
    bad = drift(read_freeze(), cur)
    if bad:
        print("check-pool-spec: FAIL — the frozen surface drifted:", file=sys.stderr)
        for b in bad:
            print(f"  {b}", file=sys.stderr)
        return 1
    print(f"ok [frozen] both files and {nstmts} statements match {FREEZE.relative_to(ROOT)}")
    if not MILESTONES.exists():
        raise SpecError(f"{MILESTONES.relative_to(ROOT)} missing — the staged discharge cannot run")
    mmap = parse_milestones(MILESTONES.read_text(), names)
    counts = {t: sum(1 for v in mmap.values() if v == t) for t in LEVELS[1:]}
    print(f"ok [milestones] {MILESTONES.relative_to(ROOT)} covers exactly the {nstmts} statements ("
          + ", ".join(f"{t}: {c}" for t, c in counts.items()) + ")")
    if landed_override is not None:
        landed, origin = landed_override, "--landed override"
    else:
        if not LANDED.exists():
            raise SpecError(f"{LANDED.relative_to(ROOT)} missing — the landed level is unknown")
        landed, origin = parse_landed(LANDED.read_text(), str(LANDED.relative_to(ROOT))), str(LANDED.relative_to(ROOT))
    sound_text = strip_comments(SOUND.read_text()) if SOUND.exists() else None
    fails, required_ok, early, owed = staged_verdict(landed, mmap, sound_text)
    if early:
        print(f"note [early] {len(early)} statement(s) of later milestones already discharged: "
              + ", ".join(f"{mmap[n]} {n}" for n in early))
    if fails:
        print(f"check-pool-spec: FAIL — the staged discharge at LANDED={landed} ({origin}):", file=sys.stderr)
        for f in fails:
            print(f"  {f}", file=sys.stderr)
        return 1
    if sound_text is None:
        print(f"ok [discharge] LANDED={landed} ({origin}): {SOUND.relative_to(ROOT)} absent, as M0 requires; "
              f"all {len(owed)} statements owed")
        return 0
    print(f"ok [discharge] LANDED={landed} ({origin}): all {len(required_ok)} statements of M1..{landed} "
          f"discharged in {SOUND.relative_to(ROOT)}; {len(early)} early; {len(owed)} owed by later milestones")
    if owed:
        print("note [owed] " + ", ".join(f"{mmap[n]} {n}" for n in owed))
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SpecError as e:
        print(f"check-pool-spec: FAIL — {e}", file=sys.stderr)
        sys.exit(1)
