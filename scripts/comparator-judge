#!/usr/bin/env bash
# The Comparator judge — independent, kernel-level certification of the
# designated headline theorems (comparator-judge sprint, 2026-08-02;
# docs/2026-08-02_comparator-judge-sprint.md).
#
# CADENCE: a LANDMARK gate, not an iteration gate (user direction
# 2026-08-02). Run before merging any arc that adds or changes a designated
# headline theorem statement, and before any external claim about a headline
# result. It is deliberately NOT part of scripts/ci.
#
# What a PASS certifies (see deps/comparator/README.md for the full trust
# statement): every theorem in proofs/judge-config.json, as STATED in the
# trusted proofs/Challenge.lean (import closure: the Iris-free chain), is
# proven in proofs/Solution.lean using no axioms beyond the allowlist, as
# re-checked by exporting both environments and replaying the Solution into
# the Lean kernel — independent of our proof scripts, Audit pins, and Lake's
# incremental state.
#
# TRUST TOOLS ARE NEVER MODIFIED (standing rule, 2026-08-02): this script
# verifies the pinned pristine SOURCES and refuses to run otherwise. Residual
# trust, stated honestly: the executed binaries live under gitignored .lake
# build dirs and are presumed to be honest builds of those pinned sources —
# rebuild via scripts/comparator-setup if in doubt; a binary-level pin is not
# maintainable across rebuilds.
set -u -o pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/scripts/lean-scan.sh"

COMPARATOR_DIR="$ROOT/deps/comparator"
COMPARATOR_REV=fd2e25de155523dbce1f35d410511f9f63998461
LEAN4EXPORT_REV=8554815c2dc6b7abe99ec1f08849c9759ba77947
LANDRUN_BIN="${LANDRUN_BIN:-$HOME/go/bin/landrun}"
# landrun pin: cli-v2-era main (v0.1.16+ eats the `--` separator comparator
# relies on; the v0.1.15 tag's -ldd misses the ELF interpreter). NB the
# binary self-reports "0.1.15" — the module pseudo-version is the identity.
LANDRUN_MODVER=v0.1.16-0.20260127195639-5283024a2f49
# The permitted axiom set is PINNED HERE, not merely read from the config —
# a config edit widening it must also edit this script (deliberate, visible).
PERMITTED_AXIOMS='propext Quot.sound Classical.choice'

fail() { echo "comparator-judge: FAIL-CLOSED: $*" >&2; exit 1; }

# ── 1. Trust-tool pins (sources pristine at recorded revs) ──────────────
[ -d "$COMPARATOR_DIR/.git" ] || fail "deps/comparator missing (scripts/comparator-setup)"
rev=$(git -C "$COMPARATOR_DIR" rev-parse HEAD)
[ "$rev" = "$COMPARATOR_REV" ] || fail "deps/comparator at $rev, pinned $COMPARATOR_REV"
dirty=$(git -C "$COMPARATOR_DIR" status --porcelain)
[ -z "$dirty" ] || fail "deps/comparator tree is NOT pristine:
$dirty"
L4X_DIR="$COMPARATOR_DIR/.lake/packages/lean4export"
[ -d "$L4X_DIR/.git" ] || fail "comparator's lean4export package missing (build comparator first)"
l4xrev=$(git -C "$L4X_DIR" rev-parse HEAD)
[ "$l4xrev" = "$LEAN4EXPORT_REV" ] || fail "lean4export package at $l4xrev, pinned $LEAN4EXPORT_REV"
l4xdirty=$(git -C "$L4X_DIR" status --porcelain)
[ -z "$l4xdirty" ] || fail "lean4export package tree is NOT pristine:
$l4xdirty"
COMPARATOR_BIN="$COMPARATOR_DIR/.lake/build/bin/comparator"
LEAN4EXPORT_BIN="$L4X_DIR/.lake/build/bin/lean4export"
[ -x "$COMPARATOR_BIN" ] || fail "comparator not built (scripts/comparator-setup)"
[ -x "$LEAN4EXPORT_BIN" ] || fail "lean4export not built (scripts/comparator-setup)"
[ -x "$LANDRUN_BIN" ] || fail "landrun not found at $LANDRUN_BIN"
modver=$(go version -m "$LANDRUN_BIN" 2>/dev/null | awk '$1=="mod" && $2 ~ /landrun/ {print $3}')
[ "$modver" = "$LANDRUN_MODVER" ] || fail "landrun at '$modver', pinned $LANDRUN_MODVER (scripts/comparator-setup)"

# ── 2. The judged tree: FRESH CLONE by default ──────────────────────────
# Comparator's assumption 2 (README): the judge must not run against a
# .lake that previously compiled the Solution or any other untrusted file —
# incremental state could poison the CHALLENGE's elaboration. The default
# mode makes that structural: clone the repo at committed HEAD into a
# disposable tree; pre-build ONLY THE TRUSTED SIDE (GoLean core + the clean
# chain + Challenge — the README's blessed "pre-built .lake obtained without
# compromising your checking environment", which also fits our layered
# packages: comparator's sandbox may write only proofs/.lake, not the core
# package's build dir). The UNTRUSTED Solution is never elaborated by us:
# comparator builds it inside its landrun sandbox, and only AFTER it has
# already exported the Challenge — so even a Solution build that tampered
# with Challenge artifacts in the shared .lake would be tampering with
# something already read.
#
# Dependency packages (iris + friends, at the manifest's pinned revs) are
# seeded by copy — a network-free `lake update`. They feed only the
# Solution build (Challenge's closure contains no fetched dependency), and
# the kernel replay re-checks everything the Solution claims.
#
# --in-place skips the clone and judges the working tree's warm .lake:
# iteration-grade ONLY, never authoritative; the verdict line says so.
MODE=fresh
[ "${1:-}" = "--in-place" ] && MODE=in-place
if [ "$MODE" = fresh ]; then
  headrev=$(git -C "$ROOT" rev-parse HEAD)
  [ -z "$(git -C "$ROOT" status --porcelain)" ] \
    || echo "comparator-judge: NOTE working tree is dirty — judging committed HEAD $headrev, not the dirty tree" >&2
  CLONE="$ROOT/artifacts/judge/clone-${headrev:0:12}"
  rm -rf "$CLONE"
  mkdir -p "$ROOT/artifacts/judge"
  echo "comparator-judge: fresh clone of $headrev -> ${CLONE#"$ROOT"/}"
  git clone --quiet --no-hardlinks "$ROOT" "$CLONE"
  mkdir -p "$CLONE/proofs/.lake"
  cp -a "$ROOT/proofs/.lake/packages" "$CLONE/proofs/.lake/packages"
  JUDGE_DIR="$CLONE/proofs"
  CHECK_ROOT="$CLONE"   # all artifact checks below run against the JUDGED tree
else
  echo "comparator-judge: --in-place: judging the WARM working tree (iteration-grade, NOT authoritative)"
  JUDGE_DIR="$ROOT/proofs"
  CHECK_ROOT="$ROOT"
fi

# ── 3. Artifact checks — against the tree the judge will actually see ───
# 3a. Config validation: modules and axioms are pinned, not just read.
cm=$(grep -oE '"challenge_module"[[:space:]]*:[[:space:]]*"[^"]*"' "$CHECK_ROOT/proofs/judge-config.json" | sed -E 's/.*:\s*"//; s/"//')
sm=$(grep -oE '"solution_module"[[:space:]]*:[[:space:]]*"[^"]*"' "$CHECK_ROOT/proofs/judge-config.json" | sed -E 's/.*:\s*"//; s/"//')
[ "$cm" = "Challenge" ] || fail "judge-config challenge_module is '$cm', expected Challenge"
[ "$sm" = "Solution" ] || fail "judge-config solution_module is '$sm', expected Solution"
# Newline-flattened single-bracket extraction: layout-independent (a
# /start/,/end/ sed range swallowed to EOF when both matched one line —
# caught by this check's own first fail-closed run; a line-based grep would
# extract nothing after a routine JSON reflow — delta-review 2026-08-02).
cfg_axioms=$(tr -d '\n' < "$CHECK_ROOT/proofs/judge-config.json" \
  | grep -oE '"permitted_axioms"[[:space:]]*:[[:space:]]*\[[^]]*\]' \
  | grep -oE '"[A-Za-z0-9_.]+"' | sed -E 's/"//g' | grep -v '^permitted_axioms$' | sort | tr '\n' ' ' | sed 's/ $//')
want_axioms=$(echo "$PERMITTED_AXIOMS" | tr ' ' '\n' | sort | tr '\n' ' ' | sed 's/ $//')
[ "$cfg_axioms" = "$want_axioms" ] || fail "judge-config permitted_axioms [$cfg_axioms] != pinned [$want_axioms]"

# 3b. Designated-list lockstep vs the statement-TCB gate, with short-name
# collision detection (the mapping GoLean.*.X -> Judge.X is only injective
# while short names are unique across the designated namespaces — a
# collision makes the set-compare blind, so it fails the run).
audit_full=$(sed -n '/let designated : List Name := \[/,/\]/p' "$CHECK_ROOT/proofs/Audit.lean" \
  | grep -oE '``[A-Za-z0-9_.]+' | sed -E 's/^``//')
[ -n "$audit_full" ] || fail "could not parse the designated list from proofs/Audit.lean"
audit_names=$(echo "$audit_full" | sed -E 's/.*\.//' | sort)
dup=$(echo "$audit_names" | uniq -d)
[ -z "$dup" ] || fail "designated short names collide ($dup) — the Judge.* mapping is no longer injective; restructure judge-config naming first"
config_names=$(grep -oE '"Judge\.[A-Za-z0-9_]+"' "$CHECK_ROOT/proofs/judge-config.json" \
  | sed -E 's/"Judge\.//; s/"$//' | sort)
[ -n "$config_names" ] || fail "could not parse theorem_names from proofs/judge-config.json"
if [ "$audit_names" != "$config_names" ]; then
  echo "designated list (Audit.lean) vs judge-config.json differ:" >&2
  diff <(echo "$audit_names") <(echo "$config_names") | sed 's/^/  /' >&2
  fail "judge theorem list is out of lockstep with the statement-TCB gate"
fi
n_theorems=$(echo "$config_names" | wc -l)

# 3c. Challenge import-closure Iris-freedom — a MODULE-level walk (weaker
# than the statement-TCB gate's constant-level walk in proofs/Audit.lean,
# which remains the in-build authority; this check is the judge-side
# defense in depth). Canonical extraction (comment-stripped, tolerant
# anchor — pre-merge audit 2026-08-02: this walk had re-introduced the
# retired fail-open '^import ' anchor); unknown module roots FAIL, never
# skip.
closure_walk() {
  local queue=("$@") m f
  declare -A seen
  while ((${#queue[@]})); do
    m="${queue[0]}"; queue=("${queue[@]:1}")
    [[ -n "${seen[$m]:-}" ]] && continue
    seen[$m]=1
    case "$m" in
      Iris*) echo "IRIS:$m"; return 0 ;;
      Std|Std.*|Init|Init.*|Lean|Lean.*|Batteries|Batteries.*|Qq|Qq.*) continue ;;
      GoLean.*) f="$CHECK_ROOT/GoLean/${m#GoLean.}" ;;
      GoLeanProofs|GoLeanProofs.*) f="$CHECK_ROOT/proofs/GoLeanProofs/${m#GoLeanProofs.}"; [ "$m" = GoLeanProofs ] && f="$CHECK_ROOT/proofs/GoLeanProofs" ;;
      *) echo "UNKNOWN:$m"; return 0 ;;
    esac
    f="${f//.//}.lean"
    [ -f "$f" ] || { echo "MISSING:$m"; return 0; }
    while read -r imp; do [ -n "$imp" ] && queue+=("$imp"); done < <(lean_imports "$f")
  done
  echo "CLEAN:${#seen[@]}"
}
mapfile -t challenge_imports < <(lean_imports "$CHECK_ROOT/proofs/Challenge.lean")
[ "${#challenge_imports[@]}" -gt 0 ] || fail "no imports parsed from Challenge.lean"
walk=$(closure_walk "${challenge_imports[@]}")
case "$walk" in
  CLEAN:*) : ;;
  IRIS:*) fail "Challenge import closure reaches ${walk#IRIS:} — the deletion test is violated at module level" ;;
  MISSING:*) fail "Challenge import closure names missing module ${walk#MISSING:}" ;;
  UNKNOWN:*) fail "Challenge import closure reaches unrecognized module root ${walk#UNKNOWN:} — extend the walk deliberately, never skip" ;;
  *) fail "closure walk returned '$walk'" ;;
esac

echo "comparator-judge: pins OK (comparator @ ${COMPARATOR_REV:0:7}, lean4export @ ${LEAN4EXPORT_REV:0:7}, both pristine;"
echo "  landrun $LANDRUN_MODVER); config pinned; $n_theorems theorems in lockstep with the"
echo "  statement-TCB gate; Challenge closure Iris-free (${walk#CLEAN:} modules) — all checked on the judged tree."

# ── 4. Pre-build the TRUSTED side only ──────────────────────────────────
if [ "$MODE" = fresh ]; then
  echo "comparator-judge: pre-building the trusted side (Challenge + closure) in the clone"
  # Write-set note (delta-review 2026-08-02): the sandboxed Solution build
  # may write only proofs/.lake, so any GoLean CORE module the proofs need
  # must already be built here. `lake build Challenge` covers core modules
  # in Challenge's closure; if the proof layer ever needs core modules
  # outside it, the judge fails LOUDLY with a landrun write denial on the
  # core .lake — widen this pre-build to the full core lib then
  # (trusted side: the core is the TCB), never widen comparator's sandbox.
  (cd "$JUDGE_DIR" && lake build Challenge) \
    || fail "pre-build of Challenge in the fresh clone failed"
fi

# ── 5. The run — exactly the README's guarded invocation ────────────────
# systemd-run confines the judge with RestrictAddressFamilies=~AF_UNIX (the
# landrun-escape guard the comparator README prescribes). Comparator then:
# builds Challenge (a no-op here) and EXPORTS it; only then builds the
# Solution — inside a landrun sandbox — and exports it; then replays the
# Solution into the kernel. Works from inside the nono sandbox too
# (validated 2026-08-02; the unit carries the same confinement).
CMD=(systemd-run --property=RestrictAddressFamilies=~AF_UNIX --user --pipe --wait
  -E PATH="$HOME/go/bin:$PATH"
  -E COMPARATOR_LANDRUN="$LANDRUN_BIN"
  -E COMPARATOR_LEAN4EXPORT="$LEAN4EXPORT_BIN"
  --working-directory "$JUDGE_DIR"
  -- bash -c "lake env '$COMPARATOR_BIN' judge-config.json")
echo "comparator-judge: running:"
printf '  %q' "${CMD[@]}"; echo
start=$(date +%s)
"${CMD[@]}"
status=$?
elapsed=$(( $(date +%s) - start ))
if [ $status -eq 0 ]; then
  if [ "$MODE" = fresh ]; then
    echo "comparator-judge: PASS — $n_theorems theorems certified in ${elapsed}s (fresh clone @ ${headrev:0:12})"
    rm -rf "$CLONE"
  else
    echo "comparator-judge: PASS (IN-PLACE, iteration-grade — not authoritative) — $n_theorems theorems, ${elapsed}s"
  fi
else
  echo "comparator-judge: FAIL (exit $status, ${elapsed}s) — the judge did NOT accept" >&2
  [ "$MODE" = fresh ] && echo "comparator-judge: clone kept for inspection: $CLONE" >&2
fi
exit $status
