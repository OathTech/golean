#!/usr/bin/env bash
# The `unseq` scheduler gate (evaluation-order model v2.1 Stage B, lane
# core/unseq-scheduler-b-0916, 2026-09-16): hand-built graphs for every
# reference witness (docs/evidence/2026-09-16_eval-order-v2-spike/outcomes.txt)
# enumerated over ALL tapes by the existing enumerator/driver path and compared
# EXACTLY with the reference sets; refusals by name; replay tapes; singleton
# non-consumption. (The separate post-import axiom audit was removed in the
# 2026-10-12 gate cull, D3: the core totality audit covers every GoLean/ module.)
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
[[ $# = 0 ]] || { echo 'check-unseq-scheduler: expected no arguments' >&2; exit 2; }
. "$ROOT/scripts/typed-gate-scratch.sh"
scripts/capped lake build UnseqSchedulerTests
scripts/capped lake env lean --run Tests/UnseqScheduler.lean | tee "$gate_scratch/tests.log"
grep -q '^Unseq scheduler (Stage B): PASS' "$gate_scratch/tests.log"
printf '%s\n' 'Unseq scheduler gate: PASS'
