#!/usr/bin/env bash
# The gate, in two tiers (gate cull 2026-10-12, docs/2026-10-12_gate-cull-plan.md;
# the standing rule is CLAUDE.md «The gates»). Runs EVERY step even if one
# fails, then prints a summary and exits non-zero on any GATE failure.
#
#   scripts/ci          the fast tier — before any commit touching runtime code:
#                       oracle pin, escape-hatch scan, lake build of every
#                       target (warning-free), core totality audit, the Go and
#                       Lean unit tests, the lowering pins, and the baseline
#                       diff of the LAST recorded corpus runs.
#   scripts/ci --diff   the merge gate — the fast tier plus a FRESH run of the
#                       differential corpus (`go run` per case, every row, no
#                       cached tier) and the negative corpus, judged against
#                       the tracked baselines. Run it when you touched runtime
#                       code; a merge to main needs it green.
#
# Speedbumps (the document-vs-code consistency checks) run in both tiers under
# their own heading, REPORT-ONLY: a red one never fails the gate; it is read at
# the merge ask and fixed or waived there, by name. Self-tests of checkers
# (scripts/test-*) are not run here: run the one for a script you change.
#
# Fail-closed rules kept from the old gate: an unknown flag refuses; a step that
# cannot run is RED, never skipped; no recorded corpus run is a FAIL (unless
# GOLEAN_ALLOW_NO_DIFF=1 says this environment never records one); a partial
# run is reported as partial and never as a full certification.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

# Never interactive: no git call here or in a sub-script may page or open an
# editor (2026-10-11: `git grep` paged on a tty and looked like an editor).
export GIT_PAGER=cat PAGER=cat GIT_EDITOR=:

# MEMORY CAP: re-exec inside a proven cgroup before any work (an uncapped Lean
# elaboration took the box down twice, 2026-08-09). Only `verified` (the
# wrapper read the cap back) and `none` (a deliberate, warned opt-out) skip it.
case "${CAPPED_STATE:-${GOLEAN_CAPPED:-}}" in
  verified|none) ;;
  *) exec "$ROOT/scripts/capped" "$ROOT/scripts/ci" "$@" ;;
esac

RUN_DIFF=0
for arg in "$@"; do
  case "$arg" in
    --diff) RUN_DIFF=1 ;;
    --slow) echo "scripts/ci: --slow is RETIRED (gate cull 2026-10-12): no cached rows; --diff enumerates every row fresh" >&2
            exit 2 ;;
    # A mistyped flag must never silently downgrade the gate to a weaker one
    # that still prints PASS (2026-08-09: `--dif` ran the fast tier green).
    *) echo "scripts/ci: unknown argument '$arg' (expected --diff)" >&2; exit 2 ;;
  esac
done

# Scratch goes under the repo's own .tmp (the sandbox convention,
# docs/agent-sandbox.md); never a shared /tmp.
export TMPDIR="${TMPDIR:-$ROOT/.tmp}"
mkdir -p "$TMPDIR"
GOCACHE_DIR="$ROOT/artifacts/go-build-cache"

# Lean import matcher + comment stripper (IMPORT_RE, strip_lean_comments).
. "$ROOT/scripts/lean-scan.sh"

CI_STARTED_SECONDS=$SECONDS
finish_ci() {
  local rc=$?
  trap - EXIT
  printf 'CI total wall seconds: %s\n' "$((SECONDS - CI_STARTED_SECONDS))"
  exit "$rc"
}
trap finish_ci EXIT

fail=0
bumps_red=0
declare -a RESULTS BUMPS
step()     { printf '\n\033[1m── %s\033[0m\n' "$1"; }
ok()       { RESULTS+=("  ok   $1"); }
bad()      { RESULTS+=("  FAIL $1"); fail=1; }
note()     { RESULTS+=("  note $1"); }
bump_ok()  { BUMPS+=("  ok   $1"); }
bump_red() { BUMPS+=("  RED  $1"); bumps_red=$((bumps_red + 1)); }
# run_gate <label> <cmd...>: a blocking step. run_bump <label> <cmd...>: a
# speedbump, same shape, never sets fail. Both print the command's tail.
run_gate() {
  local label=$1 out rc=0; shift
  out="$("$@" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then printf '%s\n' "$out" | tail -2 | sed 's/^/  /'; ok "$label"
  else printf '%s\n' "$out" | tail -25 | sed 's/^/  /'; bad "$label (exit $rc — see above)"; fi
}
run_bump() {
  local label=$1 out rc=0; shift
  out="$("$@" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then printf '%s\n' "$out" | tail -1 | sed 's/^/  /'; bump_ok "$label"
  else printf '%s\n' "$out" | tail -15 | sed 's/^/  /'; bump_red "$label (exit $rc — see above)"; fi
}

if [ "$RUN_DIFF" -eq 1 ]; then MODE="--diff (merge gate)"; else MODE="fast tier"; fi
echo "scripts/ci mode: $MODE"

# ── Build parallelism, scaled to the memory cap (a performance knob, not a
# check): Lean's thread pool bounds the concurrent `lean` workers AND the
# per-file elaboration; peak memory is a sum of per-thread peaks, 8G/thread
# measured. A cold full build needs the 64G raise (capped -m 64G -- scripts/ci).
step "build parallelism (LEAN_NUM_THREADS from the memory cap)"
if [ -n "${LEAN_NUM_THREADS:-}" ]; then
  PAR_NOTE="LEAN_NUM_THREADS=$LEAN_NUM_THREADS (set by the caller — honoured as-is)"
else
  _mem="${CAPPED_MEM_MAX:-${GOLEAN_MEM_MAX:-32G}}"
  _gb=""
  case "$_mem" in
    none)  _num=""; _unit="" ;;
    *[Gg]) _num="${_mem%[Gg]}"; _unit=G ;;
    *[Mm]) _num="${_mem%[Mm]}"; _unit=M ;;
    *)     _num="$_mem"; _unit=B ;;
  esac
  case "$_num" in ''|*[!0-9]*) _num="" ;; esac
  if [ -n "$_num" ]; then
    case "$_unit" in G) _gb="$_num" ;; M) _gb=$(( _num / 1024 )) ;; B) _gb=$(( _num / 1073741824 )) ;; esac
  fi
  if [ -z "$_gb" ]; then
    PAR_NOTE="LEAN_NUM_THREADS unset (cap '$_mem' is not an integer size — toolchain default, $(nproc) cores)"
  else
    _jobs=$(( _gb / 8 )); [ "$_jobs" -lt 2 ] && _jobs=2
    export LEAN_NUM_THREADS="$_jobs"
    PAR_NOTE="cap $_mem -> LEAN_NUM_THREADS=$_jobs (cap/8G, floor 2; $(nproc) cores)"
    if [ "$_gb" -lt 64 ] && [ ! -d "$ROOT/.lake/build" ]; then
      PAR_NOTE="$PAR_NOTE; COLD build tree under a ${_mem} cap — measured need 64G+: capped -m 64G -- scripts/ci"
    fi
  fi
fi
echo "  $PAR_NOTE"
note "build parallelism: $PAR_NOTE"

# ── GATE: the oracle pin. Drift here moves the oracle under every differential.
step "oracle toolchain pin (baselines/go-oracle-pin)"
if [ -f baselines/go-oracle-pin ]; then
  go_pin="$(head -1 baselines/go-oracle-pin | tr -d '[:space:]')"
  if command -v go >/dev/null 2>&1; then
    go_live="$(go version | awk '{print $3}')"
    if [ "$go_live" = "$go_pin" ]; then ok "oracle toolchain ($go_live = pin)"
    elif [ "${GOLEAN_ALLOW_GO_DRIFT:-0}" = 1 ]; then note "oracle toolchain DRIFTED ($go_live != pin $go_pin) — GOLEAN_ALLOW_GO_DRIFT=1"
    else bad "oracle toolchain $go_live != pinned $go_pin (baselines/go-oracle-pin; GOLEAN_ALLOW_GO_DRIFT=1 to override loudly)"; fi
  else
    bad "go is not on PATH — the oracle pin is unverifiable and the gate's go tests cannot run"
  fi
else
  bad "baselines/go-oracle-pin missing — the oracle pin is unverifiable"
fi

# ── GATE: the escape-hatch scan over GoLean/ (the charter: the semantic core is
# total). Text scans on code with comments stripped; the machine check is the
# core totality audit below. One step, four scans.
step "escape-hatch scan (sorry/admit/native_decide/axiom; unsafe/opaque/implemented_by; decide +native; partial in GoLean/GoCore/; core imports no EnumDedup)"
scan_bad=0
[ -d GoLean ] || { bad "escape-hatch scan: GoLean/ missing — the scan would be vacuous"; scan_bad=1; }
hatch="$(find GoLean GoLean.lean Main.lean -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null \
         | xargs -0 grep -nE 'sorry|admit|native_decide|ofReduceBool|^[[:space:]]*axiom ' 2>/dev/null \
         | sed -E 's/--.*$//; s@/-([^-]|-+[^/-])*-+/@@g' \
         | grep -E 'sorry|\badmit\b|native_decide|ofReduceBool|^[^:]*:[0-9]*:[[:space:]]*axiom ' \
         | grep -vE '/-|`(sorry|sorryAx|admit|native_decide|ofReduceBool|axiom)`|no sorry|without .*sorry|axioms:' \
         || true)"
if [ -n "$hatch" ]; then echo "$hatch"; bad "escape-hatch scan: sorry/admit/native_decide/axiom in the semantic core (lines above)"; scan_bad=1; fi
meta_hatch=""
nat_hatch=""
part_hatch=""
while IFS= read -r -d '' f; do
  code="$(strip_lean_comments < "$f")"
  hits="$(printf '%s\n' "$code" | grep -nE \
      '(^|[[:space:]])unsafe([[:space:]]+(def|abbrev|instance|structure|inductive|theorem|example)\b|[[:space:]]*$)|(^|[[:space:]])opaque([[:space:]]+[A-Za-z_]|[[:space:]]*$)|@\[[^]]*implemented_by' || true)"
  [ -n "$hits" ] && meta_hatch="${meta_hatch}$(printf '%s\n' "$hits" | sed "s|^|${f}:|")"$'\n'
  hits="$(printf '%s\n' "$code" | grep -nE 'decide[[:space:]]*\+[[:space:]]*native|decide[[:space:]]*\([[:space:]]*config[[:space:]]*:=[^)]*native[[:space:]]*:=[[:space:]]*true' || true)"
  [ -n "$hits" ] && nat_hatch="${nat_hatch}$(printf '%s\n' "$hits" | sed "s|^|${f}:|")"$'\n'
  case "$f" in GoLean/GoCore/*)
    hits="$(printf '%s\n' "$code" | grep -nE '(^|[[:space:]])partial[[:space:]]+(def|theorem|instance|abbrev)\b' || true)"
    [ -n "$hits" ] && part_hatch="${part_hatch}$(printf '%s\n' "$hits" | sed "s|^|${f}:|")"$'\n' ;;
  esac
done < <(find GoLean GoLean.lean Main.lean -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null)
if [ -n "$meta_hatch" ]; then printf '%s' "$meta_hatch"; bad "escape-hatch scan: unsafe/opaque/implemented_by in GoLean/ (the compiled behaviour may diverge from the logical content)"; scan_bad=1; fi
if [ -n "$nat_hatch" ]; then printf '%s' "$nat_hatch"; bad "escape-hatch scan: a native-decision spelling (same class as native_decide)"; scan_bad=1; fi
if [ -n "$part_hatch" ]; then printf '%s' "$part_hatch"; bad "escape-hatch scan: partial declaration in GoLean/GoCore/ (the semantic core uses structural/well-founded recursion)"; scan_bad=1; fi
if [ -f GoLean/EnumDedup.lean ]; then
  eng_bad=0
  while IFS= read -r -d '' ef; do
    eng_hits="$(grep -nE "${IMPORT_RE}GoLean\.EnumDedup([^A-Za-z].*)?\$" "$ef")"; eng_rc=$?
    if [ "$eng_rc" -ge 2 ]; then echo "  engine-isolation scan ERRORED on $ef (rc=$eng_rc) — failing closed" >&2; eng_bad=1
    elif [ "$eng_rc" -eq 0 ]; then printf '%s\n' "$eng_hits" | sed "s|^|$ef:|"; eng_bad=1; fi
  done < <( { find GoLean/GoCore -name '*.lean' -not -path '*/.lake/*' -print0; printf 'GoLean/GoCore.lean\0'; } )
  if [ "$eng_bad" -ne 0 ]; then bad "escape-hatch scan: the semantic core imports the untrusted dedup engine, or the scan could not run (CLI-only by design)"; scan_bad=1; fi
else
  bad "escape-hatch scan: GoLean/EnumDedup.lean missing (deleted or renamed without re-pointing this clause?)"; scan_bad=1
fi
[ "$scan_bad" -eq 0 ] && { echo "  clean"; ok "escape-hatch scan (clean)"; }

# ── SPEEDBUMPS: document-vs-code consistency, static, seconds. Report-only.
step "speedbumps (report-only — a RED is read at the merge ask and fixed or waived by name)"
run_bump "bugs index = baseline (scripts/check-bugs.sh)" ./scripts/check-bugs.sh
run_bump "feature tags, no dead tag (scripts/check-coverage)" ./scripts/check-coverage
run_bump "spec anchors resolve at the pin (scripts/check-spec-anchors)" ./scripts/check-spec-anchors
run_bump "stdlib admission register = frontend tables (scripts/check-stdlib-register)" ./scripts/check-stdlib-register
run_bump "AGENTS.md is the alias of CLAUDE.md (scripts/check-agents-alias)" ./scripts/check-agents-alias
run_bump "imported-goose verbatim at the pin (scripts/check-imported-goose)" ./scripts/check-imported-goose
run_bump "memory-module raw call sites = inventory (scripts/check-mem-callsites)" bash scripts/check-mem-callsites
run_bump "pool spec freeze + staged discharge (scripts/check-pool-spec)" python3 scripts/check-pool-spec

# ── GATE: the build of every target. Warning-free, because a GoLean/ warning
# replays into the runner's stdout and corrupts the JSON observation channel
# (the 2026-07-23 phantom-drift incident). Tests/ is in the watch too (audit
# item 5, 2026-10-12): a `sorry` in a test module is a warning, and the cold
# build of 2026-10-12 (163 jobs, 64G cap, 8 min 37 s) had zero warnings
# anywhere, so the wider watch costs nothing today.
step "lake build (every library and executable; warning-free)"
core_out="$(scripts/capped lake build 2>&1)"; core_rc=$?
echo "$core_out" | tail -3 | sed 's/^/  /'
core_warns="$(echo "$core_out" | grep -E '^warning: (GoLean/|GoLean\.lean|Main\.lean|Tests/)' || true)"
if [ "$core_rc" -ne 0 ]; then bad "lake build (exit $core_rc)"
elif [ -n "$core_warns" ]; then echo "$core_warns" | head -10; bad "lake build has GoLean/ or Tests/ warnings (a GoLean/ warning corrupts the runner JSON channel; a Tests/ one is a sorry or a dead declaration)"
else ok "lake build (every target, warning-free)"; fi

# Every Tests/ module must be named by a lakefile.toml glob, or the build above
# skipped it silently (D2: this set check replaces the receipt registry).
step "lakefile ownership (every Tests/*.lean in a glob; every declared target a default target)"
tests_unowned=""
for tf in Tests/*.lean; do
  tm="Tests.$(basename "$tf" .lean)"
  grep -q "\"$tm\"" lakefile.toml || tests_unowned="$tests_unowned $tm"
done
if [ -z "$tests_unowned" ]; then ok "Tests/ library ownership (every module named by a lakefile glob)"
else echo "  not in any lakefile.toml glob:$tests_unowned" >&2; bad "Tests/ library ownership (unowned:$tests_unowned — add to a lakefile.toml glob)"; fi
# ...and every library and executable the lakefile declares is a default
# target, or the build above skipped it silently (audit 2026-10-12, item 3).
lf_targets="$(tr -d '\n' < lakefile.toml | sed -n 's/.*defaultTargets = \[\([^]]*\)\].*/\1/p')"
lf_missing=""
for nm in $(grep -E '^name = "' lakefile.toml | sed -E 's/^name = "([^"]+)"/\1/'); do
  case "$lf_targets" in *"\"$nm\""*) ;; *) lf_missing="$lf_missing $nm" ;; esac
done
if [ -z "$lf_targets" ]; then bad "lakefile targets (defaultTargets could not be read — the build's target set is unverifiable)"
elif [ -z "$lf_missing" ]; then ok "lakefile targets (every declared library and executable is a default target)"
else echo "  declared but not in defaultTargets:$lf_missing" >&2; bad "lakefile targets (not built by the default build:$lf_missing — add to defaultTargets)"; fi

# ── GATE: the machine check of totality — a harness imports every GoLean/
# module and audits every declaration (classical trio only; required core
# theorems present; abort-text helpers constructive).
step "core totality audit (scripts/check-core-audit)"
run_gate "core totality audit (every GoLean/ module; required core theorems)" bash scripts/check-core-audit

# ── GATE: the Go-side unit tests — the lowering's own tests and the lowering
# tables, then the oracle observer (-count=1: its inertness test execs the
# pinned `go run`, which the test cache cannot key).
step "go tests (tools/nativefrontend, tools/lowerdiag, tools/coverageharness)"
run_gate "frontend + lowering-table unit tests (go test ./tools/nativefrontend ./tools/lowerdiag)" \
  env GO111MODULE=off GOCACHE="$GOCACHE_DIR" go test ./tools/nativefrontend ./tools/lowerdiag
run_gate "coverage-harness unit tests (go test -count=1 ./tools/coverageharness)" \
  env GO111MODULE=off GOCACHE="$GOCACHE_DIR" go test -count=1 ./tools/coverageharness

# ── GATE: the interpreter's unit tests. A gutted exe exiting 0 with no output
# is a degenerate run, not a pass.
step "interpreter eval tests (gocore-eval-tests)"
evout="$(scripts/capped lake exe gocore-eval-tests 2>&1)"; evrc=$?
evok="$(printf '%s\n' "$evout" | grep -c '^ok:')"
evbad="$(printf '%s\n' "$evout" | grep -icE '^(not ok|fail)')"
echo "  ok:$evok  fail:$evbad  exit:$evrc"
if [ "$evrc" -eq 0 ] && [ "$evbad" -eq 0 ] && [ "$evok" -gt 0 ]; then ok "eval tests ($evok ok)"
else printf '%s\n' "$evout" | grep -iE '^(not ok|fail)' | head -10; bad "eval tests (exit $evrc, $evbad bad, $evok ok — zero ok is a degenerate run)"; fi

# ── GATE: the lowering and decoder boundary, and the relational product's
# equation API — each its own script, each fail-closed.
step "unseq wire, Stage C (scripts/check-unseq-wire)"
run_gate "unseq wire (wires from bytes vs reference sets; decoder mutants refused by name)" bash scripts/check-unseq-wire
step "wire boundary (scripts/check-wire-boundary)"
run_gate "wire boundary (byte-level controls through the real CLI)" bash scripts/check-wire-boundary
step "method identity (scripts/check-method-identity)"
run_gate "package-correct method identity (fresh wire, strict decoder)" bash scripts/check-method-identity
step "frontend pins (scripts/check-frontend-pins)"
run_gate "frontend pins (init-order deviation observation + raft twin wire, byte-exact)" ./scripts/check-frontend-pins
step "declaration boundary (scripts/check-declarations)"
run_gate "declaration boundary (Go identity, strict JSON, Unicode table = oracle, fixture pin)" bash scripts/check-declarations
step "semantic equations (scripts/check-equations)"
run_gate "semantic equations (client PASS, exhaustive enrollment, no-unfold guard, import whitelist)" bash scripts/check-equations

# ── --diff: the fresh corpus runs. Exit 1 from a runner = some cases FAIL
# (judged by the baseline step below); >= 2 = the run itself broke.
if [ "$RUN_DIFF" -eq 1 ]; then
  step "differential corpus, fresh run of every row (scripts/diff-coverage)"
  ./scripts/diff-smoke 2>&1 | tail -3 | sed 's/^/  /'; drc=${PIPESTATUS[0]}
  case "$drc" in
    0|1) ok "differential run completed (exit $drc; the failing set is judged by the baseline diff)" ;;
    *)   bad "differential run BROKE (exit $drc — not a case failure; see output)" ;;
  esac
  step "negative corpus, fresh run (scripts/coverage-negative: gc rejects AND the native frontend refuses as a rejection)"
  ./scripts/coverage-negative 2>&1 | tail -2 | sed 's/^/  /'; nrc=${PIPESTATUS[0]}
  case "$nrc" in
    0|1) ok "negative run completed (exit $nrc; judged by the baseline diff)" ;;
    *)   bad "negative run BROKE (exit $nrc)" ;;
  esac
  step "unseq scheduler, Stage B (scripts/check-unseq-scheduler — enumerates whole tape spaces)"
  run_gate "unseq scheduler (reference sets over all tapes, named refusals, replay)" bash scripts/check-unseq-scheduler

  # Speedbump: two tracked files are GENERATED from the oracle and consumed as
  # bytes (Tests/FloatVectors.lean by the eval tests; inittask-std.tsv by the
  # frontend). Regenerate and compare; a difference is an edit or a stale pin.
  step "derived oracle artifacts regenerate byte-identical (speedbump)"
  derive_tmp="$(mktemp -d "${TMPDIR%/}/golean-derived-guard.XXXXXX")"
  if GOCACHE="$GOCACHE_DIR" GO111MODULE=off go run ./tools/floatvectors > "$derive_tmp/fv.lean" 2>"$derive_tmp/fv.err"; then
    if cmp -s "$derive_tmp/fv.lean" Tests/FloatVectors.lean; then bump_ok "Tests/FloatVectors.lean = fresh regeneration (byte-exact)"
    else cmp "$derive_tmp/fv.lean" Tests/FloatVectors.lean 2>&1 | head -3 | sed 's/^/  /'; bump_red "Tests/FloatVectors.lean DIFFERS from a fresh tools/floatvectors run (edited or stale — regenerate deliberately)"; fi
  else tail -5 "$derive_tmp/fv.err" | sed 's/^/  /'; bump_red "FloatVectors regeneration FAILED (the check could not run)"; fi
  it_pin="$(head -1 baselines/go-oracle-pin 2>/dev/null | tr -d '[:space:]')"
  it_hdr="$(grep -m1 '^# toolchain:' tools/nativefrontend/inittask-std.tsv 2>/dev/null | awk '{print $3}')"
  if [ -z "$it_hdr" ] || [ -z "$it_pin" ] || [ "$it_hdr" != "$it_pin" ]; then
    bump_red "inittask-std.tsv header toolchain [${it_hdr:-missing}] != oracle pin [${it_pin:-missing}] — not regenerated for this pin"
  elif scripts/gen-inittask-table -o "$derive_tmp/it.tsv" > "$derive_tmp/it.out" 2>&1; then
    grep -v '^# generated:' "$derive_tmp/it.tsv" > "$derive_tmp/it.fresh"
    grep -v '^# generated:' tools/nativefrontend/inittask-std.tsv > "$derive_tmp/it.tracked"
    if cmp -s "$derive_tmp/it.fresh" "$derive_tmp/it.tracked"; then bump_ok "inittask-std.tsv = fresh regeneration (header at pin; byte-exact modulo the date line)"
    else diff "$derive_tmp/it.fresh" "$derive_tmp/it.tracked" 2>&1 | head -5 | sed 's/^/  /'; bump_red "tools/nativefrontend/inittask-std.tsv DIFFERS from a fresh scripts/gen-inittask-table run"; fi
  else tail -5 "$derive_tmp/it.out" | sed 's/^/  /'; bump_red "inittask-std.tsv regeneration FAILED (the check could not run)"; fi
  rm -rf "$derive_tmp"
fi

# ── GATE: the baselines. judge_record judges a recorded corpus run against its
# tracked baseline, after checking the record is ATTRIBUTABLE: a meta file, the
# oracle of record (no toolchain drift), and for a full run a manifest sha equal
# to the manifest regenerated from the CURRENT corpus. A partial run is a note
# in the fast tier and a FAIL under --diff. No record is a FAIL.
# The 7th argument is the baseline's column format for
# scripts/coverage-baseline-diff: `cause` (result,id,stage,cause — the
# differential baseline's refusal-cause column, release-readiness item 8)
# or `no-cause` (result,id,stage — the negative baseline). Explicit per
# call, never inferred from the file.
judge_record() {  # <kind> <latest.tsv> <meta.tsv> <baseline> <manifest-cmd> <demand-full 0|1> <cause|no-cause>
  local kind=$1 latest=$2 meta=$3 baseline=$4 manifest_cmd=$5 demand_full=$6 colfmt=$7
  local -a fmt_flag=()
  case "$colfmt" in
    cause) ;;
    no-cause) fmt_flag=(--no-cause) ;;
    *) bad "$kind baseline diff (internal: judge_record column format '$colfmt' is neither cause nor no-cause)"; return ;;
  esac
  local ran total runcommit head stale="" drift tool dirty meta_sha cur_sha rc=0
  if [ ! -f "$latest" ]; then
    if [ -n "${GOLEAN_ALLOW_NO_DIFF:-}" ]; then note "$kind baseline diff NOT RUN (no record; GOLEAN_ALLOW_NO_DIFF set — this environment never records one)"
    else echo "  no $latest" >&2; bad "$kind baseline diff (NO recorded run — nothing has checked the corpus; run scripts/ci --diff, or GOLEAN_ALLOW_NO_DIFF=1 where none is ever recorded)"; fi
    return
  fi
  [ -f "$meta" ] || { bad "$kind baseline diff ($latest has NO meta — unattributable results; re-run scripts/ci --diff)"; return; }
  ran="$(awk -F'\t' '!/^#/ && $1!="result" && NF>=2' "$latest" | wc -l | tr -d ' ')"
  total="$($manifest_cmd 2>/dev/null | wc -l | tr -d ' ')"
  [ "$total" -gt 0 ] || { bad "$kind baseline diff (the manifest could not be regenerated — attribution unverifiable; run $manifest_cmd by hand)"; return; }
  runcommit="$(awk -F'\t' '$1=="git_commit"{print $2}' "$meta")"; head="$(git rev-parse HEAD 2>/dev/null)"
  [ -n "$runcommit" ] && [ "$runcommit" != unknown ] && [ "$runcommit" != "$head" ] && stale=" [recorded at ${runcommit:0:7}, HEAD is ${head:0:7} — stale]"
  drift="$(awk -F'\t' '$1=="go_drift_actual"{print $2}' "$meta")"; [ -z "$drift" ] && drift="$(awk -F'\t' '$1=="go_drift"{print $2}' "$meta")"
  tool="$(awk -F'\t' '$1=="go_toolchain"{print $2}' "$meta")"; dirty="$(awk -F'\t' '$1=="git_dirty"{print $2}' "$meta")"
  if [ -z "$drift" ]; then note "$kind record has no go_drift field (pre-provenance record) — oracle-of-record status unverifiable; re-run scripts/ci --diff"
  elif [ "$drift" != 0 ] && [ "$drift" != false ]; then
    if [ "${GOLEAN_ALLOW_GO_DRIFT:-0}" = 1 ]; then note "$kind record was made under a DRIFTED toolchain (${tool:-unknown}) — judged anyway, NOT the oracle of record"
    else bad "$kind baseline diff (recorded run used a DRIFTED toolchain ${tool:-unknown} — not the oracle of record; re-run at the pin)"; return; fi
  fi
  if [ "$ran" -ge "$total" ]; then
    meta_sha="$(awk -F'\t' '$1=="manifest_sha256"{print $2}' "$meta")"
    cur_sha="$($manifest_cmd 2>/dev/null | shasum -a 256 | awk '{print $1}')"
    if [ -z "$meta_sha" ] || [ -z "$cur_sha" ] || [ "$meta_sha" != "$cur_sha" ]; then
      bad "$kind baseline diff (meta manifest_sha256 [${meta_sha:-missing}] != the current corpus manifest — stale/foreign results; re-run scripts/ci --diff)"; return
    fi
    ./scripts/coverage-baseline-diff --full ${fmt_flag[@]+"${fmt_flag[@]}"} --baseline "$baseline" "$latest" || rc=$?
    if [ "$rc" -ge 2 ]; then bad "$kind baseline diff (REFUSED / could not judge, exit $rc — NOT a drift verdict)"
    elif [ "$rc" -eq 1 ]; then bad "$kind baseline diff (DRIFT vs $baseline — see above)"
    elif [ "$dirty" = true ]; then note "$kind baseline diff FULL ($ran/$total, no regression) but recorded on a DIRTY tree — certifies that worktree state, not a commit$stale"
    else ok "$kind baseline diff FULL ($ran/$total, no regression)$stale"; fi
  elif [ "$demand_full" -eq 1 ]; then
    bad "$kind baseline diff (--diff demanded a full run but the record is PARTIAL: $ran/$total)"
  else
    ./scripts/coverage-baseline-diff ${fmt_flag[@]+"${fmt_flag[@]}"} --baseline "$baseline" "$latest" || rc=$?
    if [ "$rc" -ge 2 ]; then bad "$kind baseline diff (REFUSED / could not judge, exit $rc — NOT a drift verdict)"
    elif [ "$rc" -eq 1 ]; then bad "$kind baseline diff (DRIFT among the $ran cases run — see above)"
    else note "$kind baseline diff PARTIAL ($ran/$total run, no drift among them — NOT a full certification; use --diff)$stale${dirty:+ [git_dirty=$dirty]}"; fi
  fi
}
step "baselines: the recorded negative run vs baselines/negative-full.tsv"
judge_record negative artifacts/coverage/negative-latest.tsv artifacts/coverage/negative-latest.meta.tsv baselines/negative-full.tsv ./scripts/coverage-negative-manifest "$RUN_DIFF" no-cause
step "baselines: the recorded differential run vs baselines/native-full.tsv"
judge_record differential artifacts/coverage/latest.tsv artifacts/coverage/latest.meta.tsv baselines/native-full.tsv ./scripts/coverage-manifest "$RUN_DIFF" cause
# Speedbump (D5 of the refusal-cause note, [USER]-approved 2026-10-12): an
# unclassified cause key (`fe?:<head>`, `<status>:?`) is pinned by the
# baseline like any other, and REPORTED here so the classifier tables
# (tools/lowerdiag/causes.tsv, scripts/machine-causes.tsv) catch up.
if [ -f artifacts/coverage/latest.tsv ]; then
  run_bump "every FAIL row's refusal cause classified (scripts/coverage-cause --unclassified)" ./scripts/coverage-cause --unclassified artifacts/coverage/latest.tsv
fi

# ── GATE: the re-pin guard. A re-pin that flips a case PASS -> non-PASS must
# list it on a `- Cases:` line in docs/BUGS.md; a stage alternation of the old
# baseline must survive unless the new one names its removal. Dirty tree:
# worktree vs HEAD; clean tree: HEAD vs HEAD~1 (a shallow clone fails closed).
repin_guard() {  # <baseline file>
  local base=$1 wt_rc c_rc mode old newfile oldbase newbase flips awk_rc id nfl pin_bad=0 surv_new surv_rc=0 surv_out
  git diff --quiet HEAD -- "$base" 2>/dev/null; wt_rc=$?
  if [ "$wt_rc" -eq 1 ]; then mode="worktree-vs-HEAD"; old=HEAD; newfile="$base"
  elif [ "$wt_rc" -ge 2 ]; then bad "re-pin guard ($base: git diff errored rc=$wt_rc — refusing to certify)"; return
  elif git rev-parse --verify -q HEAD~1 >/dev/null 2>&1; then
    git diff --quiet HEAD~1 HEAD -- "$base" 2>/dev/null; c_rc=$?
    if [ "$c_rc" -eq 1 ]; then mode="HEAD-vs-HEAD~1"; old=HEAD~1; newfile=""
    elif [ "$c_rc" -ge 2 ]; then bad "re-pin guard ($base: git diff errored rc=$c_rc comparing HEAD~1 — refusing to certify)"; return
    else ok "re-pin guard ($base unchanged at the tip)"; return; fi
  else bad "re-pin guard ($base: shallow clone, HEAD~1 unavailable — the tip is UNVERIFIABLE; fetch with depth >= 2)"; return; fi
  echo "  $base: $mode"
  if ! git cat-file -e "$old:$base" 2>/dev/null; then ok "re-pin guard ($base: initial pin at $old — no prior baseline, nothing to launder)"; return; fi
  oldbase="$(git show "$old:$base" 2>/dev/null)" || { bad "re-pin guard (could not read $old:$base — refusing to certify)"; return; }
  if [ -n "$newfile" ]; then newbase="$(cat "$newfile")"; else newbase="$(git show "HEAD:$base" 2>/dev/null)"; fi
  [ -n "$newbase" ] || { bad "re-pin guard (could not read the new $base — refusing to certify)"; return; }
  flips="$(printf '===OLD===\n%s\n===NEW===\n%s\n' "$oldbase" "$newbase" | awk -F'\t' '
    /^===OLD===$/ { sec = 1; next }
    /^===NEW===$/ { sec = 2; next }
    /^#/ { next }
    sec == 1 && $1 == "PASS" && NF >= 2 { oldpass[$2] = 1 }
    sec == 2 && $1 == "PASS" && NF >= 2 { nowpass[$2] = 1 }
    END { for (id in oldpass) if (!(id in nowpass)) print id }')"; awk_rc=$?
  [ "$awk_rc" -eq 0 ] || { bad "re-pin guard ($base: internal comparison error rc=$awk_rc — refusing to certify)"; return; }
  flips="$(printf '%s\n' "$flips" | LC_ALL=C sort | grep -v '^$' || true)"
  while read -r id; do
    [ -z "$id" ] && continue
    awk -v id="$id" '
      /^- Cases:/ { line = substr($0, 9); n = split(line, a, /[, ]+/); for (i = 1; i <= n; i++) if (a[i] == id) found = 1 }
      END { exit !found }' docs/BUGS.md || { echo "  PASS→non-PASS flip not on any BUGS.md Cases: line: $id"; pin_bad=1; }
  done <<< "$flips"
  nfl="$(printf '%s' "$flips" | grep -c . || true)"
  if [ "$pin_bad" -ne 0 ]; then bad "re-pin guard ($base: regressions baked into the baseline unexplained — add them to a BUGS.md Cases: line)"
  else ok "re-pin guard ($base: $nfl PASS→non-PASS flip(s), all on BUGS.md Cases lines)"; fi
  if [ -n "$newfile" ]; then surv_new="$newfile"; else surv_new="git:HEAD:$base"; fi
  surv_out="$(./scripts/check-alternation-survival "git:$old:$base" "$surv_new" 2>&1)" || surv_rc=$?
  if [ "$surv_rc" -eq 0 ]; then [ -n "$surv_out" ] && printf '%s\n' "$surv_out" | sed 's/^/  /'
  else printf '%s\n' "$surv_out" | sed 's/^/  /'; bad "re-pin guard ($base: a stage alternation of $old dropped without a named removal, or the check could not run — exit $surv_rc)"; fi
}
step "baseline re-pin guard (PASS→non-PASS flips must be on a BUGS.md Cases: line; alternations survive)"
repin_guard baselines/native-full.tsv
repin_guard baselines/negative-full.tsv

# ── Summary. Gate lines decide RESULT; speedbumps are listed, never decide.
printf '\n\033[1m══ scripts/ci summary (%s) ══\033[0m\n' "$MODE"
printf '%s\n' "${RESULTS[@]}"
printf '\n\033[1m── speedbumps (report-only) ──\033[0m\n'
printf '%s\n' "${BUMPS[@]}"
if [ "$bumps_red" -gt 0 ]; then
  printf '\nSPEEDBUMPS: %s RED — not a gate failure; read at the merge ask, fix or waive by name\n' "$bumps_red"
fi
if [ "$fail" -ne 0 ]; then
  printf '\n\033[1mRESULT: FAIL\033[0m\n'; exit 1
fi
printf '\n\033[1mRESULT: PASS\033[0m\n'
