#!/usr/bin/env bash
# The gate, in two tiers (gate cull 2026-10-12, docs/2026-10-12_gate-cull-plan.md;
# the standing rule is CLAUDE.md «The gates»). Runs EVERY step even if one
# fails, then prints a summary and exits non-zero on any GATE failure.
#
#   scripts/ci          the fast tier — before any commit touching runtime code:
#                       oracle pin, escape-hatch scan, lake build of every
#                       target (warning-free), kernel replay of the built
#                       GoLean oleans, core totality audit, the Go and
#                       Lean unit tests, the lowering pins, and the baseline
#                       diff of the LAST recorded corpus runs.
#   scripts/ci --diff   the merge gate — the fast tier plus a FRESH run of the
#                       differential corpus (`go run` per case, every row, no
#                       cached tier) and the negative corpus, judged against
#                       the tracked baselines, and the `lake check` and
#                       `lake comparator` speedbumps.
#                       Run it when you touched runtime code; a merge to main
#                       needs it green.
#
# Speedbumps (the document-vs-code consistency checks in both tiers; under
# --diff also the derived-artifact regeneration, `lake check` (about four
# minutes) and `lake comparator` (the kept customer surface against its frozen
# challenge, scripts/check-comparator)) run under their own heading, REPORT-ONLY: a red one never fails the
# gate; it is read at the merge ask and fixed or waived there, by name.
# Self-tests of checkers (scripts/test-*) are not run here: run the one for a
# script you change.
#
# Fail-closed rules kept from the old gate: an unknown flag refuses; a step that
# cannot run is RED, never skipped; no recorded corpus run is a FAIL (unless
# GOLEAN_ALLOW_NO_DIFF=1 says this environment never records one); a partial
# run is reported as partial and never as a full certification.
set -uo pipefail
# One collation and byte-wise character classes for every comparison, sort and pattern here
# (deep-clean review DC19, 2026-10-26): the gate's verdict must not depend on the caller's locale.
export LC_ALL=C

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT" || { echo "scripts/ci: cannot cd to $ROOT" >&2; exit 1; }

# Never interactive: no git call here or in a sub-script may page or open an
# editor (2026-10-11: `git grep` paged on a tty and looked like an editor).
export GIT_PAGER=cat PAGER=cat GIT_EDITOR=:

# MEMORY CAP: every heavy step below runs through `cap` (scripts/cap.sh): the
# box tool `capped` when it is on PATH, the bare command otherwise — the cap
# is box tooling, detected at run time, never shipped (release-readiness row
# 46, [USER] 2026-10-21). `capped scripts/ci` runs the whole gate in one
# cgroup (the inner calls exec through); a bare `scripts/ci` caps each heavy
# step by itself; a machine without the tool runs uncapped. The limit is
# CAPPED_MEM_MAX (the box tool's own variable; default 32G).
. "$ROOT/scripts/cap.sh"

RUN_DIFF=0
for arg in "$@"; do
  case "$arg" in
    --diff) RUN_DIFF=1 ;;
    --slow) echo "scripts/ci: --slow is RETIRED (gate cull 2026-10-12): no cached rows; --diff enumerates every row fresh" >&2
            exit 2 ;;
    # A mistyped flag must never silently downgrade the gate to a weaker one
    # that still prints PASS (2026-08-09: `--dif` ran the fast tier green).
    *) echo "scripts/ci: unknown argument '$arg' (expected --diff)" >&2; exit 2 ;;
  esac
done

# Scratch goes under the repo's own .tmp (the sandbox convention,
# docs/agent-sandbox.md); never a shared /tmp.
export TMPDIR="${TMPDIR:-$ROOT/.tmp}"
mkdir -p "$TMPDIR"
GOCACHE_DIR="$ROOT/artifacts/go-build-cache"

# Lean import matcher + comment stripper (IMPORT_RE, strip_lean_comments).
. "$ROOT/scripts/lean-scan.sh"
. "$ROOT/scripts/lakefile-targets.sh"

CI_STARTED_SECONDS=$SECONDS
finish_ci() {
  local rc=$?
  trap - EXIT
  printf 'CI total wall seconds: %s\n' "$((SECONDS - CI_STARTED_SECONDS))"
  exit "$rc"
}
trap finish_ci EXIT

fail=0
bumps_red=0
declare -a RESULTS BUMPS
step()     { printf '\n\033[1m── %s\033[0m\n' "$1"; }
ok()       { RESULTS+=("  ok   $1"); }
bad()      { RESULTS+=("  FAIL $1"); fail=1; }
note()     { RESULTS+=("  note $1"); }
bump_ok()  { BUMPS+=("  ok   $1"); }
bump_red() { BUMPS+=("  RED  $1"); bumps_red=$((bumps_red + 1)); }
# run_gate <label> <cmd...>: a blocking step. run_bump <label> <cmd...>: a
# speedbump, same shape, never sets fail. Both print the command's tail.
run_gate() {
  local label=$1 out rc=0; shift
  out="$("$@" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then printf '%s\n' "$out" | tail -2 | sed 's/^/  /'; ok "$label"
  else printf '%s\n' "$out" | tail -25 | sed 's/^/  /'; bad "$label (exit $rc — see above)"; fi
}
run_bump() {
  local label=$1 out rc=0; shift
  out="$("$@" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then printf '%s\n' "$out" | tail -1 | sed 's/^/  /'; bump_ok "$label"
  else printf '%s\n' "$out" | tail -15 | sed 's/^/  /'; bump_red "$label (exit $rc — see above)"; fi
}

if [ "$RUN_DIFF" -eq 1 ]; then MODE="--diff (merge gate)"; else MODE="fast tier"; fi
echo "scripts/ci mode: $MODE"

# ── The cap in force, and build parallelism scaled to it (a performance
# knob, not a check — scripts/cap.sh, cap_lean_threads: LEAN_NUM_THREADS =
# cap/8G, floor 2, from CAPPED_MEM_MAX, default 32G, unless the caller set
# it). A cold full build needs 64G (CAPPED_MEM_MAX=64G scripts/ci).
step "memory cap and build parallelism (LEAN_NUM_THREADS from CAPPED_MEM_MAX)"
CAP_NOTE="$(cap_note)"
echo "  $CAP_NOTE"
note "memory cap: $CAP_NOTE"
cap_lean_threads
PAR_NOTE="$CAP_THREADS_NOTE; $(nproc) cores"
if [ -n "$CAP_MEM_GB" ] && [ "$CAP_MEM_GB" -lt 64 ] && [ ! -d "$ROOT/.lake/build" ]; then
  PAR_NOTE="$PAR_NOTE; COLD build tree under a ${CAPPED_MEM_MAX:-32G} cap — measured need 64G+: CAPPED_MEM_MAX=64G scripts/ci"
fi
echo "  $PAR_NOTE"
note "build parallelism: $PAR_NOTE"

# ── GATE: the oracle pin. Drift here moves the oracle under every differential.
step "oracle toolchain pin (baselines/go-oracle-pin)"
if [ -f baselines/go-oracle-pin ]; then
  go_pin="$(head -1 baselines/go-oracle-pin | tr -d '[:space:]')"
  if command -v go >/dev/null 2>&1; then
    go_live="$(go version | awk '{print $3}')"
    if [ "$go_live" = "$go_pin" ]; then ok "oracle toolchain ($go_live = pin)"
    elif [ "${GOLEAN_ALLOW_GO_DRIFT:-0}" = 1 ]; then note "oracle toolchain DRIFTED ($go_live != pin $go_pin) — GOLEAN_ALLOW_GO_DRIFT=1"
    else bad "oracle toolchain $go_live != pinned $go_pin (baselines/go-oracle-pin; GOLEAN_ALLOW_GO_DRIFT=1 to override loudly)"; fi
  else
    bad "go is not on PATH — the oracle pin is unverifiable and the gate's go tests cannot run"
  fi
else
  bad "baselines/go-oracle-pin missing — the oracle pin is unverifiable"
fi

# ── GATE: the escape-hatch scan over GoLean/ (the charter: the semantic core is
# total). Text scans on code with comments stripped; the machine check is the
# core totality audit below. One step, four scans.
step "escape-hatch scan (sorry/admit/native_decide/axiom; unsafe/opaque/implemented_by/extern; decide +native; partial in GoLean/GoCore/; core imports no EnumDedup)"
scan_bad=0
[ -d GoLean ] || { bad "escape-hatch scan: GoLean/ missing — the scan would be vacuous"; scan_bad=1; }
hatch="$(find GoLean GoLean.lean Main.lean -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null \
         | xargs -0 grep -nE 'sorry|admit|native_decide|ofReduceBool|^[[:space:]]*axiom ' 2>/dev/null \
         | sed -E 's/--.*$//; s@/-([^-]|-+[^/-])*-+/@@g' \
         | grep -E 'sorry|\badmit\b|native_decide|ofReduceBool|^[^:]*:[0-9]*:[[:space:]]*axiom ' \
         | grep -vE '/-|`(sorry|sorryAx|admit|native_decide|ofReduceBool|axiom)`|no sorry|without .*sorry|axioms:' \
         || true)"
if [ -n "$hatch" ]; then echo "$hatch"; bad "escape-hatch scan: sorry/admit/native_decide/axiom in the semantic core (lines above)"; scan_bad=1; fi
meta_hatch=""
nat_hatch=""
part_hatch=""
while IFS= read -r -d '' f; do
  code="$(strip_lean_comments < "$f")"
  hits="$(printf '%s\n' "$code" | grep -nE "$META_HATCH_RE" || true)"
  [ -n "$hits" ] && meta_hatch="${meta_hatch}$(printf '%s\n' "$hits" | sed "s|^|${f}:|")"$'\n'
  hits="$(printf '%s\n' "$code" | grep -nE 'decide[[:space:]]*\+[[:space:]]*native|decide[[:space:]]*\([[:space:]]*config[[:space:]]*:=[^)]*native[[:space:]]*:=[[:space:]]*true' || true)"
  [ -n "$hits" ] && nat_hatch="${nat_hatch}$(printf '%s\n' "$hits" | sed "s|^|${f}:|")"$'\n'
  case "$f" in GoLean/GoCore/*)
    hits="$(printf '%s\n' "$code" | grep -nE '(^|[[:space:]])partial[[:space:]]+(def|theorem|instance|abbrev)\b' || true)"
    [ -n "$hits" ] && part_hatch="${part_hatch}$(printf '%s\n' "$hits" | sed "s|^|${f}:|")"$'\n' ;;
  esac
done < <(find GoLean GoLean.lean Main.lean -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null)
if [ -n "$meta_hatch" ]; then printf '%s' "$meta_hatch"; bad "escape-hatch scan: unsafe/opaque/implemented_by/extern in GoLean/ (the compiled behaviour may diverge from the logical content; an extern body passes the build, the axiom audit and the kernel replay)"; scan_bad=1; fi
if [ -n "$nat_hatch" ]; then printf '%s' "$nat_hatch"; bad "escape-hatch scan: a native-decision spelling (same class as native_decide)"; scan_bad=1; fi
if [ -n "$part_hatch" ]; then printf '%s' "$part_hatch"; bad "escape-hatch scan: partial declaration in GoLean/GoCore/ (the semantic core uses structural/well-founded recursion)"; scan_bad=1; fi
if [ -f GoLean/EnumDedup.lean ]; then
  eng_bad=0
  while IFS= read -r -d '' ef; do
    eng_hits="$(grep -nE "${IMPORT_RE}GoLean\.EnumDedup([^A-Za-z].*)?\$" "$ef")"; eng_rc=$?
    if [ "$eng_rc" -ge 2 ]; then echo "  engine-isolation scan ERRORED on $ef (rc=$eng_rc) — failing closed" >&2; eng_bad=1
    elif [ "$eng_rc" -eq 0 ]; then printf '%s\n' "$eng_hits" | sed "s|^|$ef:|"; eng_bad=1; fi
  done < <( { find GoLean/GoCore -name '*.lean' -not -path '*/.lake/*' -print0; printf 'GoLean/GoCore.lean\0'; } )
  if [ "$eng_bad" -ne 0 ]; then bad "escape-hatch scan: the semantic core imports the untrusted dedup engine, or the scan could not run (CLI-only by design)"; scan_bad=1; fi
else
  bad "escape-hatch scan: GoLean/EnumDedup.lean missing (deleted or renamed without re-pointing this clause?)"; scan_bad=1
fi
[ "$scan_bad" -eq 0 ] && { echo "  clean"; ok "escape-hatch scan (clean)"; }

# ── SPEEDBUMPS: document-vs-code consistency, static, seconds. Report-only.
step "speedbumps (report-only — a RED is read at the merge ask and fixed or waived by name)"
run_bump "bugs index = baseline (scripts/check-bugs.sh)" ./scripts/check-bugs.sh
run_bump "feature tags, no dead tag (scripts/check-coverage)" ./scripts/check-coverage
run_bump "spec anchors resolve at the pin (scripts/check-spec-anchors)" ./scripts/check-spec-anchors
run_bump "stdlib admission register = frontend tables (scripts/check-stdlib-register)" ./scripts/check-stdlib-register
run_bump "AGENTS.md is the alias of CLAUDE.md (scripts/check-agents-alias)" ./scripts/check-agents-alias
run_bump "imported-goose verbatim at the pin (scripts/check-imported-goose)" ./scripts/check-imported-goose
run_bump "memory-module raw call sites = inventory (scripts/check-mem-callsites)" bash scripts/check-mem-callsites
run_bump "third-party notices present; no upstream copyright header outside the inventoried subtrees (scripts/check-notices)" bash scripts/check-notices

# ── GATE: the build of every target, EACH NAMED on the command line. The
# default targets are the main-free libraries only ([USER] 2026-10-21,
# release-readiness row 42: `lake check` imports every default module into
# one environment and stops at the second `main`), so a bare `lake build`
# would skip the executables and the `main`-bearing test libraries; the list
# is parsed from lakefile.toml here, once, and the target-split check below
# reads the same parse. Warning-free, because a GoLean/ warning replays into
# the runner's stdout and corrupts the JSON observation channel (the
# 2026-07-23 phantom-drift incident). Tests/ is in the watch too (audit item
# 5, 2026-10-12), and Contract/ since the comparator challenge (review F8,
# 2026-10-23): a `sorry` in a test module is a warning, and the cold build
# of 2026-10-12 (163 jobs, 64G cap, 8 min 37 s) had zero warnings anywhere,
# so the wider watch costs nothing today.
#
# The parser lakefile_targets is scripts/lakefile-targets.sh (sourced above with lean-scan.sh;
# shared with scripts/check-lake-check since 2026-10-25).
lf_parse="$(lakefile_targets)"
lf_unsupported="$(printf '%s\n' "$lf_parse" | grep '^unsupported' || true)"
lf_all=(); lf_libs=(); lf_exes=(); lf_enum_bad=""
while read -r kind name rest; do
  case "$kind" in
    lib)
      lf_all+=("$name")
      if [ -z "$rest" ]; then
        if [ -f "$name.lean" ]; then
          rest="$name"
          [ -d "$name" ] && rest="$rest $(find "$name" -name '*.lean' -not -path '*/.lake/*' | sed 's|\.lean$||; s|/|.|g' | LC_ALL=C sort | tr '\n' ' ')"
        else lf_enum_bad="$lf_enum_bad $name"; fi
      fi
      lf_libs+=("$name $rest") ;;
    exe) lf_all+=("$name"); lf_exes+=("$name") ;;
  esac
done <<< "$lf_parse"
step "lake build (every declared library and executable, each named; warning-free)"
if [ -n "$lf_unsupported" ] || [ -n "$lf_enum_bad" ] || [ "${#lf_all[@]}" -eq 0 ]; then
  [ -n "$lf_unsupported" ] && printf '%s\n' "$lf_unsupported" | sed 's/^/  /' >&2
  [ -n "$lf_enum_bad" ] && echo "  library without globs and without a root module file:$lf_enum_bad" >&2
  core_rc=2; bad "lake build NOT RUN (lakefile.toml did not parse into a target list — the lines above; extend lakefile_targets in scripts/ci deliberately)"
else
  echo "  targets: ${lf_all[*]}"
  core_out="$(cap lake build "${lf_all[@]}" 2>&1)"; core_rc=$?
  echo "$core_out" | tail -3 | sed 's/^/  /'
  core_warns="$(echo "$core_out" | grep -E '^warning: (GoLean/|GoLean\.lean|Main\.lean|Tests/|Contract/)' || true)"
  if [ "$core_rc" -ne 0 ]; then bad "lake build (exit $core_rc)"
  elif [ -n "$core_warns" ]; then echo "$core_warns" | head -10; bad "lake build has GoLean/, Tests/ or Contract/ warnings (a GoLean/ warning corrupts the runner JSON channel; a Tests/ or Contract/ one is a sorry or a dead declaration — the challenge's holes are silenced by warn.sorry, not by this regex)"
  else ok "lake build (every declared target by name: ${#lf_all[@]} — ${lf_all[*]}; warning-free)"; fi
fi

# Every Tests/ module must be named by a lakefile.toml glob, or the build above
# skipped it silently (D2: this set check replaces the receipt registry).
step "lakefile ownership (every Tests/*.lean in a glob)"
tests_unowned=""
for tf in Tests/*.lean; do
  tm="Tests.$(basename "$tf" .lean)"
  grep -q "\"$tm\"" lakefile.toml || tests_unowned="$tests_unowned $tm"
done
if [ -z "$tests_unowned" ]; then ok "Tests/ library ownership (every module named by a lakefile glob)"
else echo "  not in any lakefile.toml glob:$tests_unowned" >&2; bad "Tests/ library ownership (unowned:$tests_unowned — add to a lakefile.toml glob)"; fi

# ── GATE: the default-target split ([USER] 2026-10-21, release-readiness row
# 42; it replaced «every declared target is a default target», audit
# 2026-10-12 item 3). Every library that defines no top-level `main` — the
# proof and pin holders — IS a default target, or `lake check` never sees it;
# every executable and every library with a `main`-bearing module is NOT (a
# second `main` stops `lake check`'s single-environment export) and is built
# by name above. ONE main-free library is required NOT to be default: the one
# owning the comparator's CHALLENGE module (`challenge_module` in
# comparator.json; release-readiness row 43, 2026-10-23) — its `sorry` holes
# would fail `lake check`'s axiom verdict and its alias names are the
# Solution's, which `lake check` imports into the same environment; it is
# built by name above and judged by `lake comparator` (scripts/check-comparator).
# A comparator.json that cannot be read, or a challenge module no library
# owns, FAILS here. `main` is read from each module's built .ilean — the
# elaborated constant names, so a namespaced `Tests.X.main` is not `main` —
# which is why the check runs only after a green build, and FAILS when an
# .ilean is missing or not the shape it reads. Both directions fail closed.
step "lakefile targets (the default-target split: main-free libraries default; executables and main-bearing libraries built by name)"
if [ "$core_rc" -ne 0 ]; then
  bad "lakefile target split NOT CHECKED (the lake build failed, exit $core_rc — no .ilean to read)"
else
  lf_defaults="$(lakefile_default_targets)"
  lf_challenge="$(python3 -I -c 'import json; print(json.load(open("comparator.json"))["challenge_module"])' 2>/dev/null || true)"
  split_out="$(LF_LIBS="$(printf '%s\n' "${lf_libs[@]}")" LF_EXES="${lf_exes[*]}" LF_DEFAULTS="$lf_defaults" LF_CHALLENGE="$lf_challenge" python3 -I - <<'PY'
import json, os, sys
defaults = os.environ["LF_DEFAULTS"].split()
exes = os.environ["LF_EXES"].split()
libs = [l.split() for l in os.environ["LF_LIBS"].splitlines() if l.strip()]
challenge = os.environ["LF_CHALLENGE"].strip()
bad = []
if not challenge:
    bad.append("comparator.json is unreadable or has no challenge_module — the comparator's challenge library cannot be classified (it must be the one main-free library that is NOT a default target)")
challenge_owner = None
def has_main(mod):
    p = os.path.join(".lake", "build", "lib", "lean", *mod.split(".")) + ".ilean"
    try:
        with open(p, encoding="utf-8") as f:
            d = json.load(f)
    except (OSError, ValueError) as e:
        bad.append(f"{mod}: cannot read {p} ({e}) — the build left no readable .ilean for it"); return None
    decls = d.get("decls") if isinstance(d, dict) else None
    if not isinstance(decls, dict) or d.get("module") != mod:
        bad.append(f"{mod}: {p} is not this module's .ilean in the shape this check reads (version {d.get('version')!r}, module field {d.get('module')!r}) — a stale or misplaced .ilean (rebuild: rm -rf .lake/build), or the format moved (re-derive the check)"); return None
    return "main" in decls
known = set()
for name, *mods in libs:
    known.add(name)
    states = {m: has_main(m) for m in mods}
    carriers = [m for m, v in states.items() if v]
    unreadable = [m for m, v in states.items() if v is None]
    is_default = name in defaults
    is_challenge = bool(challenge) and challenge in mods
    shape = ("main in " + ", ".join(carriers)) if carriers else ("UNREADABLE .ilean: " + ", ".join(unreadable)) if unreadable else "main-free"
    if is_challenge:
        challenge_owner = name
        shape += f"; owns the comparator challenge {challenge} (comparator.json)"
    print(f"  lib {name}: {'default' if is_default else 'built by name'}; {shape}; {len(mods)} module(s)")
    if is_challenge and is_default:
        bad.append(f"library {name} owns the comparator challenge module {challenge} but is a default target — its sorry holes fail lake check's axiom verdict and its alias names clash with GoLean.Contract.Solution's in one environment; drop it from defaultTargets (it is built by name and judged by lake comparator)")
    elif is_challenge and carriers:
        bad.append(f"library {name} owns the comparator challenge module {challenge} but defines a top-level main in {', '.join(carriers)} — the challenge is statements with holes, nothing else")
    elif is_challenge:
        pass  # the one main-free library that is NOT default, by design
    elif carriers and is_default:
        bad.append(f"library {name} is a default target but defines a top-level main in {', '.join(carriers)} — a second main stops lake check; drop it from defaultTargets (it is built by name)")
    elif unreadable:
        pass  # already a FAIL line each, above
    elif not carriers and not is_default:
        bad.append(f"library {name} defines no top-level main (a proof/pin holder) but is NOT a default target — lake check never sees it; add it to defaultTargets")
for name in exes:
    known.add(name)
    print(f"  exe {name}: {'DEFAULT' if name in defaults else 'built by name'}")
    if name in defaults:
        bad.append(f"executable {name} is a default target — its root's main stops lake check; drop it from defaultTargets (it is built by name)")
for d in defaults:
    if d not in known:
        bad.append(f"defaultTargets names {d!r}, which is not a declared library or executable")
if challenge and challenge_owner is None:
    bad.append(f"comparator.json names the challenge module {challenge!r}, which no declared library's globs own — lake comparator could not build it")
if not libs or not defaults:
    bad.append("no library parsed or no default target read — the split is unverifiable")
for b in bad:
    print("  " + b)
sys.exit(1 if bad else 0)
PY
)"; split_rc=$?
  printf '%s\n' "$split_out"
  if [ "$split_rc" -eq 0 ]; then ok "lakefile targets (defaults = the main-free libraries: $lf_defaults; executables, main-bearing libraries and the comparator challenge ($lf_challenge) built by name)"
  else bad "lakefile targets (the default-target split is broken or unverifiable — exit $split_rc; see above)"; fi
fi

# ── GATE: the kernel replay of the built GoLean oleans (the Codex zero-context
# pass, F4; release-readiness row 40, [USER]-ruled 2026-10-13). leanchecker
# replays every `GoLean.*` module's declarations through the kernel into a
# fresh environment built from its imports (the imports trusted as loaded),
# which the build, the text scan and the axiom audit cannot do: a metaprogram
# that skipped the kernel (debug.skipKernelTC) leaves a clean build and a
# clean axiom list. The script fails on any nonzero exit (a kill included) and
# on a replayed set ≠ the on-disk module set; here the count it names is
# carried into the summary line, and a PASS without a positive count is a
# FAIL. Not run when the build above failed: the oleans on disk would be the
# previous build's, and a green over them would read as this source's (fix
# round F2, 2026-10-13).
step "kernel replay (scripts/check-kernel-replay: leanchecker over every built GoLean olean, replayed through the kernel into a fresh environment of its imports)"
if [ "$core_rc" -ne 0 ]; then
  echo "  not run: the lake build above failed (exit $core_rc)"
  bad "kernel replay NOT RUN (the lake build failed, exit $core_rc — the oleans on disk are not this source's)"
else
  kr_out="$(bash scripts/check-kernel-replay 2>&1)"; kr_rc=$?
  kr_n="$(printf '%s\n' "$kr_out" | sed -n 's/^Kernel replay gate: PASS.*[^0-9]\([0-9][0-9]*\) GoLean modules replayed.*/\1/p' | tail -1)"
  if [ "$kr_rc" -eq 0 ] && [ "${kr_n:-0}" -gt 0 ]; then
    printf '%s\n' "$kr_out" | tail -2 | sed 's/^/  /'; ok "kernel replay ($kr_n GoLean modules replayed through the kernel — leanchecker)"
  else
    # The WHOLE output, not a tail: a stale-olean refusal names one module per
    # line and the list is bounded by the module count (2026-10-22: the
    # runner's tail -25 showed 23 of 79 under a «129 oleans vs 50 modules»
    # line that said «named above»). The checker's own log is still a file.
    printf '%s\n' "$kr_out" | sed 's/^/  /'
    bad "kernel replay (exit $kr_rc, ${kr_n:-no} module count — a killed, refused, incomplete or empty replay is NOT a pass; see above)"
  fi
fi

# The fast tier says where `lake check` went (review F6, 2026-10-22): a
# summary without the line would read as if the check did not exist.
if [ "$RUN_DIFF" -eq 0 ]; then
  echo "  lake check, lake comparator: not in the fast tier — scripts/ci --diff runs both as speedbumps (about four minutes, and the comparator); the owner's runs outside the sandbox are the claim-point gate"
  note "lake check, lake comparator: not in this tier (the --diff tier runs scripts/check-lake-check and scripts/check-comparator as speedbumps; the owner's runs outside the sandbox are the claim-point gate)"
fi

# ── GATE: the machine check of totality — a harness imports every GoLean/
# module and audits every declaration (classical trio only; required core
# theorems present; abort-text helpers constructive).
step "core totality audit (scripts/check-core-audit)"
run_gate "core totality audit (every GoLean/ module; required core theorems)" bash scripts/check-core-audit

# ── GATE: the Go-side unit tests — the lowering's own tests and the lowering
# tables, then the oracle observer (-count=1: its inertness test execs the
# pinned `go run`, which the test cache cannot key).
step "go tests (tools/nativefrontend, tools/lowerdiag, tools/coverageharness)"
run_gate "frontend + lowering-table unit tests (go test ./tools/nativefrontend ./tools/lowerdiag)" \
  env GO111MODULE=off GOCACHE="$GOCACHE_DIR" go test ./tools/nativefrontend ./tools/lowerdiag
run_gate "coverage-harness unit tests (go test -count=1 ./tools/coverageharness)" \
  env GO111MODULE=off GOCACHE="$GOCACHE_DIR" go test -count=1 ./tools/coverageharness

# ── GATE: the interpreter's unit tests. A gutted exe exiting 0 with no output
# is a degenerate run, not a pass.
step "interpreter eval tests (gocore-eval-tests)"
evout="$(cap lake exe gocore-eval-tests 2>&1)"; evrc=$?
evok="$(printf '%s\n' "$evout" | grep -c '^ok:')"
evbad="$(printf '%s\n' "$evout" | grep -icE '^(not ok|fail)')"
echo "  ok:$evok  fail:$evbad  exit:$evrc"
if [ "$evrc" -eq 0 ] && [ "$evbad" -eq 0 ] && [ "$evok" -gt 0 ]; then ok "eval tests ($evok ok)"
else printf '%s\n' "$evout" | grep -iE '^(not ok|fail)' | head -10; bad "eval tests (exit $evrc, $evbad bad, $evok ok — zero ok is a degenerate run)"; fi

# ── GATE: the lowering and decoder boundary, and the `stepFn_eqns` equation
# library's client check — each its own script, each fail-closed.
step "unseq wire, Stage C (scripts/check-unseq-wire)"
run_gate "unseq wire (wires from bytes vs reference sets; decoder mutants refused by name)" bash scripts/check-unseq-wire
step "wire boundary (scripts/check-wire-boundary)"
run_gate "wire boundary (byte-level controls through the real CLI)" bash scripts/check-wire-boundary
step "method identity (scripts/check-method-identity)"
run_gate "package-correct method identity (fresh wire, strict decoder)" bash scripts/check-method-identity
step "frontend pins (scripts/check-frontend-pins)"
run_gate "frontend pins (init-order deviation observation + raft twin wire, byte-exact)" ./scripts/check-frontend-pins
step "declaration boundary (scripts/check-declarations)"
run_gate "declaration boundary (Go identity, strict JSON, Unicode table = oracle, fixture pin)" bash scripts/check-declarations
step "semantic equations (scripts/check-equations)"
run_gate "semantic equations (client PASS, exhaustive enrollment, no-unfold guard, import whitelist)" bash scripts/check-equations

# ── --diff: the fresh corpus runs. Exit 1 from a runner = some cases FAIL
# (judged by the baseline step below); >= 2 = the run itself broke.
if [ "$RUN_DIFF" -eq 1 ]; then
  step "differential corpus, fresh run of every row (scripts/diff-coverage)"
  cap ./scripts/diff-smoke 2>&1 | tail -3 | sed 's/^/  /'; drc=${PIPESTATUS[0]}
  case "$drc" in
    0|1) ok "differential run completed (exit $drc; the failing set is judged by the baseline diff)" ;;
    *)   bad "differential run BROKE (exit $drc — not a case failure; see output)" ;;
  esac
  step "negative corpus, fresh run (scripts/coverage-negative: gc rejects AND the native frontend refuses as a rejection)"
  cap ./scripts/coverage-negative 2>&1 | tail -2 | sed 's/^/  /'; nrc=${PIPESTATUS[0]}
  case "$nrc" in
    0|1) ok "negative run completed (exit $nrc; judged by the baseline diff)" ;;
    *)   bad "negative run BROKE (exit $nrc)" ;;
  esac
  step "unseq scheduler, Stage B (scripts/check-unseq-scheduler — enumerates whole tape spaces)"
  run_gate "unseq scheduler (reference sets over all tapes, named refusals, replay)" bash scripts/check-unseq-scheduler

  # Speedbump: two tracked files are GENERATED from the oracle and consumed as
  # bytes (Tests/FloatVectors.lean by the eval tests; inittask-std.tsv by the
  # frontend). Regenerate and compare; a difference is an edit or a stale pin.
  step "derived oracle artifacts regenerate byte-identical (speedbump)"
  derive_tmp="$(mktemp -d "${TMPDIR%/}/golean-derived-guard.XXXXXX")"
  if GOCACHE="$GOCACHE_DIR" GO111MODULE=off go run ./tools/floatvectors > "$derive_tmp/fv.lean" 2>"$derive_tmp/fv.err"; then
    if cmp -s "$derive_tmp/fv.lean" Tests/FloatVectors.lean; then bump_ok "Tests/FloatVectors.lean = fresh regeneration (byte-exact)"
    else cmp "$derive_tmp/fv.lean" Tests/FloatVectors.lean 2>&1 | head -3 | sed 's/^/  /'; bump_red "Tests/FloatVectors.lean DIFFERS from a fresh tools/floatvectors run (edited or stale — regenerate deliberately)"; fi
  else tail -5 "$derive_tmp/fv.err" | sed 's/^/  /'; bump_red "FloatVectors regeneration FAILED (the check could not run)"; fi
  it_pin="$(head -1 baselines/go-oracle-pin 2>/dev/null | tr -d '[:space:]')"
  it_hdr="$(grep -m1 '^# toolchain:' tools/nativefrontend/inittask-std.tsv 2>/dev/null | awk '{print $3}')"
  if [ -z "$it_hdr" ] || [ -z "$it_pin" ] || [ "$it_hdr" != "$it_pin" ]; then
    bump_red "inittask-std.tsv header toolchain [${it_hdr:-missing}] != oracle pin [${it_pin:-missing}] — not regenerated for this pin"
  elif scripts/gen-inittask-table -o "$derive_tmp/it.tsv" > "$derive_tmp/it.out" 2>&1; then
    grep -v '^# generated:' "$derive_tmp/it.tsv" > "$derive_tmp/it.fresh"
    grep -v '^# generated:' tools/nativefrontend/inittask-std.tsv > "$derive_tmp/it.tracked"
    if cmp -s "$derive_tmp/it.fresh" "$derive_tmp/it.tracked"; then bump_ok "inittask-std.tsv = fresh regeneration (header at pin; byte-exact modulo the date line)"
    else diff "$derive_tmp/it.fresh" "$derive_tmp/it.tracked" 2>&1 | head -5 | sed 's/^/  /'; bump_red "tools/nativefrontend/inittask-std.tsv DIFFERS from a fresh scripts/gen-inittask-table run"; fi
  else tail -5 "$derive_tmp/it.out" | sed 's/^/  /'; bump_red "inittask-std.tsv regeneration FAILED (the check could not run)"; fi
  rm -rf "$derive_tmp"

  # ── SPEEDBUMP, --diff tier only (about four minutes): `lake check`
  # (toolchains ≥ 4.35) builds the default targets — the main-free libraries
  # — exports them, replays the export through the kernel and refuses
  # non-standard axioms. scripts/check-lake-check runs it sandboxed where
  # `bwrap` can start (unprivileged user namespaces) and with
  # `--inadvisably-no-sandbox` where it cannot (a sandboxed agent session),
  # saying which; REPORT-ONLY either way — the gate is the owner's `lake
  # check` outside the sandbox at claim points, `--paranoid` at the release
  # claim point ([USER] 2026-10-20; the default targets ruled 2026-10-21,
  # release-readiness row 42): CLAUDE.md «The gates», docs/operational-
  # lessons.md «Lean 4.35». The kernel replay (9.1 s at 4 threads, 6.8 s
  # at 8) stays in the fast tier (no sandbox; the on-disk olean set). Not
  # run when the build failed.
  step "lake check (speedbump, --diff tier; scripts/check-lake-check: the default targets exported and replayed; sandboxed where bwrap can start)"
  if [ "$core_rc" -ne 0 ]; then
    echo "  not run: the lake build above failed (exit $core_rc)"
    bump_red "lake check NOT RUN (the lake build failed, exit $core_rc)"
  else
    run_bump "lake check (scripts/check-lake-check, --diff tier; the main-free libraries built, exported, kernel-replayed; sandboxed where bwrap can start, else --inadvisably-no-sandbox — its line says which)" bash scripts/check-lake-check
  fi

  # ── SPEEDBUMP, --diff tier only: `lake comparator` (release-readiness row
  # 43, [USER] 2026-10-23). The surface kept on main for the raft-proofs
  # customer — the Prefix/Finish laws, every `stepFn_eqns` lemma, the G11
  # family, the output-fold bridge, enterFrame_declared, the Choices.consumeAt*
  # laws (285 theorems; scripts/contract-names.lean) — is FROZEN as statements
  # in Contract/Challenge.lean, and the comparator judges GoLean's own theorems
  # (through the generated aliases of GoLean/Contract/Solution.lean) against
  # it: syntactically the same statement, standard axioms only, kernel-
  # accepted. A statement drift is a kernel-level mismatch naming the theorem,
  # not a text diff. scripts/check-comparator first checks the generated half
  # is current (scripts/gen-contract --check), then runs the comparator with
  # scripts/check-lake-check's sandbox detection. REPORT-ONLY here; the gate
  # is the owner's run outside the sandbox at claim points (docs/release.md §3).
  step "lake comparator (speedbump, --diff tier; scripts/check-comparator: the kept customer surface judged against its frozen challenge)"
  if [ "$core_rc" -ne 0 ]; then
    echo "  not run: the lake build above failed (exit $core_rc)"
    bump_red "lake comparator NOT RUN (the lake build failed, exit $core_rc)"
  else
    run_bump "lake comparator (scripts/check-comparator, --diff tier; Contract/Challenge.lean vs GoLean/Contract/Solution.lean per comparator.json; sandboxed where bwrap can start, else --inadvisably-no-sandbox — its line says which)" bash scripts/check-comparator
  fi
fi

# ── GATE: the baselines. judge_record judges a recorded corpus run against its
# tracked baseline, after checking the record is ATTRIBUTABLE: a meta file, the
# oracle of record (no toolchain drift), and for a full run a manifest sha equal
# to the manifest regenerated from the CURRENT corpus. A partial run is a note
# in the fast tier and a FAIL under --diff. No record is a FAIL.
# The 7th argument is the baseline's column format for
# scripts/coverage-baseline-diff: `cause` (result,id,stage,cause — the
# differential baseline's refusal-cause column, release-readiness item 8)
# or `no-cause` (result,id,stage — the negative baseline). Explicit per
# call, never inferred from the file.
judge_record() {  # <kind> <latest.tsv> <meta.tsv> <baseline> <manifest-cmd> <demand-full 0|1> <cause|no-cause>
  local kind=$1 latest=$2 meta=$3 baseline=$4 manifest_cmd=$5 demand_full=$6 colfmt=$7
  local -a fmt_flag=()
  case "$colfmt" in
    cause) ;;
    no-cause) fmt_flag=(--no-cause) ;;
    *) bad "$kind baseline diff (internal: judge_record column format '$colfmt' is neither cause nor no-cause)"; return ;;
  esac
  local ran total runcommit head stale="" drift tool dirty meta_sha cur_sha rc=0
  if [ ! -f "$latest" ]; then
    if [ -n "${GOLEAN_ALLOW_NO_DIFF:-}" ]; then note "$kind baseline diff NOT RUN (no record; GOLEAN_ALLOW_NO_DIFF set — this environment never records one)"
    else echo "  no $latest" >&2; bad "$kind baseline diff (NO recorded run — nothing has checked the corpus; run scripts/ci --diff, or GOLEAN_ALLOW_NO_DIFF=1 where none is ever recorded)"; fi
    return
  fi
  [ -f "$meta" ] || { bad "$kind baseline diff ($latest has NO meta — unattributable results; re-run scripts/ci --diff)"; return; }
  ran="$(awk -F'\t' '!/^#/ && $1!="result" && NF>=2' "$latest" | wc -l | tr -d ' ')"
  total="$($manifest_cmd 2>/dev/null | wc -l | tr -d ' ')"
  [ "$total" -gt 0 ] || { bad "$kind baseline diff (the manifest could not be regenerated — attribution unverifiable; run $manifest_cmd by hand)"; return; }
  runcommit="$(awk -F'\t' '$1=="git_commit"{print $2}' "$meta")"; head="$(git rev-parse HEAD 2>/dev/null)"
  [ -n "$runcommit" ] && [ "$runcommit" != unknown ] && [ "$runcommit" != "$head" ] && stale=" [recorded at ${runcommit:0:7}, HEAD is ${head:0:7} — stale]"
  drift="$(awk -F'\t' '$1=="go_drift_actual"{print $2}' "$meta")"; [ -z "$drift" ] && drift="$(awk -F'\t' '$1=="go_drift"{print $2}' "$meta")"
  tool="$(awk -F'\t' '$1=="go_toolchain"{print $2}' "$meta")"; dirty="$(awk -F'\t' '$1=="git_dirty"{print $2}' "$meta")"
  if [ -z "$drift" ]; then note "$kind record has no go_drift field (pre-provenance record) — oracle-of-record status unverifiable; re-run scripts/ci --diff"
  elif [ "$drift" != 0 ] && [ "$drift" != false ]; then
    if [ "${GOLEAN_ALLOW_GO_DRIFT:-0}" = 1 ]; then note "$kind record was made under a DRIFTED toolchain (${tool:-unknown}) — judged anyway, NOT the oracle of record"
    else bad "$kind baseline diff (recorded run used a DRIFTED toolchain ${tool:-unknown} — not the oracle of record; re-run at the pin)"; return; fi
  fi
  if [ "$ran" -ge "$total" ]; then
    meta_sha="$(awk -F'\t' '$1=="manifest_sha256"{print $2}' "$meta")"
    cur_sha="$($manifest_cmd 2>/dev/null | sha256sum | awk '{print $1}')"
    if [ -z "$meta_sha" ] || [ -z "$cur_sha" ] || [ "$meta_sha" != "$cur_sha" ]; then
      bad "$kind baseline diff (meta manifest_sha256 [${meta_sha:-missing}] != the current corpus manifest — stale/foreign results; re-run scripts/ci --diff)"; return
    fi
    ./scripts/coverage-baseline-diff --full ${fmt_flag[@]+"${fmt_flag[@]}"} --baseline "$baseline" "$latest" || rc=$?
    if [ "$rc" -ge 2 ]; then bad "$kind baseline diff (REFUSED / could not judge, exit $rc — NOT a drift verdict)"
    elif [ "$rc" -eq 1 ]; then bad "$kind baseline diff (DRIFT vs $baseline — see above)"
    elif [ "$dirty" = true ]; then note "$kind baseline diff FULL ($ran/$total, no regression) but recorded on a DIRTY tree — certifies that worktree state, not a commit$stale"
    else ok "$kind baseline diff FULL ($ran/$total, no regression)$stale"; fi
  elif [ "$demand_full" -eq 1 ]; then
    bad "$kind baseline diff (--diff demanded a full run but the record is PARTIAL: $ran/$total)"
  else
    ./scripts/coverage-baseline-diff ${fmt_flag[@]+"${fmt_flag[@]}"} --baseline "$baseline" "$latest" || rc=$?
    if [ "$rc" -ge 2 ]; then bad "$kind baseline diff (REFUSED / could not judge, exit $rc — NOT a drift verdict)"
    elif [ "$rc" -eq 1 ]; then bad "$kind baseline diff (DRIFT among the $ran cases run — see above)"
    else note "$kind baseline diff PARTIAL ($ran/$total run, no drift among them — NOT a full certification; use --diff)$stale${dirty:+ [git_dirty=$dirty]}"; fi
  fi
}
step "baselines: the recorded negative run vs baselines/negative-full.tsv"
judge_record negative artifacts/coverage/negative-latest.tsv artifacts/coverage/negative-latest.meta.tsv baselines/negative-full.tsv ./scripts/coverage-negative-manifest "$RUN_DIFF" no-cause
step "baselines: the recorded differential run vs baselines/native-full.tsv"
judge_record differential artifacts/coverage/latest.tsv artifacts/coverage/latest.meta.tsv baselines/native-full.tsv ./scripts/coverage-manifest "$RUN_DIFF" cause
# Speedbump (D5 of the refusal-cause note, [USER]-approved 2026-10-12): an
# unclassified cause key (`fe?:<head>`, `<status>:?`) is pinned by the
# baseline like any other, and REPORTED here so the classifier tables
# (tools/lowerdiag/causes.tsv, scripts/machine-causes.tsv) catch up.
if [ -f artifacts/coverage/latest.tsv ]; then
  run_bump "every FAIL row's refusal cause classified (scripts/coverage-cause --unclassified)" ./scripts/coverage-cause --unclassified artifacts/coverage/latest.tsv
fi

# ── GATE: the re-pin guard. A re-pin that flips a SURVIVING case PASS -> non-PASS,
# or moves a FAIL row's cause from a named key into the non-verdict/crash family
# (scripts/check-cause-regressions), must list it on a `- Cases:` line in
# docs/BUGS.md; a REMOVED row (PASS or FAIL) must be named by a
# `# removed: <id> — <why>` header line AND its fixture must be gone from the
# corpus directory and the manifest (scripts/check-row-removals — a removal is
# not a flip: release-readiness row 31(a), [USER] ruling 2026-10-25; before it a
# vanished PASS fixture needed the Cases: line too); a stage alternation of the old
# baseline must survive unless the new one names its removal. Dirty tree:
# worktree vs HEAD; clean tree: HEAD vs HEAD~1 (a shallow clone fails closed).
repin_guard() {  # <baseline file> <exec|negative>
  local base=$1 corpus=$2 wt_rc c_rc mode old newfile oldbase newbase flips awk_rc id nfl pin_bad=0 surv_new surv_rc=0 surv_out
  git diff --quiet HEAD -- "$base" 2>/dev/null; wt_rc=$?
  if [ "$wt_rc" -eq 1 ]; then mode="worktree-vs-HEAD"; old=HEAD; newfile="$base"
  elif [ "$wt_rc" -ge 2 ]; then bad "re-pin guard ($base: git diff errored rc=$wt_rc — refusing to certify)"; return
  elif git rev-parse --verify -q HEAD~1 >/dev/null 2>&1; then
    git diff --quiet HEAD~1 HEAD -- "$base" 2>/dev/null; c_rc=$?
    if [ "$c_rc" -eq 1 ]; then mode="HEAD-vs-HEAD~1"; old=HEAD~1; newfile=""
    elif [ "$c_rc" -ge 2 ]; then bad "re-pin guard ($base: git diff errored rc=$c_rc comparing HEAD~1 — refusing to certify)"; return
    else ok "re-pin guard ($base unchanged at the tip)"; return; fi
  else bad "re-pin guard ($base: shallow clone, HEAD~1 unavailable — the tip is UNVERIFIABLE; fetch with depth >= 2)"; return; fi
  echo "  $base: $mode"
  if ! git cat-file -e "$old:$base" 2>/dev/null; then ok "re-pin guard ($base: initial pin at $old — no prior baseline, nothing to launder)"; return; fi
  oldbase="$(git show "$old:$base" 2>/dev/null)" || { bad "re-pin guard (could not read $old:$base — refusing to certify)"; return; }
  if [ -n "$newfile" ]; then newbase="$(cat "$newfile")"; else newbase="$(git show "HEAD:$base" 2>/dev/null)"; fi
  [ -n "$newbase" ] || { bad "re-pin guard (could not read the new $base — refusing to certify)"; return; }
  flips="$(printf '===OLD===\n%s\n===NEW===\n%s\n' "$oldbase" "$newbase" | awk -F'\t' '
    /^===OLD===$/ { sec = 1; next }
    /^===NEW===$/ { sec = 2; next }
    /^#/ { next }
    sec == 1 && $1 == "PASS" && NF >= 2 { oldpass[$2] = 1 }
    sec == 2 && NF >= 2 && $1 != "result" { newany[$2] = 1 }
    sec == 2 && $1 == "PASS" && NF >= 2 { nowpass[$2] = 1 }
    END { for (id in oldpass) if ((id in newany) && !(id in nowpass)) print id }')"; awk_rc=$?
  [ "$awk_rc" -eq 0 ] || { bad "re-pin guard ($base: internal comparison error rc=$awk_rc — refusing to certify)"; return; }
  flips="$(printf '%s\n' "$flips" | LC_ALL=C sort | grep -v '^$' || true)"
  while read -r id; do
    [ -z "$id" ] && continue
    awk -v id="$id" '
      /^- Cases:/ { line = substr($0, 9); n = split(line, a, /[, ]+/); for (i = 1; i <= n; i++) if (a[i] == id) found = 1 }
      END { exit !found }' docs/BUGS.md || { echo "  PASS→non-PASS flip not on any BUGS.md Cases: line: $id"; pin_bad=1; }
  done <<< "$flips"
  nfl="$(printf '%s' "$flips" | grep -c . || true)"
  if [ "$pin_bad" -ne 0 ]; then bad "re-pin guard ($base: regressions baked into the baseline unexplained — add them to a BUGS.md Cases: line)"
  else ok "re-pin guard ($base: $nfl PASS→non-PASS flip(s) of surviving rows, all on BUGS.md Cases lines; removed rows are the row-removal check's)"; fi
  if [ -n "$newfile" ]; then surv_new="$newfile"; else surv_new="git:HEAD:$base"; fi
  surv_out="$(./scripts/check-alternation-survival "git:$old:$base" "$surv_new" 2>&1)" || surv_rc=$?
  if [ "$surv_rc" -eq 0 ]; then [ -n "$surv_out" ] && printf '%s\n' "$surv_out" | sed 's/^/  /'
  else printf '%s\n' "$surv_out" | sed 's/^/  /'; bad "re-pin guard ($base: a stage alternation of $old dropped without a named removal, or the check could not run — exit $surv_rc)"; fi
  # Cause regressions (refusal-cause fix round, review HIGH-1): a FAIL row
  # re-pinned from a named cause into killed:/timeout/undecided:/crash:
  # needs a BUGS.md Cases: line, like a PASS→non-PASS flip.
  local cause_rc=0 cause_out
  cause_out="$(./scripts/check-cause-regressions "git:$old:$base" "$surv_new" 2>&1)" || cause_rc=$?
  if [ "$cause_rc" -eq 0 ]; then [ -n "$cause_out" ] && printf '%s\n' "$cause_out" | sed 's/^/  /'
  else printf '%s\n' "$cause_out" | sed 's/^/  /'; bad "re-pin guard ($base: a FAIL row's cause regressed into the non-verdict/crash family without a BUGS.md Cases: line, or the check could not run — exit $cause_rc)"; fi
  # Row removals (PASS or FAIL) need a `# removed: <id> — <why>` header line
  # and a fixture that is really gone (directory and manifest; row 31(a)).
  local rem_rc=0 rem_out
  rem_out="$(./scripts/check-row-removals "git:$old:$base" "$surv_new" "$corpus" 2>&1)" || rem_rc=$?
  if [ "$rem_rc" -eq 0 ]; then [ -n "$rem_out" ] && printf '%s\n' "$rem_out" | sed 's/^/  /'
  else printf '%s\n' "$rem_out" | sed 's/^/  /'; bad "re-pin guard ($base: a baseline row removed without a \`# removed:\` header line, or named removed while its fixture is still in the corpus, or the check could not run — exit $rem_rc)"; fi
}
step "baseline re-pin guard (PASS→non-PASS flips of surviving rows must be on a BUGS.md Cases: line; a removed row needs its # removed: header line and a vanished fixture; alternations survive)"
repin_guard baselines/native-full.tsv exec
repin_guard baselines/negative-full.tsv negative

# ── Summary. Gate lines decide RESULT; speedbumps are listed, never decide.
printf '\n\033[1m══ scripts/ci summary (%s) ══\033[0m\n' "$MODE"
printf '%s\n' "${RESULTS[@]}"
printf '\n\033[1m── speedbumps (report-only) ──\033[0m\n'
printf '%s\n' "${BUMPS[@]}"
if [ "$bumps_red" -gt 0 ]; then
  printf '\nSPEEDBUMPS: %s RED — not a gate failure; read at the merge ask, fix or waive by name\n' "$bumps_red"
fi
if [ "$fail" -ne 0 ]; then
  printf '\n\033[1mRESULT: FAIL\033[0m\n'; exit 1
fi
printf '\n\033[1mRESULT: PASS\033[0m\n'
