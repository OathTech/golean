#!/usr/bin/env bash
# The always-run gate. One command an agent runs before claiming work done; CI
# runs the same. Each step is a standing guardrail (see
# docs/2026-07-19_pipeline-error-resistance.md). Runs ALL steps even if one
# fails, then reports a summary and exits non-zero on any failure.
#
#   scripts/ci          fast gate: escape-hatch preflight, builds (incl. the
#                       in-build axiom/non-vacuity Audit gate), eval tests, and
#                       a baseline diff of the LAST recorded differential run.
#   scripts/ci --diff   also re-runs the full native differential corpus first
#                       (slow: `go run` per case), then diffs it. Do this when
#                       you touched runtime code (frontend / interpreter / Ops).
#
# NOTE: the differential is the FOUNDATION of the trust chain. `scripts/ci`
# (no flag) only checks that the LAST recorded run still matches the baseline;
# it does not re-run Go. For runtime changes, use --diff (or run
# scripts/diff-one <ids> for a focused slice) so the baseline reflects reality.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

RUN_DIFF=0
[ "${1:-}" = "--diff" ] && RUN_DIFF=1

fail=0
declare -a RESULTS
step() { printf '\n\033[1m── %s\033[0m\n' "$1"; }
ok()   { RESULTS+=("  ok   $1"); }
bad()  { RESULTS+=("  FAIL $1"); fail=1; }

# 1. Escape-hatch preflight (cheap, no build). The authoritative axiom check is
#    the in-build Audit gate (step 3); this catches obvious holes at edit time.
step "escape-hatch preflight (sorry / admit / native_decide / axiom in proof-facing code)"
# Match the tokens as CODE, then drop prose: line-comments (`--`), docstring
# lines, and backtick-quoted mentions (`sorry`/`native_decide`/…). The in-build
# Audit gate (step 3) is authoritative; this is the cheap early-warning.
# Depth-proof file list via find (no globstar dependence); .lake excluded. Any
# NEW .lean file under GoLean/ or proofs/ is scanned automatically. Line
# comments are STRIPPED before matching (tamper audit F1: a trailing `-- WIP`
# comment previously exempted the whole line, hiding real code); the token set
# includes sorryAx/ofReduceBool (the axioms behind sorry/native_decide, which
# dodge the surface-syntax tokens). Docstring prose is tolerated only via
# backticked mentions. The in-build Audit sweep remains authoritative.
hatch="$(find GoLean proofs -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null \
         | xargs -0 grep -nE 'sorry|admit|native_decide|ofReduceBool|^[[:space:]]*axiom ' 2>/dev/null \
         | sed 's/--.*$//' \
         | grep -E 'sorry|\badmit\b|native_decide|ofReduceBool|^[^:]*:[0-9]*:[[:space:]]*axiom ' \
         | grep -vE '/-|`(sorry|sorryAx|admit|native_decide|ofReduceBool|axiom)`|no sorry|without .*sorry|axioms:' \
         || true)"
if [ -n "$hatch" ]; then
  echo "$hatch"
  bad "escape-hatch preflight — review the lines above (the in-build Audit gate is authoritative)"
else
  echo "  none found"
  ok "escape-hatch preflight"
fi

# 1b2. Proofs-file audit coverage (tamper audit F2): a NEW proofs/*.lean that
# nothing imports is never built, so the in-build sweep never sees it. Every
# proofs/*.lean must be imported into the audited build (reachable from
# Audit.lean, whose root import is GoLeanProofs) or on the explicit standalone
# allowlist below (deliberate, documented exceptions only).
step "proofs-file audit coverage (every proofs/*.lean built+swept or allowlisted)"
STANDALONE_PROOFS="SliceSpike Probe"  # SliceSpike: superseded spike kept as record; Probe: scratch
pf_bad=0
for f in proofs/*.lean; do
  b="$(basename "$f" .lean)"
  case "$b" in Audit) continue ;; esac
  case " $STANDALONE_PROOFS " in *" $b "*) continue ;; esac
  if ! grep -qE "^import $b$" proofs/Audit.lean proofs/GoLeanProofs.lean 2>/dev/null \
     && [ "$b" != "GoLeanProofs" ]; then
    echo "  proofs/$b.lean is neither imported into the audited build nor on the standalone allowlist"
    pf_bad=1
  fi
done
if [ "$pf_bad" -ne 0 ]; then
  bad "proofs-file audit coverage (un-swept proof file — import it from Audit.lean or allowlist with a reason)"
else
  ok "proofs-file audit coverage"
fi

# 1b. Bug-index cross-check (static, no build): BUGS.md <-> baseline.
step "fidelity-bug index cross-check (scripts/check-bugs.sh)"
if bugout="$(./scripts/check-bugs.sh 2>&1)"; then echo "$bugout" | sed 's/^/  /'; ok "bug-index cross-check"; else echo "$bugout"; bad "bug-index cross-check"; fi

# 1c. Feature-coverage cross-check: every canonical tag exercised (no dead tags);
#     all-failing tags surfaced. Manifest generation, no Lean build.
step "feature-coverage cross-check (scripts/check-coverage)"
if covout="$(./scripts/check-coverage 2>&1)"; then echo "$covout" | tail -2 | sed 's/^/  /'; ok "feature-coverage (no dead tags)"; else echo "$covout"; bad "feature-coverage (dead tag — see above)"; fi

# 2. Core build (the frontend / interpreter / relation).
step "core build (lake build)"
if lake build 2>&1 | tail -3; then ok "core build"; else bad "core build"; fi

# 3. Proofs build — this runs proofs/Audit.lean: the axiom allowlist
#    (#guard_msgs #print axioms) + non-vacuity witness references. A weakened
#    proof-layer claim FAILS HERE.
step "proofs build incl. Audit gate (axiom allowlist + non-vacuity)"
if ( cd proofs && lake build 2>&1 | tail -4 ); then ok "proofs + Audit gate"; else bad "proofs + Audit gate"; fi

# 4. Interpreter unit tests.
step "interpreter eval tests (gocore-eval-tests)"
evout="$(lake exe gocore-eval-tests 2>&1)"; evrc=$?
evok="$(printf '%s\n' "$evout" | grep -c '^ok:')"
evbad="$(printf '%s\n' "$evout" | grep -icE '^(not ok|fail)')"
echo "  ok:$evok  fail:$evbad  exit:$evrc"
if [ "$evrc" -eq 0 ] && [ "$evbad" -eq 0 ]; then ok "eval tests ($evok ok)"; else bad "eval tests (exit $evrc, $evbad bad)"; fi

# 5. Differential baseline diff (the ratchet: PASS<->FAIL flips / stage changes).
# HONEST SCOPE: a partial run (diff-one / focused slice) can only certify the
# cases it ran. Only a full-corpus run earns "no regression"; a partial one is
# reported as partial and NEVER as a full certification — and if the recorded
# run predates HEAD, that staleness is surfaced too.
if [ "$RUN_DIFF" -eq 1 ]; then
  step "re-run full native differential corpus (--diff)"
  # Exit semantics of diff-coverage: 1 = some cases FAIL (expected — the corpus
  # deliberately outruns the tool; whether the failing SET is acceptable is the
  # baseline diff's job below), >=2 = the run itself broke (no cases, bad
  # manifest, missing oracle). Judge run-completion here, regression below.
  ./scripts/diff-smoke 2>&1 | tail -3; drc=${PIPESTATUS[0]}
  case "$drc" in
    0|1) ok "differential run completed (exit $drc; failing-set judged by baseline diff)" ;;
    *)   bad "differential run BROKE (exit $drc — not a case failure; see output)" ;;
  esac
fi
step "differential baseline diff (scripts/coverage-baseline-diff)"
if [ -f artifacts/coverage/latest.tsv ]; then
  ran="$(awk -F'\t' '!/^#/ && $1!="result" && NF>=2' artifacts/coverage/latest.tsv | wc -l | tr -d ' ')"
  total="$(./scripts/coverage-manifest 2>/dev/null | wc -l | tr -d ' ')"
  runcommit="$(awk -F'\t' '$1=="git_commit"{print $2}' artifacts/coverage/latest.meta.tsv 2>/dev/null)"
  head="$(git rev-parse HEAD 2>/dev/null)"
  stale=""
  [ -n "$runcommit" ] && [ "$runcommit" != "unknown" ] && [ "$runcommit" != "$head" ] && stale=" [recorded at ${runcommit:0:7}, HEAD is ${head:0:7} — stale]"
  if [ "$ran" -ge "$total" ] && [ "$total" -gt 0 ]; then
    if ./scripts/coverage-baseline-diff --full; then ok "baseline diff FULL ($ran/$total, no regression)$stale"; else bad "baseline diff (DRIFT — see above)"; fi
  else
    if [ "$RUN_DIFF" -eq 1 ]; then
      bad "baseline diff (--diff demanded a full run but results are PARTIAL: $ran/$total)"
    elif ./scripts/coverage-baseline-diff; then
      RESULTS+=("  note baseline diff PARTIAL ($ran/$total run, no drift among them — NOT a full certification; use --diff)$stale")
    else
      bad "baseline diff (DRIFT among the $ran cases run — see above)"
    fi
  fi
else
  echo "  no artifacts/coverage/latest.tsv — run scripts/ci --diff or scripts/diff-one first"
  RESULTS+=("  skip differential baseline diff (no recorded run)")
fi

# 5b. Baseline re-pin guard. A re-pin that flips any case PASS -> non-PASS must
# list each such case on a `- Cases:` line in docs/BUGS.md — regressions cannot
# be laundered into the baseline silently. Two modes (tamper audit F3a: the
# worktree-only mode was inert on any clean checkout, i.e. in CI):
#   dirty tree  -> compare worktree baseline vs HEAD   (pre-commit, local)
#   clean tree  -> compare HEAD baseline vs HEAD~1     (post-commit + CI; audits
#                  the tip commit — multi-commit pushes are covered pre-commit)
if ! git diff --quiet HEAD -- baselines/native-full.tsv 2>/dev/null; then
  PIN_MODE="worktree-vs-HEAD"; PIN_OLD="HEAD"; PIN_NEW_FILE="baselines/native-full.tsv"
elif ! git diff --quiet HEAD~1 HEAD -- baselines/native-full.tsv 2>/dev/null; then
  PIN_MODE="HEAD-vs-HEAD~1"; PIN_OLD="HEAD~1"; PIN_NEW_FILE=""
else
  PIN_MODE=""
fi
if [ -n "$PIN_MODE" ]; then
  step "baseline re-pin guard ($PIN_MODE; flips must be on a BUGS.md Cases: line)"
  # No process substitution (sandbox may deny /dev/fd): old version on stdin,
  # new version read inside awk. FAIL CLOSED on any unreadable input.
  if oldbase="$(git show "$PIN_OLD":baselines/native-full.tsv 2>/dev/null)"; then
    if [ -n "$PIN_NEW_FILE" ]; then newbase="$(cat "$PIN_NEW_FILE")"; else newbase="$(git show HEAD:baselines/native-full.tsv 2>/dev/null)"; fi
    if [ -z "$newbase" ]; then
      bad "re-pin guard (could not read the new baseline — refusing to certify)"
    else
    # Both versions on stdin with section markers (BSD awk rejects multiline -v
    # values — and that error initially made this guard fail OPEN; hence the
    # explicit exit-status check below).
    flips="$(printf '===OLD===\n%s\n===NEW===\n%s\n' "$oldbase" "$newbase" | awk -F'\t' '
      /^===OLD===$/ { sec = 1; next }
      /^===NEW===$/ { sec = 2; next }
      /^#/ { next }
      sec == 1 && $1 == "PASS" && NF >= 2 { oldpass[$2] = 1 }
      sec == 2 && $1 == "PASS" && NF >= 2 { nowpass[$2] = 1 }
      END { for (id in oldpass) if (!(id in nowpass)) print id }
    ')" ; awk_rc=$?
    if [ "$awk_rc" -ne 0 ]; then
      bad "re-pin guard (internal comparison error rc=$awk_rc — refusing to certify)"
    else
    flips="$(printf '%s\n' "$flips" | LC_ALL=C sort | grep -v '^$' || true)"
    pin_bad=0
    while read -r id; do
      [ -z "$id" ] && continue
      # Whole-token match on a `- Cases:` line only (tamper audit F3b: an
      # unanchored substring grep was satisfied by prose mentions and by any
      # LONGER id containing this one).
      if ! awk -v id="$id" '
            /^- Cases:/ { line = substr($0, 9); n = split(line, a, /[, ]+/)
                          for (i = 1; i <= n; i++) if (a[i] == id) found = 1 }
            END { exit !found }' docs/BUGS.md; then
        echo "  PASS→non-PASS flip not listed on any BUGS.md Cases: line: $id"; pin_bad=1
      fi
    done <<< "$flips"
    nfl="$(printf '%s' "$flips" | grep -c . || true)"
    if [ "$pin_bad" -ne 0 ]; then
      bad "re-pin guard (regressions baked into baseline unexplained — add them to a BUGS.md Cases: line)"
    else
      ok "re-pin guard ($nfl PASS→non-PASS flip(s), all listed in BUGS.md Cases)"
    fi
    fi
    fi
  else
    bad "re-pin guard (could not read $PIN_OLD baseline — refusing to certify the re-pin)"
  fi
fi

# Summary
printf '\n\033[1m══ scripts/ci summary ══\033[0m\n'
printf '%s\n' "${RESULTS[@]}"
if [ "$fail" -ne 0 ]; then
  printf '\n\033[1mRESULT: FAIL\033[0m\n'; exit 1
fi
printf '\n\033[1mRESULT: PASS\033[0m\n'
