#!/usr/bin/env bash
# The always-run gate. One command an agent runs before claiming work done; CI
# runs the same. Each step is a standing guardrail (see
# docs/2026-07-19_pipeline-error-resistance.md). Runs ALL steps even if one
# fails, then reports a summary and exits non-zero on any failure.
#
#   scripts/ci          fast gate: escape-hatch preflight, builds (incl. the
#                       in-build axiom/non-vacuity Audit gate), eval tests, and
#                       a baseline diff of the LAST recorded differential run.
#   scripts/ci --diff   also re-runs the full native differential corpus first
#                       (slow: `go run` per case), then diffs it. Do this when
#                       you touched runtime code (frontend / interpreter / Ops).
#
# NOTE: the differential is the FOUNDATION of the trust chain. `scripts/ci`
# (no flag) only checks that the LAST recorded run still matches the baseline;
# it does not re-run Go. For runtime changes, use --diff (or run
# scripts/diff-one <ids> for a focused slice) so the baseline reflects reality.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

RUN_DIFF=0
[ "${1:-}" = "--diff" ] && RUN_DIFF=1

# Lean import matcher, shared by every import-scanning gate below.
# Whitespace- and `public`-tolerant (audit response 2026-08-01, pre-merge
# findings): the previous '^import ' anchors were fail-open — Lean accepts
# leading whitespace before `import`, extra whitespace after it, and (under
# the 4.31 module system) `public import`; all three forms compiled while
# being INVISIBLE to the scans, so a violation was not merely allowed but
# unseen. Matched lines are normalized to canonical 'import X' before any
# allowlist check, so odd formatting is judged, never skipped.
IMPORT_RE='^[[:space:]]*(public[[:space:]]+)?import[[:space:]]+'
# Strip Lean comments before extracting CLOSURE EDGES (delta-audit
# 2026-08-01: at the closure walk a match is evidence of a BUILD EDGE, so
# an import line quoted in a /- -/ block or docstring injected a phantom
# edge — fail-OPEN. Depth-counting handles nested block comments; `--`
# line comments truncate at depth 0. The allowlist/lint sites keep the
# raw tolerant match: over-matching there only over-FLAGS (fail-closed).
strip_lean_comments() {
  awk '{
    line=$0; out=""; i=1
    while (i <= length(line)) {
      two = substr(line, i, 2)
      if (two == "/-") { d++; i += 2; continue }
      if (two == "-/" && d > 0) { d--; i += 2; continue }
      if (d == 0) {
        if (two == "--") break
        out = out substr(line, i, 1)
      }
      i++
    }
    print out
  }'
}

fail=0
declare -a RESULTS
step() { printf '\n\033[1m── %s\033[0m\n' "$1"; }
ok()   { RESULTS+=("  ok   $1"); }
bad()  { RESULTS+=("  FAIL $1"); fail=1; }

# 1. Escape-hatch preflight (cheap, no build). The authoritative axiom check is
#    the in-build Audit gate (step 3); this catches obvious holes at edit time.
step "escape-hatch preflight (sorry / admit / native_decide / axiom in proof-facing code)"
# Match the tokens as CODE, then drop prose: line-comments (`--`), docstring
# lines, and backtick-quoted mentions (`sorry`/`native_decide`/…). The in-build
# Audit gate (step 3) is authoritative; this is the cheap early-warning.
# Depth-proof file list via find (no globstar dependence); .lake excluded. Any
# NEW .lean file under GoLean/ or proofs/ is scanned automatically. Line
# comments are STRIPPED before matching (tamper audit F1: a trailing `-- WIP`
# comment previously exempted the whole line, hiding real code); the token set
# includes sorryAx/ofReduceBool (the axioms behind sorry/native_decide, which
# dodge the surface-syntax tokens). Docstring prose is tolerated only via
# backticked mentions. The in-build Audit sweep remains authoritative.
hatch="$(find GoLean proofs -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null \
         | xargs -0 grep -nE 'sorry|admit|native_decide|ofReduceBool|^[[:space:]]*axiom ' 2>/dev/null \
         | sed 's/--.*$//' \
         | grep -E 'sorry|\badmit\b|native_decide|ofReduceBool|^[^:]*:[0-9]*:[[:space:]]*axiom ' \
         | grep -vE '/-|`(sorry|sorryAx|admit|native_decide|ofReduceBool|axiom)`|no sorry|without .*sorry|axioms:' \
         || true)"
if [ -n "$hatch" ]; then
  echo "$hatch"
  bad "escape-hatch preflight — review the lines above (the in-build Audit gate is authoritative)"
else
  echo "  none found"
  ok "escape-hatch preflight"
fi

# 1b2. Proofs-file audit coverage (tamper audit F2): a NEW proofs/*.lean that
# nothing imports is never built, so the in-build sweep never sees it. Every
# proofs/*.lean must be imported into the audited build (reachable from
# Audit.lean, whose root import is GoLeanProofs) or on the explicit standalone
# allowlist below (deliberate, documented exceptions only).
step "proofs-file audit coverage (every proofs/**/*.lean in the audited import closure or allowlisted)"
STANDALONE_PROOFS="SliceSpike"  # SliceSpike: superseded spike kept as record (structure audit P1-3: an allowlist entry must name an existing, documented file — no pre-authorized holes)
# Transitive import closure from the build roots (Audit, GoLeanProofs), over
# ALL .lean files under proofs/ including subdirectories — module names derived
# from paths (proofs/GoLeanProofs/Foo.lean -> GoLeanProofs.Foo). A module
# outside the closure is never built, so the in-build sweep never sees it
# (tamper-audit F2 class; subdir handling required by the module-split design,
# docs/2026-07-20_proofs-structure-backlog.md).
pf_bad=0
closure="Audit GoLeanProofs"
grow=1
while [ "$grow" -eq 1 ]; do
  grow=0
  for m in $closure; do
    mf="proofs/$(echo "$m" | tr '.' '/').lean"
    [ -f "$mf" ] || continue
    for imp in $(strip_lean_comments < "$mf" | grep -E "$IMPORT_RE" | sed -E "s/$IMPORT_RE//"); do
      impf="proofs/$(echo "$imp" | tr '.' '/').lean"
      [ -f "$impf" ] || continue   # external import (Iris, GoLean core) — not ours
      case " $closure " in *" $imp "*) ;; *) closure="$closure $imp"; grow=1 ;; esac
    done
  done
done
while IFS= read -r f; do
  rel="${f#proofs/}"
  m="$(echo "${rel%.lean}" | tr '/' '.')"
  case " $STANDALONE_PROOFS " in *" $m "*) continue ;; esac
  case " $closure " in *" $m "*) continue ;; esac
  echo "  proofs/$rel (module $m) is not in the audited import closure nor on the standalone allowlist"
  pf_bad=1
done < <(find proofs -name '*.lean' -not -path '*/.lake/*')
if [ "$pf_bad" -ne 0 ]; then
  bad "proofs-file audit coverage (un-swept proof file — import it from Audit.lean or allowlist with a reason)"
else
  ok "proofs-file audit coverage"
fi

# 1b. Bug-index cross-check (static, no build): BUGS.md <-> baseline.
step "fidelity-bug index cross-check (scripts/check-bugs.sh)"
if bugout="$(./scripts/check-bugs.sh 2>&1)"; then echo "$bugout" | sed 's/^/  /'; ok "bug-index cross-check"; else echo "$bugout"; bad "bug-index cross-check"; fi

# 1c. Feature-coverage cross-check: every canonical tag exercised (no dead tags);
#     all-failing tags surfaced. Manifest generation, no Lean build.
step "feature-coverage cross-check (scripts/check-coverage)"
if covout="$(./scripts/check-coverage 2>&1)"; then echo "$covout" | tail -2 | sed 's/^/  /'; ok "feature-coverage (no dead tags)"; else echo "$covout"; bad "feature-coverage (dead tag — see above)"; fi

step "golden-lowering staleness (scripts/check-golden)"
if ./scripts/check-golden; then
  ok "golden lowering (proof subject = decoded(frontend(source)))"
else
  bad "golden lowering DRIFTED (re-pin deliberately with the frontend change)"
fi

# 1c. Surface purity (docs/2026-07-21_native-spec-surface.md D1; widened to
# the FULL statement-bearing set 2026-08-01 per the TCB doctrine,
# docs/2026-08-01_tcb-and-layering-doctrine.md §1 — QuorumTargets/
# QuorumRefSpec/AutomationTargets were Iris-free-by-chain-or-gated but
# UNGATED here, the exact silent-reopen class the 2026-07-23 hardening note
# below warns about): the spec surface and its dependency chain stay
# Iris-free — statements humans read must never mention Iris machinery.
# Checks that close the chain (2026-07-21 audit hardening — the original
# checked only two files' direct imports against an unanchored allowlist,
# which was fail-open):
#   (a) each statement-bearing file's DIRECT imports against its own
#       exactly-anchored allowlist; every allowlisted GoLeanProofs module is
#       itself in this scan, so the chain closes by induction;
#   (b) the GoLean/ core — the only allowlisted prefix with its own
#       dependency freedom — contains NO Iris imports anywhere, so every
#       transitive path from the surface stays Iris-free;
#   (c) the SEMANTIC twin lives in proofs/Audit.lean (the statement-TCB
#       gate): imports are per-module, meaning is per-theorem.
step "surface purity (Iris-free spec surface, full statement-bearing set)"
surface_ok=1
# R3 audit fix (2026-07-23, sustained finding): the scan list follows the
# GoldenSlice -> GoldenProgram rename (the half-completed rename left the
# gate scanning a deleted file — a silent no-op — while the replacement,
# imported by Surface.lean, was scanned by neither arm). Hardened
# fail-closed: a listed file that does not exist FAILS the gate, so a
# future rename cannot silently reopen this hole.
check_surface_imports() {
  # $1 = file, $2 = anchored allowlist regex for its direct imports
  if [ ! -f "$1" ]; then
    echo "  surface-purity scan target MISSING: $1 (rename without re-pointing the gate?)" >&2
    surface_ok=0
    return
  fi
  local bad_imports
  # Tolerant match + normalization (see IMPORT_RE above): an indented or
  # `public` import is normalized to 'import X' and judged by the
  # allowlist, never invisible to the first-stage grep. Comments are
  # stripped first (2026-08-02, same class as the closure-walk fix at
  # b27e608→3c1b4bf: a docstring line beginning 'import ...' is not an
  # import — here it was a false POSITIVE, noisy rather than fail-open,
  # but the blindness is the same).
  bad_imports=$(strip_lean_comments < "$1" | grep -E "$IMPORT_RE" | sed -E "s/$IMPORT_RE/import /" | grep -Ev "$2" || true)
  if [ -n "$bad_imports" ]; then
    echo "  $1 has non-allowlisted imports:" >&2
    echo "$bad_imports" | sed 's/^/    /' >&2
    surface_ok=0
  fi
}
# The general surface judgment language: GoLean core + Std only.
check_surface_imports proofs/GoLeanProofs/Surface.lean \
  '^import (GoLean\.|Std\.)'
# The two program pins: GoLean core only.
check_surface_imports proofs/GoLeanProofs/Specs/GoldenProgram.lean \
  '^import GoLean\.'
check_surface_imports proofs/GoLeanProofs/Specs/GoldenQuorum.lean \
  '^import GoLean\.'
# Statement modules over the surface + pins.
check_surface_imports proofs/GoLeanProofs/Specs/GoldenTargets.lean \
  '^import (GoLean\.|Std\.|GoLeanProofs\.Surface$|GoLeanProofs\.Specs\.GoldenProgram$)'
check_surface_imports proofs/GoLeanProofs/Specs/QuorumTargets.lean \
  '^import (GoLean\.|Std\.|GoLeanProofs\.Surface$)'
check_surface_imports proofs/GoLeanProofs/Specs/QuorumRefSpec.lean \
  '^import (GoLean\.|Std\.|GoLeanProofs\.Specs\.QuorumTargets$)'
# Statements.lean is THE Iris-free statement layer (comparator-judge sprint,
# 2026-08-02): every def a designated headline STATEMENT references and that
# formerly lived in an Iris-reaching module was hoisted here, so that the
# judge's Challenge import closure — and any skeptic reading it — never
# touches Iris. Allowlist: core + Std + the clean statement chain.
check_surface_imports proofs/GoLeanProofs/Specs/Statements.lean \
  '^import (GoLean\.|Std\.|GoLeanProofs\.Surface$|GoLeanProofs\.Specs\.QuorumTargets$|GoLeanProofs\.Specs\.GoldenQuorum$|GoLeanProofs\.Specs\.GoldenProgram$)'
# AutomationTargets is statement-bearing but MIXED BY DESIGN: it holds the
# range-rule target (a statement ABOUT the Iris-side proof infrastructure,
# quantifying over IProp) and the phase-2 acceptance pins that reference
# proven theorems — so an Iris-free import chain is impossible and is NOT
# claimed for it. What IS pinned: its EXACT import list (any new import
# fails here and must be justified). Since 2026-08-02 its pure headline
# targets (the ∀-config and 3-voter statements) live in Specs/Statements
# (Iris-free by import chain, scanned above); what remains here is the
# range-rule target, the non-vacuity/pin-consistency theorems, and the
# acceptance pins. (Recorded finding, close-out 2026-08-01: the doctrine's
# "Iris-free by import chain" note was wrong for this file pre-hoist.)
check_surface_imports proofs/GoLeanProofs/Specs/AutomationTargets.lean \
  '^import (GoLeanProofs\.Specs\.GoldenQuorumWP$|GoLeanProofs\.Specs\.Statements$|GoLeanProofs\.Laws\.Range$)'
if grep -rEq "${IMPORT_RE}Iris" GoLean/ --include='*.lean'; then
  echo "  GoLean/ core has Iris imports (taints the surface chain):" >&2
  grep -rEl "${IMPORT_RE}Iris" GoLean/ --include='*.lean' | sed 's/^/    /' >&2
  surface_ok=0
fi
if [ "$surface_ok" = 1 ]; then
  ok "surface purity (Iris-free imports, chain-closed)"
else
  bad "surface purity violated (Iris reachable from the spec surface)"
fi

# 1d. Import-direction lint (layering doctrine,
# docs/2026-08-01_tcb-and-layering-doctrine.md §2, mechanized at the
# proof-automation close-out): the proof layer divides into GENERAL
# infrastructure (laws, lifting, ghost state, tactics, the surface and its
# exit pipes — everything under proofs/GoLeanProofs/ EXCEPT Specs/) and the
# TARGET layer (Specs/*: program pins, walks, witnesses, per-target
# statements). The direction rule: target depends on general, never the
# reverse — a general module importing a Specs pin is how target shapes leak
# into laws (the over-specialization standing check's structural form).
#   Exceptions: NONE. The 2026-08-01 restructure eliminated all three that
#   existed (Laws/QuorumOps.lean -> Laws/StmtOps.lean + Specs/GoldenQuorumPin;
#   Laws/Call.lean witnesses -> Specs/GoldenSliceWP; Surface.lean step-0
#   statements -> Specs/GoldenTargets). Add an exception ONLY with a reason
#   comment here and a matching note in docs/architecture.md.
#   (The root aggregator proofs/GoLeanProofs.lean and the gate proofs/Audit.lean
#   import everything by design; they live outside proofs/GoLeanProofs/ and are
#   structurally exempt.)
# Second clause: Tactics/* must not import GoCore at all (a tactic that can
# name Config constructors can grow target knowledge; GoWalk.lean imports only
# Lean + the Iris proof mode/WP, by construction).
step "import-direction lint (general proof modules import no Specs/*; Tactics import no GoCore)"
dir_bad=0
while IFS= read -r f; do
  hits=$(grep -nE "${IMPORT_RE}GoLeanProofs\\.Specs\\." "$f" || true)
  if [ -n "$hits" ]; then
    echo "  $f (general layer) imports target-layer Specs modules:" >&2
    echo "$hits" | sed 's/^/    /' >&2
    dir_bad=1
  fi
done < <(find proofs/GoLeanProofs -name '*.lean' -not -path '*/Specs/*' -not -path '*/.lake/*')
# Tactics clause — hardened at the 2026-08-01 audit response (pre-merge
# findings): the previous form was a NON-recursive shell glob with grep
# errors swallowed (`Tactics/*.lean 2>/dev/null || true`), so a renamed or
# moved Tactics/ directory made the clause a silent no-op, and a nested
# Tactics/Sub/*.lean escaped it with the directory fully intact — the same
# silent-reopen class the surface scan's 2026-07-23 hardening note warns
# about, reproduced in a gate introduced on the same branch. Fail closed:
# a missing directory or zero enumerated .lean files FAILS the lint; files
# are enumerated recursively via find (depth-proof, matching this script's
# own stated standard); imports matched via the tolerant IMPORT_RE.
TACTICS_DIR=proofs/GoLeanProofs/Tactics
if [ ! -d "$TACTICS_DIR" ]; then
  echo "  Tactics directory MISSING: $TACTICS_DIR (renamed without re-pointing the lint?)" >&2
  dir_bad=1
else
  tac_files=$(find "$TACTICS_DIR" -name '*.lean' -not -path '*/.lake/*')
  if [ -z "$tac_files" ]; then
    echo "  Tactics directory has NO .lean files: $TACTICS_DIR (moved without re-pointing the lint?)" >&2
    dir_bad=1
  else
    # Per-file grep so exit codes are unambiguous: 1 = clean no-match,
    # >=2 = unscannable file -> fail CLOSED (delta-audit 2026-08-01: the
    # previous `xargs ... || true` swallowed read errors as "ok").
    tac_hits=""
    while IFS= read -r tf; do
      hits=$(grep -nE "${IMPORT_RE}GoLean" "$tf"); rc=$?
      if [ "$rc" -ge 2 ]; then
        echo "  Tactics import scan ERRORED on $tf (rc=$rc) — failing closed" >&2
        dir_bad=1
      elif [ "$rc" -eq 0 ]; then
        tac_hits="$tac_hits$tf: $hits
"
      fi
    done <<EOF_TACFILES
$tac_files
EOF_TACFILES
    if [ -n "$tac_hits" ]; then
      echo "  Tactics/ imports GoCore/GoLean (a walk tactic must stay semantics-blind):" >&2
      echo "$tac_hits" | sed 's/^/    /' >&2
      dir_bad=1
    fi
  fi
fi
if [ "$dir_bad" = 0 ]; then
  ok "import-direction (general ↛ Specs; Tactics ↛ GoCore)"
else
  bad "import-direction violated (move the pin/witness to Specs/, or record an exception with a reason)"
fi

# 2. Core build (the frontend / interpreter / relation).
step "core build (lake build; must be WARNING-free — GoLean/ module warnings
# replay into the runner's stdout and corrupt the JSON observation channel,
# the recorded ops failure mode that produced mass phantom drift 2026-07-23)"
core_out="$(lake build 2>&1)"
core_rc=$?
echo "$core_out" | tail -3
core_warns="$(echo "$core_out" | grep -E '^warning: GoLean/' || true)"
if [ $core_rc -ne 0 ]; then
  bad "core build"
elif [ -n "$core_warns" ]; then
  echo "$core_warns" | head -10
  bad "core build has GoLean/ warnings (they corrupt the runner JSON channel)"
else
  ok "core build (warning-free)"
fi

# 3. Proofs build — this runs proofs/Audit.lean: the axiom allowlist
#    (#guard_msgs #print axioms) + non-vacuity witness references. A weakened
#    proof-layer claim FAILS HERE.
step "proofs build incl. Audit gate (axiom allowlist + non-vacuity)"
if ( cd proofs && lake build 2>&1 | tail -4 ); then ok "proofs + Audit gate"; else bad "proofs + Audit gate"; fi

# 4. Interpreter unit tests.
step "interpreter eval tests (gocore-eval-tests)"
evout="$(lake exe gocore-eval-tests 2>&1)"; evrc=$?
evok="$(printf '%s\n' "$evout" | grep -c '^ok:')"
evbad="$(printf '%s\n' "$evout" | grep -icE '^(not ok|fail)')"
echo "  ok:$evok  fail:$evbad  exit:$evrc"
if [ "$evrc" -eq 0 ] && [ "$evbad" -eq 0 ]; then ok "eval tests ($evok ok)"; else bad "eval tests (exit $evrc, $evbad bad)"; fi

# 5. Differential baseline diff (the ratchet: PASS<->FAIL flips / stage changes).
# HONEST SCOPE: a partial run (diff-one / focused slice) can only certify the
# cases it ran. Only a full-corpus run earns "no regression"; a partial one is
# reported as partial and NEVER as a full certification — and if the recorded
# run predates HEAD, that staleness is surfaced too.
if [ "$RUN_DIFF" -eq 1 ]; then
  step "re-run full native differential corpus (--diff)"
  # Exit semantics of diff-coverage: 1 = some cases FAIL (expected — the corpus
  # deliberately outruns the tool; whether the failing SET is acceptable is the
  # baseline diff's job below), >=2 = the run itself broke (no cases, bad
  # manifest, missing oracle). Judge run-completion here, regression below.
  ./scripts/diff-smoke 2>&1 | tail -3; drc=${PIPESTATUS[0]}
  case "$drc" in
    0|1) ok "differential run completed (exit $drc; failing-set judged by baseline diff)" ;;
    *)   bad "differential run BROKE (exit $drc — not a case failure; see output)" ;;
  esac
fi
# 5n. Negative corpus (structure audit P1-1): 309 compile-rejection guardrails,
# previously attached to nothing. Fresh run under --diff (cheap: go build per
# case); static diff of the last recorded run always.
if [ "$RUN_DIFF" -eq 1 ]; then
  step "re-run negative corpus (--diff)"
  ./scripts/coverage-negative 2>&1 | tail -2; nrc=${PIPESTATUS[0]}
  case "$nrc" in
    0|1) ok "negative run completed (exit $nrc; set judged by baseline diff)" ;;
    *)   bad "negative run BROKE (exit $nrc)" ;;
  esac
fi
step "negative baseline diff"
if [ -f artifacts/coverage/negative-latest.tsv ]; then
  if ./scripts/coverage-baseline-diff --full --baseline baselines/negative-full.tsv        artifacts/coverage/negative-latest.tsv; then
    ok "negative baseline diff (no regression)"
  else
    bad "negative baseline diff (DRIFT — see above)"
  fi
else
  echo "  no artifacts/coverage/negative-latest.tsv — run scripts/coverage-negative first"
  RESULTS+=("  skip negative baseline diff (no recorded run)")
fi

step "differential baseline diff (scripts/coverage-baseline-diff)"
if [ -f artifacts/coverage/latest.tsv ]; then
  ran="$(awk -F'\t' '!/^#/ && $1!="result" && NF>=2' artifacts/coverage/latest.tsv | wc -l | tr -d ' ')"
  total="$(./scripts/coverage-manifest 2>/dev/null | wc -l | tr -d ' ')"
  runcommit="$(awk -F'\t' '$1=="git_commit"{print $2}' artifacts/coverage/latest.meta.tsv 2>/dev/null)"
  head="$(git rev-parse HEAD 2>/dev/null)"
  stale=""
  [ -n "$runcommit" ] && [ "$runcommit" != "unknown" ] && [ "$runcommit" != "$head" ] && stale=" [recorded at ${runcommit:0:7}, HEAD is ${head:0:7} — stale]"
  if [ "$ran" -ge "$total" ] && [ "$total" -gt 0 ]; then
    if ./scripts/coverage-baseline-diff --full; then ok "baseline diff FULL ($ran/$total, no regression)$stale"; else bad "baseline diff (DRIFT — see above)"; fi
  else
    if [ "$RUN_DIFF" -eq 1 ]; then
      bad "baseline diff (--diff demanded a full run but results are PARTIAL: $ran/$total)"
    elif ./scripts/coverage-baseline-diff; then
      RESULTS+=("  note baseline diff PARTIAL ($ran/$total run, no drift among them — NOT a full certification; use --diff)$stale")
    else
      bad "baseline diff (DRIFT among the $ran cases run — see above)"
    fi
  fi
else
  echo "  no artifacts/coverage/latest.tsv — run scripts/ci --diff or scripts/diff-one first"
  RESULTS+=("  skip differential baseline diff (no recorded run)")
fi

for GUARD_BASE in baselines/native-full.tsv baselines/negative-full.tsv; do
# 5b. Baseline re-pin guards — BOTH tracked baselines (exec + negative).
# A re-pin that flips any case PASS -> non-PASS must
# list each such case on a `- Cases:` line in docs/BUGS.md — regressions cannot
# be laundered into the baseline silently. Two modes (tamper audit F3a: the
# worktree-only mode was inert on any clean checkout, i.e. in CI):
#   dirty tree  -> compare worktree baseline vs HEAD   (pre-commit, local)
#   clean tree  -> compare HEAD baseline vs HEAD~1     (post-commit + CI; audits
#                  the tip commit — multi-commit pushes are covered pre-commit)
# Mode detection by EXACT git exit code (0 = same, 1 = differs, >=2 = error):
# treating an error as "differs" made the guard misfire on GitHub's shallow
# clones (HEAD~1 absent -> git error -> guard activated -> fail-closed on a
# baseline that never changed). A shallow clone without HEAD~1 cannot verify
# the tip commit at all, so it FAILS CLOSED with instructions (never a silent
# skip — a laundered tip re-pin must not pass a shallow CI). Our workflow
# fetches depth 2; any checkout that can't provide HEAD~1 must be fixed, not
# waved through.
git diff --quiet HEAD -- $GUARD_BASE 2>/dev/null; wt_rc=$?
PIN_MODE=""
if [ "$wt_rc" -eq 1 ]; then
  PIN_MODE="worktree-vs-HEAD"; PIN_OLD="HEAD"; PIN_NEW_FILE="$GUARD_BASE"
elif [ "$wt_rc" -ge 2 ]; then
  step "baseline re-pin guard"
  bad "re-pin guard (git diff errored rc=$wt_rc determining worktree state — refusing to certify)"
elif git rev-parse --verify -q HEAD~1 >/dev/null 2>&1; then
  git diff --quiet HEAD~1 HEAD -- $GUARD_BASE 2>/dev/null; c_rc=$?
  if [ "$c_rc" -eq 1 ]; then
    PIN_MODE="HEAD-vs-HEAD~1"; PIN_OLD="HEAD~1"; PIN_NEW_FILE=""
  elif [ "$c_rc" -ge 2 ]; then
    step "baseline re-pin guard"
    bad "re-pin guard (git diff errored rc=$c_rc comparing HEAD~1 — refusing to certify)"
  fi
else
  step "baseline re-pin guard"
  bad "re-pin guard (shallow clone: HEAD~1 unavailable, tip commit UNVERIFIABLE — fetch with depth >= 2)"
fi
if [ -n "$PIN_MODE" ]; then
  step "baseline re-pin guard ($PIN_MODE; flips must be on a BUGS.md Cases: line)"
  # No process substitution (sandbox may deny /dev/fd): old version on stdin,
  # new version read inside awk. FAIL CLOSED on any unreadable input.
  # An INITIAL pin (file absent in the old rev) has no PASS→non-PASS flips by
  # definition: treat it as nothing-to-launder. Fail closed only on OTHER read
  # errors. (Found live: adding baselines/negative-full.tsv tripped the guard
  # on the very next commit because HEAD~1 predated the file.)
  if ! git cat-file -e "$PIN_OLD":"$GUARD_BASE" 2>/dev/null; then
    ok "re-pin guard ($GUARD_BASE: initial pin at $PIN_OLD — no prior baseline, nothing to launder)"
  elif oldbase="$(git show "$PIN_OLD":$GUARD_BASE 2>/dev/null)"; then
    if [ -n "$PIN_NEW_FILE" ]; then newbase="$(cat "$PIN_NEW_FILE")"; else newbase="$(git show HEAD:$GUARD_BASE 2>/dev/null)"; fi
    if [ -z "$newbase" ]; then
      bad "re-pin guard (could not read the new baseline — refusing to certify)"
    else
    # Both versions on stdin with section markers (BSD awk rejects multiline -v
    # values — and that error initially made this guard fail OPEN; hence the
    # explicit exit-status check below).
    flips="$(printf '===OLD===\n%s\n===NEW===\n%s\n' "$oldbase" "$newbase" | awk -F'\t' '
      /^===OLD===$/ { sec = 1; next }
      /^===NEW===$/ { sec = 2; next }
      /^#/ { next }
      sec == 1 && $1 == "PASS" && NF >= 2 { oldpass[$2] = 1 }
      sec == 2 && $1 == "PASS" && NF >= 2 { nowpass[$2] = 1 }
      END { for (id in oldpass) if (!(id in nowpass)) print id }
    ')" ; awk_rc=$?
    if [ "$awk_rc" -ne 0 ]; then
      bad "re-pin guard (internal comparison error rc=$awk_rc — refusing to certify)"
    else
    flips="$(printf '%s\n' "$flips" | LC_ALL=C sort | grep -v '^$' || true)"
    pin_bad=0
    while read -r id; do
      [ -z "$id" ] && continue
      # Whole-token match on a `- Cases:` line only (tamper audit F3b: an
      # unanchored substring grep was satisfied by prose mentions and by any
      # LONGER id containing this one).
      if ! awk -v id="$id" '
            /^- Cases:/ { line = substr($0, 9); n = split(line, a, /[, ]+/)
                          for (i = 1; i <= n; i++) if (a[i] == id) found = 1 }
            END { exit !found }' docs/BUGS.md; then
        echo "  PASS→non-PASS flip not listed on any BUGS.md Cases: line: $id"; pin_bad=1
      fi
    done <<< "$flips"
    nfl="$(printf '%s' "$flips" | grep -c . || true)"
    if [ "$pin_bad" -ne 0 ]; then
      bad "re-pin guard (regressions baked into baseline unexplained — add them to a BUGS.md Cases: line)"
    else
      ok "re-pin guard ($nfl PASS→non-PASS flip(s), all listed in BUGS.md Cases)"
    fi
    fi
    fi
  else
    bad "re-pin guard (could not read $PIN_OLD baseline — refusing to certify the re-pin)"
  fi
fi

done

# Summary
printf '\n\033[1m══ scripts/ci summary ══\033[0m\n'
printf '%s\n' "${RESULTS[@]}"
if [ "$fail" -ne 0 ]; then
  printf '\n\033[1mRESULT: FAIL\033[0m\n'; exit 1
fi
printf '\n\033[1mRESULT: PASS\033[0m\n'
