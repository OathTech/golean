#!/usr/bin/env bash
# The always-run gate. One command an agent runs before claiming work done; CI
# runs the same. Each step is a standing guardrail (see
# docs/2026-07-19_pipeline-error-resistance.md). Runs ALL steps even if one
# fails, then reports a summary and exits non-zero on any failure.
#
#   scripts/ci          fast gate: escape-hatch preflight, core build, eval
#                       tests, and a baseline diff of the LAST recorded
#                       differential run.
#   scripts/ci --diff   also re-runs the full native differential corpus first
#                       (slow: `go run` per case), then diffs it. Do this when
#                       you touched runtime code (frontend / interpreter / Ops).
#                       tier=slow rows verify against their tracked
#                       certified-set records (baselines/certified/) and
#                       report CERTIFIED-CACHED — visible, never silent.
#   scripts/ci --slow   --diff plus FULL re-certification of tier=slow rows
#                       (the nightly / pre-merge path; a re-certification
#                       that differs from the tracked record fails loud).
#
# NOTE: the differential is the FOUNDATION of the trust chain. `scripts/ci`
# (no flag) only checks that the LAST recorded run still matches the baseline;
# it does not re-run Go. For runtime changes, use --diff (or run
# scripts/diff-one <ids> for a focused slice) so the baseline reflects reality.
#
# REPO SPLIT (2026-08-31, [USER]-directed): this gate covers the SEMANTICS
# product only — the executable GoCore interpreter, the native frontend, the
# Go fixture corpus, and the differential apparatus. The reasoning layer
# (proofs/, compat/, the Audit/Challenge/Solution + comparator-judge
# apparatus, the A-TRIP veneer gates, check-golden and the R2 pin guards)
# left main with its package; it is preserved whole on branch
# park/reasoning-2026-08-31 and its gate steps went with it — see
# docs/2026-08-31_repo-split-plan.md for the step-by-step inventory (every
# removed step is accounted for there; none was silently dropped).
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

# 0. MEMORY CAP — re-exec ourselves inside our own cgroup before doing any
#    work. An uncapped Lean elaboration reached 60 GB and killed the session
#    (twice) on 2026-08-09; the gate is exactly the thing that must not be
#    able to take the machine down. Self-wrapping rather than documenting is
#    deliberate: a rule you can forget is not a gate. See scripts/capped for
#    the cap size, the opt-out, and the two mechanisms that DON'T work.
#    Only two token values may skip the wrap: `verified` (scripts/capped read
#    the cgroup's memory.max back and PROVED a cap) and `none` (a deliberate,
#    warned opt-out). Anything else — notably a stale `=1` inherited from an
#    unrelated shell — gets wrapped, and bounces off the readback with exit 3.
#    Trusting the bare variable here meant the readback never protected THIS
#    script, the one CLAUDE.md tells everyone to run (delta-review D2).
case "${GOLEAN_CAPPED:-}" in
  verified|none) ;;
  *) exec "$ROOT/scripts/capped" "$ROOT/scripts/ci" "$@" ;;
esac

RUN_DIFF=0
RUN_SLOW=0
for arg in "$@"; do
  case "$arg" in
    --diff) RUN_DIFF=1 ;;
    # Tiered checking (user directive 2026-08-08): --slow implies --diff
    # and RE-CERTIFIES tier=slow rows fully (GOLEAN_SLOW=1 to the
    # differential); without it, slow-tier rows verify against their
    # tracked certified-set records and report CERTIFIED-CACHED —
    # visibly, never as a silent skip.
    --slow) RUN_DIFF=1; RUN_SLOW=1 ;;
    # FAIL CLOSED ON TYPOS (2026-08-09). This loop used to ignore anything it
    # didn't recognise, so `scripts/ci --dif` ran the FAST gate and printed
    # RESULT: PASS — the operator believes the differential ran when it never
    # did, which is the exact "gate quietly failed open" class this repo
    # treats as worse than a red. Cost us a wasted run the day it was found.
    # NOTE the ordering: the memory-cap re-exec above runs FIRST, so a typo
    # creates and tears down a scope (~ms) before landing here — and on a host
    # with no systemd user bus this guard is unreachable, the operator getting
    # the wrapper's error instead (pre-merge audit F7; the original commit
    # message's "before any work" was imprecise).
    *) echo "scripts/ci: unknown argument '$arg' (expected --diff or --slow)" >&2
       echo "  Refusing to run: a mistyped flag must never silently downgrade" >&2
       echo "  the gate to a weaker one that still reports PASS." >&2
       exit 2 ;;
  esac
done

# Lean import matcher + comment stripper: canonical definitions extracted to
# scripts/lean-scan.sh (comparator-judge pre-merge audit, 2026-08-02 — the
# judge wrapper had re-implemented the matcher with the retired fail-open
# '^import ' anchor; one sourced copy ends that drift class). History of the
# hardening: tolerant anchor 2026-08-01 audit response; comment-stripping at
# closure walks, delta-audit 2026-08-01.
. "$ROOT/scripts/lean-scan.sh"

fail=0
declare -a RESULTS
step() { printf '\n\033[1m── %s\033[0m\n' "$1"; }
ok()   { RESULTS+=("  ok   $1"); }
bad()  { RESULTS+=("  FAIL $1"); fail=1; }

# 0b. BUILD PARALLELISM, SCALED TO THE MEMORY CAP (examples phase-2 slice 0,
#     lever 1, 2026-08-14). Lean's task-scheduler pool size (LEAN_NUM_THREADS)
#     bounds BOTH the number of `lean` workers Lake runs concurrently AND the
#     within-file parallel elaboration of declarations — and peak memory is a
#     SUM OF PER-THREAD PEAKS. On this 32-core box an unbounded build therefore
#     multiplies the heaviest module's peak by the number of live threads, which
#     is how the full proofs build OOM-died inside a 48G cap while completing at
#     64G (charter measurement, docs/2026-08-14_examples-phase2-arc-charter.md —
#     the measurement record is on branch park/reasoning-2026-08-31; the 8G/thread
#     constant below derives from it).
#     Lake 5.0 has no -j/--jobs flag; this env var is the only knob.
#
#     THIS IS A PERFORMANCE KNOB, NOT A CORRECTNESS GATE: it changes how fast
#     and in what memory the SAME build runs, never what is checked. So an
#     unparseable cap falls back to the toolchain default with a visible note
#     rather than failing the gate — and if that default then breaches the cap,
#     the build dies loudly at the cgroup, which is the outcome we already have.
#     An explicit LEAN_NUM_THREADS from the caller is always honoured.
step "build parallelism (LEAN_NUM_THREADS scaled to the memory cap)"
if [ -n "${LEAN_NUM_THREADS:-}" ]; then
  PAR_NOTE="LEAN_NUM_THREADS=$LEAN_NUM_THREADS (set by the caller — honoured as-is)"
else
  _mem="${GOLEAN_MEM_MAX:-64G}"
  # Bytes-per-thread budget: 8G. Chosen from the measured per-thread peaks of
  # the heavy example modules; floor 2 so a small cap still builds in parallel.
  #
  # THE DIGIT GUARD RUNS BEFORE ANY ARITHMETIC (pre-merge audit finding,
  # 2026-08-15). The earlier form matched the `*M` suffix first and then
  # evaluated `$(( ${_mem%[Mm]} / 1024 ))`, so a malformed value like `abcM`
  # reached `$(( … ))` unvalidated — bash evaluates the text as an arithmetic
  # EXPRESSION (a bare name, or a syntax error printed raw to stderr), which
  # both bypassed the documented fallback and showed the operator a shell
  # diagnostic instead of the note. So: strip at most one size suffix, require
  # what remains to be a non-empty run of digits, and only then compute.
  _gb=""
  case "$_mem" in
    none)  _num="" ; _unit="" ;;
    *[Gg]) _num="${_mem%[Gg]}" ; _unit=G ;;
    *[Mm]) _num="${_mem%[Mm]}" ; _unit=M ;;
    *)     _num="$_mem"        ; _unit=B ;;   # bare bytes
  esac
  case "$_num" in
    ''|*[!0-9]*) _num="" ;;  # "", "64.5G", "abcM", "infinity" — not an integer
  esac
  if [ -n "$_num" ]; then
    case "$_unit" in
      G) _gb="$_num" ;;
      M) _gb=$(( _num / 1024 )) ;;
      B) _gb=$(( _num / 1073741824 )) ;;
    esac
  fi
  if [ -z "$_gb" ]; then
    PAR_NOTE="LEAN_NUM_THREADS unset (cap '$_mem' is not an integer GiB size — toolchain default, $(nproc) cores)"
  else
    _jobs=$(( _gb / 8 )); [ "$_jobs" -lt 2 ] && _jobs=2
    export LEAN_NUM_THREADS="$_jobs"
    PAR_NOTE="cap $_mem -> LEAN_NUM_THREADS=$_jobs (cap/8G, floor 2; $(nproc) cores on this box)"
  fi
fi
echo "  $PAR_NOTE"
RESULTS+=("  note build parallelism: $PAR_NOTE")

# 0c. Oracle toolchain pin (launch audit D10-F4): the box's live go
# must match baselines/go-oracle-pin — drift here silently moves the
# oracle under every differential, probe, and re-pin (incident
# precedent: the '1.26.x' CI float, 2026-08-21). Absent go is a note
# (the fast gate itself does not run the oracle); mismatch is a FAIL
# unless GOLEAN_ALLOW_GO_DRIFT=1 says so loudly.
step "oracle toolchain pin (baselines/go-oracle-pin)"
if [ -f baselines/go-oracle-pin ]; then
  go_pin="$(head -1 baselines/go-oracle-pin | tr -d '[:space:]')"
  if command -v go >/dev/null 2>&1; then
    go_live="$(go version | awk '{print $3}')"
    if [ "$go_live" = "$go_pin" ]; then
      ok "oracle toolchain ($go_live = pin)"
    elif [ "${GOLEAN_ALLOW_GO_DRIFT:-0}" = 1 ]; then
      RESULTS+=("  note oracle toolchain DRIFTED ($go_live != pin $go_pin) — GOLEAN_ALLOW_GO_DRIFT=1")
    else
      bad "oracle toolchain $go_live != pinned $go_pin (baselines/go-oracle-pin; GOLEAN_ALLOW_GO_DRIFT=1 to override loudly)"
    fi
  else
    RESULTS+=("  note go not on PATH — oracle pin unverified here (differential runs verify it themselves)")
  fi
else
  bad "baselines/go-oracle-pin missing — the oracle pin is unverifiable"
fi

# 1. Escape-hatch preflight (cheap, no build). GoCore is proof-facing code —
#    the charter's totality rule (no sorry/native_decide/axiom in the semantic
#    core) binds it regardless of where the proofs live.
#    SCOPE NARROWED AT THE REPO SPLIT (2026-08-31): GoLean/ only — proofs/
#    left with its package (the in-build Audit gate, formerly the
#    authoritative sweep behind this preflight, went with it; for the
#    semantics core this text scan is now the standing check, and the
#    charter's ban is the rule it polices).
step "escape-hatch preflight (sorry / admit / native_decide / axiom in the semantic core)"
# Match the tokens as CODE, then drop prose: line-comments (`--`), docstring
# lines, and backtick-quoted mentions (`sorry`/`native_decide`/…).
# Depth-proof file list via find (no globstar dependence); .lake excluded. Any
# NEW .lean file under GoLean/ (plus the root GoLean.lean/Main.lean —
# split audit A8) is scanned automatically. Line
# comments are STRIPPED before matching (tamper audit F1: a trailing `-- WIP`
# comment previously exempted the whole line, hiding real code); the token set
# includes sorryAx/ofReduceBool (the axioms behind sorry/native_decide, which
# dodge the surface-syntax tokens). Docstring prose is tolerated only via
# backticked mentions.
# The scan root must exist — an absent dir made the scan vacuously
# green (launch audit D6-F2, probed).
[ -d GoLean ] || bad "escape-hatch preflight: GoLean/ missing — scan would be vacuous"
# Complete inline block comments are STRIPPED (like `--` comments)
# before matching, so `sorry /- TODO -/` is caught; only a line with
# an UNTERMINATED `/-` is still excluded (the token may sit inside a
# multiline comment). Launch audit D6-F2 closed the `/-` sibling of
# the earlier `--` tamper hole.
hatch="$(find GoLean GoLean.lean Main.lean -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null \
         | xargs -0 grep -nE 'sorry|admit|native_decide|ofReduceBool|^[[:space:]]*axiom ' 2>/dev/null \
         | sed -E 's/--.*$//; s@/-([^-]|-+[^/-])*-+/@@g' \
         | grep -E 'sorry|\badmit\b|native_decide|ofReduceBool|^[^:]*:[0-9]*:[[:space:]]*axiom ' \
         | grep -vE '/-|`(sorry|sorryAx|admit|native_decide|ofReduceBool|axiom)`|no sorry|without .*sorry|axioms:' \
         || true)"
if [ -n "$hatch" ]; then
  echo "$hatch"
  bad "escape-hatch preflight — review the lines above (charter: the semantic core is total)"
else
  echo "  none found"
  ok "escape-hatch preflight"
fi

# 1a2. META-LAYER escape hatches (examples phase-2 pre-merge audit, 2026-08-15).
#      `unsafe`, `opaque` and `@[implemented_by]` let a declaration's COMPILED
#      behaviour diverge from its logical content — the same class as
#      native_decide, and invisible to `#print axioms` because the divergence
#      is in the evaluator, not the proof term. The scan is DECLARATION-ANCHORED
#      rather than token-based: all three words appear in prose throughout the
#      docstrings (block comments are not stripped by the pipeline above), so
#      matching bare tokens would be noise. Speedbump standard: any NEW hit
#      fails loud and is either removed or added here with a reason.
step "meta-layer escape hatches (unsafe / opaque / @[implemented_by] outside the allowlist)"
# THE ALLOWLIST — EMPTY since the repo split (2026-08-31): the sole entry
# (proofs/GoLeanProofs/EntryEq.lean, the `derive_entry_eq` macro's
# compiler-evaluation plumbing) left with the proofs package. GoLean/ has
# no allowlisted meta-layer hatches; any NEW hit fails loud and is either
# removed or allowlisted here with a reason.
META_HATCH_ALLOW=''
# Widened + comment-stripped (launch audit D6-F4, probed): the old
# line-anchored patterns missed `@[simp, implemented_by …]`, split-line
# `unsafe`⏎`def`, and `opaque` with the signature on the next line —
# and had no downstream cover (#print axioms is blind to
# implemented_by). strip_lean_comments preserves line numbers, so the
# scan now runs on code, not prose, and the patterns can be loose.
meta_hatch=""
while IFS= read -r -d '' mh_f; do
  [ "$mh_f" = "$META_HATCH_ALLOW" ] && continue
  mh_hits="$(strip_lean_comments < "$mh_f" | grep -nE \
      '(^|[[:space:]])unsafe([[:space:]]+(def|abbrev|instance|structure|inductive|theorem|example)\b|[[:space:]]*$)|(^|[[:space:]])opaque([[:space:]]+[A-Za-z_]|[[:space:]]*$)|@\[[^]]*implemented_by' \
      || true)"
  if [ -n "$mh_hits" ]; then
    meta_hatch="${meta_hatch}$(printf '%s\n' "$mh_hits" | sed "s|^|${mh_f}:|")"$'\n'
  fi
done < <(find GoLean GoLean.lean Main.lean -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null)
meta_hatch="${meta_hatch%$'\n'}"
if [ -n "$meta_hatch" ]; then
  echo "$meta_hatch"
  bad "meta-layer escape hatches outside the allowlist — remove them, or allowlist with a reason"
else
  echo "  none found"
  ok "meta-layer escape hatches (allowlist empty since the repo split)"
fi

# 1a3. ESCAPE-HATCH ADDENDUM — native decision config/flag spellings
# (origin: A-TRIP fix round F4, 2026-08-28; scope narrowed to GoLean/ at
# the repo split, 2026-08-31). Step 1's token set predates this unit and
# is NOT modified; this ADDS the spellings it cannot see: `decide +native`
# and `decide (config := … native := true …)` reach the same ofReduceBool
# axiom as `native_decide` without the surface token. Scope: same file
# set and comment-stripping as the meta-hatch scan; single-line grep
# (a line-broken config object evades it — recorded limit; the in-build
# Audit axiom sweep that backstopped this left with the proofs package).
step "escape-hatch addendum (decide +native / config-syntax native spellings — A-TRIP F4)"
nat_hatch=""
while IFS= read -r -d '' nh_f; do
  nh_hits="$(strip_lean_comments < "$nh_f" | grep -nE 'decide[[:space:]]*\+[[:space:]]*native|decide[[:space:]]*\([[:space:]]*config[[:space:]]*:=[^)]*native[[:space:]]*:=[[:space:]]*true' || true)"
  if [ -n "$nh_hits" ]; then
    nat_hatch="${nat_hatch}$(printf '%s\n' "$nh_hits" | sed "s|^|${nh_f}:|")"$'\n'
  fi
done < <(find GoLean GoLean.lean Main.lean -name '*.lean' -not -path '*/.lake/*' -print0 2>/dev/null)
nat_hatch="${nat_hatch%$'\n'}"
if [ -n "$nat_hatch" ]; then
  echo "$nat_hatch"
  bad "escape-hatch addendum (a native-decision spelling outside the token scan — same class as native_decide)"
else
  echo "  none found"
  ok "escape-hatch addendum (no decide +native / native-config spellings)"
fi


# 1b. Bug-index cross-check (static, no build): BUGS.md <-> baseline.
step "fidelity-bug index cross-check (scripts/check-bugs.sh)"
if bugout="$(./scripts/check-bugs.sh 2>&1)"; then echo "$bugout" | sed 's/^/  /'; ok "bug-index cross-check"; else echo "$bugout"; bad "bug-index cross-check"; fi

# 1c. Feature-coverage cross-check: every canonical tag exercised (no dead tags);
#     all-failing tags surfaced. Manifest generation, no Lean build.
step "feature-coverage cross-check (scripts/check-coverage)"
if covout="$(./scripts/check-coverage 2>&1)"; then echo "$covout" | tail -2 | sed 's/^/  /'; ok "feature-coverage (no dead tags)"; else echo "$covout"; bad "feature-coverage (dead tag — see above)"; fi

# 1c2b. Spec-anchor citations resolve against the PINNED Go spec/memory
#     model (spec-truth campaign mechanism 4.1, landed at P2). Checks
#     resolution only (anchor exists at the pin); content-level drift is
#     the covmap layer's job. Fails closed without deps/go or on rev
#     drift — deps/go is default-tier in scripts/setup-deps, and the CI
#     workflow clones it pinned (like deps/goose for the verbatim gate).
step "spec-anchor citations (scripts/check-spec-anchors)"
if anchout="$(./scripts/check-spec-anchors 2>&1)"; then echo "$anchout" | sed 's/^/  /'; ok "spec-anchor citations resolve at the pin"; else echo "$anchout" | sed 's/^/  /'; bad "spec-anchor citations (see above)"; fi

# 1c2. Membership-lane gate self-test (delta-review T2, 2026-08-05): the
# lane's shell gates (manifest lane validation incl. the explicit-width
# requirement) exercised against the recorded bad-shape fixtures, PLUS —
# hoisted into the fast gate at the channels-arc final audit (F19,
# 2026-08-07) — the G1-G4 gate-integrity no-publish fixtures (go on PATH
# required, no real build: G1/G2 shadow `lake`, G3/G4 die pre-build;
# ~2s). The golean-binary-dependent half (harness param re-validation,
# frontend guard, B3-B5) runs under --diff below.
step "membership-lane gate self-test (scripts/test-lane-validation; incl. G1-G4 no-publish)"
if laneout="$(./scripts/test-lane-validation 2>&1)"; then
  echo "$laneout" | tail -1 | sed 's/^/  /'
  ok "lane-validation fixtures (manifest gates reject bad shapes)"
else
  echo "$laneout"
  bad "lane-validation fixtures (a lane gate went quiet — see above)"
fi

# 1c4. Imported-goose verbatim staleness (goose-parity phase-A checkpoint,
# 2026-08-08; check-golden mold — re-verify the LANDED artifact against
# its source): every imported-goose main.go's above-marker region must be
# byte-identical (modulo trailing blanks) to the upstream goose sources
# its provenance header names, at the pinned rev. Fails closed on a
# missing/wrong-rev deps/goose checkout — the charter's verbatim-import
# invariant must never pass unverified.
step "imported-goose verbatim staleness (scripts/check-imported-goose)"
if ./scripts/check-imported-goose; then
  ok "imported-goose verbatim (above-marker bytes = pinned upstream)"
else
  bad "imported-goose verbatim DRIFTED (a landed imported body no longer matches goose @ pin)"
fi

# 1d. Engine-isolation lint (POR slice 2026-08-21,
# docs/2026-08-21_w32-por-design.md §7; the surviving semantics-side clause
# of the pre-split import-direction lint — the proof-layer clauses left with
# the proofs package at the repo split, 2026-08-31): the dedup ENGINE
# (GoLean/EnumDedup.lean) is untrusted and deletable — the semantic core
# (GoLean/GoCore/**) must never import it (only the CLI may). This is the
# module's deletion test, mechanized; fail closed if the engine file
# vanishes without this clause moving.
# SCOPE, honest (audit fix 2026-08-21, finding B-F2): the scan is
# DIRECT-import only — a `GoLean/*.lean` intermediary that imported the
# engine and was itself imported by a scanned file would be missed.
# Recorded, not fixed: the aggregator is the realistic vector and it IS
# scanned (GoLean/GoCore.lean listed explicitly — a file, not inside the
# GoLean/GoCore/ directory the find walks).
step "engine-isolation lint (semantic core imports no EnumDedup — CLI-only by design)"
dir_bad=0
if [ ! -f GoLean/EnumDedup.lean ]; then
  echo "  dedup engine file MISSING: GoLean/EnumDedup.lean (deleted/renamed without re-pointing this clause?)" >&2
  dir_bad=1
else
  eng_files=$(find GoLean/GoCore -name '*.lean' -not -path '*/.lake/*'; echo GoLean/GoCore.lean)
  while IFS= read -r ef; do
    hits=$(grep -nE "${IMPORT_RE}GoLean\.EnumDedup([^A-Za-z].*)?\$" "$ef"); rc=$?
    if [ "$rc" -ge 2 ]; then
      echo "  engine-isolation scan ERRORED on $ef (rc=$rc) — failing closed" >&2
      dir_bad=1
    elif [ "$rc" -eq 0 ]; then
      echo "  $ef imports the untrusted dedup engine (GoLean.EnumDedup — CLI-only by design):" >&2
      echo "$hits" | sed 's/^/    /' >&2
      dir_bad=1
    fi
  done <<EOF_ENGFILES
$eng_files
EOF_ENGFILES
fi
if [ "$dir_bad" = 0 ]; then
  ok "engine-isolation (core ↛ EnumDedup)"
else
  bad "engine-isolation violated (the semantic core must not import the dedup engine)"
fi



# 2. Core build (the frontend / interpreter / relation).
step "core build (lake build; must be WARNING-free — GoLean/ module warnings
# replay into the runner's stdout and corrupt the JSON observation channel,
# the recorded ops failure mode that produced mass phantom drift 2026-07-23)"
core_out="$(lake build 2>&1)"
core_rc=$?
echo "$core_out" | tail -3
# Root modules included in the warning watch (split audit A8, 2026-08-31):
# GoLean.lean/Main.lean warnings replay into the runner channel the same way.
core_warns="$(echo "$core_out" | grep -E '^warning: (GoLean/|GoLean\.lean|Main\.lean)' || true)"
if [ $core_rc -ne 0 ]; then
  bad "core build"
elif [ -n "$core_warns" ]; then
  echo "$core_warns" | head -10
  bad "core build has GoLean/ warnings (they corrupt the runner JSON channel)"
else
  ok "core build (warning-free)"
fi

# 2b. Frontend pins (restored at the split audit, findings A1/A2 + B1/B8
# — docs/2026-08-31_repo-split-plan.md fix round): the two SEMANTICS
# pins that lived inside the parked check-golden. (1) the
# hidden-dep-order deviation-observation pin — the differential row is
# permanently red ("≠ gc"), so ONLY this pin catches a drift to a third
# realized init order; (2) the raft twin-wire pin — the only gate
# exercising the frontend over the real raftsubject/ packages. Ordered
# after the core build (both need the golean binary; their internal
# lake build is then a no-op). Fail closed, byte-exact, re-pin only
# deliberately with a written reason.
step "frontend pins (scripts/check-frontend-pins — deviation observation + raft twin wire)"
if ./scripts/check-frontend-pins; then
  ok "frontend pins (realized init-order deviation + twin wire = pinned bytes)"
else
  bad "frontend pins DRIFTED or broken (see above — re-pin deliberately with the reason)"
fi








# 3a1. Import-pipeline gate self-test (goose-parity phase-A checkpoint,
# 2026-08-08): scripts/import-goose's reject-shape fixtures (rev drift,
# imports, func main, build tags, package mismatch, non-self-containment,
# zero-oracle fail-closed, dest collision) plus the standing verbatim
# guard's own tamper/wrong-rev/missing-checkout fixtures — the same
# gated-mold treatment as its declared mold, test-lane-validation.
# Needs go on PATH (self-containment fixture) and the core build above.
# (The R2 pin-guard fixture half was removed at the repo split — its
# subject, check-imported-pins, left with the proofs package.)
step "import-goose gate self-test (scripts/test-import-goose)"
if igout="$(./scripts/test-import-goose 2>&1)"; then
  echo "$igout" | tail -1 | sed 's/^/  /'
  ok "import-goose fixtures (importer + verbatim guard reject bad shapes)"
else
  echo "$igout"
  bad "import-goose fixtures (an import gate went quiet — see above)"
fi



# 3b. Frontend unit tests (generics slice, 2026-08-05): the monomorphization
#     identity layer (mono.go — mangled-key renderings pinned against the
#     reflect probes, registry collision/cap refusals) is exercised by
#     `go test`, not by the differential, so it gets its own step.
step "frontend unit tests (go test ./tools/nativefrontend)"
if ftout="$(GO111MODULE=off GOCACHE="$PWD/artifacts/go-build-cache" go test ./tools/nativefrontend 2>&1)"; then
  echo "$ftout" | tail -2
  ok "frontend unit tests"
else
  echo "$ftout" | tail -20
  bad "frontend unit tests"
fi

# 4. Interpreter unit tests.
step "interpreter eval tests (gocore-eval-tests)"
evout="$(lake exe gocore-eval-tests 2>&1)"; evrc=$?
evok="$(printf '%s\n' "$evout" | grep -c '^ok:')"
evbad="$(printf '%s\n' "$evout" | grep -icE '^(not ok|fail)')"
echo "  ok:$evok  fail:$evbad  exit:$evrc"
# House non-empty assertion (launch audit D6-F3): a gutted test exe
# exiting 0 with no output must not print "ok (0 ok)".
if [ "$evrc" -eq 0 ] && [ "$evbad" -eq 0 ] && [ "$evok" -gt 0 ]; then ok "eval tests ($evok ok)"; else bad "eval tests (exit $evrc, $evbad bad, $evok ok — zero ok is a degenerate run)"; fi

# 5. Differential baseline diff (the ratchet: PASS<->FAIL flips / stage changes).
# HONEST SCOPE: a partial run (diff-one / focused slice) can only certify the
# cases it ran. Only a full-corpus run earns "no regression"; a partial one is
# reported as partial and NEVER as a full certification — and if the recorded
# run predates HEAD, that staleness is surfaced too.
if [ "$RUN_DIFF" -eq 1 ]; then
  # Mode in the banner (audit fix 2026-08-21, finding A-INFO): --diff and
  # --slow print otherwise-identical step lists, so a saved log could not
  # be told apart after the fact. Say which one ran.
  if [ "$RUN_SLOW" -eq 1 ]; then
    step "re-run full native differential corpus (--slow: --diff + GOLEAN_SLOW=1 tier=slow re-certification)"
  else
    step "re-run full native differential corpus (--diff: tier=slow rows verified against their cached certified records)"
  fi
  # Exit semantics of diff-coverage: 1 = some cases FAIL (expected — the corpus
  # deliberately outruns the tool; whether the failing SET is acceptable is the
  # baseline diff's job below), >=2 = the run itself broke (no cases, bad
  # manifest, missing oracle — and, since the grossmith-findings §2 fix,
  # the no-publish paths: lake build failure/timeout, missing golean
  # binary; those also remove latest.tsv/meta up front, so a dead run
  # leaves nothing for the baseline diff below to judge as fresh).
  # Judge run-completion here, regression below.
  GOLEAN_SLOW="$RUN_SLOW" ./scripts/diff-smoke 2>&1 | tail -3; drc=${PIPESTATUS[0]}
  case "$drc" in
    0|1) ok "differential run completed (exit $drc; failing-set judged by baseline diff)" ;;
    *)   bad "differential run BROKE (exit $drc — not a case failure; see output)" ;;
  esac
fi
if [ "$RUN_DIFF" -eq 1 ]; then
  step "membership-lane gate self-test, go-dependent half (--with-go: F4 param re-validation, F6 frontend guard, B3-B5 slice-4 lane gates; G1-G4 run in the fast half since audit F19)"
  if laneout="$(./scripts/test-lane-validation --with-go 2>&1)"; then
    echo "$laneout" | grep -E "F4|F6|B[0-9]|G[0-9]|^test-lane" | sed 's/^/  /'
    ok "lane-validation fixtures incl. harness half (F4/F6/B3-B5)"
  else
    echo "$laneout"
    bad "lane-validation fixtures, harness half (a lane gate went quiet — see above)"
  fi
fi
# 5n. Negative corpus (structure audit P1-1): 309 compile-rejection guardrails,
# previously attached to nothing. Fresh run under --diff (cheap: go build per
# case); static diff of the last recorded run always.
if [ "$RUN_DIFF" -eq 1 ]; then
  step "re-run negative corpus (--diff)"
  ./scripts/coverage-negative 2>&1 | tail -2; nrc=${PIPESTATUS[0]}
  case "$nrc" in
    0|1) ok "negative run completed (exit $nrc; set judged by baseline diff)" ;;
    *)   bad "negative run BROKE (exit $nrc)" ;;
  esac
fi
step "negative baseline diff"
if [ -f artifacts/coverage/negative-latest.tsv ]; then
  if ./scripts/coverage-baseline-diff --full --baseline baselines/negative-full.tsv        artifacts/coverage/negative-latest.tsv; then
    ok "negative baseline diff (no regression)"
  else
    bad "negative baseline diff (DRIFT — see above)"
  fi
else
  # Same fail-open as the differential branch below, same fix (audit F4).
  if [ -n "${GOLEAN_ALLOW_NO_DIFF:-}" ]; then
    echo "  no artifacts/coverage/negative-latest.tsv — GOLEAN_ALLOW_NO_DIFF set, allowed"
    RESULTS+=("  note negative baseline diff NOT RUN (no record; explicitly allowed here)")
  else
    echo "  no artifacts/coverage/negative-latest.tsv" >&2
    bad "negative baseline diff (NO recorded negative run — run scripts/coverage-negative, or set GOLEAN_ALLOW_NO_DIFF=1 for an environment that never records one)"
  fi
fi

step "differential baseline diff (scripts/coverage-baseline-diff)"
if [ -f artifacts/coverage/latest.tsv ]; then
  ran="$(awk -F'\t' '!/^#/ && $1!="result" && NF>=2' artifacts/coverage/latest.tsv | wc -l | tr -d ' ')"
  total="$(./scripts/coverage-manifest 2>/dev/null | wc -l | tr -d ' ')"
  runcommit="$(awk -F'\t' '$1=="git_commit"{print $2}' artifacts/coverage/latest.meta.tsv 2>/dev/null)"
  head="$(git rev-parse HEAD 2>/dev/null)"
  stale=""
  [ -n "$runcommit" ] && [ "$runcommit" != "unknown" ] && [ "$runcommit" != "$head" ] && stale=" [recorded at ${runcommit:0:7}, HEAD is ${head:0:7} — stale]"
  # Gate integrity (grossmith findings §2,
  # docs/2026-08-07_grossmith-findings.md): before judging latest.tsv,
  # verify it is ATTRIBUTABLE — a published meta exists and, for a run
  # claiming full-corpus scope, its recorded manifest_sha256 matches the
  # manifest regenerated from the CURRENT corpus. A no-publish failure
  # inside diff-coverage used to leave the previous run's file here to
  # be judged as if fresh; diff-coverage now removes its outputs up
  # front, and this closes the remaining consumer-side hole (results
  # without meta, or a CASE-SET/EXPECTATION change since the recorded
  # full run — manifest-content swaps of ids/status/args/lane the
  # `ran >= total` count check cannot see; corpus SOURCE bytes are not
  # in the manifest, so an edited main.go is only re-validated by a
  # fresh --diff run — the general limit of judging cached results,
  # maint-check note). Partial
  # runs are exempt from the sha comparison (their manifest was
  # filtered) — they are already reported as partial, never certified.
  meta_ok=1
  metafile=artifacts/coverage/latest.meta.tsv
  if [ ! -f "$metafile" ]; then
    bad "baseline diff (latest.tsv has NO published meta — refusing to judge unattributable results; re-run scripts/ci --diff)"
    meta_ok=0
  elif [ "$ran" -ge "$total" ] && [ "$total" -gt 0 ]; then
    meta_sha="$(awk -F'\t' '$1=="manifest_sha256"{print $2}' "$metafile")"
    cur_sha="$(./scripts/coverage-manifest 2>/dev/null | shasum -a 256 | awk '{print $1}')"
    if [ -z "$meta_sha" ] || [ -z "$cur_sha" ] || [ "$meta_sha" != "$cur_sha" ]; then
      bad "baseline diff (published meta manifest_sha256 [${meta_sha:-missing}] does not match the current corpus manifest — stale/foreign results; re-run scripts/ci --diff)"
      meta_ok=0
    fi
  fi
  if [ "$meta_ok" -eq 0 ]; then
    :
  elif [ "$ran" -ge "$total" ] && [ "$total" -gt 0 ]; then
    if ./scripts/coverage-baseline-diff --full; then ok "baseline diff FULL ($ran/$total, no regression)$stale"; else bad "baseline diff (DRIFT — see above)"; fi
  else
    if [ "$RUN_DIFF" -eq 1 ]; then
      bad "baseline diff (--diff demanded a full run but results are PARTIAL: $ran/$total)"
    elif ./scripts/coverage-baseline-diff; then
      RESULTS+=("  note baseline diff PARTIAL ($ran/$total run, no drift among them — NOT a full certification; use --diff)$stale")
    else
      bad "baseline diff (DRIFT among the $ran cases run — see above)"
    fi
  fi
else
  # NO RECORD AT ALL IS A FAILURE, NOT A SKIP (pre-merge audit F4, 2026-08-09).
  # This branch used to append to RESULTS directly — bypassing bad(), the only
  # thing that sets fail=1 — so "nothing has ever checked the corpus" exited
  # PASS, while a meta-less or sha-mismatched record (above) is a FAIL.
  # Deleting the evidence scored better than corrupting it. And it is trivially
  # reachable: scripts/diff-coverage removes these outputs unconditionally up
  # front, so ANY killed --diff parks the repo here — which is exactly where a
  # cgroup kill from the new memory cap lands you.
  if [ -n "${GOLEAN_ALLOW_NO_DIFF:-}" ]; then
    echo "  no artifacts/coverage/latest.tsv — GOLEAN_ALLOW_NO_DIFF set, allowed"
    RESULTS+=("  note differential baseline diff NOT RUN (no record; explicitly allowed here)")
  else
    echo "  no artifacts/coverage/latest.tsv" >&2
    bad "baseline diff (NO recorded differential run — nothing has checked the corpus; run scripts/ci --diff, or set GOLEAN_ALLOW_NO_DIFF=1 for an environment that never records one)"
  fi
fi

for GUARD_BASE in baselines/native-full.tsv baselines/negative-full.tsv; do
# 5b. Baseline re-pin guards — BOTH tracked baselines (exec + negative).
# A re-pin that flips any case PASS -> non-PASS must
# list each such case on a `- Cases:` line in docs/BUGS.md — regressions cannot
# be laundered into the baseline silently. Two modes (tamper audit F3a: the
# worktree-only mode was inert on any clean checkout, i.e. in CI):
#   dirty tree  -> compare worktree baseline vs HEAD   (pre-commit, local)
#   clean tree  -> compare HEAD baseline vs HEAD~1     (post-commit + CI; audits
#                  the tip commit — multi-commit pushes are covered pre-commit)
# Mode detection by EXACT git exit code (0 = same, 1 = differs, >=2 = error):
# treating an error as "differs" made the guard misfire on GitHub's shallow
# clones (HEAD~1 absent -> git error -> guard activated -> fail-closed on a
# baseline that never changed). A shallow clone without HEAD~1 cannot verify
# the tip commit at all, so it FAILS CLOSED with instructions (never a silent
# skip — a laundered tip re-pin must not pass a shallow CI). Our workflow
# fetches depth 2; any checkout that can't provide HEAD~1 must be fixed, not
# waved through.
git diff --quiet HEAD -- $GUARD_BASE 2>/dev/null; wt_rc=$?
PIN_MODE=""
if [ "$wt_rc" -eq 1 ]; then
  PIN_MODE="worktree-vs-HEAD"; PIN_OLD="HEAD"; PIN_NEW_FILE="$GUARD_BASE"
elif [ "$wt_rc" -ge 2 ]; then
  step "baseline re-pin guard"
  bad "re-pin guard (git diff errored rc=$wt_rc determining worktree state — refusing to certify)"
elif git rev-parse --verify -q HEAD~1 >/dev/null 2>&1; then
  git diff --quiet HEAD~1 HEAD -- $GUARD_BASE 2>/dev/null; c_rc=$?
  if [ "$c_rc" -eq 1 ]; then
    PIN_MODE="HEAD-vs-HEAD~1"; PIN_OLD="HEAD~1"; PIN_NEW_FILE=""
  elif [ "$c_rc" -ge 2 ]; then
    step "baseline re-pin guard"
    bad "re-pin guard (git diff errored rc=$c_rc comparing HEAD~1 — refusing to certify)"
  fi
else
  step "baseline re-pin guard"
  bad "re-pin guard (shallow clone: HEAD~1 unavailable, tip commit UNVERIFIABLE — fetch with depth >= 2)"
fi
if [ -n "$PIN_MODE" ]; then
  step "baseline re-pin guard ($PIN_MODE; flips must be on a BUGS.md Cases: line)"
  # No process substitution (sandbox may deny /dev/fd): old version on stdin,
  # new version read inside awk. FAIL CLOSED on any unreadable input.
  # An INITIAL pin (file absent in the old rev) has no PASS→non-PASS flips by
  # definition: treat it as nothing-to-launder. Fail closed only on OTHER read
  # errors. (Found live: adding baselines/negative-full.tsv tripped the guard
  # on the very next commit because HEAD~1 predated the file.)
  if ! git cat-file -e "$PIN_OLD":"$GUARD_BASE" 2>/dev/null; then
    ok "re-pin guard ($GUARD_BASE: initial pin at $PIN_OLD — no prior baseline, nothing to launder)"
  elif oldbase="$(git show "$PIN_OLD":$GUARD_BASE 2>/dev/null)"; then
    if [ -n "$PIN_NEW_FILE" ]; then newbase="$(cat "$PIN_NEW_FILE")"; else newbase="$(git show HEAD:$GUARD_BASE 2>/dev/null)"; fi
    if [ -z "$newbase" ]; then
      bad "re-pin guard (could not read the new baseline — refusing to certify)"
    else
    # Both versions on stdin with section markers (BSD awk rejects multiline -v
    # values — and that error initially made this guard fail OPEN; hence the
    # explicit exit-status check below).
    flips="$(printf '===OLD===\n%s\n===NEW===\n%s\n' "$oldbase" "$newbase" | awk -F'\t' '
      /^===OLD===$/ { sec = 1; next }
      /^===NEW===$/ { sec = 2; next }
      /^#/ { next }
      sec == 1 && $1 == "PASS" && NF >= 2 { oldpass[$2] = 1 }
      sec == 2 && $1 == "PASS" && NF >= 2 { nowpass[$2] = 1 }
      END { for (id in oldpass) if (!(id in nowpass)) print id }
    ')" ; awk_rc=$?
    if [ "$awk_rc" -ne 0 ]; then
      bad "re-pin guard (internal comparison error rc=$awk_rc — refusing to certify)"
    else
    flips="$(printf '%s\n' "$flips" | LC_ALL=C sort | grep -v '^$' || true)"
    pin_bad=0
    while read -r id; do
      [ -z "$id" ] && continue
      # Whole-token match on a `- Cases:` line only (tamper audit F3b: an
      # unanchored substring grep was satisfied by prose mentions and by any
      # LONGER id containing this one).
      if ! awk -v id="$id" '
            /^- Cases:/ { line = substr($0, 9); n = split(line, a, /[, ]+/)
                          for (i = 1; i <= n; i++) if (a[i] == id) found = 1 }
            END { exit !found }' docs/BUGS.md; then
        echo "  PASS→non-PASS flip not listed on any BUGS.md Cases: line: $id"; pin_bad=1
      fi
    done <<< "$flips"
    nfl="$(printf '%s' "$flips" | grep -c . || true)"
    if [ "$pin_bad" -ne 0 ]; then
      bad "re-pin guard (regressions baked into baseline unexplained — add them to a BUGS.md Cases: line)"
    else
      ok "re-pin guard ($nfl PASS→non-PASS flip(s), all listed in BUGS.md Cases)"
    fi
    fi
    fi
  else
    bad "re-pin guard (could not read $PIN_OLD baseline — refusing to certify the re-pin)"
  fi
fi

done

# Summary
printf '\n\033[1m══ scripts/ci summary ══\033[0m\n'
printf '%s\n' "${RESULTS[@]}"
if [ "$fail" -ne 0 ]; then
  printf '\n\033[1mRESULT: FAIL\033[0m\n'; exit 1
fi
printf '\n\033[1mRESULT: PASS\033[0m\n'
