#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

ARTIFACT_ROOT="${GOLEAN_COVERAGE_ARTIFACTS:-artifacts/coverage}"

usage() {
  cat >&2 <<'EOF'
usage: scripts/coverage [command] [filters]

Commands:
  run                 run executable differential coverage
  all                 run executable and compile-negative coverage
  list                list executable cases matching filters
  report              summarize artifacts/coverage/latest.tsv
  negative            run compile-negative coverage

Default command is "all".

Filters for run/list:
  <id> ...            exact executable case ids
  --id <id>           exact executable case id
  --prefix <prefix>   executable case id prefix
  --tag <tag>         required feature tag; repeat for intersection
  --status <status>   expected status filter
  --last-failed       rerun failures from artifacts/coverage/latest.tsv

Report options:
  --by tag|stage      group latest results by feature tag or failure stage
  --full              report artifacts/coverage/latest-full.tsv
EOF
}

manifest_args=()

run_exec() {
  local manifest
  manifest="$(mktemp "${TMPDIR:-/tmp}/golean-coverage.XXXXXX")"
  cleanup() {
    rm -f "$manifest"
  }
  trap cleanup RETURN

  if ! scripts/coverage-manifest --artifact-root "$ARTIFACT_ROOT" ${manifest_args+"${manifest_args[@]}"} > "$manifest"; then
    return 2
  fi

  local total_cases run_full filters
  total_cases="$(scripts/coverage-manifest --artifact-root "$ARTIFACT_ROOT" --list | wc -l | tr -d ' ')"
  if [[ "${#manifest_args[@]}" -eq 0 ]]; then
    run_full=true
    filters="-"
  else
    run_full=false
    printf -v filters '%q ' "${manifest_args[@]}"
    filters="${filters% }"
  fi

  GOLEAN_COVERAGE_TOTAL_CASES="$total_cases" \
  GOLEAN_COVERAGE_RUN_FULL="$run_full" \
  GOLEAN_COVERAGE_FILTERS="$filters" \
    scripts/diff-coverage "$manifest"
}

list_cases() {
  scripts/coverage-manifest --artifact-root "$ARTIFACT_ROOT" --list ${manifest_args+"${manifest_args[@]}"}
}

report_latest() {
  local by=""
  local full_report=0
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --full)
        full_report=1
        shift
        ;;
      --by)
        if [[ "$#" -lt 2 ]]; then
          echo "coverage report: --by requires tag or stage" >&2
          return 2
        fi
        by="$2"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        echo "coverage report: unknown option $1" >&2
        return 2
        ;;
    esac
  done

  local latest="$ARTIFACT_ROOT/latest.tsv"
  local meta="$ARTIFACT_ROOT/latest.meta.tsv"
  local report_status=0
  if [[ "$full_report" -eq 1 ]]; then
    latest="$ARTIFACT_ROOT/latest-full.tsv"
    meta="$ARTIFACT_ROOT/latest-full.meta.tsv"
  fi
  if [[ ! -f "$latest" ]]; then
    echo "coverage report: missing $latest; run scripts/coverage run first" >&2
    return 2
  fi
  if [[ -f "$meta" ]]; then
    local full_run filters total_cases manifest_cases
    full_run="$(awk -F '\t' '$1 == "full_run" { print $2 }' "$meta")"
    filters="$(awk -F '\t' '$1 == "filters" { print $2 }' "$meta")"
    total_cases="$(awk -F '\t' '$1 == "total_corpus_cases" { print $2 }' "$meta")"
    manifest_cases="$(awk -F '\t' '$1 == "manifest_cases" { print $2 }' "$meta")"
    if [[ "$full_run" != "true" ]]; then
      echo "coverage report: latest.tsv is not a full run; filters=${filters:-unknown}" >&2
    fi
    if [[ -n "$total_cases" && -n "$manifest_cases" && "$total_cases" != "$manifest_cases" ]]; then
      echo "coverage report: latest.tsv covers $manifest_cases of $total_cases corpus cases" >&2
    fi
    if [[ "$full_report" -eq 1 ]]; then
      local stored_manifest_sha current_manifest current_manifest_sha current_manifest_cases stored_commit current_commit current_dirty
      stored_manifest_sha="$(awk -F '\t' '$1 == "manifest_sha256" { print $2 }' "$meta")"
      stored_commit="$(awk -F '\t' '$1 == "git_commit" { print $2 }' "$meta")"
      current_manifest="$(mktemp "${TMPDIR:-/tmp}/golean-current-full-manifest.XXXXXX")"
      if scripts/coverage-manifest --artifact-root "$ARTIFACT_ROOT" > "$current_manifest"; then
        current_manifest_sha="$(shasum -a 256 "$current_manifest" | awk '{ print $1 }')"
        current_manifest_cases="$(awk -F '\t' 'NF > 0 && $1 !~ /^#/ { count += 1 } END { print count + 0 }' "$current_manifest")"
        if [[ -n "$stored_manifest_sha" && "$stored_manifest_sha" != "$current_manifest_sha" ]]; then
          echo "coverage report: latest-full.tsv is stale; current full manifest hash differs" >&2
          report_status=1
        fi
        if [[ -n "$manifest_cases" && "$manifest_cases" != "$current_manifest_cases" ]]; then
          echo "coverage report: latest-full.tsv has $manifest_cases case(s), current corpus has $current_manifest_cases" >&2
          report_status=1
        fi
      else
        echo "coverage report: could not regenerate current full manifest for staleness check" >&2
        report_status=1
      fi
      rm -f "$current_manifest"

      current_commit="$(git rev-parse HEAD 2>/dev/null || printf 'unknown')"
      if git diff --quiet -- . 2>/dev/null && git diff --cached --quiet -- . 2>/dev/null; then
        current_dirty=false
      else
        current_dirty=true
      fi
      if [[ -n "$stored_commit" && "$stored_commit" != "$current_commit" ]]; then
        echo "coverage report: latest-full.tsv was produced at git commit $stored_commit, current commit is $current_commit" >&2
        report_status=1
      fi
      if [[ "$current_dirty" == "true" ]]; then
        echo "coverage report: working tree is dirty; latest-full.tsv may not match current files" >&2
        report_status=1
      fi
    fi
  fi

  case "$by" in
    "")
      awk -F '\t' '
        NR == 1 { next }
        {
          total += 1
          counts[$1] += 1
        }
        END {
          printf "cases=%d pass=%d fail=%d\n", total, counts["PASS"] + 0, counts["FAIL"] + 0
        }
      ' "$latest"
      ;;
    tag)
      printf "tag\tpass\tfail\ttotal\n"
      awk -F '\t' '
        NR == 1 { next }
        {
          n = split($3, tags, ",")
          for (i = 1; i <= n; i++) {
            tag = tags[i]
            total[tag] += 1
            if ($1 == "PASS") pass[tag] += 1
            if ($1 == "FAIL") fail[tag] += 1
          }
        }
        END {
          for (tag in total) {
            printf "%s\t%d\t%d\t%d\n", tag, pass[tag] + 0, fail[tag] + 0, total[tag]
          }
        }
      ' "$latest" | sort
      ;;
    stage)
      printf "stage\tfail\n"
      awk -F '\t' '
        NR == 1 { next }
        $1 == "FAIL" { stage[$4] += 1; total += 1 }
        END {
          for (s in stage) {
            printf "%s\t%d\n", s, stage[s]
          }
          if (total == 0) {
            printf "-\t0\n"
          }
        }
      ' "$latest" | sort
      ;;
    *)
      echo "coverage report: unknown grouping $by" >&2
      return 2
      ;;
  esac
  return "$report_status"
}

cmd="${1:-all}"
case "$cmd" in
  run|all|list|report|negative|-h|--help)
    shift || true
    ;;
  *)
    cmd="all"
    ;;
esac

case "$cmd" in
  -h|--help)
    usage
    exit 0
    ;;
  report)
    report_latest "$@"
    exit $?
    ;;
  negative)
    negative_manifest="$(mktemp "${TMPDIR:-/tmp}/golean-negative-coverage.XXXXXX")"
    cleanup_negative() {
      rm -f "$negative_manifest"
    }
    trap cleanup_negative EXIT
    if ! scripts/coverage-negative-manifest "$@" > "$negative_manifest"; then
      exit 2
    fi
    scripts/coverage-negative "$negative_manifest"
    exit $?
    ;;
  run|list|all)
    manifest_args=("$@")
    ;;
esac

case "$cmd" in
  list)
    list_cases
    exit $?
    ;;
  run)
    run_exec
    exit $?
    ;;
  all)
    if [[ "$#" -ne 0 ]]; then
      echo "coverage all: filters are ambiguous across lanes; use 'scripts/coverage run ...' or 'scripts/coverage negative ...'" >&2
      exit 2
    fi
    run_exec
    diff_status=$?

    scripts/coverage-negative
    negative_status=$?

    echo
    echo "coverage lanes: differential=$diff_status negative=$negative_status"

    if [[ "$diff_status" -ne 0 || "$negative_status" -ne 0 ]]; then
      exit 1
    fi
    ;;
esac
