#!/usr/bin/env bash
# Gallery staleness check: docs/verified-examples.md vs the files it quotes.
#
# Every fenced block in the gallery that is preceded by a marker line
#
#     <!-- verbatim: <path> -->
#
# must appear in <path> byte-for-byte, as a CONTIGUOUS run of lines. That is
# the whole check: Go programs and harnesses quoted from the corpus, theorem
# statements quoted from the proof modules, and axiom pins quoted from
# proofs/Audit.lean cannot silently go stale.
#
# SPEEDBUMP, NOT A FORTRESS — DO NOT HARDEN. No Lean parsing, no AST, no
# semantic analysis, no attempt to check that an English claim matches its
# theorem (that is the reader's job, and the pre-merge audit's — it is the
# thing the gallery exists to make checkable BY HAND). If you find yourself
# adding a parser here, delete this script instead: a gate nobody can read
# in one sitting buys nothing this one doesn't.
#
# Standalone by design (2026-08-14): scripts/ci has no docs-check hook to
# hang this on, and the gallery is a docs artifact — run it when you touch
# an example module, a corpus example program, Audit.lean, or the gallery.
#
#   scripts/render-gallery [doc]     default doc: docs/verified-examples.md
#
# Plus ONE counting check, added 2026-08-16 (post-autonomy audit A1): each
# example section carries exactly one Fuel bound, one Status and one
# Ground. It exists because a merge spliced one entry's honesty half into
# its neighbour and every verbatim block still matched. See the comment at
# the check itself, including the instruction NOT to grow it.
#
# Exit codes: 0 = every block matches; 1 = DRIFT (each stale block printed
# with a diff) or a section-structure violation (the section named); 2 =
# structural problem (missing doc/source, marker with no block,
# unterminated fence, or zero blocks found — fail closed, because a
# check that silently verifies nothing is worse than no check).
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

DOC="${1:-docs/verified-examples.md}"
[ -f "$DOC" ] || { echo "render-gallery: FAIL — no gallery doc at $DOC" >&2; exit 2; }

WORK="$(mktemp -d "${TMPDIR:-/tmp}/render-gallery.XXXXXX")" || {
  echo "render-gallery: FAIL — could not create a temp dir" >&2; exit 2; }
trap 'rm -rf "$WORK"' EXIT

blocks=0
bad=0
structural=0

check_block() {  # $1 = source path, $2 = block file, $3 = doc line of the fence
  local path="$1" blk="$2" at="$3"
  local n first starts s e
  n="$(wc -l < "$blk" | tr -d ' ')"
  if [ "$n" -eq 0 ]; then
    echo "render-gallery: FAIL — $DOC:$at empty verbatim block" >&2
    structural=1; return
  fi
  if [ ! -f "$path" ]; then
    echo "render-gallery: FAIL — $DOC:$at quotes '$path', which does not exist" >&2
    structural=1; return
  fi
  first="$(head -1 "$blk")"
  starts="$(grep -n -F -x -- "$first" "$path" | cut -d: -f1)"
  if [ -z "$starts" ]; then
    echo "DRIFT $DOC:$at — first quoted line does not occur in $path:" >&2
    echo "    $first" >&2
    bad=1; return
  fi
  for s in $starts; do
    e=$((s + n - 1))
    if sed -n "${s},${e}p" "$path" | diff -q - "$blk" > /dev/null 2>&1; then
      return
    fi
  done
  echo "DRIFT $DOC:$at — $n quoted lines do not match $path (tried line(s): $(echo $starts | tr '\n' ' '))" >&2
  s="$(echo "$starts" | head -1)"; e=$((s + n - 1))
  echo "    (-) $path:$s..$e   (+) $DOC" >&2
  sed -n "${s},${e}p" "$path" | diff -u - "$blk" | tail -n +3 | sed 's/^/    /' >&2
  bad=1
}

src=""
pending=0
pending_line=0
in_block=0
fence_line=0
lineno=0
: > "$WORK/block"

while IFS= read -r line || [ -n "$line" ]; do
  lineno=$((lineno + 1))
  if [ "$in_block" -eq 1 ]; then
    case "$line" in
      '```'*)
        in_block=0
        blocks=$((blocks + 1))
        check_block "$src" "$WORK/block" "$fence_line"
        : > "$WORK/block"
        ;;
      *) printf '%s\n' "$line" >> "$WORK/block" ;;
    esac
    continue
  fi
  case "$line" in
    '<!-- verbatim: '*' -->')
      if [ "$pending" -eq 1 ]; then
        echo "render-gallery: FAIL — $DOC:$pending_line verbatim marker not followed by a fenced block" >&2
        structural=1
      fi
      src="${line#<!-- verbatim: }"; src="${src% -->}"
      pending=1; pending_line=$lineno
      ;;
    '```'*)
      if [ "$pending" -eq 1 ]; then
        in_block=1; fence_line=$lineno; pending=0; : > "$WORK/block"
      fi
      ;;
    '') ;;  # a blank line between marker and fence is fine
    *)
      if [ "$pending" -eq 1 ]; then
        echo "render-gallery: FAIL — $DOC:$pending_line verbatim marker not followed by a fenced block" >&2
        structural=1; pending=0
      fi
      ;;
  esac
done < "$DOC"

if [ "$in_block" -eq 1 ]; then
  echo "render-gallery: FAIL — $DOC:$fence_line unterminated fenced block" >&2
  structural=1
fi
if [ "$pending" -eq 1 ]; then
  echo "render-gallery: FAIL — $DOC:$pending_line verbatim marker not followed by a fenced block" >&2
  structural=1
fi
if [ "$blocks" -eq 0 ]; then
  echo "render-gallery: FAIL — no '<!-- verbatim: ... -->' blocks in $DOC (markers lost? this check would verify nothing)" >&2
  structural=1
fi

# SECTION STRUCTURE, the cheapest possible form (post-autonomy audit A1,
# 2026-08-16): an integration merge spliced dedup's honesty half into the
# palin section — dedup lost its Fuel/Status/Ground, palin carried two of
# each — and nothing noticed, because every verbatim block still matched.
# So: an example section — one that quotes a Corpus/ file or carries any
# of the three — must have exactly one of each, and at most one
# Domain-bounds. Both halves of a splice fire: the section that LOST its
# half reads 0/0/0 and the one that gained it reads 2/2/2.
# DO NOT HARDEN: no ordering rule, no content rule, no per-example
# knowledge, no cross-section reasoning. If this ever wants to know what a
# section MEANS, delete it instead.
if ! awk 'function chk(){if(n>0&&(f!=1||s!=1||g!=1||d>1)){
      printf "render-gallery: SECTION STRUCTURE — %s (Fuel=%d Status=%d Ground=%d Domain=%d, want 1/1/1 and <=1)\n",h,f,s,g,d>"/dev/stderr";bad=1}}
  /^## /{chk();h=substr($0,4);f=s=g=d=n=0;next}
  /^<!-- verbatim: Corpus\//{n++}
  /^\*\*Fuel bound/{f++;n++} /^\*\*Status/{s++;n++} /^\*\*Ground/{g++;n++} /^\*\*Domain bounds/{d++}
  END{chk();exit bad}' "$DOC"; then
  echo "render-gallery: FAIL — section structure (see above); an entry lost or doubled its Fuel/Status/Ground" >&2
  exit 1
fi

if [ "$structural" -ne 0 ]; then
  echo "render-gallery: FAIL (structural — see above)" >&2
  exit 2
fi
if [ "$bad" -ne 0 ]; then
  echo "render-gallery: FAIL — gallery is STALE ($blocks blocks checked; drifted ones listed above)" >&2
  exit 1
fi
echo "render-gallery: ok — $blocks verbatim blocks match their sources"
exit 0
