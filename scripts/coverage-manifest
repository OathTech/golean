#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

EXEC_ROOT="Corpus/coverage/exec"
ARTIFACT_ROOT="${GOLEAN_COVERAGE_ARTIFACTS:-artifacts/coverage}"
LIST_ONLY=0
STATUS_FILTER=""
PREFIX_FILTER=""
TAG_FILTERS=()
EXACT_IDS=()
TAG_FILTER_COUNT=0
EXACT_ID_COUNT=0
LAST_FAILED=0

usage() {
  cat >&2 <<'EOF'
usage: scripts/coverage-manifest [options] [<id> ...]

Options:
  --list              print ids and metadata instead of normalized manifest rows
  --id <id>           include one exact id
  --prefix <prefix>   include ids under a prefix
  --tag <tag>         require a feature tag; repeat for intersection
  --status <status>   include rows with expected Go status: ok or panic
  --last-failed       include ids that failed in artifacts/coverage/latest.tsv
  --exec-root <dir>   executable corpus root
  --artifact-root <dir>
                      artifact root used to derive Gobra JSON paths
EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --list)
      LIST_ONLY=1
      shift
      ;;
    --id)
      if [[ "$#" -lt 2 ]]; then
        echo "coverage-manifest: --id requires an argument" >&2
        exit 2
      fi
      EXACT_IDS+=("$2")
      EXACT_ID_COUNT=$((EXACT_ID_COUNT + 1))
      shift 2
      ;;
    --prefix)
      if [[ "$#" -lt 2 ]]; then
        echo "coverage-manifest: --prefix requires an argument" >&2
        exit 2
      fi
      PREFIX_FILTER="$2"
      shift 2
      ;;
    --tag)
      if [[ "$#" -lt 2 ]]; then
        echo "coverage-manifest: --tag requires an argument" >&2
        exit 2
      fi
      TAG_FILTERS+=("$2")
      TAG_FILTER_COUNT=$((TAG_FILTER_COUNT + 1))
      shift 2
      ;;
    --status)
      if [[ "$#" -lt 2 ]]; then
        echo "coverage-manifest: --status requires an argument" >&2
        exit 2
      fi
      STATUS_FILTER="$2"
      shift 2
      ;;
    --last-failed)
      LAST_FAILED=1
      shift
      ;;
    --exec-root)
      if [[ "$#" -lt 2 ]]; then
        echo "coverage-manifest: --exec-root requires an argument" >&2
        exit 2
      fi
      EXEC_ROOT="$2"
      shift 2
      ;;
    --artifact-root)
      if [[ "$#" -lt 2 ]]; then
        echo "coverage-manifest: --artifact-root requires an argument" >&2
        exit 2
      fi
      ARTIFACT_ROOT="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [[ "$#" -gt 0 ]]; do
        EXACT_IDS+=("$1")
        EXACT_ID_COUNT=$((EXACT_ID_COUNT + 1))
        shift
      done
      ;;
    -*)
      echo "coverage-manifest: unknown option $1" >&2
      usage
      exit 2
      ;;
    *)
      EXACT_IDS+=("$1")
      EXACT_ID_COUNT=$((EXACT_ID_COUNT + 1))
      shift
      ;;
  esac
done

if [[ "$LAST_FAILED" -eq 1 ]]; then
  latest="$ARTIFACT_ROOT/latest.tsv"
  if [[ ! -f "$latest" ]]; then
    echo "coverage-manifest: --last-failed requires $latest" >&2
    exit 2
  fi
  while IFS=$'\t' read -r result id _features _stage _detail _extra; do
    if [[ "$result" == "FAIL" && -n "$id" ]]; then
      EXACT_IDS+=("$id")
      EXACT_ID_COUNT=$((EXACT_ID_COUNT + 1))
    fi
  done < "$latest"
  if [[ "$EXACT_ID_COUNT" -eq 0 ]]; then
    echo "coverage-manifest: no failed cases in $latest" >&2
    exit 1
  fi
fi

if [[ ! -d "$EXEC_ROOT" ]]; then
  echo "coverage-manifest: executable corpus root not found: $EXEC_ROOT" >&2
  exit 2
fi

contains_exact_id() {
  local wanted="$1"
  if [[ "$EXACT_ID_COUNT" -eq 0 ]]; then
    return 0
  fi
  local id
  for id in "${EXACT_IDS[@]}"; do
    if [[ "$id" == "$wanted" ]]; then
      return 0
    fi
  done
  return 1
}

has_tag() {
  local features="$1"
  local tag="$2"
  [[ ",$features," == *",$tag,"* ]]
}

include_case() {
  local full_id="$1"
  local status="$2"
  local features="$3"

  contains_exact_id "$full_id" || return 1
  if [[ -n "$PREFIX_FILTER" && "$full_id" != "$PREFIX_FILTER"* ]]; then
    return 1
  fi
  if [[ -n "$STATUS_FILTER" && "$status" != "$STATUS_FILTER" ]]; then
    return 1
  fi
  local tag
  if [[ "$TAG_FILTER_COUNT" -gt 0 ]]; then
    for tag in "${TAG_FILTERS[@]}"; do
      has_tag "$features" "$tag" || return 1
    done
  fi
  return 0
}

seen_ids=""
emitted=0
bad=0

while IFS= read -r cases_file; do
  rel="${cases_file#"$EXEC_ROOT"/}"
  rel="${rel%/cases.tsv}"
  go_dir="$EXEC_ROOT/$rel"
  if [[ ! -f "$go_dir/main.go" ]]; then
    echo "coverage-manifest: missing $go_dir/main.go" >&2
    bad=1
    continue
  fi

  while IFS=$'\t' read -r row_id subject args expected_status expected_reason features extra; do
    if [[ -z "${row_id:-}" || "$row_id" == \#* ]]; then
      continue
    fi
    if [[ -n "${extra:-}" ]]; then
      echo "coverage-manifest: $cases_file: too many tab-separated fields" >&2
      bad=1
      continue
    fi
    if [[ -z "${subject:-}" || -z "${args:-}" || -z "${expected_status:-}" || -z "${expected_reason:-}" || -z "${features:-}" ]]; then
      echo "coverage-manifest: $cases_file: expected 6 tab-separated fields" >&2
      bad=1
      continue
    fi
    case "$expected_status" in
      ok|panic) ;;
      *)
        echo "coverage-manifest: $cases_file: invalid expected Go status $expected_status; use ok or panic" >&2
        bad=1
        continue
        ;;
    esac
    case "$expected_status" in
      panic)
        if [[ "$expected_reason" == "-" ]]; then
          echo "coverage-manifest: $cases_file: $expected_status requires expected_reason" >&2
          bad=1
          continue
        fi
        ;;
      *)
        if [[ "$expected_reason" != "-" ]]; then
          echo "coverage-manifest: $cases_file: unexpected expected_reason for $expected_status" >&2
          bad=1
          continue
        fi
        ;;
    esac

    if [[ "$row_id" == "-" ]]; then
      full_id="$rel"
    else
      full_id="$rel/$row_id"
    fi
    seen_ids="$seen_ids $full_id"
    include_case "$full_id" "$expected_status" "$features" || continue

    emitted=$((emitted + 1))
    if [[ "$LIST_ONLY" -eq 1 ]]; then
      printf '%s\t%s\t%s\t%s\t%s\n' "$full_id" "$expected_status" "$features" "$go_dir" "$subject"
    else
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$full_id" \
        "$go_dir" \
        "$ARTIFACT_ROOT/work/$full_id/main.go.internal.json" \
        "$subject" \
        "$args" \
        "$expected_status" \
        "$features" \
        "$expected_reason"
    fi
  done < "$cases_file"
done < <(find "$EXEC_ROOT" -name cases.tsv -print | sort)

if [[ "$bad" -ne 0 ]]; then
  exit 2
fi

missing=0
if [[ "$EXACT_ID_COUNT" -gt 0 ]]; then
  for id in "${EXACT_IDS[@]}"; do
    if [[ " $seen_ids " != *" $id "* ]]; then
      echo "coverage-manifest: no executable case id $id" >&2
      missing=1
    fi
  done
fi
if [[ "$missing" -ne 0 ]]; then
  exit 2
fi

if [[ "$emitted" -eq 0 ]]; then
  echo "coverage-manifest: no executable cases matched filters" >&2
  exit 1
fi
