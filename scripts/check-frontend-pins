#!/usr/bin/env bash
# check-frontend-pins — the two SEMANTICS-side pins that lived inside
# scripts/check-golden before the repo split (2026-08-31) and were
# restored at the split's audit (findings A1/A2, B1/B8: both run
# entirely on tools/nativefrontend + the golean binary + checked-in
# baselines — no proofs dependency; parking them with check-golden was
# a misclassification; docs/2026-08-31_repo-split-plan.md, fix round).
# Baselines re-homed baselines/golden/ -> baselines/pins/ (golden/ was
# the proofs-side pin directory and left with that product).
#
#   1. Deviation-observation pin (init slice audit response 2026-08-05,
#      C2): init/hidden-dep-order is the recorded hidden-dependency
#      initialization-order deviation — the spec leaves the order
#      unspecified, our realized order (go/types InitOrder) differs
#      from gc's, and the differential red only says "≠ gc"; a drift
#      to ANY third order would read identically there. This pin
#      asserts the order WE realize, end-to-end (frontend InitOrder
#      emission → decoder → seeded driver run), against the checked-in
#      observation. Re-pin deliberately, with the reason, only on a
#      DECIDED order change.
#   2. Twin wire pin (campaign Arc 1, U-c5): a fresh frontend emit
#      over the canonical raft-twin assembly (the raftsubject/
#      packages + tools/raftsubject's twin-lib + chdriver + thin main)
#      must reproduce the pinned wire byte-for-byte. On main this is
#      the ONLY gate exercising the frontend on the real raft subject
#      packages (the Lean-side consumer of these bytes is parked).
#      Re-pin deliberately with the reason on any frontend/subject
#      change.
#      Re-pin history: 2026-09-03 (lane q-trylock) 45cd882a… → f2309df2…
#      (re-derived at the lane's audit fix round after the rebase onto
#      main 221d8964; the pre-rebase pair was eef32142… → c824f9e4…)
#      — Q-TRYLOCK: the twin's `sync.Mutex` stub method set entry
#      `TryLock` (methods[518] on the rebased tree, [515] before) gained
#      its bodied stub (the same `sync-op
#      tryLock` node the direct forms emit — identity principle); the
#      SOLE structural change (enumerated by a JSON diff, evidence dir
#      docs/evidence/2026-09-03_q-trylock/). Raft never calls TryLock;
#      the move is the stub policy's, [USER]-ruled (A) 2026-09-03 —
#      «we should break things rather than preserve incorrect behavior»
#      (relayed by the [AGENT] coordinator).
#      Re-pin history: 2026-09-04 (lane stdlib-source-2, landed at the
#      round-10 merge train) f2309df2… → 69a538de… — RE-DERIVED on the
#      rebased tree (the lane's own pin was 45cd882a… → 6a9ef8bb…; both
#      sides had moved the pin, so neither's bytes were taken): stdlib
#      source-through slice 2 — 6 hand-written shim bodies out
#      (quorum.goleanShimStringsRepeat{,Bound}, raft.goleanShim{BytesEqual,
#      LEPutUint64,LEUint64,StringsJoin}), the 18 reached library functions
#      + bytes.Buffer/binary.littleEndian/slices.xorshift methods in; the
#      TryLock stub above present on both sides. [USER]-authorized by G9 +
#      ruling (a) (relayed); structural diff + hashes in
#      docs/evidence/2026-09-03_stdlib-source-2/twin-{structural-diff,pin}-round10*.
#      Re-pin history: 2026-09-04 (lane fr24, checkpoint C) 69a538de… →
#      b4458244… — the cmp.Compare kind-dispatch desugar RETIRED per the
#      [USER] ruling (Mike 2026-09-04, relayed by the coordinator, cited
#      as relayed: «(2) given we have a plan, I think this should be an
#      honest red»): the three dead injected shims
#      quorum.goleanShimCmpCompare{Int,String,Uint} (planted by the
#      file-presence scan for majority.go's cmp.Compare calls inside the
#      H-3-quarantined MajorityConfig.Describe; referenced by no body)
#      leave the wire — the SOLE change (0 added, 0 changed; enumerated
#      by a JSON diff, docs/evidence/2026-09-04_fr24-fr25/twin-repin-C/).
#      Re-pin history: 2026-09-04 (lane fr4-rowm, memo §3 row M — the
#      `slices.Sort` machine-op intercept RETIRED; the G1-G9 stdlib plan
#      ruled «(3) agree, go ahead with the plan» [USER], relayed)
#      b4458244… → 4ee39f73…: the twin's nine `slices.Sort` sites
#      (quorum.MajorityConfig.{CommittedIndex,Slice,String},
#      tracker.ProgressTracker.{LearnerNodes,Visit,VoterNodes},
#      tracker.ProgressMap.String, raft.raft.campaign,
#      raftpb.ConfState.Equivalent$lit0) lose their `sort-slice` machine-op
#      node for a static call to the real `slices.Sort[[]uint64,uint64]`
#      stencil, and the pdqsort closure joins the wire (16 funcs added:
#      slices.{Sort,pdqsortOrdered,…}[uint64], cmp.{Less,isNaN}[uint64]);
#      0 removed, 0 types/globals changed, 0 `sort-slice` nodes remain
#      (enumerated by a JSON diff, docs/evidence/2026-09-04_fr4-rowm/
#      twin-repin/structural-diff.txt).
#      Re-pin history: 2026-09-05 (lane fr19-bug097 — FR-19 scope-ordinal
#      TypeIds, BUG-097 path-keyed anonymous interfaces, BUG-059 display
#      records; docs/2026-09-05_fr19-bug097-design.md) 4ee39f73… →
#      f89e1c9e…: (1) every one of the 92 TypeDefs gains `display`/`pkg`
#      (def bytes identical); (2) quorum.MajorityConfig.Describe — an H-3
#      stub since the cmp retirement (its function-local `tup` reached
#      `slices.SortFunc` and mono.go's C6 refusal) — LOWERS: a function
#      instantiation at a local type is identity-only, so `quorum.tup·1`
#      joins the types and 20 funcs join the wire (Describe's 2 literals +
#      fmt shim, slices.SortFunc/pdqsortCmpFunc/… ×15 at [quorum.tup·1],
#      cmp.Compare[quorum.Index], cmp.Compare[uint64], cmp.isNaN[quorum.Index]);
#      (3) the 208 funcs / 203 methods otherwise "changed" differ ONLY by
#      program-wide temporary renumbering ($cN/$swfN/$swiN/$tsN — Describe's
#      body now consumes counters ahead of them; 3214 + 2802 leaf changes,
#      all of that class, 0 other). 0 removed, 0 globals changed; +1
#      methodSet (`quorum.tup·1`, full — a section the first structural
#      diff omitted; added at the audit fix round R12, producer tracked:
#      docs/evidence/2026-09-05_fr19-bug097/twin-repin/twin-structural-diff.py,
#      output structural-diff.txt beside it).
#      Re-pin history: 2026-09-05 (lane c-arc-c2, gate G-C2 — RULED
#      [USER] 2026-09-04 as recommended, CONFIRMED [USER] 2026-09-05,
#      both relayed by the [AGENT] coordinator, cited as relayed)
#      4ee39f73… → d2bcb07b…: the wire's `types` table is now emitted
#      in DEPENDENCY ORDER (struct fields / defined targets, through
#      array elements, refer only to EARLIER entries; the decoder
#      refuses anything else — `TypeEnv.WellFounded`, the `Accepted`
#      clause). The SOLE change is a PERMUTATION of the 92 type entries
#      (36 moved, same multiset, byte-equal per entry; the pinned order
#      had 12 order-contract violations, e.g. raft.raftLog before its
#      field type raft.entryEncodingSize); funcs, methods, methodSets,
#      globals, fileOrder IDENTICAL (docs/evidence/2026-09-05_c-arc-c2/
#      twin-repin/). Design note docs/2026-09-05_c-arc-c2-design.md.
#      Re-pin history: 2026-09-05 (round-17 merge train, lane c-arc-c2
#      rebased onto main cf858f0f — round-17 rebase: fr19 display/pkg
#      fields × c2 dependency order) f89e1c9e… → a9a2e2b1…: a FRESH
#      EMIT from the MERGED frontend over the twin assembly, never a
#      merge result (the lane's own pin 4ee39f73… → d2bcb07b… above was
#      taken from the pre-fr19 frontend; neither side's bytes were
#      kept). Structural diff against main's f89e1c9e… (order-aware,
#      docs/evidence/2026-09-05_c-arc-c2/twin-repin/round17-*): `types`
#      is a PERMUTATION of the 93 entries (the fr19 92 + quorum.tup·1),
#      36 moved — the same 36 the lane moved, quorum.tup·1 not among
#      them — byte-equal per entry, every entry carrying fr19's
#      display/pkg on BOTH sides (12 order-contract violations in
#      main's table, 0 in the new one); funcs, methods, methodSets,
#      globals, fileOrder, package, schema IDENTICAL including order.
#      Expected classes only (fr19's fields, c2's order); nothing else.
#      Re-pin history: 2026-09-05 (lane e13-b — latitude E13 option (b),
#      RULED [USER] Mike 2026-09-05, relayed by the [AGENT] coordinator,
#      cited as relayed: «we should do what the standard supports, and avoid
#      over-refusal if we can. That's what (b) means right?») 4ee39f73… →
#      11270c55…: the frontend now emits an `unseq-probe` statement at the
#      lexical position of every panicky non-call operand (here: 119
#      `field-get` operands — pointer-selector reads such as `pr.Match`)
#      that has a sibling ordered event lexically after it, so the machine
#      realizes BOTH spec-unsequenced orders (`ChoiceSite.unseqPanic`) —
#      the SOLE structural change (7 funcs + 33 methods gain probe
#      statements; 0 added/removed/other changes; enumerated by a JSON
#      diff, docs/evidence/2026-09-05_e13-b/twin-repin/). Raft's twin
#      driver reaches no early panic on these operands, so the twin's
#      observations are unchanged (the probe pops only on a panic).
#      Design: docs/2026-09-05_e13-b-design.md §4/§7.
#      Re-pin history: 2026-09-05 (round-17 merge train, lane e13-b rebased
#      onto main 9343a310 — round-17 rebase: e13-b probes × landed
#      fr19/b4/c2) a9a2e2b1… → 31fb50dc…: a FRESH EMIT from the MERGED frontend
#      over the twin assembly at this rebased commit, never a merge result
#      (the lane's own pin above was taken from the pre-fr19/pre-c2
#      frontend; neither side's bytes were kept). Structural diff against
#      main's a9a2e2b1… (order-aware, docs/evidence/2026-09-05_e13-b/
#      twin-repin/round17-*): 7 funcs + 33 methods gain `unseq-probe`
#      statements (119 in total); stripping every probe yields main's
#      a9a2e2b1… (structural identity incl. order); types (93 entries,
#      fr19's display/pkg, c2's dependency order), globals, methodSets,
#      fileOrder, package, schema IDENTICAL. Expected classes only (this
#      lane's probes); nothing else. Later commits of the lane re-emit
#      at each rebased commit — the entries below record each hash.
#
# Fail-closed throughout: missing baseline, failed build, failed emit,
# failed run, or any byte drift exits 1 naming the failing pin.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/check-frontend-pins.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

lake build golean > /dev/null \
  || { echo "check-frontend-pins: FAIL — golean build failed (fail closed)" >&2; exit 1; }

# ---- 1. Deviation-observation pin ----
DEV_SRC="Corpus/coverage/exec/init/hidden-dep-order"
DEV_BASE="baselines/pins/hidden-dep-order.observation.json"
DEV_FUNC="hiddenDepOrder"
[ -f "$DEV_BASE" ] || { echo "check-frontend-pins: FAIL — no baseline at $DEV_BASE" >&2; exit 1; }
# --allow-hidden-dep-init-order: the E7 detector (t1-fidelity-fixes,
# 2026-08-31) refuses hidden-dep-shape programs; this pinned deviation
# case is the ONE recorded exception, allowed explicitly here in the
# apparatus (the detector's finding still prints as a warning).
GO111MODULE=off go run ./tools/nativefrontend --allow-hidden-dep-init-order --dir "$DEV_SRC" --out "$WORK/deviation.wire.json" \
  || { echo "check-frontend-pins: FAIL [hidden-dep-order] — frontend emit failed (fail closed)" >&2; exit 1; }
.lake/build/bin/golean native-json-run --input "$WORK/deviation.wire.json" --function "$DEV_FUNC" \
  > "$WORK/deviation.obs" \
  || { echo "check-frontend-pins: FAIL [hidden-dep-order] — machine run failed (fail closed)" >&2; exit 1; }
if ! diff -q "$DEV_BASE" "$WORK/deviation.obs" > /dev/null; then
  echo "check-frontend-pins: FAIL [hidden-dep-order] — the REALIZED hidden-dependency init order drifted from the recorded deviation pin:" >&2
  diff "$DEV_BASE" "$WORK/deviation.obs" | head -10 >&2
  exit 1
fi
echo "check-frontend-pins: ok [hidden-dep-order] — realized deviation order matches the recorded pin"

# ---- 2. Twin wire pin ----
TWIN_BASE="baselines/pins/twin-chdriver.wire.json"
[ -f "$TWIN_BASE" ] || { echo "check-frontend-pins: FAIL — no wire pin at $TWIN_BASE" >&2; exit 1; }
TWIN_PROG="$WORK/twin-prog"
mkdir -p "$TWIN_PROG"
for pkg in quorum raftpb tracker proto confchange raft; do
  cp -r "raftsubject/$pkg" "$TWIN_PROG/" \
    || { echo "check-frontend-pins: FAIL [twin-wire] — subject package $pkg missing" >&2; exit 1; }
done
for f in twin-lib.go twin-chdriver.go twin-chdriver-main.go; do
  cp "tools/raftsubject/$f" "$TWIN_PROG/" \
    || { echo "check-frontend-pins: FAIL [twin-wire] — $f missing" >&2; exit 1; }
done
GO111MODULE=off go run ./tools/nativefrontend --dir "$TWIN_PROG" --out "$WORK/twin.wire.json" \
  || { echo "check-frontend-pins: FAIL [twin-wire] — frontend emit failed (fail closed)" >&2; exit 1; }
if ! cmp -s "$TWIN_BASE" "$WORK/twin.wire.json"; then
  echo "check-frontend-pins: FAIL [twin-wire] — fresh frontend emit differs from the pinned wire (frontend or subject drifted; re-pin deliberately with the reason):" >&2
  echo "  pinned: $(sha256sum "$TWIN_BASE" | cut -d' ' -f1)" >&2
  echo "  fresh:  $(sha256sum "$WORK/twin.wire.json" | cut -d' ' -f1)" >&2
  exit 1
fi
echo "check-frontend-pins: ok [twin-wire] — fresh emit = pinned wire ($(sha256sum "$TWIN_BASE" | cut -c1-12)…)"

# ---- 3. Stdlib library pin (stdlib source-through, slice 1 — 2026-09-03) ----
# baselines/stdlib-pin.tsv is the sha256 of every GOROOT source file the
# frontend SELECTS for an allowed library package (oracle build context +
# tools/nativefrontend/stdlib-substitutions.tsv). The frontend itself
# refuses at every emit whose selected file differs from the pin; THIS
# check catches the other direction — a stale pin (a row for a file no
# longer selected, a selected file with no row) — by regenerating the
# manifest from the pinned checkout and comparing byte-for-byte. Re-pin
# only with an oracle re-pin, a full differential, and a written reason
# (docs/2026-09-03_stdlib-boundary-design.md §2.1.3; G3/G9 ruled).
STDLIB_PIN="baselines/stdlib-pin.tsv"
[ -f "$STDLIB_PIN" ] || { echo "check-frontend-pins: FAIL — no library pin at $STDLIB_PIN" >&2; exit 1; }
if ! GO111MODULE=off go run ./tools/nativefrontend --stdlib-pin-manifest > "$WORK/stdlib-pin.fresh" 2>"$WORK/stdlib-pin.err"; then
  cat "$WORK/stdlib-pin.err" >&2
  echo "check-frontend-pins: FAIL [stdlib-pin] — the pin manifest could not be regenerated (deps/go missing or off the pin; fail closed)" >&2
  exit 1
fi
if ! cmp -s "$STDLIB_PIN" "$WORK/stdlib-pin.fresh"; then
  echo "check-frontend-pins: FAIL [stdlib-pin] — $STDLIB_PIN differs from a fresh manifest of the pinned GOROOT source (stale pin, moved checkout, or edited library text; re-pin deliberately with the reason):" >&2
  diff "$STDLIB_PIN" "$WORK/stdlib-pin.fresh" | head -10 >&2
  exit 1
fi
rows="$(grep -vc '^#' "$STDLIB_PIN")"
echo "check-frontend-pins: ok [stdlib-pin] — $rows lowered stdlib source files match the pinned sha256 manifest"
