#!/usr/bin/env bash
# Stage-alternation SURVIVAL across a baseline re-pin (audit fix 4 of the
# guard-stage-alt lane, 2026-09-03). scripts/ci's re-pin guards read only
# RESULT (col 1) and id (col 2); a baseline regenerated from latest.tsv
# would therefore drop an alternation row's `|` set and its `# reason:`
# block with nothing red — and the exact-match flake the alternation
# exists for would be back. Rule: every id whose stage is an alternation
# (`a|b`) in OLD must still carry an alternation in NEW, unless NEW names
# the removal in a header comment `# alternation removed: <id> — <why>`.
#
# Usage: scripts/check-alternation-survival <old> <new>
#   <old>/<new> are a file path or `git:<rev>:<path>` (read via git show).
# Exit 0 = every OLD alternation survives (or is named removed; each named
#   removal is printed as a note). Exit 1 = at least one dropped silently
#   (ids printed). Exit 2 = an input could not be read (fail closed).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
[ $# -eq 2 ] || { echo "usage: $0 <old> <new>   (file path or git:<rev>:<path>)" >&2; exit 2; }

slurp() {  # $1 spec -> contents on stdout; exit 2 if unreadable
  case "$1" in
    git:*) local spec="${1#git:}"; git show "$spec" 2>/dev/null || { echo "check-alternation-survival: cannot read $1" >&2; exit 2; } ;;
    *)     [ -f "$1" ] || { echo "check-alternation-survival: no file $1" >&2; exit 2; }; cat "$1" ;;
  esac
}
old="$(slurp "$1")"; new="$(slurp "$2")"

rc=0
out="$(printf '===OLD===\n%s\n===NEW===\n%s\n' "$old" "$new" | awk -F'\t' '
  /^===OLD===$/ { sec = 1; next }
  /^===NEW===$/ { sec = 2; next }
  sec == 2 && /^# alternation removed: / {
    line = substr($0, 23); sub(/[ \t]+—.*$/, "", line); sub(/[ \t]+$/, "", line); sub(/^[ \t]+/, "", line)
    removed[line] = $0; next
  }
  /^#/ { next }
  $1 == "result" { next }
  sec == 1 && NF >= 3 && index($3, "|") > 0 { oldalt[$2] = $1 "/" $3 }
  sec == 2 && NF >= 3 && index($3, "|") > 0 { newalt[$2] = 1 }
  END {
    for (id in oldalt) {
      if (id in newalt) continue
      if (id in removed) { print "NOTE\t" id "\talternation [" oldalt[id] "] removed, named by the header: " removed[id]; continue }
      print "DROPPED\t" id "\talternation [" oldalt[id] "] is not an alternation in the new baseline and no `# alternation removed: " id "` header names the removal"
      bad = 1
    }
    if (bad) exit 1
  }')" || rc=$?
if [ "$rc" -ge 2 ]; then
  echo "check-alternation-survival: internal comparison error (awk rc=$rc) — refusing to certify" >&2
  { printf '%s\n' "$out" | grep . >&2; } || true
  exit 2
fi
{ printf '%s\n' "$out" | grep . | LC_ALL=C sort; } || true
if [ "$rc" -eq 1 ]; then
  echo "check-alternation-survival: FAIL — stage alternation(s) dropped without a named removal (add \`# alternation removed: <id> — <why>\` to the new baseline header, or restore the row's alternation and its # reason: block)"
  exit 1
fi
exit 0
