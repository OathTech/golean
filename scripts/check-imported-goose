#!/usr/bin/env bash
# Standing verbatim-import guard for the imported-goose corpus lane
# (goose-parity phase-A checkpoint fix, 2026-08-08; mold: check-golden —
# re-verify a LANDED artifact against its source, fail closed).
#
# For EVERY landed case under Corpus/coverage/exec/imported-goose/, checks
# that the above-marker region of main.go is byte-identical to the upstream
# goose sources its provenance header names, at the PINNED rev:
#   1. every `// source: <path> @ <rev>` line must carry the pinned rev;
#   2. expected body := concatenation, in header order, of
#      `git -C deps/goose show <rev>:testdata/...` with the first
#      `^package` line removed;
#   3. got body := main.go from after the generated header + `package main`
#      up to the `// --- GoLean harness ---` marker;
#   4. compare with trailing-blank-line runs normalized (the assembly
#      inserts single separator blanks; comparison is on the sequence of
#      non-degenerate lines exactly as the checkpoint verifier's method).
# Any drift, any missing marker/header, a missing/wrong-rev deps/goose
# checkout, or an unreadable upstream blob FAILS (exit 1) — a tampered or
# hand-edited imported main.go must never pass silently ("do not edit
# canonical Go to make something pass" is the invariant this arms).
#
# Fixture overrides (scripts/test-import-goose): --corpus-root, --goose-root,
# --expect-rev.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

PINNED_REV="3be88bbb4982f58e5813b6f0344302d5582c8e8a"
# go preflight (round 4: the parser-based import vet needs the same
# toolchain the differential oracle already requires).
command -v go >/dev/null 2>&1 || { echo "check-imported-goose: FAIL — go not found (the import vet is go/parser-based)" >&2; exit 2; }
LSIMPORTS="$(mktemp "${TMPDIR:-/tmp}/golean-lsimports.XXXXXX")"
trap 'rm -f "$LSIMPORTS"' EXIT
if ! buildmsg="$(GO111MODULE=off GOCACHE="${GOCACHE:-$PWD/artifacts/go-build-cache}" \
    go build -o "$LSIMPORTS" "$PWD/tools/lsimports/main.go" 2>&1)"; then
  echo "check-imported-goose: FAIL — cannot build tools/lsimports (the import vet): $buildmsg" >&2
  exit 2
fi

CORPUS_ROOT="Corpus/coverage/exec/imported-goose"
GOOSE_ROOT="deps/goose"
EXPECT_REV="$PINNED_REV"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --corpus-root) CORPUS_ROOT="$2"; shift 2 ;;
    --goose-root) GOOSE_ROOT="$2"; shift 2 ;;
    --expect-rev) EXPECT_REV="$2"; shift 2 ;;
    *) echo "check-imported-goose: unknown arg $1" >&2; exit 2 ;;
  esac
done

fail=0
checked=0

if [[ ! -d "$CORPUS_ROOT" ]]; then
  # An empty lane is legitimately guard-free (pre-population state).
  echo "check-imported-goose: ok (no imported-goose lane at $CORPUS_ROOT)"
  exit 0
fi

if ! git -C "$GOOSE_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  echo "check-imported-goose: FAIL — $GOOSE_ROOT is not a git checkout; the" >&2
  echo "  verbatim guard cannot run (fail closed — clone goose at the pinned" >&2
  echo "  rev $EXPECT_REV; see CLAUDE.md 'Reference checkouts')" >&2
  exit 1
fi

# Normalize: drop trailing blank lines and collapse nothing else (the
# checkpoint verifier's comparison: exact bytes modulo trailing blanks).
strip_trailing_blanks() { sed -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}'; }

TMP="$(mktemp -d "${TMPDIR:-/tmp}/check-imported-goose.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

while IFS= read -r main_go; do
  case_dir="${main_go%/main.go}"
  rel="${case_dir#"$CORPUS_ROOT"/}"
  checked=$((checked + 1))

  if ! grep -q '^// --- GoLean harness ---$' "$main_go"; then
    echo "check-imported-goose: FAIL [$rel] — no harness marker line" >&2
    fail=1
    continue
  fi

  # Provenance sources, in header order; every one must be at EXPECT_REV.
  mapfile -t src_lines < <(grep -E '^// source: ' "$main_go")
  if [[ ${#src_lines[@]} -eq 0 ]]; then
    echo "check-imported-goose: FAIL [$rel] — no provenance source lines" >&2
    fail=1
    continue
  fi

  : > "$TMP/want"
  bad_case=0
  for line in "${src_lines[@]}"; do
    path="${line#// source: }"
    rev="${path##* @ }"
    path="${path% @ *}"
    if [[ "$rev" != "$EXPECT_REV" ]]; then
      echo "check-imported-goose: FAIL [$rel] — source '$path' pinned at $rev, expected $EXPECT_REV" >&2
      bad_case=1
      break
    fi
    if ! git -C "$GOOSE_ROOT" show "$rev:$path" > "$TMP/blob" 2>/dev/null; then
      echo "check-imported-goose: FAIL [$rel] — cannot read $path @ ${rev:0:7} from $GOOSE_ROOT" >&2
      bad_case=1
      break
    fi
    echo "" >> "$TMP/want"
    awk '!done && /^package[ \t]/ { done=1; next } { print }' "$TMP/blob" >> "$TMP/want"
  done
  if [[ "$bad_case" -ne 0 ]]; then
    fail=1
    continue
  fi

  # Got: above-marker region minus the generated header and package clause.
  sed -n '1,/^\/\/ --- GoLean harness ---$/p' "$main_go" \
    | sed '/^\/\/ --- GoLean harness ---$/d' \
    | sed '/^\/\/ GoLean imported-goose corpus case/d; /^\/\/ source: /d; /^\/\/ imported: /d; /^\/\/ transform: /d; /^\/\/ GoLean-authored code sits below the harness marker\.$/d; /^\/\/ imports-allowed: /d' \
    | awk '!done && /^package main$/ { done=1; next } { print }' \
    > "$TMP/got"

  if ! diff -u <(strip_trailing_blanks < "$TMP/want" | sed '/./,$!d') \
               <(strip_trailing_blanks < "$TMP/got" | sed '/./,$!d') \
               > "$TMP/diff" 2>&1; then
    echo "check-imported-goose: FAIL [$rel] — above-marker region has drifted from the pinned upstream bytes:" >&2
    head -15 "$TMP/diff" >&2
    fail=1
    continue
  fi

  # THE IMPORT-GRANT RE-CHECK (delta-review round 4, STRUCTURAL): the
  # landed file's imports are re-derived by Go's OWN grammar
  # (tools/lsimports, go/parser parser.ImportsOnly — the same helper
  # and invariant as the importer's landing-time vet; rounds 1-3
  # patched ad-hoc recognizers and each round a legal import form
  # escaped). The parsed set must EQUAL the grant line's set exactly:
  # a parsed import missing from the grant is an unvetted landing (or
  # later tampering); a granted path with no matching import is grant
  # tampering/staleness. Zero parsed imports need no grant line. The
  # grant set stays inside the machine-modeled allow-set (sync).
  # Parse failure = FAIL (fail closed). go/parser is the toolchain
  # already trusted as the differential oracle — no new trust surface.
  if ! parsed_imports="$("$LSIMPORTS" "$main_go" 2>&1)"; then
    echo "check-imported-goose: FAIL [$rel] — import parse failed (fail closed): $parsed_imports" >&2
    fail=1
    continue
  fi
  grant_line="$(sed -n 's/^\/\/ imports-allowed: \(.*\) (--allow-import)$/\1/p' "$main_go" | head -1)"
  for a in $grant_line; do
    case "$a" in
      sync) ;;
      *)
        echo "check-imported-goose: FAIL [$rel] — grant line names \"$a\", outside the machine-modeled import set (sync)" >&2
        fail=1
        ;;
    esac
  done
  # parsed ⊆ grant
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    ok_grant=0
    for a in $grant_line; do
      [[ "$p" == "$a" ]] && ok_grant=1
    done
    if [[ "$ok_grant" -ne 1 ]]; then
      echo "check-imported-goose: FAIL [$rel] — parsed import \"$p\" is not on the file's imports-allowed grant line (unvetted landing or tampering)" >&2
      fail=1
    fi
  done <<< "$parsed_imports"
  # grant ⊆ parsed (tamper/staleness direction)
  for a in $grant_line; do
    found=0
    while IFS= read -r p; do
      [[ "$p" == "$a" ]] && found=1
    done <<< "$parsed_imports"
    if [[ "$found" -ne 1 ]]; then
      echo "check-imported-goose: FAIL [$rel] — grant line names \"$a\" but the file parses no such import (stale or tampered grant)" >&2
      fail=1
    fi
  done
done < <(find "$CORPUS_ROOT" -name main.go | sort)

if [[ "$checked" -eq 0 ]]; then
  echo "check-imported-goose: FAIL — lane directory exists but contains no main.go (husk?)" >&2
  exit 1
fi
if [[ "$fail" -ne 0 ]]; then
  exit 1
fi
echo "check-imported-goose: ok — $checked imported case(s) verbatim against goose @ ${EXPECT_REV:0:7}"
