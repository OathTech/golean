#!/usr/bin/env bash
# mine-spec-archaeology — regenerate the community-archaeology census
# from the pinned golang/go clone (spec-truth campaign P4, mechanism
# 4.3 seeds #1/#2; docs/2026-08-17_spec-and-community-truth-campaign.md).
#
# Outputs (tracked, dated-header TSVs under docs/spec-archaeology/):
#   spec-history.tsv     one row per commit touching doc/go_spec.html:
#                        date, sha, issue refs, ANCHORS TOUCHED, subject
#   mem-history.tsv      same for doc/go_mem.html
#   anchor-rollup.tsv    judgements-per-anchor: how many recorded edge
#                        rulings each spec section has accumulated
#
# The anchor column is the load-bearing design: anchors are the covmap
# segment names by construction (campaign §8), so every census row is
# pre-keyed for the clause-segment mapping layer. Hunks are mapped to
# the nearest enclosing id= anchor IN THAT COMMIT'S OWN VERSION of the
# file (anchors move over history; mapping against the pin would lie).
#
# Fail closed: requires deps/go at the recorded pin (the census is a
# function of the pin; regenerating from a drifted clone would produce
# an unlabeled different census).
set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

pin="$(sed -n '/^PINS=/,/^TABLE$/p' scripts/setup-deps | awk '$1 == "go" { print $2 }')"
have="$(git -C deps/go rev-parse HEAD 2>/dev/null || true)"
if [[ -z "$pin" || -z "$have" || "$have" != "$pin"* ]]; then
  echo "mine-spec-archaeology: FAIL — deps/go missing/off-pin or pin row unreadable (have ${have:0:9}, pin ${pin:0:9}); scripts/setup-deps --only go" >&2
  exit 1
fi

mkdir -p docs/spec-archaeology

# --enrich: join the gh-fetched issue snapshot (gitignored JSONL,
# refreshed by the loop documented in docs/spec-divergence-ledger.md)
# into the tracked index docs/spec-archaeology/issue-index.tsv.
# Fail closed if the snapshot is missing — the index is only ever
# written from a real fetch, never guessed.
if [[ "${1:-}" == "--enrich" ]]; then
  snap=deps/issue-snapshots/golang-go-issues.jsonl
  [[ -s "$snap" ]] || { echo "mine-spec-archaeology: FAIL — $snap missing/empty; run the gh fetch first (fail closed)" >&2; exit 1; }
  python3 - "$pin" <<'ENRICHEOF'
import json, sys
PIN = sys.argv[1]
rows, failed = [], []
for line in open('deps/issue-snapshots/golang-go-issues.jsonl'):
    d = json.loads(line)
    if d.get('fetch') == 'FAILED':
        failed.append(d['number']); continue
    rows.append((d['number'], d['state'], (d.get('closed_at') or '-')[:10],
                 ','.join(d.get('labels') or []) or '-',
                 (d.get('title') or '').replace('\t',' ').strip()))
rows.sort()
# Filter to refs the CURRENT census actually contains (regenerating the
# census can retire false-positive refs; stale snapshot rows must not
# resurrect them in the index — audit follow-on to F-7).
refs = set()
for t in ('docs/spec-archaeology/spec-history.tsv','docs/spec-archaeology/mem-history.tsv'):
    for line in open(t):
        if line.startswith('#') or line.startswith('date\t'): continue
        c = line.split('\t')[2]
        if c != '-': refs.update(int(x) for x in c.split(','))
dropped = [r for r in rows if r[0] not in refs]
rows = [r for r in rows if r[0] in refs]
failed = [n for n in failed if n in refs]
with open('docs/spec-archaeology/issue-index.tsv','w') as f:
    f.write(f"# golang/go issue metadata for the archaeology census's {len(rows)} resolvable refs\n"
            f"# joined from the gh snapshot (deps/issue-snapshots/, gitignored); census pin {PIN[:12]}\n"
            f"# unresolvable via the ISSUES api: {len(failed)} ({','.join(map(str,failed)) if failed else 'none'}) — NOT necessarily junk:\n"
            f"# check the Discussions api before dismissing (audit F-5: 47141 and 56010 are the\n"
            f"# memory-model-rewrite and loopvar-semantics DISCUSSIONS — top-value census objects)\n"
            f"# snapshot rows not in the current census (retired refs): {len(dropped)}\n"
            f"number\tstate\tclosed\tlabels\ttitle\n")
    for r in rows:
        f.write('\t'.join(map(str,r)) + '\n')
print(f"issue-index: {len(rows)} rows, {len(failed)} unresolvable")
ENRICHEOF
  exit 0
fi

exec python3 - "$pin" <<'PYEOF'
import re, subprocess, sys, collections

PIN = sys.argv[1]
GO = 'deps/go'

def git(*a):
    return subprocess.run(['git','-C',GO,*a], capture_output=True, text=True, check=True).stdout

def anchors_of(blob_lines):
    # audit F-12: a 2009-era MULTI-LINE comment taught '<h2 id="Foo">' to
    # the harvester — strip comments across lines, preserving line counts
    # so the (line, anchor) pairs stay true.
    text = '\n'.join(blob_lines)
    text = re.sub(r'<!--.*?-->', lambda m: '\n' * m.group(0).count('\n'), text, flags=re.S)
    out = []
    for i, l in enumerate(text.split('\n'), 1):
        m = re.search(r'<h[234][^>]*id="([^"]+)"', l)
        if m: out.append((i, m.group(1)))
    return out

def enclosing(line, anch):
    name = '(preamble)'
    for i, n in anch:
        if i <= line: name = n
        else: break
    return name

# Bare '#N' must not be preceded by a word char or '/' (kills code-browser
# line fragments like go.y#801 — audit F-7) and not followed by a digit
# (7-digit truncation guard). Explicit forms keep their own prefixes.
ISSUE = re.compile(r'(?:(?<![\w/])#|golang/go#|go\.dev/issue/|golang\.org/issue[s]?/)(\d{3,6})(?!\d)')

def mine(path, out_tsv):
    # All commits touching the file, oldest-first, from the pin backwards.
    log = git('log','--follow','--format=%H\t%cs\t%s', PIN, '--', path)
    rows = []
    blob_cache = {}
    for line in log.splitlines():
        sha, date, subject = line.split('\t', 2)
        # Issue refs from the full message.
        body = git('log','-1','--format=%B', sha)
        issues = sorted(set(ISSUE.findall(body)), key=int)
        # Anchor mapping: hunks of this commit vs its parent, new-file lines,
        # against THIS commit's version of the file.
        touched = set()
        # Pre-rename commits (--follow walks through doc/go_spec.txt ->
        # doc/go_spec.html etc.) have no blob at the html path: mark them
        # '(pre-anchor-era)' explicitly instead of a silent '-' (audit F-1
        # — the old behavior was a fail-open swallow; the pre-html file is
        # plain text with no id= anchors, so no data is lost, but the
        # record must say WHY the mapping is absent).
        if sha not in blob_cache:
            try:
                blob_cache[sha] = git('show', f'{sha}:{path}').splitlines()
            except subprocess.CalledProcessError:
                blob_cache[sha] = None
        if blob_cache[sha] is None:
            rows.append((date, sha[:12], ','.join(issues) or '-',
                         '(pre-anchor-era)', subject))
            continue
        diff = git('show', sha, '--unified=0', '--format=', '--', path)
        anch = anchors_of(blob_cache[sha])
        for m in re.finditer(r'^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@', diff, re.M):
            new_start = int(m.group(1))
            new_len = int(m.group(2)) if m.group(2) is not None else 1
            if new_len == 0:
                # pure deletion: the enclosing section at the deletion point
                touched.add(enclosing(max(new_start,1), anch))
            else:
                # Full-range mapping (audit F-9: endpoint-only dropped
                # anchors strictly interior to large hunks — including the
                # very sections the generics/memory-model rewrites added).
                end = new_start + new_len - 1
                touched.add(enclosing(new_start, anch))
                for i, n in anch:
                    if new_start <= i <= end:
                        touched.add(n)
        rows.append((date, sha[:12], ','.join(issues) or '-',
                     ','.join(sorted(touched)) or '-', subject))
    hdr = (f"# spec-archaeology census: {path}\n"
           f"# regenerated by scripts/mine-spec-archaeology from deps/go @ {PIN[:12]}\n"
           f"# rows: {len(rows)} commits (full --follow history at the pin)\n"
           f"# anchors are mapped against EACH COMMIT'S OWN file version\n"
           f"date\tsha\tissues\tanchors\tsubject\n")
    with open(out_tsv, 'w') as f:
        f.write(hdr)
        for r in sorted(rows):
            f.write('\t'.join(r) + '\n')
    return rows

spec_rows = mine('doc/go_spec.html', 'docs/spec-archaeology/spec-history.tsv')
mem_rows  = mine('doc/go_mem.html',  'docs/spec-archaeology/mem-history.tsv')

# Rollup: rulings per anchor (spec + mem), the accounting view.
roll = collections.Counter()
issue_roll = collections.Counter()
for rows, tag in ((spec_rows,'spec'), (mem_rows,'mem')):
    for date, sha, issues, anchs, subject in rows:
        for a in (anchs.split(',') if anchs != '-' else []):
            roll[(tag, a)] += 1
            if issues != '-':
                issue_roll[(tag, a)] += len(issues.split(','))
# live_at_pin: the anchor key space is HISTORIC — sections get removed
# (e.g. Implementation_differences removed 2012, Core_types removed
# 2025; the current census has 34 dead spec anchors — count the 'no'
# rows rather than trusting comments, delta-review S3).
# Only live anchors are covmap segment names; dead ones are archaeology.
live = {}
for path, tag in (('doc/go_spec.html','spec'), ('doc/go_mem.html','mem')):
    live[tag] = {n for _, n in anchors_of(git('show', f'{PIN}:{path}').splitlines())}
with open('docs/spec-archaeology/anchor-rollup.tsv', 'w') as f:
    f.write(f"# judgements-per-anchor rollup (spec+mem), from the same census run\n"
            f"# deps/go @ {PIN[:12]}; commits touching the section / issue refs in them\n"
            f"# NOTE: '(preamble)' is pre-first-anchor content — every release's subtitle/date bump\n"
            f"# lands there, so its count is dominated by version-line churn, not rulings\n"
            f"# live_at_pin=no marks sections REMOVED before the pin: historic key,\n"
            f"# not a covmap segment name; curate as archaeology, not as mapping targets\n"
            f"doc\tanchor\tcommits\tissue_refs\tlive_at_pin\n")
    for (tag, a), n in sorted(roll.items(), key=lambda kv: (-kv[1], kv[0])):
        lv = 'yes' if a in live.get(tag, set()) else ('n/a' if a.startswith('(') else 'no')
        f.write(f"{tag}\t{a}\t{n}\t{issue_roll.get((tag,a),0)}\t{lv}\n")

n_issues = len({i for rows in (spec_rows, mem_rows) for r in rows if r[2] != '-' for i in r[2].split(',')})
print(f"spec commits: {len(spec_rows)}  mem commits: {len(mem_rows)}  "
      f"distinct issue refs: {n_issues}  anchors with rulings: {len(roll)}")
PYEOF
