#!/usr/bin/env bash
# The `lake comparator` SPEEDBUMP (lane gate/comparator-1023, 2026-10-23; release-readiness row
# 43, [USER]-ruled 2026-10-23: the surface GoLean keeps on main for the raft-proofs customer is a
# comparator CHALLENGE, so that a statement drift in it is a kernel-level mismatch, not a text
# diff; a `--diff`-tier speedbump beside `lake check`, and part of the claim-point run).
#
# `lake comparator` (toolchains >= 4.35; comparator.json at the root) builds and exports the
# CHALLENGE module `Contract.Challenge` (the kept statements, frozen as text, `sorry` holes) and
# the SOLUTION module `GoLean.Contract.Solution` (one alias per kept theorem, its own type under
# the challenge's name; generated by scripts/gen-contract), then judges: every name in
# `theorem_names` has SYNTACTICALLY the same statement in both exports, every definition those
# statements reach is identical in both, the solution rests on propext / Quot.sound /
# Classical.choice only, and Lean's kernel (`leanchecker`) accepts the solution export. Exit 0
# accepted; 1 rejected (the first mismatching constant is named); 2 could not start.
#
# Two steps, both fail-closed:
#   1. `scripts/gen-contract --check` — the tracked comparator.json and Solution equal a fresh
#      generation from the built environment (a kept theorem added, removed, renamed or
#      re-attributed is a FAIL by name), the challenge declares every kept name and nothing
#      else, spells nothing through the solution side, and every §D pin is a kept name.
#   2. The comparator itself. Like scripts/check-lake-check it DETECTS whether `bwrap` can
#      start here with Lake's own flag set and runs sandboxed where it can, with
#      `--inadvisably-no-sandbox` where it cannot (the toolchain prints «this run is not
#      trustworthy»); the line it prints says which form ran. A nonzero exit, a missing
#      «Your solution is okay!» line or a missing «Lean default kernel accepts the solution»
#      line is a FAIL naming the toolchain's first error line; the log is kept.
# The line printed carries the sandbox form, the exit code, the wall and the peak RSS of the
# comparator's process tree (GNU time's %M: the largest single process). The comparator's
# stdout and stderr are logged SEPARATELY: its «Exporting #[…]» stdout line is tens of KB and
# written in chunks, and an unbuffered stderr `error:` line lands inside it when the two are
# merged (measured 2026-10-23: the rejection of a perturbed statement was invisible to a
# line-anchored grep over a merged log). Runs through `cap`
# (scripts/cap.sh). A SPEEDBUMP in scripts/ci --diff: report-only, read at the merge ask by
# name; the GATE is the owner's `lake comparator` outside the sandbox at claim points, beside
# `lake check` (CLAUDE.md «The gates»; docs/release.md §3; docs/operational-lessons.md «Lean 4.35»).
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$ROOT/scripts/cap.sh"
cd "$ROOT" || { echo "check-comparator: cannot cd to $ROOT" >&2; exit 1; }
[[ $# = 0 ]] || { echo 'check-comparator: expected no arguments' >&2; exit 2; }
export TMPDIR="$ROOT/.tmp"
mkdir -p "$TMPDIR"
log="$(mktemp "$TMPDIR/lake-comparator.XXXXXX.log")"
errlog="$log.stderr"

# 1. The generated half is current, and the challenge is complete and non-circular.
if ! gen_out="$(bash scripts/gen-contract --check 2>&1)"; then
  printf '%s\n' "$gen_out" | tail -15 >&2
  echo "check-comparator: FAIL — scripts/gen-contract --check refused (above): the tracked contract is stale or the challenge is incomplete" >&2
  exit 1
fi
echo "$gen_out"

# 2. The sandbox probe (scripts/check-lake-check's, verbatim: Lake's base flag set through the
# binary Lake would use).
sandbox_bin="${COMPARATOR_BWRAP:-bwrap}"
sandbox_flags=()
if ! command -v "$sandbox_bin" >/dev/null 2>&1; then
  sandbox_flags=(--inadvisably-no-sandbox); form="no sandbox ($sandbox_bin is not installed)"
elif probe="$("$sandbox_bin" --ro-bind / / --tmpfs /home --tmpfs /root --tmpfs /run/user --tmpfs /tmp --dir /tmp/home \
                --dev /dev --proc /proc --clearenv --setenv HOME /tmp/home --unshare-all --die-with-parent --new-session \
                --chdir / -- /bin/true 2>&1)"; then
  form="sandboxed ($sandbox_bin starts with Lake's flags here)"
else
  sandbox_flags=(--inadvisably-no-sandbox); form="no sandbox ($sandbox_bin cannot start with Lake's flags here: $(printf '%s' "$probe" | head -1))"
fi

timer=()
if [ -x /usr/bin/time ]; then timer=(/usr/bin/time -f 'lake-comparator-rusage wall=%e s maxrss=%M KB'); fi
started=$SECONDS
cap "${timer[@]+"${timer[@]}"}" lake comparator "${sandbox_flags[@]+"${sandbox_flags[@]}"}" > "$log" 2> "$errlog"; rc=$?
wall=$((SECONDS - started))
rusage="$(grep -m1 '^lake-comparator-rusage ' "$errlog" || true)"
if [ -n "$rusage" ]; then
  kb="$(printf '%s\n' "$rusage" | sed -n 's/.*maxrss=\([0-9][0-9]*\) KB.*/\1/p')"
  cost="wall $(printf '%s\n' "$rusage" | sed -n 's/.*wall=\([0-9.]*\) s.*/\1/p') s; largest process $((kb / 1024)) MB"
else
  cost="wall ${wall} s; peak RSS unmeasured (/usr/bin/time absent)"
fi
okay="$(grep -m1 -F 'Your solution is okay!' "$log" || true)"
accepted="$(grep -m1 -E 'kernel accepts the solution' "$log" || true)"
n_names="$(python3 -I -c 'import json,sys; print(len(json.load(open("comparator.json"))["theorem_names"]))' 2>/dev/null || echo '?')"
echo "lake comparator, $form (speedbump; the owner's run outside the sandbox is the gate): exit $rc; $cost; $n_names theorem names; ${accepted:-no kernel acceptance line printed}; ${okay:-no «Your solution is okay!» line printed}"
if [ "$rc" -ne 0 ] || [ -z "$okay" ] || [ -z "$accepted" ]; then
  first_err="$(grep -m1 -E '^error: ' "$errlog" || true)"
  echo "check-comparator: FAIL — ${first_err:-lake comparator exited $rc without an error line}" >&2
  echo "check-comparator: the logs are kept at $log (stdout) and $errlog (stderr)" >&2
  exit 1
fi
rm -f "$log" "$errlog"
echo "lake comparator speedbump: PASS — $form; $cost; the $n_names kept statements of Contract/Challenge.lean are proved, syntactically as stated, on standard axioms, kernel-accepted («$accepted»; «$okay»)"
