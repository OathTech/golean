#!/usr/bin/env bash
# go-version-diversity — REPORT-ONLY tooling, NOT a gate step: run the
# differential and negative corpora with ONLY THE ORACLE on another Go
# toolchain, and compare row by row with the recorded run of record (the
# pinned oracle). Release-readiness item 32 — [USER] Mike 2026-10-13: «if we
# wanted to add more Go version diversity, is there an easy way to do that?
# I'm happy to install things», then «the go setup should support you calling
# different go versions» (relayed by the [AGENT] coordinator; the plan on
# row 32 is the coordinator's [AGENT] proposal, agreed in principle). Built by
# the [AGENT] lane apparatus/go-diversity-1013. Supersedes
# scripts/oracle-version-sweep (retired: it floated the frontend with the
# oracle and judged result/stage only).
#
#   scripts/capped scripts/go-version-diversity [--staticinit] [--record <dir>] [--reuse] <goX.Y.Z>
#   scripts/capped scripts/go-version-diversity --control [--staticinit] [--record <dir>] [--reuse]
#
# --control runs the PIN through the same oracle-only seam on a fresh run and
# compares it with the record: everything it reports is run-to-run noise by
# definition — the NOISE FLOOR. A version report prints the latest control's
# counts beside its own (.tmp/go-diversity/control-<pin>/). --reuse
# re-compares the last run without re-running the corpora; it refuses unless
# that run's per-row evidence (go-run/, membership/) is still there.
#
# THE SEAM: scripts/diff-coverage and scripts/coverage-negative take
# GOLEAN_ORACLE_GOTOOLCHAIN=<v> (their header blocks): the oracle's per-row
# `go run` / `go build` alone runs under <v> (PATH/GOROOT of the module-cache
# toolchain — Go IGNORES GOTOOLCHAIN in the oracle's GOPATH mode, measured),
# checked by a runtime.Version() canary; the native frontend (go/types) and
# the harness are built and run on the pinned toolchain, so the lowering is
# not a second variable. Both toolchains land in each run's meta
# (go_toolchain_frontend / go_toolchain_oracle, go_drift_actual).
#
# TWO EFFECTS OF THE PINNED ABORT CLASSIFIER (tools/coverageharness/
# abortkind.go pins go1.26.5's runtime/panic.go frame lines — trusted
# surface 2, not changed here): under any non-pin toolchain (1) every
# panic/fatal row refuses classification, so the MACHINE does not compare it;
# this report compares those rows on the oracle's raw text only (stdout + the
# stderr head: program output, panic/fatal message); (2) a sampled
# (membership) row with a panic member stops at its first such draw, so
# sampled abort rows are SINGLE-DRAW under diversity.
#
# WHAT IT COMPARES (the machine's side of a row does not depend on the Go
# version, so every difference is Go's — or the sampling's, named as such):
#   * per differential row: result, stage, the refusal-cause key
#     (scripts/coverage-cause), and the detail text normalized (`bytes`
#     observation values decoded first, then artifact roots, GOROOT paths,
#     go-build dirs, hex addresses, goroutine ids; tracebacks cut);
#   * per membership row: the EXHIBITED SETS (the distinct per-draw oracle
#     observations, membership/<id>/draws.txt) — a member one side exhibited
#     and the other never did is its own class, with both draw counts
#     (sampling-ambiguous: absence in K draws is not impossibility);
#   * per row whose columns agree: the ORACLE's own recorded output
#     (go-run/<id>/: stdout, the fd-2 split, the abort message), only where
#     the record ran byte-identical program files (every .go under the row's
#     go-run dir, gopath/ included) — racy/confluent rows keep the LAST draw
#     only (no per-draw record exists for those lanes);
#   * per negative row: result, stage, detail;
#   * --staticinit: gc's static-init verdict table re-recorded under <v>.
# The report (printed, and written to .tmp/go-diversity/<v>/report.txt)
# ends with an EVIDENCE appendix — per classified row: class, both details,
# both exhibited sets / raw abort texts — so it stands alone after the
# run's artifacts are cleaned.
#
# WHAT IT IS NOT: never a re-pin (the oracle of record is
# baselines/go-oracle-pin, moved only deliberately with a full run and a
# written reason — CLAUDE.md, trusted surface 2); never the gate (no lock,
# artifacts only under .tmp/go-diversity/, the judged records are read,
# never written). Each difference is a FINDING for a human.
#
# REFUSALS (exit 2, nothing run): bad usage; <v> is the pin without
# --control («pointless: that is the oracle of record»); <v> not runnable
# here (not in the module cache — the [USER] runs `GOTOOLCHAIN=<v> go
# version` OUTSIDE the sandbox to fetch it); no usable record (missing
# results/meta, recorded off the pin or drifted, or for another case set —
# «run scripts/ci --diff first»); --reuse without the run's evidence.
# Exit 1 = a run could not complete (a runner infra exit, a meta that does
# not show the asked toolchains, a comparator failure). Exit 0 = the run
# completed; the differences are findings, not failures.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT" || exit 2

usage() {
  echo "usage: scripts/capped scripts/go-version-diversity [--staticinit] [--record <dir>] [--reuse] <goX.Y.Z>" >&2
  echo "       scripts/capped scripts/go-version-diversity --control [--staticinit] [--record <dir>] [--reuse]   (--help: the header)" >&2
  exit 2
}
STATICINIT=0
REUSE=0
CONTROL=0
RECORD="$ROOT/artifacts/coverage"
V=""
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --staticinit) STATICINIT=1; shift ;;
    --reuse) REUSE=1; shift ;;
    --control) CONTROL=1; shift ;;
    --record) [[ -n "${2:-}" ]] || usage; RECORD="$2"; shift 2 ;;
    -h|--help) sed -n '2,79p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "go-version-diversity: unknown option '$1'" >&2; usage ;;
    *) [[ -z "$V" ]] || { echo "go-version-diversity: one toolchain per run" >&2; usage; }; V="$1"; shift ;;
  esac
done
PIN="$(head -1 baselines/go-oracle-pin 2>/dev/null | tr -d '[:space:]')"
if [[ -z "$PIN" ]]; then
  echo "go-version-diversity: baselines/go-oracle-pin unreadable — refusing" >&2
  exit 2
fi
if [[ "$CONTROL" = 1 ]]; then
  if [[ -n "$V" && "$V" != "$PIN" ]]; then
    echo "go-version-diversity: --control runs the pin ($PIN), not '$V'" >&2
    usage
  fi
  V="$PIN"
fi
[[ -n "$V" ]] || usage
if [[ ! "$V" =~ ^go[0-9]+\.[0-9]+(\.[0-9]+)?((rc|beta)[0-9]+)?$ ]]; then
  echo "go-version-diversity: '$V' is not a toolchain name (goX.Y.Z)" >&2
  exit 2
fi
if [[ "$V" == "$PIN" && "$CONTROL" != 1 ]]; then
  echo "go-version-diversity: $V is the pin — pointless: that is the oracle of record (scripts/ci --diff runs it); --control runs it as the noise-floor calibration" >&2
  exit 2
fi
LIVE="$(go version 2>/dev/null | awk '{print $3}')"
if [[ "$LIVE" != "$PIN" ]]; then
  echo "go-version-diversity: the live toolchain is '${LIVE:-<none>}', not the pin $PIN — the frontend must run on the pin; refusing" >&2
  exit 2
fi
if ! ALT_GOROOT="$(env -u GOROOT GO111MODULE=on GOFLAGS= GOTOOLCHAIN="$V" go env GOROOT 2>&1)" \
    || [[ ! -x "$ALT_GOROOT/bin/go" ]] \
    || [[ "$("$ALT_GOROOT/bin/go" version 2>/dev/null | awk '{print $3}')" != "$V" ]]; then
  cat >&2 <<EOF
go-version-diversity: $V is not runnable here ($(printf '%s' "$ALT_GOROOT" | tail -1 | head -c 200)).
  Only toolchains already in the module cache run inside the sandbox. The
  [USER] populates the cache OUTSIDE the sandbox with:
      GOTOOLCHAIN=$V go version
  (it downloads golang.org/toolchain@v0.0.1-$V.linux-amd64 into ~/go/pkg/mod;
  nothing global moves).
EOF
  exit 2
fi

# THE RECORD: the run of record, at the pin, for the current case sets.
meta_get() { awk -F'\t' -v k="$2" '$1==k{print $2; exit}' "$1"; }
DM="$(mktemp "${TMPDIR:-/tmp}/golean-diversity-manifest.XXXXXX")"
NM="$(mktemp "${TMPDIR:-/tmp}/golean-diversity-negmanifest.XXXXXX")"
trap 'rm -f "$DM" "$NM"' EXIT
if ! scripts/coverage-manifest --artifact-root "$RECORD" > "$DM" || ! scripts/coverage-negative-manifest > "$NM"; then
  echo "go-version-diversity: could not generate the current manifests — refusing" >&2
  exit 2
fi
D_SHA="$(shasum -a 256 "$DM" | awk '{print $1}')"
N_SHA="$(shasum -a 256 "$NM" | awk '{print $1}')"
check_record() { # <results> <meta> <want sha> <lane>
  local r="$1" m="$2" want="$3" lane="$4" tc drift sha
  if [[ ! -s "$r" || ! -s "$m" ]]; then
    echo "go-version-diversity: no recorded $lane run at $r (+ meta) — run scripts/ci --diff first (or pass --record <dir>)" >&2
    exit 2
  fi
  tc="$(meta_get "$m" go_toolchain)"; drift="$(meta_get "$m" go_drift_actual)"; sha="$(meta_get "$m" manifest_sha256)"
  if [[ "$tc" != "$PIN" || "$drift" != false ]]; then
    echo "go-version-diversity: the recorded $lane run ($m) is not at the pin (go_toolchain=$tc go_drift_actual=${drift:-<absent>}) — run scripts/ci --diff first" >&2
    exit 2
  fi
  if [[ "$sha" != "$want" ]]; then
    echo "go-version-diversity: the recorded $lane run is for another case set (manifest sha $sha, current $want) — run scripts/ci --diff first" >&2
    exit 2
  fi
}
check_record "$RECORD/latest.tsv" "$RECORD/latest.meta.tsv" "$D_SHA" differential
check_record "$RECORD/negative-latest.tsv" "$RECORD/negative-latest.meta.tsv" "$N_SHA" negative
REC_COMMIT="$(meta_get "$RECORD/latest.meta.tsv" git_commit)"
HEAD_COMMIT="$(git rev-parse HEAD)"
TREE_NOTE=""
if [[ "$REC_COMMIT" != "$HEAD_COMMIT" ]]; then
  # The machine/frontend/corpus side must be the record's for a difference to
  # be Go's; a moved tree is named in the report, not hidden.
  if ! moved="$(git diff --name-only "$REC_COMMIT" HEAD -- GoLean tools Corpus raftsubject raftharness lakefile.lean lean-toolchain lake-manifest.json 2>&1)"; then
    echo "go-version-diversity: cannot compare the record's commit $REC_COMMIT with HEAD ($moved) — refusing" >&2
    exit 2
  fi
  if [[ -n "$moved" ]]; then
    TREE_NOTE="WARNING: the record is at $REC_COMMIT and HEAD is $HEAD_COMMIT; $(printf '%s\n' "$moved" | wc -l) machine/frontend/corpus file(s) differ — a difference may be the tree's, not Go's"
  else
    TREE_NOTE="record at $REC_COMMIT, HEAD $HEAD_COMMIT: no machine/frontend/corpus file differs"
  fi
fi

if [[ "$CONTROL" = 1 ]]; then
  OUT_REL=".tmp/go-diversity/control-$PIN"
else
  OUT_REL=".tmp/go-diversity/$V"
fi
OUT="$ROOT/$OUT_REL"
CONTROL_REPORT="$ROOT/.tmp/go-diversity/control-$PIN/report.txt"
d_rc="reused" n_rc="reused"
if [[ "$REUSE" = 1 ]]; then
  # --reuse: re-compare an existing run (no corpus run). The comparison reads
  # per-row evidence (go-run/, membership/) as well as the TSVs; without it
  # the classes would silently change (a no-compile row read as a flip), so
  # its absence is a refusal by name.
  for f in latest.tsv latest.meta.tsv negative-latest.tsv negative-latest.meta.tsv; do
    [[ -s "$OUT/$f" ]] || { echo "go-version-diversity: --reuse: $OUT_REL/$f missing — run without --reuse" >&2; exit 2; }
  done
  for d in go-run membership; do
    [[ -d "$OUT/$d" && -d "$RECORD/$d" ]] || { echo "go-version-diversity: --reuse: the per-row evidence $d/ is gone (from $OUT_REL or the record) — the report would reclassify rows; run without --reuse" >&2; exit 2; }
  done
else
  rm -rf "$OUT"
fi
# Snapshot the record's rows now (validated above): a gate run elsewhere may
# replace it while this one runs (the per-row oracle files are read in place,
# at the end, and checked per row against this run's program sources).
mkdir -p "$OUT/record"
for f in latest.tsv latest.meta.tsv negative-latest.tsv negative-latest.meta.tsv; do
  cp "$RECORD/$f" "$OUT/record/$f" || { echo "go-version-diversity: cannot snapshot $RECORD/$f" >&2; exit 2; }
done
if [[ "$REUSE" != 1 ]]; then
  echo "go-version-diversity: oracle $V ($ALT_GOROOT)$([[ "$CONTROL" = 1 ]] && printf ' [CONTROL]'); frontend $LIVE (pin $PIN); record $RECORD; artifacts $OUT_REL"
  # THE RUNS (report-only probes, artifacts redirected; drift allowed loudly
  # off the pin — a control run is at the pin and needs no escape).
  run_env=(GOLEAN_ORACLE_GOTOOLCHAIN="$V" GOLEAN_COVERAGE_ARTIFACTS="$OUT_REL")
  if [[ "$CONTROL" != 1 ]]; then run_env+=(GOLEAN_ALLOW_GO_DRIFT=1); fi
  d_rc=0
  env "${run_env[@]}" GOLEAN_COVERAGE_RESULTS="$OUT_REL/latest.tsv" GOLEAN_COVERAGE_META="$OUT_REL/latest.meta.tsv" \
    scripts/diff-coverage > "$OUT/diff-coverage.log" 2>&1 || d_rc=$?
  tail -3 "$OUT/diff-coverage.log"
  if [[ "$d_rc" -ge 2 ]]; then
    echo "go-version-diversity: the differential run could not complete (exit $d_rc; $OUT_REL/diff-coverage.log) — nothing to compare" >&2
    exit 1
  fi
  n_rc=0
  env "${run_env[@]}" GOLEAN_NEGATIVE_RESULTS="$OUT_REL/negative-latest.tsv" GOLEAN_NEGATIVE_META="$OUT_REL/negative-latest.meta.tsv" \
    scripts/coverage-negative > "$OUT/coverage-negative.log" 2>&1 || n_rc=$?
  tail -3 "$OUT/coverage-negative.log"
  if [[ "$n_rc" -ge 2 ]]; then
    echo "go-version-diversity: the negative run could not complete (exit $n_rc; $OUT_REL/coverage-negative.log) — nothing to compare" >&2
    exit 1
  fi
fi
want_drift=true
[[ "$CONTROL" = 1 ]] && want_drift=false
for m in "$OUT/latest.meta.tsv:$D_SHA" "$OUT/negative-latest.meta.tsv:$N_SHA"; do
  f="${m%%:*}"; want="${m#*:}"
  if [[ "$(meta_get "$f" go_toolchain_oracle)" != "$V" || "$(meta_get "$f" go_toolchain_frontend)" != "$PIN" \
        || "$(meta_get "$f" go_drift_actual)" != "$want_drift" || "$(meta_get "$f" manifest_sha256)" != "$want" ]]; then
    echo "go-version-diversity: $f does not record oracle=$V frontend=$PIN drift=$want_drift on the current case set — the run is not what was asked; refusing to report it" >&2
    exit 1
  fi
done

SI_TSV=""
if [[ "$STATICINIT" = 1 ]]; then
  SI_TSV="$OUT/staticinit-oracle.tsv"
  if ! env GO111MODULE=off GOFLAGS= PATH="$ALT_GOROOT/bin:$PATH" GOROOT="$ALT_GOROOT" GOTOOLCHAIN=local \
      go run ./tools/staticinitoracle --shapes tools/nativefrontend/testdata/staticinit-shapes.go \
      --other tools/nativefrontend/testdata/staticinit-other.go --out "$SI_TSV" > "$OUT/staticinit.log" 2>&1; then
    echo "go-version-diversity: the static-init oracle could not record under $V ($OUT_REL/staticinit.log)" >&2
    exit 1
  fi
fi

# THE COMPARISON.
if ! scripts/coverage-cause "$OUT/record/latest.tsv" > "$OUT/cause.pin.tsv" \
    || ! scripts/coverage-cause "$OUT/latest.tsv" > "$OUT/cause.alt.tsv"; then
  echo "go-version-diversity: scripts/coverage-cause failed — cannot compare causes" >&2
  exit 1
fi
if ! python3 -I - "$V" "$PIN" "$LIVE" "$ALT_GOROOT" "$RECORD" "$OUT" "$DM" "$d_rc" "$n_rc" "$TREE_NOTE" "$SI_TSV" \
    "$CONTROL" "$CONTROL_REPORT" > "$OUT/report.txt" <<'PY'
import json, os, re, sys
(V, PIN, LIVE, ALT_GOROOT, REC, OUT, MANIFEST, D_RC, N_RC, TREE_NOTE, SI,
 CONTROL, CONTROL_REPORT) = sys.argv[1:14]
CONTROL = CONTROL == "1"
ALT = f"{V}(control)" if CONTROL else V

def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except FileNotFoundError:
        return None

def rows(path):
    out = {}
    with open(path, encoding="utf-8", errors="replace") as f:
        for i, line in enumerate(f):
            if i == 0:
                continue
            p = line.rstrip("\n").split("\t")
            if len(p) < 5:
                raise SystemExit(f"malformed row {i+1} in {path}")
            out[p[1]] = (p[0], p[3], "\t".join(p[4:]))
    return out

def causes(path):
    out = {}
    with open(path) as f:
        for line in f:
            k, _, v = line.rstrip("\n").partition("\t")
            out[k] = v
    return out

# `bytes` observation values (golean-observation-v1 strings) are decoded
# BEFORE normalizing, so an address printed into a string (fmt %v of a
# pointer) is normalized like any other — raw or JSON-escaped in a detail.
BYTES = re.compile(r'(\\?)"bytes\1":\[([0-9, ]*)\]')
def decode_bytes(s):
    def sub(m):
        try:
            text = bytes(int(x) for x in m.group(2).split(",") if x.strip()).decode("utf-8", "replace")
        except ValueError:
            return m.group(0)
        q = m.group(1)
        return f'{q}"str{q}":{q}"' + json.dumps(text)[1:-1].replace('"', '\\"') + f'{q}"'
    return BYTES.sub(sub, s)

# Every absolute prefix starts at a `/`: details carry escaped `\t/path` text.
ART = re.compile(r'(?:/[^\s"\'\\=]*/)?(?:artifacts/coverage|\.tmp/go-diversity/[^/\s"\'\\]+)/')
GOROOT = re.compile(r'(?:/usr/local/go|/[^\s"\'\\]*/toolchain@v0\.0\.1-go[^/\s]+)/')
# Cut a crash text (raw, or escaped inside a detail) before its goroutine
# dumps: GOTRACEBACK=system's runtime frames and system goroutines vary run
# to run and version to version; the message and output are the observation.
TRACE = re.compile(r'(?:\n|\\n)(?:goroutine \d+|goroutine N|runtime stack:)')
def head(s):
    m = TRACE.search(s)
    return s[:m.start()] if m else s

def norm(s):
    s = decode_bytes(s)
    s = ART.sub("<ART>/", s)
    s = GOROOT.sub("<GOROOT>/", s)
    s = re.sub(r'/[^\s"\'\\]*go-build\d+', "<GOBUILD>", s)
    s = re.sub(r'golean-[a-z-]+\.[A-Za-z0-9]{6}', "golean-<tmp>", s)
    s = re.sub(r'(<GOROOT>/src/[^\s:"\'\\]+\.(?:go|s)):\d+', r"\1:L", s)
    s = re.sub(r'0x[0-9a-fA-F]+', "0x_", s)
    s = re.sub(r'goroutine \d+', "goroutine N", s)
    return head(s)

def clip(s, n=300):
    s = s.replace("\n", "\\n")
    return s if len(s) <= n else s[:n] + "…"

def oneline_diff(a, b, ctx=30, width=110):
    p = 0
    while p < min(len(a), len(b)) and a[p] == b[p]:
        p += 1
    st = max(0, p - ctx)
    q = lambda s: (("…" if st else "") + s[st:st + width] + ("…" if len(s) > st + width else "")).replace("\n", "\\n")
    return f"pin«{q(a)}» {ALT}«{q(b)}»"

def rundir(root, cid):
    return os.path.join(root, "go-run", cid.replace("/", "__"))

def same_program(cid):
    # The record's per-row oracle files are evidence for THIS row only if the
    # record ran the same program: every .go file under the two go-run dirs
    # (the fixture copy, the generated harness, and the gopath/ tree of a
    # multi-package row) byte-identical. Otherwise the row's oracle files are
    # NOT compared — counted as unverifiable, never as agreement.
    a, b = rundir(REC, cid), rundir(OUT, cid)
    if not (os.path.isdir(a) and os.path.isdir(b)):
        return False
    def gofiles(d):
        out = {}
        for dp, _, fs in os.walk(d):
            for f in fs:
                if f.endswith(".go"):
                    p = os.path.join(dp, f)
                    with open(p, "rb") as x:
                        out[os.path.relpath(p, d)] = x.read()
        return out
    fa, fb = gofiles(a), gofiles(b)
    return bool(fa) and fa == fb

def oracle_obs(root, cid):
    d = rundir(root, cid)
    if not os.path.isdir(d):
        return None
    parts = [f"{n}={read(os.path.join(d, n)) or ''}" for n in ("oracle.stdout", "oracle.split.err", "oracle.message.err")]
    crash = read(os.path.join(d, "oracle.crash")) or read(os.path.join(d, "oracle.stderr")) or ""
    parts.append("abort=" + crash)
    return norm(" | ".join(parts))

def raw_abort(root, cid):
    # The oracle's own bytes, independent of the harness's classification:
    # stdout, and stderr up to the first goroutine trace.
    d = rundir(root, cid)
    if not os.path.isdir(d):
        return None
    return norm("stdout=" + (read(os.path.join(d, "oracle.stdout")) or "") + " | stderr=" + (read(os.path.join(d, "oracle.stderr")) or ""))

def exhibited(root, cid):
    # The membership lane's per-draw oracle observations: (draws, set).
    t = read(os.path.join(root, "membership", cid, "draws.txt"))
    if t is None:
        return None
    obs = [norm(l.split("\t", 1)[1] if "\t" in l else l) for l in t.splitlines() if l.strip()]
    return (len(obs), set(obs))

def fmt_set(ex):
    if ex is None:
        return "<no per-draw record>"
    n, s = ex
    return f"draws={n} exhibited={len(s)} {{" + " ; ".join(clip(x, 160) for x in sorted(s)) + "}"

PINNED_ABORT = "abort classification: unknown first runtime frame/source"

def compile_failure(root, cid):
    err = read(os.path.join(rundir(root, cid), "oracle.stderr")) or ""
    if err.startswith("# ") or "\n# " in err[:200]:
        lines = [l for l in err.splitlines() if l and not l.startswith("# ")]
        return lines[0] if lines else err.splitlines()[0]
    return None

lanes = {}
with open(MANIFEST) as f:
    for line in f:
        if not line.strip() or line.startswith("#"):
            continue
        p = line.rstrip("\n").split("\t")
        lanes[p[0]] = p[7] if len(p) > 7 else "?"

pin, alt = rows(os.path.join(OUT, "record", "latest.tsv")), rows(os.path.join(OUT, "latest.tsv"))
cp, ca = causes(os.path.join(OUT, "cause.pin.tsv")), causes(os.path.join(OUT, "cause.alt.tsv"))
KEYS = ("compile", "abort-same", "abort-differ", "abort-sampled", "abort-unverified", "flip", "detail",
        "exhibited-differs", "sampling", "obs-strict", "obs-lastdraw", "obs-unverified", "missing")
cls = {k: [] for k in KEYS}
evidence = []   # (class, id, lines)
def file(k, cid, summary, ev):
    cls[k].append(summary)
    evidence.append((k, cid, ev))
same = 0
for cid in sorted(set(pin) | set(alt)):
    if cid not in pin or cid not in alt:
        file("missing", cid, f"  {cid}: only in the {'record' if cid in pin else ALT + ' run'}", [])
        continue
    (pr, ps, pd), (ar, as_, ad) = pin[cid], alt[cid]
    pc, ac = cp.get(cid, "?"), ca.get(cid, "?")
    npd, nad = norm(pd), norm(ad)
    lane = lanes.get(cid, "?")
    ep, ea = exhibited(REC, cid), exhibited(OUT, cid)
    base = [f"lane={lane} pin={pr}/{ps}/{pc} {ALT}={ar}/{as_}/{ac}",
            f"pin detail: {clip(npd)}", f"{ALT} detail: {clip(nad)}"]
    if ep is not None or ea is not None:
        base += [f"pin exhibited: {fmt_set(ep)}", f"{ALT} exhibited: {fmt_set(ea)}"]
    if (pr, ps, pc) != (ar, as_, ac) or npd != nad:
        cf = compile_failure(OUT, cid)
        if cf and not compile_failure(REC, cid):
            file("compile", cid, f"  {cid}  pin={pr}/{ps} {ALT}={ar}/{as_}  gc: {cf[:160]}", base + [f"gc: {cf}"])
            continue
        if PINNED_ABORT in ad and PINNED_ABORT not in pd:
            pa, aa = raw_abort(REC, cid), raw_abort(OUT, cid)
            ev = base + [f"pin raw abort: {clip(pa or '<absent>')}", f"{ALT} raw abort: {clip(aa or '<absent>')}"]
            if lane == "membership":
                file("abort-sampled", cid, f"{cid}[pin {fmt_set(ep).split(' {')[0]}; {ALT} {fmt_set(ea).split(' {')[0]}]", ev)
            elif not same_program(cid):
                file("abort-unverified", cid, cid, ev)
            elif pa is not None and pa == aa:
                file("abort-same", cid, cid, ev)
            else:
                file("abort-differ", cid, f"  {cid}  pin={pr}/{ps} lane={lane}\n      {oneline_diff(pa or '<pin oracle files absent>', aa or '<no oracle files>')}", ev)
            continue
    if (pr, ps, pc) != (ar, as_, ac):
        file("flip", cid, f"  {cid}  pin={pr}/{ps}/{pc} {ALT}={ar}/{as_}/{ac}\n      {oneline_diff(npd, nad)}", base)
        continue
    if ep is not None and ea is not None and ep[1] != ea[1]:
        only_p, only_a = sorted(ep[1] - ea[1]), sorted(ea[1] - ep[1])
        file("exhibited-differs", cid,
             f"  {cid}  {pr}/{ps}  pin draws={ep[0]} exhibited={len(ep[1])}, {ALT} draws={ea[0]} exhibited={len(ea[1])}"
             + "".join(f"\n      only pin: {clip(x, 200)}" for x in only_p)
             + "".join(f"\n      only {ALT}: {clip(x, 200)}" for x in only_a), base)
        continue
    if npd != nad:
        if pr == "PASS" and ps == "membership" and ep is not None and ea is not None:
            file("sampling", cid, cid, base)   # same exhibited set; the captions' draw counts moved
        else:
            file("detail", cid, f"  {cid}  {pr}/{ps}/{pc}\n      {oneline_diff(npd, nad)}", base)
        continue
    if not same_program(cid):
        cls["obs-unverified"].append(cid)
        same += 1
        continue
    if ep is not None and ea is not None:
        same += 1   # the exhibited sets (above) are this lane's oracle evidence
        continue
    po, ao = oracle_obs(REC, cid), oracle_obs(OUT, cid)
    if po is not None and ao is not None and po != ao:
        ev = base + [f"pin oracle: {clip(po, 500)}", f"{ALT} oracle: {clip(ao, 500)}"]
        if lane == "strict":
            file("obs-strict", cid, f"  {cid}  {pr}/{ps} (lane strict)\n      {oneline_diff(po, ao)}", ev)
        else:
            file("obs-lastdraw", cid, f"{cid}[{lane}]", ev)
        continue
    same += 1

npin, nalt = rows(os.path.join(OUT, "record", "negative-latest.tsv")), rows(os.path.join(OUT, "negative-latest.tsv"))
neg_diff, neg_same = [], 0
for cid in sorted(set(npin) | set(nalt)):
    if cid not in npin or cid not in nalt:
        neg_diff.append(f"  {cid}: only in the {'record' if cid in npin else ALT + ' run'}")
        continue
    a, b = npin[cid], nalt[cid]
    if (a[0], a[1], norm(a[2])) != (b[0], b[1], norm(b[2])):
        neg_diff.append(f"  {cid}  pin={a[0]}/{a[1]} {ALT}={b[0]}/{b[1]}\n      {oneline_diff(norm(a[2]), norm(b[2]))}")
        evidence.append(("negative", cid, [f"pin={a[0]}/{a[1]} {ALT}={b[0]}/{b[1]}", f"pin detail: {clip(norm(a[2]))}", f"{ALT} detail: {clip(norm(b[2]))}"]))
    else:
        neg_same += 1

si_lines = []
if SI:
    def verdicts(p):
        d = {}
        for line in open(p):
            if line.startswith("#") or line.startswith("key\t") or not line.strip():
                continue
            k, _, v = line.rstrip("\n").partition("\t")
            d[k] = v
        return d
    a, b = verdicts("tools/nativefrontend/testdata/staticinit-oracle.tsv"), verdicts(SI)
    for k in sorted(set(a) | set(b)):
        if a.get(k) != b.get(k):
            si_lines.append(f"  {k}: pin={a.get(k, '<absent>')} {ALT}={b.get(k, '<absent>')}")

n = lambda k: len(cls[k])
ndiff = sum(len(v) for k, v in cls.items() if k != "obs-unverified")
counts = (f"[oracle-compile={n('compile')} abort-unclassifiable={n('abort-same') + n('abort-differ') + n('abort-sampled') + n('abort-unverified')} "
          f"(text-same={n('abort-same')} text-differs={n('abort-differ')} sampled-single-draw={n('abort-sampled')} unverified={n('abort-unverified')}) "
          f"flip={n('flip')} detail={n('detail')} exhibited-set-differs={n('exhibited-differs')} sampling-captions={n('sampling')} "
          f"oracle-obs-strict={n('obs-strict')} oracle-obs-lastdraw={n('obs-lastdraw')} oracle-obs-unverified={n('obs-unverified')} missing={n('missing')}]")
print(f"go-version-diversity: oracle {ALT} ({ALT_GOROOT}) vs the pinned oracle {PIN}; frontend and harness on {LIVE}")
print(f"  record: {REC}  (differential run exit {D_RC}, negative run exit {N_RC}: 1 = FAIL rows, read against the record below)")
if TREE_NOTE:
    print(f"  {TREE_NOTE}")
if CONTROL:
    print("  CONTROL RUN: the pin vs the pin on a fresh run — every difference below is run-to-run NOISE by definition (the noise floor).")
else:
    print("  REPORT-ONLY: never a re-pin; each difference is a finding for a human.")
    print(f"  PINNED ABORT CLASSIFIER (tools/coverageharness/abortkind.go, go1.26.5's runtime/panic.go lines): under {V} every panic/fatal row is")
    print("  NOT machine-compared (raw text only, below), and sampled (membership) abort rows are SINGLE-DRAW under diversity.")
    floor = read(CONTROL_REPORT)
    fl = [l for l in (floor or "").splitlines() if l.startswith("(") and " vs pin) " in l]
    if fl:
        print("  NOISE FLOOR (latest --control run of the pin): " + " | ".join(l.split(") ", 1)[1] for l in fl))
    else:
        print("  NOISE FLOOR: no --control report found — run `scripts/go-version-diversity --control` to calibrate.")
print(f"({ALT} vs pin) differential rows={len(set(pin) | set(alt))} same={same} differ={ndiff} {counts}")
print(f"({ALT} vs pin) negative rows={len(set(npin) | set(nalt))} same={neg_same} differ={len(neg_diff)}")
if SI:
    print(f"({ALT} vs pin) staticinit shapes differ={len(si_lines)}")
heads = [
    ("compile", f"oracle does not compile under {ALT} (a fixture needs a newer/removed toolchain feature — by construction)"),
    ("abort-differ", f"abort NOT machine-compared under {ALT}, and the oracle's raw abort text differs from the pin's"),
    ("flip", "result/stage/cause changed"),
    ("detail", "detail changed (same result/stage/cause)"),
    ("exhibited-differs", "membership: one side exhibited a member the other never did (SAMPLING-AMBIGUOUS: absence within the draw budget is not impossibility; both draw counts shown)"),
    ("obs-strict", "oracle output changed, all columns equal (strict lane)"),
    ("missing", "row present on one side only"),
]
for k, h in heads:
    if cls[k]:
        print(f"-- {h} ({n(k)})")
        print("\n".join(cls[k]))
inline = [
    ("abort-same", f"abort NOT machine-compared under {ALT}, raw abort text identical to the pin's"),
    ("abort-sampled", f"abort on a membership row: SINGLE-DRAW under {ALT} (the first panic draw stops the row); exhibited sets in the appendix"),
    ("abort-unverified", "abort NOT machine-compared, and the record's oracle files are not this program's — NOT compared"),
    ("sampling", "membership PASS, same exhibited set, only the captions' draw counts moved"),
    ("obs-lastdraw", "racy/confluent row: the LAST draw's oracle output changed (no per-draw record for these lanes; schedule-dependent, not by itself a version signal)"),
    ("obs-unverified", "columns agree, but the record's oracle files are not this program's — the oracle-output check did NOT run (counted in same=)"),
]
for k, h in inline:
    if cls[k]:
        print(f"-- {h} ({n(k)}): " + " ".join(cls[k]))
if neg_diff:
    print(f"-- negative lane changed ({len(neg_diff)})")
    print("\n".join(neg_diff))
if si_lines:
    print(f"-- static-init verdicts changed ({len(si_lines)})")
    print("\n".join(si_lines))
print()
print(f"== EVIDENCE (per classified row; normalized, clipped) — {len(evidence)} row(s)")
for k, cid, ev in evidence:
    print(f"[{k}] {cid}")
    for line in ev:
        print(f"    {line}")
PY
then
  echo "go-version-diversity: the comparison failed (see above) — no report" >&2
  exit 1
fi
sed '/^== EVIDENCE/,$d' "$OUT/report.txt"
echo "go-version-diversity: report (with the per-row EVIDENCE appendix) written to $OUT_REL/report.txt"
exit 0
