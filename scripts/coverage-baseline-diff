#!/usr/bin/env bash
# Diff a differential-coverage run against the recorded native-frontend baseline
# (baselines/native-full.tsv). "Same set = no regression" is the validation gate.
# Scope: for each case the results file ACTUALLY RAN, flag any (result, stage)
# change vs baseline, plus any id not in the baseline. A baseline case ABSENT
# from the results is treated as "not run this time" (skipped), NOT a regression
# — so a focused `diff-one` run diffs cleanly. Use --full to additionally require
# every baseline case to be present (a completeness check for full corpus runs).
#
# Usage: scripts/coverage-baseline-diff [--full] [--baseline <file>] [<results.tsv>]
#   default baseline: baselines/native-full.tsv; default results:
#   artifacts/coverage/latest.tsv. Pass --baseline baselines/negative-full.tsv
#   with artifacts/coverage/negative-latest.tsv for the negative lane (same
#   column discipline in both lanes).
# Exit 0 = no regression among cases run. Exit 1 = drift (ids printed).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

FULL=0
BASELINE="baselines/native-full.tsv"
while :; do
  case "${1:-}" in
    --full) FULL=1; shift ;;
    --baseline) BASELINE="${2:?--baseline needs a file}"; shift 2 ;;
    *) break ;;
  esac
done
RESULTS="${1:-artifacts/coverage/latest.tsv}"

[ -f "$BASELINE" ] || { echo "no baseline at $BASELINE" >&2; exit 2; }
[ -f "$RESULTS" ]  || { echo "no results at $RESULTS" >&2; exit 2; }

# Baseline columns: result,id,stage. Results columns: result,id,features,stage.
# Single awk pass, no temp files (sandbox-safe): load baseline (result/stage keyed
# by id), then compare each result row; emit drift and one-sided ids. A baseline
# id ABSENT from the results is "not run" (skipped) unless --full is set.
drift="$(awk -F'\t' -v BASE="$BASELINE" -v FULL="$FULL" '
  BEGIN {
    while ((getline line < BASE) > 0) {
      if (line ~ /^#/) continue
      n = split(line, f, "\t")
      if (f[1] == "result" || n < 2) continue
      # Well-formedness of the RECORD itself (S2 audit response: the
      # re-pinned baseline carried a silently-tolerated duplicated row —
      # id-keyed consumers resolved it last-wins; a duplicate with
      # CONFLICTING results would have been laundered the same way).
      if (f[2] in bseen) { print f[2] "\tDUPLICATE id in baseline (record integrity)"; }
      bkey[f[2]] = f[1] "/" f[3]; bseen[f[2]] = 1
    }
  }
  /^#/ { next }
  $1 == "result" { next }
  NF >= 2 {
    id = $2; now = $1 "/" $4; rseen[id] = 1
    if (!(id in bkey))      { print id "\tNEW id (not in baseline) -> " now; next }
    if (bkey[id] != now)      print id "\tbaseline[" bkey[id] "] -> now[" now "]"
  }
  END {
    if (FULL == 1)
      for (id in bseen) if (!(id in rseen)) print id "\tMISSING (in baseline, not run — --full)"
  }
' "$RESULTS" | LC_ALL=C sort)"

ran="$(awk -F'\t' '!/^#/ && $1!="result" && NF>=2' "$RESULTS" | wc -l | tr -d ' ')"
if [ -z "$drift" ]; then
  echo "no regression: $ran case(s) run in $(basename "$RESULTS") match $BASELINE"
  exit 0
fi
echo "DRIFT vs $BASELINE ($ran case(s) run):"
echo "$drift"
exit 1
