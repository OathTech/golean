#!/usr/bin/env bash
# wp-veneer-lint — the A-TRIP text lint: the day-one, syntax-level half of
# the VENEER tripwire (docs/2026-08-28_iris-corpus-plan.md §2d + §6.3;
# unit log docs/a-trip-log.md).
#
# THREAT MODEL (scope statement, [USER]-calibrated at the fix round,
# 2026-08-28): this gate exists to catch an HONEST AUTHOR under schedule
# pressure taking a shortcut that looks innocent — a direct machine
# unfold, a kernel decision on a machine prop, a corpus file that never
# got enrolled. It is NOT a fortress against a deliberate evader; we are
# the gate's only authors. Per the standing gates-are-speedbumps rule
# (2026-08-11): THIS GATE IS DONE — no further evasion iterations, no
# arms race; future changes to it are simplifications or deletions.
#
# THE NAMED FORBIDDEN PATTERN (plan §2d): a WP-stated theorem whose proof
# drops through adequacy — or unfolds the interpreter directly — to grind
# kernel spans of the concrete run under an Iris wrapper is a VENEER: the
# banned concrete-walking method in costume. The Audit statement-TCB gate
# polices STATEMENTS only (its own license: "Proofs may use anything" —
# proofs/Audit.lean), and at corpus scale kernel grinding is a cost
# INLIER, so neither existing defense can catch it. This lint is the
# cheap textual tripwire; scripts/WpVeneerClosure.lean is the proof-term
# closure check behind it.
#
# THIS IS A GATE, NOT A SPEEDBUMP-REPORT — deliberately unlike
# scripts/proof-lint (whose header forbids hardening because its rules
# are cost HEURISTICS). The rules here mechanize a chartered BAN with an
# explicit, opt-in scope: inside a scope-listed WP-tier file there is no
# legitimate kernel-decision closure and no legitimate unfold of the
# executable machine — a file that genuinely needs the machine is
# boundary-layer by definition and moves to the config's boundary class
# with a reviewed reason, never argues here.
#
# Scope config: scripts/wp-lint-scope.txt (the boundary definition, the
# directive reference, and the split-file convention live there).
# GOLEAN_WP_SCOPE overrides the config path — for the tripwire's own
# fire drills only (see docs/a-trip-log.md); ci always runs the default.
#
# What is checked, per file class (comments/docstrings stripped first, so
# prose mentions never fire):
#   police + boundary-sentences files:
#     V1  native decision in ANY spelling: `native_decide`,
#         `decide +native`, `decide (config := … native := true …)`
#     V2  kernel-replay decision in ANY spelling: `decide +kernel`,
#         `decide (config := … kernel := true …)`
#     V3  an unfold-class mention of an executable-machine name
#         (stepFn / stepFnIter / execStmt / execStmtLoop / allStreamsOk /
#         allStreamsOkPool): inside `unfold`/`delta` arguments, inside a
#         simp-family / `rw` bracket list (multi-line aware), or an
#         equation-lemma reference (`stepFn.eq_def`-class names). BARE
#         mentions are deliberately NOT banned: statements may speak the
#         machine where their class licenses it; what a scoped file may
#         never do is UNFOLD it.
#   boundary files: V1 + V2 only (the boundary layer legitimately
#     mentions the machine — that is its job; kernel-decision closures
#     stay banned everywhere in the WP stack).
#   boundary-kernel-ok files: V1, plus the V2 occurrence count must
#     EQUAL the pinned count from the config (grandfather drift, either
#     direction, FAILS — fix F6).
#   police-root dirs: completeness — every *.lean under the root must be
#     classified (police / boundary / boundary-kernel-ok /
#     boundary-sentences / exempt-file) or the lint FAILS naming the
#     stragglers (fix F5 — the silent-non-enrollment hole).
#
# EXIT SEMANTICS (fix F10): exit 2 = the scope itself is unusable
# (config missing/unreadable, or the police+sentences set is EMPTY —
# whatever the cause); exit 1 = violations, or scope problems (missing
# listed file, count drift, completeness stragglers, unparseable entry)
# alongside a nonempty scope. Clean -> exit 0. Every failure names its
# cause.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

SCOPE="${GOLEAN_WP_SCOPE:-scripts/wp-lint-scope.txt}"
if [ ! -r "$SCOPE" ]; then
  echo "wp-veneer-lint: FAIL — scope config '$SCOPE' missing or unreadable (fail closed)" >&2
  exit 2
fi

python3 - "$SCOPE" <<'PY'
import os, re, sys

scope_path = sys.argv[1]
MACHINE = r'(stepFnIter|stepFn|execStmtLoop|execStmt|allStreamsOkPool|allStreamsOk)'

police, boundary, sentences, roots, exempt_files = [], [], [], [], []
kernel_ok = {}      # path -> pinned decide+kernel count (F6)
problems, violations = [], []

with open(scope_path, encoding="utf-8") as fh:
    for lineno, raw in enumerate(fh, 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        kind = parts[0]
        if kind == "police" and len(parts) == 2:
            police.append(parts[1])
        elif kind == "boundary" and len(parts) == 2:
            boundary.append(parts[1])
        elif kind == "boundary-sentences" and len(parts) == 2:
            sentences.append(parts[1])
        elif kind == "boundary-kernel-ok" and len(parts) == 3 and parts[2].isdigit():
            boundary.append(parts[1])
            kernel_ok[parts[1]] = int(parts[2])
        elif kind == "police-root" and len(parts) == 2:
            roots.append(parts[1])
        elif kind == "exempt-file" and len(parts) == 2:
            exempt_files.append(parts[1])
        elif kind == "exempt" and len(parts) >= 2:
            pass  # closure-check-only directive; not this lint's business
        else:
            problems.append(f"{scope_path}:{lineno}: unparseable entry: {raw.rstrip()}")

# Scope vacuity: the POLICED tier (police + sentence files) must be
# nonempty — an empty tripwire scope is a misconfiguration, never a pass.
if not (police or sentences):
    print(f"wp-veneer-lint: FAIL — scope config '{scope_path}' lists NO police/"
          f"boundary-sentences files (an empty tripwire scope is a "
          f"misconfiguration, never a pass)", file=sys.stderr)
    for p in problems:
        print("  " + p, file=sys.stderr)
    sys.exit(2)

# F5 completeness: every .lean under a police-root must be classified.
classified = set(police) | set(boundary) | set(sentences) | set(exempt_files)
for root in roots:
    if not os.path.isdir(root):
        problems.append(f"police-root '{root}' is not a directory (fail closed)")
        continue
    found = []
    for dp, _, names in os.walk(root):
        for n in sorted(names):
            if n.endswith(".lean"):
                found.append(os.path.join(dp, n))
    if not found:
        problems.append(f"police-root '{root}' contains no .lean files (fail-noisy)")
    for f in sorted(found):
        if f not in classified:
            problems.append(
                f"{f}: UNENROLLED under police-root '{root}' — classify it in "
                f"{scope_path} (police / boundary-sentences per the split-file "
                f"convention; exempt-file is for pre-existing legacy only)")

# exempt-file entries must exist (config rot is loud).
for f in exempt_files:
    if not os.path.isfile(f):
        problems.append(f"exempt-file '{f}' missing on disk (stale scope entry — fail closed)")

def strip_comments(src):
    """Strip -- line comments and (nested) /- ... -/ block comments,
    preserving line structure. Stripping too much can only hide prose,
    never invent code — the safe direction for this gate."""
    out, i, depth, n = [], 0, 0, len(src)
    while i < n:
        c = src[i]
        if depth == 0 and c == '-' and src.startswith("--", i):
            j = src.find("\n", i)
            i = n if j == -1 else j
            continue
        if c == '/' and src.startswith("/-", i):
            depth += 1; i += 2; continue
        if depth > 0 and c == '-' and src.startswith("-/", i):
            depth -= 1; i += 2; continue
        if depth > 0:
            out.append(c if c == "\n" else " ")
        else:
            out.append(c)
        i += 1
    return "".join(out)

# F4: the flag AND config-syntax spellings, as plain patterns (no decide-
# configuration parser — [USER] recalibration). The config-syntax window
# is a bounded lazy match so a line-broken config object still hits.
NATIVE_RES = [
    re.compile(r'\bnative_decide\b'),
    re.compile(r'\bdecide\s*\+\s*native\b'),
    re.compile(r'\bdecide\s*\(\s*config\s*:=[^)]{0,200}?\bnative\s*:=\s*true'),
]
KERNEL_RES = [
    re.compile(r'\bdecide\s*\+\s*kernel\b'),
    re.compile(r'\bdecide\s*\(\s*config\s*:=[^)]{0,200}?\bkernel\s*:=\s*true'),
]
MACHINE_RE = re.compile(r'\b' + MACHINE + r'\b')
EQLEMMA_RE = re.compile(r'\b' + MACHINE + r'\.(eq_def|eq_\d+|_eq_\d+|_unfold|match_\d+)\b')
UNFOLD_RE = re.compile(r'\b(unfold|delta)\b([^\n;]*)')
SIMPHEAD_RE = re.compile(r'\b(simp_all_arith|simp_arith|simp_all|dsimp|simp|rw|rewrite|norm_num)\b')

def bracket_lists(text):
    """Yield (start_offset, content) for each [...] argument list that
    follows a simp-family/rw head (whitespace, `only`, and a (config)
    group may intervene). Multi-line aware, bracket-balanced."""
    for m in SIMPHEAD_RE.finditer(text):
        i = m.end()
        n = len(text)
        while i < n:
            if text[i].isspace():
                i += 1
            elif text.startswith("only", i):
                i += 4
            elif text[i] == '(':
                depth = 1; i += 1
                while i < n and depth:
                    if text[i] == '(': depth += 1
                    elif text[i] == ')': depth -= 1
                    i += 1
            else:
                break
        if i < n and text[i] == '[':
            depth = 1; j = i + 1
            while j < n and depth:
                if text[j] == '[': depth += 1
                elif text[j] == ']': depth -= 1
                j += 1
            yield i, text[i:j]

def lineno_at(text, off):
    return text.count("\n", 0, off) + 1

def scan(path, machine_rules):
    try:
        src = open(path, encoding="utf-8").read()
    except OSError as e:
        problems.append(f"{path}: UNREADABLE ({e}) — a scope-listed file must be scannable (fail closed)")
        return
    code = strip_comments(src)
    for rx in NATIVE_RES:
        for m in rx.finditer(code):
            violations.append(f"{path}:{lineno_at(code, m.start())}: V1 native decision "
                              f"(`{m.group(0).splitlines()[0]}`) in WP-tier scope")
    nkernel = 0
    for rx in KERNEL_RES:
        nkernel += len(rx.findall(code))
    if path in kernel_ok:
        if nkernel != kernel_ok[path]:
            problems.append(
                f"{path}: grandfathered kernel-decide count DRIFTED — pinned "
                f"{kernel_ok[path]}, found {nkernel} (F6: re-pin deliberately in "
                f"{scope_path} with a reason, never silently)")
    elif nkernel:
        for rx in KERNEL_RES:
            for m in rx.finditer(code):
                violations.append(f"{path}:{lineno_at(code, m.start())}: V2 kernel-replay decision "
                                  f"(`{m.group(0).splitlines()[0]}`) in WP-tier scope")
    if not machine_rules:
        return
    for m in UNFOLD_RE.finditer(code):
        hit = MACHINE_RE.search(m.group(2))
        if hit:
            violations.append(
                f"{path}:{lineno_at(code, m.start())}: V3 `{m.group(1)} … {hit.group(0)}` — "
                f"direct machine unfold above the Laws/lifting/adequacy boundary (plan §2d)")
    for off, content in bracket_lists(code):
        hit = MACHINE_RE.search(content)
        if hit:
            violations.append(
                f"{path}:{lineno_at(code, off)}: V3 simp/rw set names `{hit.group(0)}` — "
                f"direct machine unfold above the Laws/lifting/adequacy boundary (plan §2d)")
    for m in EQLEMMA_RE.finditer(code):
        violations.append(
            f"{path}:{lineno_at(code, m.start())}: V3 equation-lemma reference `{m.group(0)}` — "
            f"machine unfolding by equation lemma (plan §2d)")

seen = set()
for p, machine_rules in ([(x, True) for x in police] + [(x, True) for x in sentences]
                          + [(x, False) for x in boundary]):
    if p in seen:
        problems.append(f"{p}: listed in more than one scope class (fail closed — pick one)")
        continue
    seen.add(p)
    scan(p, machine_rules)

status = 0
if problems:
    print("wp-veneer-lint: scope problems (fail closed):", file=sys.stderr)
    for p in problems:
        print("  " + p, file=sys.stderr)
    status = 1
if violations:
    print("wp-veneer-lint: VENEER-BAN VIOLATIONS (plan §2d — reformulate through the "
          "Laws/lifting/adequacy layer; a file that IS that layer moves to the config's "
          "boundary class with a reviewed reason):", file=sys.stderr)
    for v in violations:
        print("  " + v, file=sys.stderr)
    status = 1
if status == 0:
    print(f"wp-veneer-lint: clean — {len(police)} policed, {len(sentences)} sentence-export, "
          f"{len(boundary)} boundary file(s); {len(roots)} completeness root(s) "
          f"({len(exempt_files)} legacy-exempt); 0 violations")
sys.exit(status)
PY
