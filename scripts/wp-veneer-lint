#!/usr/bin/env bash
# wp-veneer-lint — the A-TRIP text lint: the day-one, syntax-level half of
# the VENEER tripwire (docs/2026-08-28_iris-corpus-plan.md §2d + §6.3;
# unit log docs/a-trip-log.md).
#
# THE NAMED FORBIDDEN PATTERN (plan §2d): a WP-stated theorem whose proof
# drops through adequacy — or unfolds the interpreter directly — to grind
# kernel spans of the concrete run under an Iris wrapper is a VENEER: the
# banned concrete-walking method in costume. The Audit statement-TCB gate
# polices STATEMENTS only (its own license: "Proofs may use anything" —
# proofs/Audit.lean), and at corpus scale kernel grinding is a cost
# INLIER, so neither existing defense can catch it. This lint is the
# cheap textual tripwire; scripts/WpVeneerClosure.lean is the proof-term
# closure check behind it.
#
# THIS IS A GATE, NOT A SPEEDBUMP — deliberately unlike scripts/proof-lint
# (whose header forbids hardening because its rules are cost HEURISTICS
# with measured false-positive classes). The rules here mechanize a
# chartered BAN with an explicit, opt-in scope: inside a scope-listed
# WP-tier file there is no legitimate `decide +kernel` closure and no
# legitimate unfold of the executable machine — a file that genuinely
# needs the machine is boundary-layer by definition and moves to the
# config's `boundary` class with a reviewed reason, never argues here.
#
# Scope config: scripts/wp-lint-scope.txt (the boundary definition lives
# there). GOLEAN_WP_SCOPE overrides the config path — for the tripwire's
# own fire drill only (see docs/a-trip-log.md); ci always runs the
# default.
#
# What is checked, per file class (comments/docstrings stripped first, so
# prose mentions never fire):
#   police files:
#     V1  `native_decide` (redundant with the global escape-hatch ban —
#         kept so this gate is self-contained over its scope)
#     V2  `decide +kernel` (kernel-replay decision closures)
#     V3  an unfold-class mention of an executable-machine name
#         (stepFn / stepFnIter / execStmt / execStmtLoop / allStreamsOk /
#         allStreamsOkPool): inside `unfold`/`delta` arguments, inside a
#         simp-family / `rw` bracket list (multi-line aware), or an
#         equation-lemma reference (`stepFn.eq_def`-class names). BARE
#         mentions are deliberately NOT banned: a corpus file's exported
#         first-order sentence may STATE the machine (statement closure is
#         the Audit gate's beat); what it may never do is UNFOLD it.
#   boundary files: V1 + V2 only (the boundary layer legitimately
#     mentions the machine — that is its job; kernel-decision closures
#     stay banned everywhere in the WP stack). `boundary-kernel-ok`
#     files (the config's grandfather class, per-file, provenance
#     required) drop V2 only.
#
# FAIL-CLOSED: missing/unreadable config -> exit 2; EMPTY police list ->
# exit 2 (a tripwire with nothing under it is a misconfiguration, not a
# pass); scope-listed file missing/unreadable -> exit 1; *-dir with no
# .lean files -> exit 1. Violations -> exit 1. Clean -> exit 0.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

SCOPE="${GOLEAN_WP_SCOPE:-scripts/wp-lint-scope.txt}"
if [ ! -r "$SCOPE" ]; then
  echo "wp-veneer-lint: FAIL — scope config '$SCOPE' missing or unreadable (fail closed)" >&2
  exit 2
fi

python3 - "$SCOPE" <<'PY'
import os, re, sys

scope_path = sys.argv[1]
MACHINE = r'(stepFnIter|stepFn|execStmtLoop|execStmt|allStreamsOkPool|allStreamsOk)'

police, boundary, problems, violations = [], [], [], []
kernel_ok = set()   # boundary-kernel-ok files: grandfathered decide+kernel

with open(scope_path, encoding="utf-8") as fh:
    for lineno, raw in enumerate(fh, 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) != 2:
            problems.append(f"{scope_path}:{lineno}: unparseable entry: {raw.rstrip()}")
            continue
        kind, arg = parts
        if kind in ("police", "boundary"):
            (police if kind == "police" else boundary).append(arg)
        elif kind == "boundary-kernel-ok":
            boundary.append(arg)
            kernel_ok.add(arg)
        elif kind in ("police-dir", "boundary-dir"):
            if not os.path.isdir(arg):
                problems.append(f"{scope_path}:{lineno}: {kind} '{arg}' is not a directory (fail closed)")
                continue
            found = []
            for dp, _, names in os.walk(arg):
                for n in sorted(names):
                    if n.endswith(".lean"):
                        found.append(os.path.join(dp, n))
            if not found:
                problems.append(f"{scope_path}:{lineno}: {kind} '{arg}' contains no .lean files (fail closed)")
            (police if kind == "police-dir" else boundary).extend(sorted(found))
        elif kind == "exempt":
            pass  # closure-check-only directive; not this lint's business
        else:
            problems.append(f"{scope_path}:{lineno}: unknown directive '{kind}' (fail closed)")

if not police:
    print(f"wp-veneer-lint: FAIL — scope config '{scope_path}' lists NO police files "
          f"(an empty tripwire scope is a misconfiguration, never a pass)", file=sys.stderr)
    for p in problems:
        print("  " + p, file=sys.stderr)
    sys.exit(2)

def strip_comments(src):
    """Strip -- line comments and (nested) /- ... -/ block comments,
    preserving line structure. Backtick/string subtleties are accepted
    slop in the SAFE direction for this gate: stripping too much can only
    hide prose, never invent code."""
    out, i, depth, n = [], 0, 0, len(src)
    while i < n:
        c = src[i]
        if depth == 0 and c == '-' and src.startswith("--", i):
            j = src.find("\n", i)
            i = n if j == -1 else j
            continue
        if c == '/' and src.startswith("/-", i):
            depth += 1; i += 2; continue
        if depth > 0 and c == '-' and src.startswith("-/", i):
            depth -= 1; i += 2; continue
        if depth > 0:
            out.append(c if c == "\n" else " ")
        else:
            out.append(c)
        i += 1
    return "".join(out)

MACHINE_RE = re.compile(r'\b' + MACHINE + r'\b')
EQLEMMA_RE = re.compile(r'\b' + MACHINE + r'\.(eq_def|eq_\d+|_eq_\d+|_unfold|match_\d+)\b')
UNFOLD_RE = re.compile(r'\b(unfold|delta)\b([^\n;]*)')
SIMPHEAD_RE = re.compile(r'\b(simp_all_arith|simp_arith|simp_all|dsimp|simp|rw|rewrite|norm_num)\b')

def bracket_lists(text):
    """Yield (start_offset, content) for each [...] argument list that
    follows a simp-family/rw head (whitespace, `only`, and a (config)
    group may intervene). Multi-line aware, bracket-balanced."""
    for m in SIMPHEAD_RE.finditer(text):
        i = m.end()
        n = len(text)
        # skip whitespace, `only`, `(...)` config groups, `at h` is a stop
        while i < n:
            if text[i].isspace():
                i += 1
            elif text.startswith("only", i):
                i += 4
            elif text[i] == '(':
                depth = 1; i += 1
                while i < n and depth:
                    if text[i] == '(': depth += 1
                    elif text[i] == ')': depth -= 1
                    i += 1
            else:
                break
        if i < n and text[i] == '[':
            depth = 1; j = i + 1
            while j < n and depth:
                if text[j] == '[': depth += 1
                elif text[j] == ']': depth -= 1
                j += 1
            yield i, text[i:j]

def lineno_at(text, off):
    return text.count("\n", 0, off) + 1

def scan(path, is_police):
    try:
        src = open(path, encoding="utf-8").read()
    except OSError as e:
        problems.append(f"{path}: UNREADABLE ({e}) — a scope-listed file must be scannable (fail closed)")
        return
    code = strip_comments(src)
    for m in re.finditer(r'\bnative_decide\b', code):
        violations.append(f"{path}:{lineno_at(code, m.start())}: V1 native_decide in WP-tier scope")
    if path not in kernel_ok:
        for m in re.finditer(r'\bdecide\s*\+\s*kernel\b', code):
            violations.append(f"{path}:{lineno_at(code, m.start())}: V2 `decide +kernel` kernel-replay closure in WP-tier scope")
    if not is_police:
        return
    for m in UNFOLD_RE.finditer(code):
        hit = MACHINE_RE.search(m.group(2))
        if hit:
            violations.append(
                f"{path}:{lineno_at(code, m.start())}: V3 `{m.group(1)} … {hit.group(0)}` — "
                f"direct machine unfold above the Laws/lifting/adequacy boundary (plan §2d)")
    for off, content in bracket_lists(code):
        hit = MACHINE_RE.search(content)
        if hit:
            violations.append(
                f"{path}:{lineno_at(code, off)}: V3 simp/rw set names `{hit.group(0)}` — "
                f"direct machine unfold above the Laws/lifting/adequacy boundary (plan §2d)")
    for m in EQLEMMA_RE.finditer(code):
        violations.append(
            f"{path}:{lineno_at(code, m.start())}: V3 equation-lemma reference `{m.group(0)}` — "
            f"machine unfolding by equation lemma (plan §2d)")

seen = set()
for p in police:
    if p not in seen:
        seen.add(p); scan(p, True)
for p in boundary:
    if p in seen:
        problems.append(f"{p}: listed as BOTH police and boundary (fail closed — pick one)")
        continue
    seen.add(p); scan(p, False)

status = 0
if problems:
    print("wp-veneer-lint: scope problems (fail closed):", file=sys.stderr)
    for p in problems:
        print("  " + p, file=sys.stderr)
    status = 1
if violations:
    print("wp-veneer-lint: VENEER-BAN VIOLATIONS (plan §2d — reformulate through the "
          "Laws/lifting/adequacy layer; a file that IS that layer moves to the config's "
          "boundary class with a reviewed reason):", file=sys.stderr)
    for v in violations:
        print("  " + v, file=sys.stderr)
    status = 1
if status == 0:
    print(f"wp-veneer-lint: clean — {len(police)} policed file(s), "
          f"{len(boundary)} boundary file(s), 0 violations")
sys.exit(status)
PY
