#!/usr/bin/env bash
# check-spec-anchors — every spec#/mem# citation in tracked files must
# resolve to a real anchor in the PINNED Go spec / memory model.
#
# Mechanism 4.1 of the spec-truth campaign
# (docs/2026-08-17_spec-and-community-truth-campaign.md §4.1): a spec
# citation is a machine-checkable object. This lint checks RESOLUTION
# (the cited anchor exists at the pin), deliberately not claim-support
# — that stays with the audit dimension. Content-level drift detection
# (did the cited TEXT change) is the covmap layer's job, not this
# lint's; see the campaign doc §8 and the go_mem `977e23a707` lesson
# (anchors and version lines can survive normative changes).
#
# Citation syntax (tracked convention, JSCert-style):
#   spec#Anchor_name  ->  deps/go/doc/go_spec.html  id="Anchor_name"
#   mem#anchor_name   ->  deps/go/doc/go_mem.html   id="anchor_name"
# Scanned surface: tracked .md, .lean, and .go files (audit F1.3 — the
# corpus's Go sources carry citations too). Prose placeholders use
# angle brackets (spec#<Anchor>), which the scanner does not match. A
# citation token is #-then-anchor-chars; anchor chars are
# [A-Za-z0-9_.-] (the pinned namespace includes dots and hyphens —
# Floating-point_literals, Passing_arguments_to_..._parameters, Go_1.9
# — verified: zero pinned ids outside this set; grammar widened at P3
# when the first dotted-anchor citations arrived). Trailing dots and
# hyphens are stripped as prose punctuation, so "see spec#Close."
# cites Close; an interior hyphen or dot is part of the anchor.
# SCOPE, stated honestly: this lint checks RESOLUTION only — it cannot
# see a resolving anchor attached to a misquoted or stale clause text
# (that class is the covmap content-hash layer's job, and the audit
# that found five such quotes proves the class is real).
#
# Fail closed:
#   - no deps/go checkout             -> FAIL (scripts/setup-deps --only go)
#   - deps/go not at the recorded pin -> FAIL (trust-tools rule: resolve
#     rev drift by hand, never silently)
#   - any unresolved citation         -> FAIL, listing file:line:token
set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

SPEC=deps/go/doc/go_spec.html
MEM=deps/go/doc/go_mem.html
if [[ ! -f "$SPEC" || ! -f "$MEM" ]]; then
  echo "check-spec-anchors: FAIL — pinned spec checkout missing ($SPEC)." >&2
  echo "  run: scripts/setup-deps --only go   (fail closed by design)" >&2
  exit 1
fi

# The pin's authoritative home is the setup-deps table (itself derived
# from docs/spec-sources.md). Verify the checkout matches it, so this
# lint never validates citations against the wrong revision.
pin="$(sed -n '/^PINS=/,/^TABLE$/p' scripts/setup-deps | awk '$1 == "go" { print $2 }')"
have="$(git -C deps/go rev-parse HEAD)"
if [[ -z "$pin" || "$have" != "$pin"* ]]; then
  echo "check-spec-anchors: FAIL — deps/go at ${have:0:9}, pin is ${pin:0:9} (rev drift; fail closed)" >&2
  exit 1
fi

# The pin check verifies the REVISION; also refuse a locally modified
# spec/mem file (audit F1.4 — a dirty doc at the right SHA must not
# validate citations).
if ! git -C deps/go diff --quiet HEAD -- doc/go_spec.html doc/go_mem.html 2>/dev/null; then
  echo "check-spec-anchors: FAIL — deps/go doc files locally modified at the pin (fail closed)" >&2
  exit 1
fi

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
grep -o 'id="[^"]*"' "$SPEC" | sed 's/^id="//;s/"$//' | sort -u > "$tmp/spec-ids"
grep -o 'id="[^"]*"' "$MEM"  | sed 's/^id="//;s/"$//' | sort -u > "$tmp/mem-ids"

# Spool the file list FIRST so a git failure is a hard stop (audit F1.1:
# a trailing `|| true` on the whole pipeline swallowed `git ls-files`
# dying and reported ok with 0 citations). grep gets `|| true` only for
# its legitimate no-match exit; --null makes the filename separator
# unambiguous so paths containing ':' cannot shift the parse (F1.2).
git ls-files -z '*.md' '*.lean' '*.go' > "$tmp/files"
# Gate the grep pipeline on exit 0/1 only (delta-review N4: a bare
# `|| true` also swallowed grep exit 2 / xargs 123 — unreadable files
# would silently vanish from the scan). Known residual gap, recorded:
# a tracked file containing NUL bytes is treated as binary by grep and
# its citations are skipped with only an stderr note (N6).
# BATCHING FIX (2026-08-28, arc4b landing): once the NUL-separated file
# list exceeds xargs's ~128 KiB per-invocation budget (first crossed at
# 131,087 bytes when the arc4b lane's nine files landed), grep runs in
# MULTIPLE batches, and any batch with zero matches exits 1 — which
# xargs reports as 123, indistinguishable at the top level from a real
# scan death. So map grep's legitimate no-match exit (1) to 0 INSIDE
# each batch; a real grep error (>=2) makes the wrapper exit nonzero,
# xargs returns 123, and the rc>1 death check below still fires —
# fail-closed behavior for genuine errors is unchanged.
set +e
xargs -0 sh -c 'grep --null -nHoE "(^|[^A-Za-z0-9_])(spec|mem)#[A-Za-z0-9_][A-Za-z0-9_.-]*" -- "$@" || [ "$?" -eq 1 ]' scan < "$tmp/files" > "$tmp/hits"
rc=$?
set -e
if [[ "$rc" -gt 1 ]]; then
  echo "check-spec-anchors: FAIL — citation scan died (grep/xargs exit $rc; fail closed)" >&2
  exit 1
fi

fail=0
n_spec=0; n_mem=0
while IFS= read -r -d '' f && IFS= read -r rest; do
  ln="${rest%%:*}"; tok="${rest#*:}"
  tok="$(printf '%s' "$tok" | sed 's/^[^A-Za-z0-9_]*//')"
  prefix="${tok%%#*}"; anchor="${tok#*#}"
  anchor="$(printf '%s' "$anchor" | sed 's/[.-]*$//')"  # trailing prose punctuation
  case "$prefix" in
    spec) ids="$tmp/spec-ids"; name="go_spec.html"; n_spec=$((n_spec+1)) ;;
    mem)  ids="$tmp/mem-ids";  name="go_mem.html";  n_mem=$((n_mem+1)) ;;
    *)    echo "  UNPARSED ${f}: '${rest}' (fail closed on grammar misses — audit F1.2)"; fail=1; continue ;;
  esac
  if ! grep -qxF "$anchor" "$ids"; then
    echo "  UNRESOLVED ${f}:${ln}: ${prefix}#${anchor} — no id=\"${anchor}\" in the pinned ${name}"
    fail=1
  fi
done < "$tmp/hits"

if [[ "$fail" -ne 0 ]]; then
  echo "check-spec-anchors: FAIL — unresolved citations above (pin ${pin:0:9})" >&2
  exit 1
fi
if [[ $((n_spec + n_mem)) -eq 0 ]]; then
  echo "check-spec-anchors: FAIL — zero citations found; the scan is degenerate (a repo with the retrofit landed always has citations — if that ever legitimately changes, update this guard with the reason)" >&2
  exit 1
fi
echo "check-spec-anchors: ok — ${n_spec} spec# + ${n_mem} mem# citations all resolve at pin ${pin:0:9}"
