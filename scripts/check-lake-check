#!/usr/bin/env bash
# The `lake check` SPEEDBUMP (lane toolchain/lean-4.35-1020, 2026-10-21; release-readiness row
# 42, [USER]-ruled 2026-10-20: bump to Lean v4.35.0 and add `lake check` to the gate script as a
# report-only speedbump inside the sandbox; the open half ruled 2026-10-21, lane
# gate/lake-check-1021: the default targets are the main-free LIBRARIES only, so the check can
# run — before that it stopped at the second top-level `main` — and it sits in the `--diff`
# tier of scripts/ci, about four minutes).
#
# `lake check` (toolchains >= 4.35) builds the default targets, exports every default module's
# declarations (`leanexport`), replays the export through the kernel (`leanchecker`) and refuses
# any axiom beyond propext / Classical.choice / Quot.sound; `--paranoid` adds the bundled external
# kernels. It runs the project inside a `bwrap` sandbox, which needs unprivileged user namespaces
# (or a setuid bwrap). THIS SCRIPT DETECTS whether bwrap can start here (box-independence,
# release-readiness row 46, [USER] 2026-10-21: nothing box-specific hard-coded): where it can,
# `lake check` runs sandboxed; where it cannot — an OS-sandboxed agent session fails Lake's flag
# set on «loopback: Failed to create NETLINK_ROUTE socket», a box without bwrap has none — it runs with
# `--inadvisably-no-sandbox` (the toolchain itself prints «this run is not trustworthy»). The
# line this script prints says which form ran. Either way it is a SPEEDBUMP: report-only, read
# at the merge ask by name. The GATE is the owner's `lake check` outside the sandbox at claim
# points, `--paranoid` at the release claim point (CLAUDE.md «The gates»; docs/operational-
# lessons.md, «Lean 4.35»). The kernel replay gate stays `scripts/check-kernel-replay` in the
# fast tier: no bwrap, 9.1 s at 4 threads (6.8 s at 8), and it checks the on-disk olean set against the module set, which
# `lake check` (exporting what the default targets import) does not; `lake check` in turn
# covers the default test libraries' modules (the pins in Tests/GoCoreContract.lean, the audit
# harness, the admission facts), which the `GoLean`-prefix replay does not.
#
# Fail closed: any nonzero exit of `lake check` is a FAIL that names the toolchain's first error
# line; a run that prints no acceptance line («… kernel accepts …») or no axiom verdict («Uses
# no axioms» / «Uses axioms: …») is a FAIL too; a green run prints both lines, and then SAYS WHAT
# THE EXPORT COVERED (lane gate/contract-pins-1025, 2026-10-25, release-readiness row 42's
# follow-up: the two theorem-bearing test libraries became default targets, and the line must
# show it): `lake check`'s export half imports every module of the default targets into one
# environment and dumps that environment (Lake/CLI/Main.lean, `checkExport`), so the covered set
# is that import closure. After a green run this script imports the same modules (the default
# targets' modules from lakefile.toml, scripts/lakefile-targets.sh — the parser scripts/ci uses)
# in a scratch `lake env lean` and counts the environment's modules: the project's (`GoLean.*`,
# `Tests.*`, `Contract.*`) and all. A count that cannot be computed is a FAIL (the line would
# otherwise claim a coverage it cannot name).
# The line this script prints carries the sandbox form, the exit code, the wall and the peak RSS
# of the checker process tree (GNU time's %M is the largest single process; the cgroup peak is
# the gate's). The run goes through `cap` (scripts/cap.sh): the box tool `capped` when it is on
# PATH, bare otherwise.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$ROOT/scripts/cap.sh"
. "$ROOT/scripts/lakefile-targets.sh"
cd "$ROOT" || { echo "check-lake-check: cannot cd to $ROOT" >&2; exit 1; }
[[ $# = 0 ]] || { echo 'check-lake-check: expected no arguments' >&2; exit 2; }
export TMPDIR="$ROOT/.tmp"
mkdir -p "$TMPDIR"
log="$(mktemp "$TMPDIR/lake-check.XXXXXX.log")"

# The sandbox probe: Lake's own base flag set (Lake/CLI/Check.lean,
# buildSandboxArgs, minus the per-run binds and chdir), through the same
# binary Lake would use (COMPARATOR_BWRAP names it, default `bwrap`), so an
# environment that passes here can start Lake's sandbox and one that cannot
# is labelled «no sandbox» with the first stderr line as the reason — a user
# namespace that opens but cannot unshare the network, say, fails here too
# (fix round 2026-10-21: the weaker `--ro-bind / / --dev /dev` probe would
# have called that run «sandboxed»).
sandbox_bin="${COMPARATOR_BWRAP:-bwrap}"
sandbox_flags=()
if ! command -v "$sandbox_bin" >/dev/null 2>&1; then
  sandbox_flags=(--inadvisably-no-sandbox); form="no sandbox ($sandbox_bin is not installed)"
elif probe="$("$sandbox_bin" --ro-bind / / --tmpfs /home --tmpfs /root --tmpfs /run/user --tmpfs /tmp --dir /tmp/home \
                --dev /dev --proc /proc --clearenv --setenv HOME /tmp/home --unshare-all --die-with-parent --new-session \
                --chdir / -- /bin/true 2>&1)"; then
  form="sandboxed ($sandbox_bin starts with Lake's flags here)"
else
  sandbox_flags=(--inadvisably-no-sandbox); form="no sandbox ($sandbox_bin cannot start with Lake's flags here: $(printf '%s' "$probe" | head -1))"
fi

timer=()
if [ -x /usr/bin/time ]; then timer=(/usr/bin/time -f 'lake-check-rusage wall=%e s maxrss=%M KB'); fi
started=$SECONDS
cap "${timer[@]+"${timer[@]}"}" lake check "${sandbox_flags[@]+"${sandbox_flags[@]}"}" > "$log" 2>&1; rc=$?
wall=$((SECONDS - started))
rusage="$(grep -m1 '^lake-check-rusage ' "$log" || true)"
if [ -n "$rusage" ]; then
  kb="$(printf '%s\n' "$rusage" | sed -n 's/.*maxrss=\([0-9][0-9]*\) KB.*/\1/p')"
  cost="wall $(printf '%s\n' "$rusage" | sed -n 's/.*wall=\([0-9.]*\) s.*/\1/p') s; largest process $((kb / 1024)) MB"
else
  cost="wall ${wall} s; peak RSS unmeasured (/usr/bin/time absent)"
fi
verdict="$(grep -m1 -E '^Uses (no axioms|axioms: )' "$log" || true)"
accepted="$(grep -m1 -E 'kernel accepts' "$log" || true)"
echo "lake check, $form (speedbump; the owner's run outside the sandbox is the gate): exit $rc; $cost; ${accepted:-no acceptance line printed}; ${verdict:-no axiom verdict printed}"
if [ "$rc" -ne 0 ] || [ -z "$verdict" ] || [ -z "$accepted" ]; then
  first_err="$(grep -m1 -E '^error: ' "$log" || true)"
  echo "check-lake-check: FAIL — ${first_err:-lake check exited $rc without an error line}" >&2
  echo "check-lake-check: the log is kept at $log" >&2
  exit 1
fi
rm -f "$log"

# What the export covered: the default targets' modules, imported as `lake check` imports them.
defaults="$(lakefile_default_targets)"
[ -n "$defaults" ] || { echo "check-lake-check: FAIL — no defaultTargets read from lakefile.toml; the covered set cannot be named" >&2; exit 1; }
mods=""
for d in $defaults; do
  line="$(lakefile_targets | grep -E "^lib $d( |$)" || true)"
  [ -n "$line" ] || { echo "check-lake-check: FAIL — default target '$d' is not a declared library (lakefile.toml); the covered set cannot be named" >&2; exit 1; }
  m="$(lakefile_lib_modules "$line")"
  [ -n "$m" ] || { echo "check-lake-check: FAIL — default library '$d' has no modules to import (no globs and no root module file)" >&2; exit 1; }
  mods="$mods $m"
done
scratch="$(mktemp "$TMPDIR/lake-check-modules.XXXXXX.lean")"
{
  for m in $mods; do echo "import $m"; done
  cat <<'LEAN'
open Lean Elab Command in
#eval show CommandElabM Unit from do
  let names := (← getEnv).header.moduleNames
  let project := names.filter fun n => [`GoLean, `Tests, `Contract].any (fun r => r.isPrefixOf n)
  IO.println s!"lake-check-modules project={project.size} all={names.size}"
LEAN
} > "$scratch"
count_out="$(cap lake env lean "$scratch" 2>&1)"; count_rc=$?
rm -f "$scratch"
covered="$(printf '%s\n' "$count_out" | grep -m1 '^lake-check-modules ' || true)"
if [ "$count_rc" -ne 0 ] || [ -z "$covered" ]; then
  printf '%s\n' "$count_out" | head -5 >&2
  echo "check-lake-check: FAIL — the default targets' modules could not be imported to count the covered set (above)" >&2
  exit 1
fi
n_project="$(printf '%s\n' "$covered" | sed -n 's/.*project=\([0-9]*\).*/\1/p')"
n_all="$(printf '%s\n' "$covered" | sed -n 's/.*all=\([0-9]*\).*/\1/p')"
echo "lake check speedbump: PASS — $form; $cost; the default targets ($defaults) export and replay through the kernel on standard axioms only («$accepted»; «$verdict»); the exported environment holds $n_project project modules ($n_all with the toolchain's)"
