#!/usr/bin/env bash
# Per-module proof-cost recorder — a SPEEDBUMP, report-only.
#
#   scripts/proof-costs            record a run (incremental: only what Lake
#                                  rebuilds is measured, and only that is
#                                  written)
#   scripts/proof-costs --clean    wipe our own proofs modules first, so the
#                                  record covers the whole GoLeanProofs tree
#                                  (dependencies/iris are left alone)
#   scripts/proof-costs --check    no build: compare each module against its
#                                  own previous recording, print growth notes
#
# Writes/appends to artifacts/proof-costs.tsv (artifacts/ is gitignored — this
# is a local trend line, never a tracked baseline). Format: a dated `#run`
# header per recording, then one row per module:
#
#   module<TAB>wall_s<TAB>peak_mib
#
# DO NOT HARDEN THIS INTO A GATE. It reports; it never blocks, never fails a
# build, and its absence is never an error. Proof cost is a budget question
# for a human, not a correctness property: a module that legitimately grows
# (a new phase, a harder theorem) must not need a ceremony to land, and a
# cost gate would either be tuned so loose it says nothing or so tight it
# turns every real proof into a fight with the gate. The repo's gates are for
# claims that must be true; this one is for a number that must be VISIBLE.
# (Standing policy: gates are speedbumps — never aim hardening at this file.)
#
# HOW PEAK IS MEASURED, and its honest limit: Lake spawns one `lean` worker
# per module; this script polls /proc/<pid>/status VmHWM in kB (the kernel's own
# high-water mark for that process — not a sample of current RSS) every
# 0.25 s and keeps the largest value seen per module. A module whose worker
# lives shorter than the poll interval can be MISSED entirely (it is then
# absent from the record, not recorded as zero). Wall time is Lake's own
# per-module figure, parsed from its build log.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

# MEMORY CAP — record mode runs a full `lake build`, which is exactly the
# thing that must never run uncapped (CLAUDE.md; scripts/capped's header).
# Self-wrap like scripts/ci does, for the same reason: a rule you can forget
# is not a rule. `verified` (scripts/capped proved a cap) and `none` (the
# deliberate, warned opt-out) are the only tokens that skip the wrap.
case "${GOLEAN_CAPPED:-}" in
  verified|none) ;;
  *) exec "$ROOT/scripts/capped" "$ROOT/scripts/proof-costs" "$@" ;;
esac

OUT=artifacts/proof-costs.tsv
MODE=record
CLEAN=0
for arg in "$@"; do
  case "$arg" in
    --clean) CLEAN=1 ;;
    --check) MODE=check ;;
    *) echo "scripts/proof-costs: unknown argument '$arg' (expected --clean or --check)" >&2; exit 2 ;;
  esac
done

# ---------------------------------------------------------------- check mode
# Print a note per module that grew more than the threshold since its own
# previous recording. Exit 0 ALWAYS (see the do-not-harden note above); the
# only nonzero exit in this script is the argument typo above.
GROWTH_PCT=25
if [ "$MODE" = check ]; then
  if [ ! -f "$OUT" ]; then
    echo "  no $OUT yet — run scripts/proof-costs to record one (report-only)"
    exit 0
  fi
  awk -F'\t' -v pct="$GROWTH_PCT" '
    # Per-MODULE trend: a recording only lists the modules Lake rebuilt, so
    # run-vs-run would compare disjoint sets. Compare each module against its
    # own previous recorded value instead.
    /^#run/ { nrun++; hdr = $0; next }
    /^#/ || NF < 3 { next }
    { if ($1 in curw) { prevw[$1] = curw[$1]; prevp[$1] = curp[$1] }
      curw[$1] = $2 + 0; curp[$1] = $3 + 0; seen[$1] = 1 }
    END {
      if (nrun < 1) { print "  no recorded run yet (report-only)"; exit 0 }
      n = 0; cmp = 0
      for (m in seen) {
        if (!(m in prevw)) continue
        cmp++
        gw = (prevw[m] > 0) ? (curw[m] - prevw[m]) * 100.0 / prevw[m] : 0
        gp = (prevp[m] > 0) ? (curp[m] - prevp[m]) * 100.0 / prevp[m] : 0
        # Trivial modules are noise, not a trend: ignore sub-2s / sub-256 MiB.
        if (gw > pct && curw[m] >= 2)   { printf "  note %s wall %.1fs -> %.1fs (+%.0f%%)\n", m, prevw[m], curw[m], gw; n++ }
        if (gp > pct && curp[m] >= 256) { printf "  note %s peak %d MiB -> %d MiB (+%.0f%%)\n", m, prevp[m], curp[m], gp; n++ }
      }
      if (cmp == 0) { printf "  %d recording(s), no module recorded twice yet — no trend\n", nrun; exit 0 }
      if (n == 0) printf "  no module grew more than %d%% (%d compared, %d recordings)\n", pct, cmp, nrun
      print "  (latest) " hdr
    }
  ' "$OUT"
  exit 0
fi

# --------------------------------------------------------------- record mode
if [ "$CLEAN" = 1 ]; then
  echo "proof-costs: removing GoLeanProofs/Audit build outputs (deps left alone)"
  rm -rf proofs/.lake/build/lib/lean/GoLeanProofs \
         proofs/.lake/build/lib/lean/GoLeanProofs.* \
         proofs/.lake/build/lib/lean/Audit \
         proofs/.lake/build/lib/lean/Audit.*
fi

mkdir -p artifacts
SAMPLE=artifacts/.proof-costs-peaks
: > "$SAMPLE"

# Sampler: highest VmHWM per module, from the worker's command line. Lake
# invokes `lean ... <path>.lean ...`; the module name is that path.
(
  while :; do
    for pid in $(pgrep -f "$ROOT/proofs" 2>/dev/null); do
      [ -r "/proc/$pid/cmdline" ] || continue
      cmd="$(cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ')"
      case "$cmd" in
        *bin/lean\ *) ;;
        *) continue ;;
      esac
      src="$(printf '%s\n' "$cmd" | tr ' ' '\n' | grep -E '\.lean$' | head -1)"
      [ -n "$src" ] || continue
      hwm="$(awk '/^VmHWM:/{print $2}' "/proc/$pid/status" 2>/dev/null)"
      [ -n "$hwm" ] || continue
      mod="$(printf '%s' "$src" | sed 's|^.*/proofs/||; s|\.lean$||; s|/|.|g')"
      printf '%s\t%s\n' "$mod" "$hwm" >> "$SAMPLE"
    done
    sleep 0.25
  done
) &
SAMPLER=$!
trap 'kill $SAMPLER 2>/dev/null' EXIT

echo "proof-costs: building (LEAN_NUM_THREADS=${LEAN_NUM_THREADS:-<unset>}, GOLEAN_MEM_MAX=${GOLEAN_MEM_MAX:-64G})"
BUILDLOG=artifacts/.proof-costs-build.log
( cd proofs && lake build ) > "$BUILDLOG" 2>&1
BRC=$?
kill $SAMPLER 2>/dev/null

# Lake's own per-module wall times: "✔ [12/34] Built Some.Module (1.2s)".
# Sizes come through as ms / s / min; normalise to seconds.
{
  printf '#run\tdate=%s\tcommit=%s\tthreads=%s\tcap=%s\tlake_rc=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(git rev-parse --short HEAD 2>/dev/null || echo unknown)" \
    "${LEAN_NUM_THREADS:-default}" "${GOLEAN_MEM_MAX:-64G}" "$BRC"
  printf '#module\twall_s\tpeak_mib\n'
  awk -F'\t' '{ if ($2 + 0 > peak[$1]) peak[$1] = $2 + 0 }
              END { for (m in peak) printf "%s\t%d\n", m, int(peak[m] / 1024) }' "$SAMPLE" \
    > artifacts/.proof-costs-peaks.max
  grep -oE 'Built [A-Za-z0-9_.]+ \([0-9.]+(ms|s|min)\)' "$BUILDLOG" \
  | sed -E 's/^Built //; s/ \(/\t/; s/\)$//' \
  | awk -F'\t' '
      { v = $2
        if (v ~ /ms$/)       { sub(/ms$/, "", v); v = v / 1000 }
        else if (v ~ /min$/) { sub(/min$/, "", v); v = v * 60 }
        else                 { sub(/s$/, "", v) }
        printf "%s\t%.2f\n", $1, v }' > artifacts/.proof-costs-wall
  awk -F'\t' 'NR==FNR { p[$1] = $2; next }
              { printf "%s\t%s\t%s\n", $1, $2, ($1 in p ? p[$1] : "") }' \
      artifacts/.proof-costs-peaks.max artifacts/.proof-costs-wall \
  | LC_ALL=C sort
} >> "$OUT"

nmod="$(awk -F'\t' 'END{print NR}' artifacts/.proof-costs-wall)"
echo "proof-costs: recorded $nmod module(s) to $OUT (lake exit $BRC)"
if [ "$BRC" -ne 0 ]; then
  echo "proof-costs: NOTE — the build itself failed (exit $BRC); the record covers"
  echo "  only the modules that completed. See $BUILDLOG."
fi
exit 0
