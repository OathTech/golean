#!/usr/bin/env bash
# Imported-goose R2 pin-module GENERATOR (spec-parity slice 6 — the
# P-S3-2 pin-backfill tooling lever, promoting the session-scratch
# `.tmp` mkpins helper to a tracked script per the parking ledger's
# open question; check-imported-pins mold).
#
# For ONE imported-goose unit dir, emits a pin module
# `proofs/GoLeanProofs/Specs/ImportedGoose<Name>.lean` containing:
#   - the frontend's lowering pinned verbatim (`<unit>Lowered : Program`,
#     fresh emit + NativeToIR decode + repr — exactly the term
#     `scripts/check-imported-pins` re-derives on every run);
#   - the TotalPins seed (`<unit>Env`/`<unit>Out`);
#   - per `golean*` oracle in cases.tsv: the ∀-streams R2 `Terminates`
#     pin (allStreamsOk @ fuel 2000 + soundness) and the
#     canonical-stream `.normal` readout at verdict 1 (the imported
#     boolean-oracle convention — a FALSE oracle fails the decide
#     loudly at build, never silently).
#
# SCOPE, fail closed: golean-wrapper boolean-oracle units ONLY (the
# feature-class-1 convention). A cases.tsv subject not matching
# `golean*` or with expected_status != ok REFUSES (authored-wrapper
# units like unittest/const need per-unit R2 shapes — write those by
# hand, as before). The generator NEVER registers the module: add the
# printed PINS entry + import line to scripts/check-imported-pins in
# the SAME commit (its completeness cross-check fails loud on a pin
# module it does not know — that is the deliberate closing guard).
#
# The emitted decide certs MUST be #eval'd true before building
# (eval-before-you-decide doctrine); the script does this itself and
# refuses to write the module if any oracle's checker Bool is false.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
export GOCACHE="${GOCACHE:-$ROOT/artifacts/go-build-cache}"

usage() {
  echo "usage: scripts/gen-imported-pin --dir Corpus/coverage/exec/imported-goose/<cat>/<unit> [--fuel N]" >&2
  exit 2
}

SRC_DIR=""
FUEL=2000
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) SRC_DIR="$2"; shift 2 ;;
    --fuel) FUEL="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$SRC_DIR" && -d "$SRC_DIR" ]] || usage
[[ -f "$SRC_DIR/cases.tsv" ]] || { echo "gen-imported-pin: FAIL — no cases.tsv in $SRC_DIR" >&2; exit 1; }

unit="$(basename "$SRC_DIR")"
cat="$(basename "$(dirname "$SRC_DIR")")"
camel() { echo "$1" | awk -F'[-_]' '{ for (i=1;i<=NF;i++) $i = toupper(substr($i,1,1)) substr($i,2) } 1' OFS=''; }
UnitCamel="$(camel "$unit")"
CatCamel="$(camel "$cat")"
# lower-camel term prefix: first letter of UnitCamel lowered
term="$(echo "${UnitCamel:0:1}" | tr '[:upper:]' '[:lower:]')${UnitCamel:1}"
MODULE_FILE="proofs/GoLeanProofs/Specs/ImportedGoose${UnitCamel}.lean"
NAMESPACE="GoLean.ImportedGoose.${CatCamel}${UnitCamel}"
[[ -e "$MODULE_FILE" ]] && { echo "gen-imported-pin: FAIL — $MODULE_FILE exists (regenerate deliberately: remove it first, in the same commit as the reason)" >&2; exit 1; }

# Oracles: fail closed on any non-golean / non-ok row.
subjects=()
while IFS=$'\t' read -r id subject args expected _rest; do
  [[ "$id" =~ ^# ]] && continue
  [[ -z "$id" ]] && continue
  if [[ ! "$subject" =~ ^golean ]] || [[ "$expected" != "ok" ]]; then
    echo "gen-imported-pin: FAIL — subject '$subject' (expected_status '$expected') is outside the golean-boolean-oracle convention; this unit needs a hand-written pin module (fail closed)" >&2
    exit 1
  fi
  subjects+=("$subject")
done < "$SRC_DIR/cases.tsv"
[[ ${#subjects[@]} -gt 0 ]] || { echo "gen-imported-pin: FAIL — no oracle rows in cases.tsv" >&2; exit 1; }

WORK="$(mktemp -d "${TMPDIR:-/tmp}/gen-imported-pin.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

echo "gen-imported-pin: emitting + decoding $cat/$unit ..."
lake build GoLean.NativeToIR > /dev/null \
  || { echo "gen-imported-pin: FAIL — NativeToIR build failed" >&2; exit 1; }
GO111MODULE=off go run ./tools/nativefrontend --dir "$SRC_DIR" --out "$WORK/wire.json" \
  || { echo "gen-imported-pin: FAIL — frontend emit failed" >&2; exit 1; }

cat > "$WORK/decode.lean" <<'LEAN'
import GoLean.NativeToIR
def main (args : List String) : IO Unit := do
  let raw ← IO.FS.readFile args[0]!
  match Lean.Json.parse raw with
  | .error e => IO.println s!"PARSE ERROR: {e}"
  | .ok json =>
    match GoLean.NativeToIR.decodeProgram json with
    | .error e => IO.println s!"DECODE ERROR: {e}"
    | .ok prog => IO.println (repr prog)
LEAN
lake env lean --run "$WORK/decode.lean" "$WORK/wire.json" > "$WORK/prog.repr" 2> "$WORK/decode.err" \
  || { echo "gen-imported-pin: FAIL — decode run failed:" >&2; cat "$WORK/decode.err" >&2; exit 1; }
grep -q "ERROR" "$WORK/prog.repr" && { echo "gen-imported-pin: FAIL — decoder error:" >&2; head -3 "$WORK/prog.repr" >&2; exit 1; }

# eval-before-decide: check every oracle's checker Bool and readout on
# the REAL decoded term before any decide is written.
{
  echo "import GoLean.NativeToIR"
  echo "import GoLeanProofs.Surface"
  echo "open GoLean GoLean.GoCore GoLean.GoCore.Machine"
  echo "def pinProg : Program :="
  sed 's/^/  /' "$WORK/prog.repr"
  echo "def pinEnv : LocalEnv := [[(\"r\", .base ⟨0⟩)]]"
  echo "def pinOut : ExecState :="
  echo "  { types := pinProg.typeDefs.toList, functions := pinProg.funcs,"
  echo "    methods := pinProg.methods,"
  echo "    heap := [(.base ⟨0⟩, ⟨some (.int .int), .int 0 .int⟩)], nextAddr := 1 }"
  i=0
  for s in "${subjects[@]}"; do
    i=$((i+1))
    echo "def chkAll$i : Bool := allStreamsOk $FUEL pinOut (.exec (.call #[.var \"r\"] ⟨\"$s\"⟩ #[]) pinEnv .stop)"
    echo "def chkRead$i : Bool :="
    echo "  match execStmt $FUEL pinEnv pinOut [] (.call #[.var \"r\"] ⟨\"$s\"⟩ #[]) with"
    echo "  | .ok (.normal σf, _) =>"
    echo "      (match loadLoc σf (.base ⟨0⟩) with"
    echo "       | .ok (.int 1 .int) => true"
    echo "       | _ => false)"
    echo "  | _ => false"
  done
  echo "def main : IO Unit := do"
  i=0
  for s in "${subjects[@]}"; do
    i=$((i+1))
    echo "  IO.println s!\"$s allStreamsOk={chkAll$i} readout1={chkRead$i}\""
  done
} > "$WORK/eval.lean"
(cd proofs && lake env lean --run "$WORK/eval.lean") > "$WORK/eval.out" 2> "$WORK/eval.err" \
  || { echo "gen-imported-pin: FAIL — eval run failed:" >&2; cat "$WORK/eval.err" >&2; exit 1; }
cat "$WORK/eval.out"
if grep -q "=false" "$WORK/eval.out"; then
  echo "gen-imported-pin: FAIL — an oracle's checker/readout Bool is FALSE at fuel $FUEL (raise --fuel only if the run is genuinely longer; a false verdict is a real red — never pin it)" >&2
  exit 1
fi

today="$(date +%F)"
{
  cat <<HEADER
import GoLeanProofs.Surface

/-!
# Imported-goose R2 pins: ${cat}/${unit}

Kernel pins for the R1-PASS imported oracles of
\`Corpus/coverage/exec/imported-goose/${cat}/${unit}/\`.
\`${term}Lowered\` is generated by frontend emit +
\`NativeToIR.decodeProgram\` + \`repr\` (scripts/gen-imported-pin,
${today}) — staleness-GUARDED: \`scripts/check-imported-pins\` (ci step
3a2) re-checks this term against a fresh decoded(frontend(source))
every run; a frontend change that moves this lowering fails the gate
and the term is regenerated deliberately.

Per oracle, kernel-checked and first-order over the interpreter:
∀-streams \`Terminates\` (\`allStreamsOk\` + soundness) and the
canonical-stream \`.normal\` readout at the oracle's true verdict \`1\`.
NOT designated statements.
-/

open GoLean GoLean.GoCore GoLean.GoCore.Machine

namespace ${NAMESPACE}

set_option maxRecDepth 1000000

/-- The frontend's lowering of the imported case, verbatim (generated
by scripts/gen-imported-pin; see module docstring for the staleness
guard). -/
def ${term}Lowered : Program :=
HEADER
  sed 's/^/  /' "$WORK/prog.repr"
  cat <<HEADER

/-- Driver env: \`r\` names the harness output cell at base address 0. -/
abbrev ${term}Env : LocalEnv := [[("r", .base ⟨0⟩)]]

/-- Seeded initial state (the TotalPins observable convention). -/
def ${term}Out : ExecState :=
  { types := ${term}Lowered.typeDefs.toList,
    functions := ${term}Lowered.funcs,
    methods := ${term}Lowered.methods,
    heap := [(.base ⟨0⟩, ⟨some (.int .int), .int 0 .int⟩)],
    nextAddr := 1 }
HEADER
  for s in "${subjects[@]}"; do
    inner="${s#golean}"
    thm="$(echo "${inner:0:1}" | tr '[:upper:]' '[:lower:]')${inner:1}"
    cat <<THEOREM

/-- ∀-streams termination of \`${s}\` at fuel ${FUEL}. -/
theorem ${thm}Terminates :
    GoLean.Surface.Terminates ${term}Env ${term}Out
      (.call #[.var "r"] ⟨"${s}"⟩ #[]) := by
  refine ⟨${FUEL}, fun fuel hfuel ch => ?_⟩
  have hall : allStreamsOk ${FUEL} ${term}Out
      (.exec (.call #[.var "r"] ⟨"${s}"⟩ #[]) ${term}Env .stop) = true := by
    decide +kernel
  obtain ⟨out, ch', hrun⟩ := execStmtLoop_ok_of_allStreamsOk hall ch
  exact ⟨out, ch', execStmtLoop_mono ${FUEL} fuel _ _ _ _ hfuel hrun⟩

/-- Canonical-stream \`.normal\` completion of \`${s}\` with verdict \`1\`. -/
theorem ${thm}Readout :
    (match execStmt ${FUEL} ${term}Env ${term}Out []
        (.call #[.var "r"] ⟨"${s}"⟩ #[]) with
     | .ok (.normal σf, _) =>
         (match loadLoc σf (.base ⟨0⟩) with
          | .ok (.int 1 .int) => true
          | _ => false)
     | _ => false) = true := by decide +kernel
THEOREM
  done
  echo ""
  echo "end ${NAMESPACE}"
} > "$MODULE_FILE"

echo "gen-imported-pin: wrote $MODULE_FILE (${#subjects[@]} oracle(s), fuel $FUEL)"
echo ""
echo "REGISTER IT NOW (same commit; check-imported-pins fails loud until you do):"
echo "  1. PINS array entry:"
echo "     \"$SRC_DIR|${NAMESPACE}.${term}Lowered|GoLeanProofs.Specs.ImportedGoose${UnitCamel}\""
echo "  2. term.lean import block line:"
echo "     import GoLeanProofs.Specs.ImportedGoose${UnitCamel}"
echo "  3. build: (cd proofs && lake build GoLeanProofs.Specs.ImportedGoose${UnitCamel}); then scripts/check-imported-pins"
