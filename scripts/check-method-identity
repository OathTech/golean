#!/usr/bin/env bash
# [AGENT] Package-correct method identity, in two halves. (1) BUILD TIME:
# Tests/MethodIdentity.lean's twelve theorems and its two in-memory controls
# (`satisfactionControls`: the 1620-cell identity/signature/receiver matrix and
# the coverage answers; `receiverControls`: the UTF-8 key vector, receiver
# agreement, the duplicate-target control) are `#eval`s that fail the module's
# elaboration on the first failed cell and log a PASS line each into the build
# output — printed fresh when the module is rebuilt, REPLAYED by Lake from the
# module's saved log when it is cached; this script builds the library and
# requires BOTH lines (a missing line is a FAIL whatever the build's exit).
# The lines alone are NOT the guard: Lean continues past an error, so a
# module with one broken theorem still prints both PASS lines beside
# `error:` lines and exits nonzero (fix round F5, 2026-10-25). The
# load-bearing guards, in order: `set -Eeuo pipefail` on the `tee` pipeline
# fails the script on the build's exit FIRST; then any `^error:` line in the
# output is refused; then the two lines are required.
# The library is a default target since 2026-10-25 (lane gate/contract-pins-1025,
# release-readiness row 42's follow-up), so `lake check` exports and replays the
# theorems. (2) BY NAME, the residue that cannot run at build time: a FRESH
# executable member wire, produced by the frontend's own Go tests (a subprocess,
# the filesystem, a path argument — a build-time read of a fixed path would be
# cached by Lake's trace), read by the strict decoder in
# Tests/MethodIdentityFixture.lean (library MethodIdentityFixtureTests, `main`-
# bearing, built by name, no theorem) and checked against the checked identities.
# The compiled poison controls and the dispatch audit were removed in the
# 2026-10-12 gate cull (D3); the four Go tests also run inside `go test
# ./tools/nativefrontend` — here they produce the fixture the Lean side reads.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$ROOT/scripts/cap.sh"
cd "$ROOT"
[[ $# = 0 ]] || { echo 'check-method-identity: expected no arguments' >&2; exit 2; }
. "$ROOT/scripts/typed-gate-scratch.sh"
# (1) the build-time half: the library builds and both control lines are in the build output
cap lake build MethodIdentityTests MethodIdentityFixtureTests golean 2>&1 | tee "$gate_scratch/build.log"
! grep -qE '^error: ' "$gate_scratch/build.log" || {
  echo "check-method-identity: FAIL — the build output carries an error line" >&2; exit 1; }
grep -q 'Method satisfaction: PASS; ' "$gate_scratch/build.log" || {
  echo "check-method-identity: FAIL — the build output carries no 'Method satisfaction: PASS' line (the build-time control did not pass, or its log was neither printed nor replayed)" >&2; exit 1; }
grep -q 'Method targets: PASS; ' "$gate_scratch/build.log" || {
  echo "check-method-identity: FAIL — the build output carries no 'Method targets: PASS' line" >&2; exit 1; }
echo "ok [build-time controls] both control lines present in the build output"

# (2) the by-name half: the fresh wire from the Go tests, read by the strict decoder
GOLEAN_METHOD_IDENTITY_FIXTURE="$gate_scratch/methods.json" \
  GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go test ./tools/nativefrontend -run '^Test(MemberIdentityCheckedObjects|ExecutableMemberIdentityFixture|MethodFuncKey|InitQuarantinePreservesMemberIdentity)$' -count=1 -v | tee "$gate_scratch/go-tests.log"
python3 - "$gate_scratch/go-tests.log" <<'PYTEST'
import re, sys
from pathlib import Path
expected = sorted(['TestMemberIdentityCheckedObjects', 'TestExecutableMemberIdentityFixture',
                   'TestMethodFuncKey', 'TestInitQuarantinePreservesMemberIdentity'])
passed = sorted(re.findall(r'^--- PASS: (Test\w+) \(', Path(sys.argv[1]).read_text(), re.M))
if passed != expected:
    raise SystemExit(f'method identity Go tests: required exactly {expected}; passed {passed}')
print('Method identity Go tests: all four named tests passed')
PYTEST
[[ -s "$gate_scratch/methods.json" ]] || { echo 'check-method-identity: the Go tests wrote no fixture' >&2; exit 1; }
cap lake env lean --run Tests/MethodIdentityFixture.lean "$gate_scratch/methods.json" | tee "$gate_scratch/fixture.log"
grep -q 'Method identity: PASS; ' "$gate_scratch/fixture.log" || {
  echo "check-method-identity: FAIL — the fixture module printed no 'Method identity: PASS' line" >&2; exit 1; }
printf '%s\n' 'Method identity gate: PASS (build-time controls and theorems under lake check; the fresh-wire fixture by name)'
