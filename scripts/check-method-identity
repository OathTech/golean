#!/usr/bin/env bash
# [AGENT] Fresh executable member wire, strict decoder and compiled audit controls.
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
[[ $# = 0 ]] || { echo 'check-method-identity: expected no arguments' >&2; exit 2; }
. "$ROOT/scripts/typed-gate-scratch.sh"
scripts/capped lake build MethodIdentityTests golean
GOLEAN_METHOD_IDENTITY_FIXTURE="$gate_scratch/methods.json" \
  GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go test ./tools/nativefrontend -run '^Test(MemberIdentityCheckedObjects|ExecutableMemberIdentityFixture|MethodFuncKey|InitQuarantinePreservesMemberIdentity)$' -count=1 -v | tee "$gate_scratch/go-tests.log"
python3 - "$gate_scratch/go-tests.log" <<'PYTEST'
import re, sys
from pathlib import Path
expected = sorted(['TestMemberIdentityCheckedObjects', 'TestExecutableMemberIdentityFixture',
                   'TestMethodFuncKey', 'TestInitQuarantinePreservesMemberIdentity'])
passed = sorted(re.findall(r'^--- PASS: (Test\w+) \(', Path(sys.argv[1]).read_text(), re.M))
if passed != expected:
    raise SystemExit(f'method identity Go tests: required exactly {expected}; passed {passed}')
print('Method identity Go tests: all four named tests passed')
PYTEST
scripts/capped lake env lean --run Tests/MethodIdentity.lean "$gate_scratch/methods.json"
scripts/capped lake env python3 tools/method-identity-audit.py
scripts/capped python3 tools/method-identity-dispatch.py
printf '%s\n' 'Method identity gate: PASS'
