#!/usr/bin/env bash
# Reproduce the Comparator judge environment from a clean checkout
# (comparator-judge sprint, 2026-08-02; docs/2026-08-02_comparator-judge-sprint.md).
#
# NEEDS NETWORK (git clone + lake dep fetch + go module fetch) — run outside
# the agent sandbox. Idempotent: each step is skipped when already satisfied.
# Installs NOTHING outside the repo except landrun into $HOME/go/bin (the
# user-approved pin). TRUST TOOLS ARE NEVER MODIFIED: everything is cloned
# and built pristine at recorded pins; scripts/comparator-judge refuses to
# run against anything else.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
COMPARATOR_URL=https://github.com/leanprover/comparator
# [TRUST-ADJACENT] U0 N-2 re-pin (2026-08-28): v4.31.0 tag → v4.32.0 tag —
# see the provenance block in scripts/comparator-judge (the pins move in
# lockstep; a drift between the two scripts is a bug).
COMPARATOR_REV=07bc4ea40f2266dcb861820a2ec1fa3244ed307f
# landrun: cli-v2-era main. v0.1.16+ (urfave/cli v3) eats the `--` separator
# comparator's lean4export invocation relies on; the v0.1.15 tag's -ldd
# misses the ELF interpreter line. Full finding: the sprint doc.
LANDRUN_MOD=github.com/zouuup/landrun
LANDRUN_REV=5283024a2f49b28046c3b4a06d7d775c058d4d80
LANDRUN_MODVER=v0.1.16-0.20260127195639-5283024a2f49

echo "== deps/comparator @ ${COMPARATOR_REV:0:7}"
if [ ! -d "$ROOT/deps/comparator/.git" ]; then
  git clone "$COMPARATOR_URL" "$ROOT/deps/comparator"
fi
git -C "$ROOT/deps/comparator" fetch --quiet origin
git -C "$ROOT/deps/comparator" checkout --quiet "$COMPARATOR_REV"
dirty=$(git -C "$ROOT/deps/comparator" status --porcelain)
[ -z "$dirty" ] || { echo "deps/comparator is not pristine — refusing:"; echo "$dirty"; exit 1; }

echo "== build comparator + its lean4export (lake, may fetch pinned deps)"
# U0 N-2 re-pin: build with THE PROOF TOOLCHAIN via per-invocation selection
# (olean loading is exact-version-gated; comparator@v4.32.0's own
# lean-toolchain says v4.32.0, but the judge reads v4.32.2 artifacts —
# upstream cut no v4.32.2 tag, so the file cannot say it without dirtying
# the pristine tree). No global elan state is touched.
#
# DOCTRINE (audit fix round, trust observation): this floating read
# AUTOMATES the "matching" invariant — the trust-tool binaries always build
# at whatever proofs/lean-toolchain says, and a mismatch fails closed at
# olean load. The flip side: a FUTURE toolchain bump silently re-targets
# this trust-tool build. That is a NAMED REVIEW TRIGGER, never a silent
# ride-along: toolchain bump ⇒ trust-tool rebuild ⇒ judge landmark
# re-baseline, each under its own trust-adjacent delta-flagged commit.
PROOF_TOOLCHAIN="$(cat "$ROOT/proofs/lean-toolchain")"
(cd "$ROOT/deps/comparator" && lake +"$PROOF_TOOLCHAIN" build lean4export comparator)

echo "== landrun @ $LANDRUN_MODVER -> \$HOME/go/bin"
have=$(go version -m "$HOME/go/bin/landrun" 2>/dev/null \
  | awk '$1=="mod" && $2 ~ /landrun/ {print $3}' || true)
if [ "$have" != "$LANDRUN_MODVER" ]; then
  GOBIN="$HOME/go/bin" go install "$LANDRUN_MOD/cmd/landrun@$LANDRUN_REV"
fi

echo "== smoke: comparator's own simple_match / simple_mismatch"
SMOKE=$(mktemp -d)
trap 'rm -rf "$SMOKE"' EXIT
for t in simple_match simple_mismatch; do
  mkdir -p "$SMOKE/$t"
  cp "$ROOT/deps/comparator/tests/projects/$t"/{Challenge.lean,Solution.lean,config.json} "$SMOKE/$t/"
  # U0 N-2 re-pin: the smoke projects build with the PROOF toolchain (the
  # binaries are v4.32.2-built and must read the smoke oleans).
  cp "$ROOT/proofs/lean-toolchain" "$SMOKE/$t/"
  printf 'name = "comparatortest"\nversion = "0.1.0"\n\n[[lean_lib]]\nname = "Solution"\n\n[[lean_lib]]\nname = "Challenge"\n' \
    > "$SMOKE/$t/lakefile.toml"
done
run_one() {
  (cd "$SMOKE/$1" && PATH="$HOME/go/bin:$PATH" \
    COMPARATOR_LEAN4EXPORT="$ROOT/deps/comparator/.lake/packages/lean4export/.lake/build/bin/lean4export" \
    lake env "$ROOT/deps/comparator/.lake/build/bin/comparator" config.json >/dev/null 2>&1)
}
if ! run_one simple_match; then echo "SMOKE FAIL: simple_match should be ACCEPTED"; exit 1; fi
if run_one simple_mismatch; then echo "SMOKE FAIL: simple_mismatch should be REJECTED"; exit 1; fi
echo "== setup complete; scripts/comparator-judge is ready"
