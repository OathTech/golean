#!/usr/bin/env bash
# R2-pin staleness guard for the imported-goose kernel pins (user check-in
# ruling on ledger P1, 2026-08-08; check-golden mold, check-imported-goose
# wiring precedent).
#
# For EACH imported-goose R2 pin, verifies "proof subject =
# decoded(frontend(source))" DIRECTLY: a fresh frontend emit + decode of the
# pin's corpus case must print the SAME repr as the checked-in Lean Program
# term. Any drift fails loud — regenerate the pin term deliberately, in the
# same commit as the frontend/decoder change, with the reason (this is
# exactly how a frontend fix that changes a lowering, e.g. BUG-047's, is
# forced to surface here instead of silently dating a pinned term).
#
# Fixture mode (scripts/test-import-goose): --dir <case-dir> --term <fqn>
# checks a single (possibly scratch) case dir against a real term.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

# source case dir | fully qualified Lean term | proofs module
PINS=(
  "Corpus/coverage/exec/imported-goose/semantics/block|GoLean.ImportedGoose.SemanticsBlock.blockLowered|GoLeanProofs.Specs.ImportedGooseBlock"
  "Corpus/coverage/exec/imported-goose/semantics/defer|GoLean.ImportedGoose.SemanticsDefer.deferLowered|GoLeanProofs.Specs.ImportedGooseDefer"
  "Corpus/coverage/exec/imported-goose/semantics/nil|GoLean.ImportedGoose.SemanticsNil.nilLowered|GoLeanProofs.Specs.ImportedGooseNil"
  "Corpus/coverage/exec/imported-goose/semantics/new|GoLean.ImportedGoose.SemanticsNew.newLowered|GoLeanProofs.Specs.ImportedGooseNew"
  "Corpus/coverage/exec/imported-goose/semantics/vars|GoLean.ImportedGoose.SemanticsVars.varsLowered|GoLeanProofs.Specs.ImportedGooseVars"
  "Corpus/coverage/exec/imported-goose/storage/mapliteral|GoLean.ImportedGoose.StorageMapliteral.mapliteralLowered|GoLeanProofs.Specs.ImportedGooseMapliteral"
  "Corpus/coverage/exec/imported-goose/unittest/const|GoLean.ImportedGoose.UnittestConst.constLowered|GoLeanProofs.Specs.ImportedGooseConst"
  "Corpus/coverage/exec/imported-goose/unittest/rune|GoLean.ImportedGoose.UnittestRune.runeLowered|GoLeanProofs.Specs.ImportedGooseRune"
  "Corpus/coverage/exec/imported-goose/channel/select-tricky-examples|GoLean.ImportedGoose.ChannelSelectTricky.selectTrickyLowered|GoLeanProofs.Specs.ImportedGooseSelectTricky"
  "Corpus/coverage/exec/imported-goose/channel/muxer|GoLean.ImportedGoose.ChannelMuxer.muxerLowered|GoLeanProofs.Specs.ImportedGooseMuxer"
  "Corpus/coverage/exec/imported-goose/channel/actris-example|GoLean.ImportedGoose.ChannelActris.actrisLowered|GoLeanProofs.Specs.ImportedGooseActris"
)

SINGLE_DIR=""
SINGLE_TERM=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) SINGLE_DIR="$2"; shift 2 ;;
    --term) SINGLE_TERM="$2"; shift 2 ;;
    *) echo "check-imported-pins: unknown arg $1" >&2; exit 2 ;;
  esac
done

WORK="$(mktemp -d "${TMPDIR:-/tmp}/imported-pins.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
export GOCACHE="${GOCACHE:-$ROOT/artifacts/go-build-cache}"

# Completeness cross-check (pre-merge audit note, 2026-08-08): the PINS
# array is hand-maintained (the check-golden mold); a new
# Specs/ImportedGoose*.lean pin module that is not registered here would
# otherwise be silently unguarded. Fail loud on any module not in PINS
# (and vice versa). Partial registration already fails closed via the
# term-print step; this closes the total-non-registration hole.
# Scope decisions (closing review 2026-08-09, note finding — recorded so
# the behavior reads as chosen, not accidental; a stub skip-in-fixture-
# mode no-op that was never wired is removed):
#  - the cross-check runs in fixture mode (--dir) too, DELIBERATELY: it
#    guards a repo invariant that must hold regardless of invocation, and
#    the extra strictness fails closed;
#  - its universe is the ImportedGoose*.lean glob under Specs/ — a pin
#    module named or placed outside that pattern is not seen here (pin
#    modules follow the naming convention; the term.lean import block's
#    term-print step still fails closed on partial registration).
modules_on_disk="$(ls proofs/GoLeanProofs/Specs/ImportedGoose*.lean 2>/dev/null \
  | sed 's|proofs/||; s|/|.|g; s|\.lean$||' | sort)"
modules_in_pins="$(for pin in "${PINS[@]}"; do IFS='|' read -r _ _ m <<< "$pin"; echo "$m"; done | sort)"
if [[ "$modules_on_disk" != "$modules_in_pins" ]]; then
  echo "check-imported-pins: FAIL — Specs/ImportedGoose*.lean modules and the PINS registry differ (register every pin module here AND in the term.lean import block):" >&2
  diff <(echo "$modules_on_disk") <(echo "$modules_in_pins") | sed 's/^/  /' >&2
  exit 1
fi

# Build both sides once (stale-olean hardening per check-golden). The pin
# modules build in FIXTURE mode too (CI-only failure, 2026-08-09): the
# term-print step imports ALL registered pin modules, so fixture mode is
# just as dependent on their .oleans as full mode — skipping the build made
# the guard depend on the INVOKING environment having already built proofs,
# which held locally and failed on a fresh runner (lean's "object file ...
# does not exist" went to stdout, i.e. into term.repr, and the guard
# reported only the misleading "term print failed").
lake build GoLean.NativeToIR > /dev/null \
  || { echo "check-imported-pins: FAIL — NativeToIR build failed (fail closed)" >&2; exit 1; }
mods=()
for pin in "${PINS[@]}"; do IFS='|' read -r _ _ m <<< "$pin"; mods+=("$m"); done
(cd proofs && lake build "${mods[@]}" > /dev/null) \
  || { echo "check-imported-pins: FAIL — pin module build failed (fail closed): cd proofs && lake build ${mods[*]}" >&2; exit 1; }

cat > "$WORK/decode.lean" <<'LEAN'
import GoLean.NativeToIR
def main (args : List String) : IO Unit := do
  let raw ← IO.FS.readFile args[0]!
  match Lean.Json.parse raw with
  | .error e => IO.println s!"PARSE ERROR: {e}"
  | .ok json =>
    match GoLean.NativeToIR.decodeProgram json with
    | .error e => IO.println s!"DECODE ERROR: {e}"
    | .ok prog => IO.println (repr prog)
LEAN

check_pin() {
  local src_dir="$1" term="$2" name
  name="$(basename "$(dirname "$src_dir")")/$(basename "$src_dir")"
  GO111MODULE=off go run ./tools/nativefrontend --dir "$src_dir" --out "$WORK/wire.json" \
    || { echo "check-imported-pins: FAIL [$name] — frontend emit failed (fail closed)" >&2; return 1; }
  # NB `lean --run` prints elaboration errors (missing .olean, unknown
  # identifier, ...) to STDOUT — surface both streams on failure or the
  # real cause is silently redirected into the repr file (the 2026-08-09
  # CI-only failure's misleading-message half).
  lake env lean --run "$WORK/decode.lean" "$WORK/wire.json" > "$WORK/fresh.repr" 2> "$WORK/fresh.err" \
    || { echo "check-imported-pins: FAIL [$name] — decode run failed: lake env lean --run could not load/elaborate the decoder (is GoLean.NativeToIR built?); lean output: (fail closed)" >&2
         sed 's/^/    /' "$WORK/fresh.repr" "$WORK/fresh.err" >&2; return 1; }
  if grep -q "ERROR" "$WORK/fresh.repr"; then
    echo "check-imported-pins: FAIL [$name] — decoder error:" >&2
    head -3 "$WORK/fresh.repr" >&2
    return 1
  fi
  cat > "$WORK/term.lean" <<LEAN
import GoLeanProofs.Specs.ImportedGooseBlock
import GoLeanProofs.Specs.ImportedGooseDefer
import GoLeanProofs.Specs.ImportedGooseNil
import GoLeanProofs.Specs.ImportedGooseNew
import GoLeanProofs.Specs.ImportedGooseVars
import GoLeanProofs.Specs.ImportedGooseMapliteral
import GoLeanProofs.Specs.ImportedGooseConst
import GoLeanProofs.Specs.ImportedGooseRune
import GoLeanProofs.Specs.ImportedGooseSelectTricky
import GoLeanProofs.Specs.ImportedGooseMuxer
import GoLeanProofs.Specs.ImportedGooseActris
def main : IO Unit :=
  IO.println (repr $term)
LEAN
  (cd proofs && lake env lean --run "$WORK/term.lean" > "$WORK/term.repr" 2> "$WORK/term.err") \
    || { echo "check-imported-pins: FAIL [$name] — term print failed: lake env lean --run could not load/elaborate the pin term $term (missing GoLeanProofs.Specs.ImportedGoose* .oleans or a bad term name); lean output: (fail closed)" >&2
         sed 's/^/    /' "$WORK/term.repr" "$WORK/term.err" >&2; return 1; }
  if ! diff -q "$WORK/fresh.repr" "$WORK/term.repr" > /dev/null; then
    echo "check-imported-pins: FAIL [$name] — pinned R2 term drifted from decoded(frontend(source)):" >&2
    diff "$WORK/fresh.repr" "$WORK/term.repr" | head -15 >&2
    return 1
  fi
  echo "check-imported-pins: ok [$name] — R2 pin term = decoded(frontend(source))"
  return 0
}

if [[ -n "$SINGLE_DIR" ]]; then
  [[ -n "$SINGLE_TERM" ]] || { echo "check-imported-pins: --dir needs --term" >&2; exit 2; }
  check_pin "$SINGLE_DIR" "$SINGLE_TERM" || exit 1
  exit 0
fi

fail=0
# House non-empty assertion (launch audit D6-F3): an emptied PINS
# table must fail loud, not certify "all pins" over zero pins.
if [[ "${#PINS[@]}" -eq 0 ]]; then
  echo "check-imported-pins: PINS table is EMPTY — degenerate run" >&2
  exit 1
fi
for pin in "${PINS[@]}"; do
  IFS='|' read -r src_dir term _mod <<< "$pin"
  check_pin "$src_dir" "$term" || fail=1
done
[[ "$fail" -eq 0 ]] || exit 1
