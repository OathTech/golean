#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

OUT_FINAL="${GOLEAN_COVERAGE_ARTIFACTS:-artifacts/coverage}"
MANIFEST="$(mktemp "${TMPDIR:-/tmp}/golean-gobra-smoke.XXXXXX")"
LAKE_BUILD_TIMEOUT_SECONDS="${LAKE_BUILD_TIMEOUT_SECONDS:-120}"
LEAN_TIMEOUT_SECONDS="${LEAN_TIMEOUT_SECONDS:-30}"

mkdir -p artifacts

run_with_timeout() {
  local seconds="$1"
  shift
  perl -e 'my $t = shift @ARGV; my $pid = fork(); die "fork failed\n" unless defined $pid; if ($pid == 0) { exec @ARGV; exit 127 } $SIG{ALRM} = sub { kill "TERM", $pid; select undef, undef, undef, 1; kill "KILL", $pid; exit 124 }; alarm $t; waitpid $pid, 0; my $s = $?; exit($s == -1 ? 127 : ($s & 127 ? 128 + ($s & 127) : $s >> 8));' "$seconds" "$@"
}

lean() {
  run_with_timeout "$LEAN_TIMEOUT_SECONDS" lake exe golean "$@"
}

run_with_timeout "$LAKE_BUILD_TIMEOUT_SECONDS" lake build

EXPORT_MANIFEST="$(mktemp "${TMPDIR:-/tmp}/golean-gobra-export.XXXXXX")"
cleanup() {
  rm -f "$EXPORT_MANIFEST" "$MANIFEST"
}
trap cleanup EXIT

scripts/coverage-manifest --artifact-root "$OUT_FINAL" > "$MANIFEST"

awk -v root="$ROOT" -F $'\t' '
/^#/ || NF == 0 { next }
NF != 7 {
  print "malformed differential manifest row: expected 7 tab-separated fields: " $0 > "/dev/stderr"
  exit 2
}
{
  if ($2 ~ /^\//) {
    print $1 " " $2 "/main.go"
  } else {
    print $1 " " root "/" $2 "/main.go"
  }
}
' "$MANIFEST" > "$EXPORT_MANIFEST"

lake exe golean gobra-export --manifest "$EXPORT_MANIFEST" --out "$OUT_FINAL"

case_count=0
validated_count=0
while IFS=$'\t' read -r id _go_dir function_name arg_ints expected_status _features _expected_reason extra; do
  if [[ -z "${id:-}" || "$id" == \#* ]]; then
    continue
  fi
  if [[ -n "${extra:-}" ]]; then
    echo "malformed differential manifest row for $id: too many fields" >&2
    exit 2
  fi
  case "$expected_status" in
    ok|panic) ;;
    *)
      echo "invalid expected Go status for $id: $expected_status; use ok or panic" >&2
      exit 2
      ;;
  esac

  json_file="$OUT_FINAL/work/$id/main.go.internal.json"
  if [[ ! -f "$json_file" ]]; then
    echo "Gobra JSON artifact not found for $id: $json_file" >&2
    exit 1
  fi
  lean gobra-json-check --input "$json_file"
  validated_count=$((validated_count + 1))

  lean_args=(gobra-json-run --input "$json_file" --function "$function_name")
  if [[ "$arg_ints" != "-" ]]; then
    IFS=',' read -r -a ints <<< "$arg_ints"
    for value in "${ints[@]}"; do
      lean_args+=(--arg-int "$value")
    done
  fi

  if lean_observation="$(lean "${lean_args[@]}")"; then
    lean_status=0
  else
    lean_status=$?
  fi
  if [[ "$lean_observation" != *"\"status\":\"$expected_status\""* ]]; then
    echo "Lean observation for $id did not have expected status $expected_status" >&2
    echo "Lean: $lean_observation" >&2
    exit 1
  fi
  if [[ "$expected_status" == "ok" && "$lean_status" -ne 0 ]]; then
    echo "Lean execution for $id returned nonzero status $lean_status despite ok observation" >&2
    echo "Lean: $lean_observation" >&2
    exit 1
  fi

  case_count=$((case_count + 1))
done < "$MANIFEST"

echo "validated $validated_count Gobra internal JSON artifact(s)"
echo "executed $case_count Gobra-fronted Go function(s) in Lean"
