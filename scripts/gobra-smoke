#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

OUT_FINAL="artifacts/gobra-smoke"
LAKE_BUILD_TIMEOUT_SECONDS="${LAKE_BUILD_TIMEOUT_SECONDS:-120}"
GOBRA_EXPORT_TIMEOUT_SECONDS="${GOBRA_EXPORT_TIMEOUT_SECONDS:-180}"
LEAN_TIMEOUT_SECONDS="${LEAN_TIMEOUT_SECONDS:-30}"

mkdir -p artifacts
OUT="$(mktemp -d "$ROOT/artifacts/gobra-smoke.XXXXXX")"

cleanup() {
  rm -rf "$OUT"
}
trap cleanup EXIT

run_with_timeout() {
  local seconds="$1"
  shift
  perl -e 'my $t = shift @ARGV; my $pid = fork(); die "fork failed\n" unless defined $pid; if ($pid == 0) { exec @ARGV; exit 127 } $SIG{ALRM} = sub { kill "TERM", $pid; select undef, undef, undef, 1; kill "KILL", $pid; exit 124 }; alarm $t; waitpid $pid, 0; my $s = $?; exit($s == -1 ? 127 : ($s & 127 ? 128 + ($s & 127) : $s >> 8));' "$seconds" "$@"
}

lean() {
  run_with_timeout "$LEAN_TIMEOUT_SECONDS" lake exe golean "$@"
}

run_with_timeout "$LAKE_BUILD_TIMEOUT_SECONDS" lake build
lake exe golean gobra-export --manifest Corpus/gobra-smoke.txt --out "$OUT"

json_files=()
while IFS= read -r -d '' json_file; do
  json_files+=("$json_file")
done < <(find "$OUT/work" -name '*.internal.json' -print0)
if [[ "${#json_files[@]}" -eq 0 ]]; then
  echo "no Gobra internal JSON artifacts found under $OUT/work" >&2
  exit 1
fi

for json_file in "${json_files[@]}"; do
  lean gobra-json-check --input "$json_file"
done

echo "validated ${#json_files[@]} Gobra internal JSON artifact(s)"

MANIFEST="Differential/manifest.tsv"
case_count=0
while IFS=$'\t' read -r id _go_dir gobra_json function_name arg_ints expected_status _features _expected_reason extra; do
  if [[ -z "${id:-}" || "$id" == \#* ]]; then
    continue
  fi
  if [[ -n "${extra:-}" ]]; then
    echo "malformed differential manifest row for $id: too many fields" >&2
    exit 2
  fi
  case "$expected_status" in
    ok|panic|unsupported|stuck|error) ;;
    *)
      echo "unknown expected status for $id: $expected_status" >&2
      exit 2
      ;;
  esac

  case "$gobra_json" in
    artifacts/gobra-smoke/*) json_file="$OUT/${gobra_json#artifacts/gobra-smoke/}" ;;
    *) json_file="$gobra_json" ;;
  esac
  if [[ ! -f "$json_file" ]]; then
    echo "Gobra JSON artifact not found for $id: $json_file" >&2
    exit 1
  fi

  lean_args=(gobra-json-run --input "$json_file" --function "$function_name")
  if [[ "$arg_ints" != "-" ]]; then
    IFS=',' read -r -a ints <<< "$arg_ints"
    for value in "${ints[@]}"; do
      lean_args+=(--arg-int "$value")
    done
  fi

  if lean_observation="$(lean "${lean_args[@]}")"; then
    lean_status=0
  else
    lean_status=$?
  fi
  if [[ "$lean_observation" != *"\"status\":\"$expected_status\""* ]]; then
    echo "Lean observation for $id did not have expected status $expected_status" >&2
    echo "Lean: $lean_observation" >&2
    exit 1
  fi
  if [[ "$expected_status" == "ok" && "$lean_status" -ne 0 ]]; then
    echo "Lean execution for $id returned nonzero status $lean_status despite ok observation" >&2
    echo "Lean: $lean_observation" >&2
    exit 1
  fi

  case_count=$((case_count + 1))
done < "$MANIFEST"

rm -rf "$OUT_FINAL"
mv "$OUT" "$OUT_FINAL"
trap - EXIT

echo "executed $case_count Gobra-fronted Go function(s) in Lean"
