#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

OUT="artifacts/gobra-smoke"

rm -rf "$OUT"
lake build
lake exe golean gobra-export --manifest Corpus/gobra-smoke.txt --out "$OUT"

json_files=()
while IFS= read -r -d '' json_file; do
  json_files+=("$json_file")
done < <(find "$OUT/work" -name '*.internal.json' -print0)
if [[ "${#json_files[@]}" -eq 0 ]]; then
  echo "no Gobra internal JSON artifacts found under $OUT/work" >&2
  exit 1
fi

for json_file in "${json_files[@]}"; do
  lake exe golean gobra-json-check --input "$json_file"
done

echo "validated ${#json_files[@]} Gobra internal JSON artifact(s)"

multi_assign_json="$OUT/work/features/multi-assign/multi-assign.gobra.internal.json"
multi_assign_expected='{"status":"ok","values":[]}'
multi_assign_actual="$(lake exe golean gobra-json-run --input "$multi_assign_json" --function foo_bda1d7d_F)"
if [[ "$multi_assign_actual" != "$multi_assign_expected" ]]; then
  echo "unexpected multi-assign Lean execution result: $multi_assign_actual" >&2
  exit 1
fi

while1_json="$OUT/work/features/while1/while1.gobra.internal.json"
while1_expected='{"status":"ok","values":[{"tag":"int","value":42}]}'
while1_actual="$(lake exe golean gobra-json-run --input "$while1_json" --function test_bda1d7d_F --arg-int 6 --arg-int 7)"
if [[ "$while1_actual" != "$while1_expected" ]]; then
  echo "unexpected while1 Lean execution result: $while1_actual" >&2
  exit 1
fi

pointer_identity_json="$OUT/work/features/pointer-identity/pointer-identity.gobra.internal.json"
pointer_identity_expected='{"message":"Gobra assertion failed","status":"error"}'
if pointer_identity_actual="$(lake exe golean gobra-json-run --input "$pointer_identity_json" --function test_bda1d7d_F)"; then
  echo "expected pointer-identity Lean execution to fail" >&2
  exit 1
fi
if [[ "$pointer_identity_actual" != "$pointer_identity_expected" ]]; then
  echo "unexpected pointer-identity Lean execution result: $pointer_identity_actual" >&2
  exit 1
fi

echo "executed 3 Gobra internal JSON function(s) in Lean"
