#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

OUT_FINAL="artifacts/gobra-smoke"
LAKE_BUILD_TIMEOUT_SECONDS="${LAKE_BUILD_TIMEOUT_SECONDS:-120}"
GOBRA_EXPORT_TIMEOUT_SECONDS="${GOBRA_EXPORT_TIMEOUT_SECONDS:-180}"
LEAN_TIMEOUT_SECONDS="${LEAN_TIMEOUT_SECONDS:-30}"

mkdir -p artifacts
OUT="$(mktemp -d "$ROOT/artifacts/gobra-smoke.XXXXXX")"

cleanup() {
  rm -rf "$OUT"
}
trap cleanup EXIT

run_with_timeout() {
  local seconds="$1"
  shift
  perl -e 'my $t = shift @ARGV; my $pid = fork(); die "fork failed\n" unless defined $pid; if ($pid == 0) { exec @ARGV; exit 127 } $SIG{ALRM} = sub { kill "TERM", $pid; select undef, undef, undef, 1; kill "KILL", $pid; exit 124 }; alarm $t; waitpid $pid, 0; my $s = $?; exit($s == -1 ? 127 : ($s & 127 ? 128 + ($s & 127) : $s >> 8));' "$seconds" "$@"
}

lean() {
  run_with_timeout "$LEAN_TIMEOUT_SECONDS" lake exe golean "$@"
}

run_with_timeout "$LAKE_BUILD_TIMEOUT_SECONDS" lake build
run_with_timeout "$GOBRA_EXPORT_TIMEOUT_SECONDS" lake exe golean gobra-export --manifest Corpus/gobra-smoke.txt --out "$OUT"

json_files=()
while IFS= read -r -d '' json_file; do
  json_files+=("$json_file")
done < <(find "$OUT/work" -name '*.internal.json' -print0)
if [[ "${#json_files[@]}" -eq 0 ]]; then
  echo "no Gobra internal JSON artifacts found under $OUT/work" >&2
  exit 1
fi

for json_file in "${json_files[@]}"; do
  lean gobra-json-check --input "$json_file"
done

echo "validated ${#json_files[@]} Gobra internal JSON artifact(s)"

multi_assign_json="$OUT/work/features/multi-assign/multi-assign.gobra.internal.json"
multi_assign_expected='{"status":"ok","values":[]}'
multi_assign_actual="$(lean gobra-json-run --input "$multi_assign_json" --function foo_bda1d7d_F)"
if [[ "$multi_assign_actual" != "$multi_assign_expected" ]]; then
  echo "unexpected multi-assign Lean execution result: $multi_assign_actual" >&2
  exit 1
fi

while1_json="$OUT/work/features/while1/while1.gobra.internal.json"
while1_expected='{"status":"ok","values":[{"tag":"int","value":42}]}'
while1_actual="$(lean gobra-json-run --input "$while1_json" --function test_bda1d7d_F --arg-int 6 --arg-int 7)"
if [[ "$while1_actual" != "$while1_expected" ]]; then
  echo "unexpected while1 Lean execution result: $while1_actual" >&2
  exit 1
fi

if_return_json="$OUT/work/features/if-return/if-return.gobra.internal.json"
if_return_expected='{"status":"ok","values":[{"tag":"int","value":7}]}'
if_return_actual="$(lean gobra-json-run --input "$if_return_json" --function ifReturn_bda1d7d_F --arg-int 7)"
if [[ "$if_return_actual" != "$if_return_expected" ]]; then
  echo "unexpected if-return Lean execution result: $if_return_actual" >&2
  exit 1
fi

break_continue_json="$OUT/work/features/break-continue/break-continue.gobra.internal.json"
break_continue_expected='{"status":"ok","values":[{"tag":"int","value":8}]}'
break_continue_actual="$(lean gobra-json-run --input "$break_continue_json" --function breakContinue_bda1d7d_F)"
if [[ "$break_continue_actual" != "$break_continue_expected" ]]; then
  echo "unexpected break-continue Lean execution result: $break_continue_actual" >&2
  exit 1
fi

scalars_json="$OUT/work/features/scalars/scalars.gobra.internal.json"
scalars_expected='{"status":"ok","values":[{"tag":"int","value":7}]}'
scalars_actual="$(lean gobra-json-run --input "$scalars_json" --function scalars_bda1d7d_F)"
if [[ "$scalars_actual" != "$scalars_expected" ]]; then
  echo "unexpected scalars Lean execution result: $scalars_actual" >&2
  exit 1
fi

divide_by_zero_json="$OUT/work/features/divide-by-zero/divide-by-zero.gobra.internal.json"
divide_by_zero_expected='{"message":"integer divide by zero","status":"panic"}'
if divide_by_zero_actual="$(lean gobra-json-run --input "$divide_by_zero_json" --function divideByZero_bda1d7d_F)"; then
  echo "expected divide-by-zero Lean execution to panic" >&2
  exit 1
fi
if [[ "$divide_by_zero_actual" != "$divide_by_zero_expected" ]]; then
  echo "unexpected divide-by-zero Lean execution result: $divide_by_zero_actual" >&2
  exit 1
fi

arrays_json="$OUT/work/features/arrays/arrays.gobra.internal.json"
arrays_expected='{"status":"ok","values":[{"tag":"int","value":11}]}'
arrays_actual="$(lean gobra-json-run --input "$arrays_json" --function arrays_bda1d7d_F)"
if [[ "$arrays_actual" != "$arrays_expected" ]]; then
  echo "unexpected arrays Lean execution result: $arrays_actual" >&2
  exit 1
fi

array_len_cap_json="$OUT/work/features/array-len-cap/array-len-cap.gobra.internal.json"
array_len_cap_expected='{"status":"ok","values":[{"tag":"int","value":6}]}'
array_len_cap_actual="$(lean gobra-json-run --input "$array_len_cap_json" --function arrayLenCap_bda1d7d_F)"
if [[ "$array_len_cap_actual" != "$array_len_cap_expected" ]]; then
  echo "unexpected array-len-cap Lean execution result: $array_len_cap_actual" >&2
  exit 1
fi

array_zero_json="$OUT/work/features/array-zero/array-zero.gobra.internal.json"
array_zero_expected='{"status":"ok","values":[{"tag":"int","value":0}]}'
array_zero_actual="$(lean gobra-json-run --input "$array_zero_json" --function arrayZero_bda1d7d_F)"
if [[ "$array_zero_actual" != "$array_zero_expected" ]]; then
  echo "unexpected array-zero Lean execution result: $array_zero_actual" >&2
  exit 1
fi

nested_arrays_json="$OUT/work/features/nested-arrays/nested-arrays.gobra.internal.json"
nested_arrays_expected='{"status":"ok","values":[{"tag":"int","value":5}]}'
nested_arrays_actual="$(lean gobra-json-run --input "$nested_arrays_json" --function nestedArrays_bda1d7d_F)"
if [[ "$nested_arrays_actual" != "$nested_arrays_expected" ]]; then
  echo "unexpected nested-arrays Lean execution result: $nested_arrays_actual" >&2
  exit 1
fi

array_param_return_json="$OUT/work/features/array-param-return/array-param-return.gobra.internal.json"
array_param_return_expected='{"status":"ok","values":[{"tag":"int","value":10}]}'
array_param_return_actual="$(lean gobra-json-run --input "$array_param_return_json" --function arrayParamReturn_bda1d7d_F)"
if [[ "$array_param_return_actual" != "$array_param_return_expected" ]]; then
  echo "unexpected array-param-return Lean execution result: $array_param_return_actual" >&2
  exit 1
fi

pointer_array_json="$OUT/work/features/pointer-array/pointer-array.gobra.internal.json"
pointer_array_expected='{"status":"ok","values":[{"tag":"int","value":14}]}'
pointer_array_actual="$(lean gobra-json-run --input "$pointer_array_json" --function pointerArray_bda1d7d_F)"
if [[ "$pointer_array_actual" != "$pointer_array_expected" ]]; then
  echo "unexpected pointer-array Lean execution result: $pointer_array_actual" >&2
  exit 1
fi

array_bounds_json="$OUT/work/features/array-bounds/array-bounds.gobra.internal.json"
array_bounds_expected='{"message":"index out of range","status":"panic"}'
if array_bounds_actual="$(lean gobra-json-run --input "$array_bounds_json" --function arrayBounds_bda1d7d_F)"; then
  echo "expected array-bounds Lean execution to panic" >&2
  exit 1
fi
if [[ "$array_bounds_actual" != "$array_bounds_expected" ]]; then
  echo "unexpected array-bounds Lean execution result: $array_bounds_actual" >&2
  exit 1
fi

array_copy_json="$OUT/work/features/array-copy/array-copy.gobra.internal.json"
array_copy_expected='{"status":"ok","values":[{"tag":"int","value":10}]}'
array_copy_actual="$(lean gobra-json-run --input "$array_copy_json" --function arrayCopy_bda1d7d_F)"
if [[ "$array_copy_actual" != "$array_copy_expected" ]]; then
  echo "unexpected array-copy Lean execution result: $array_copy_actual" >&2
  exit 1
fi

array_slice_alias_json="$OUT/work/features/array-slice-alias/array-slice-alias.gobra.internal.json"
array_slice_alias_expected='{"status":"ok","values":[{"tag":"int","value":229}]}'
array_slice_alias_actual="$(lean gobra-json-run --input "$array_slice_alias_json" --function arraySliceAlias_bda1d7d_F)"
if [[ "$array_slice_alias_actual" != "$array_slice_alias_expected" ]]; then
  echo "unexpected array-slice-alias Lean execution result: $array_slice_alias_actual" >&2
  exit 1
fi

pointer_identity_json="$OUT/work/features/pointer-identity/pointer-identity.gobra.internal.json"
pointer_identity_expected='{"status":"ok","values":[]}'
pointer_identity_actual="$(lean gobra-json-run --input "$pointer_identity_json" --function test_bda1d7d_F)"
if [[ "$pointer_identity_actual" != "$pointer_identity_expected" ]]; then
  echo "unexpected pointer-identity Lean execution result: $pointer_identity_actual" >&2
  exit 1
fi

swap_json="$OUT/work/examples/swap/swap.gobra.internal.json"
swap_expected='{"status":"ok","values":[]}'
swap_actual="$(lean gobra-json-run --input "$swap_json" --function client_bda1d7d_F)"
if [[ "$swap_actual" != "$swap_expected" ]]; then
  echo "unexpected swap client Lean execution result: $swap_actual" >&2
  exit 1
fi

rm -rf "$OUT_FINAL"
mv "$OUT" "$OUT_FINAL"
trap - EXIT

echo "executed 17 Gobra-fronted Go function(s) in Lean"
