#!/usr/bin/env bash
# Goose testdata importer (goose-parity buildout, charter
# docs/2026-08-07_goose-parity-charter.md; pipeline shape from
# docs/2026-08-07_goose-comparative-scoping.md Part C).
#
# Takes one or more sibling files of ONE upstream goose testdata package
# (deps/goose at the PINNED rev — the checkout is READ-ONLY) and lands an
# assembled single-file corpus case under
# Corpus/coverage/exec/imported-goose/<dest>/ with:
#   - a provenance header (upstream path(s) @ rev, import date, transform),
#   - the upstream bodies VERBATIM (only the package clause is replaced by
#     `package main` — the Part-C permitted assembly transform),
#   - a `// --- GoLean harness ---` marker; everything below it is
#     GoLean-authored (generated int wrappers over the upstream
#     `test*() bool` / `failing_test*() bool` oracles + an empty `main`),
#   - skeleton cases.tsv rows (one per detected oracle, subject = the
#     wrapper, expected_status ok — red-first: the differential run is
#     what classifies each row; a wrong expectation fails loud there).
#
# Fail-closed shapes (see scripts/test-import-goose):
#   wrong checkout rev / missing source / source with imports / source
#   with func main / no package clause / package mismatch across siblings /
#   assembled file does not compile (self-containment) / dest exists
#   (without --force) / duplicate derived row ids / ZERO detected oracles
#   (checkpoint fix 2026-08-08: a source whose test functions do not match
#   the `test*()/failing_test*() bool` shape must not land silently as an
#   exercises-nothing case — pass --allow-no-oracles EXPLICITLY for the
#   legitimate zero-auto-oracle use, the unittest wrapper lane, where the
#   harness rows are authored by hand below the marker).
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

PINNED_REV="3be88bbb4982f58e5813b6f0344302d5582c8e8a"
ALLOW_IMPORTS=()
GRANTED_PATHS=()
GRANTED_USED=0

usage() {
  cat >&2 <<'EOF'
usage: scripts/import-goose --source <rel.go> [--also <rel.go>]... \
         --dest <class>/<name> [--tags t1,t2] [--force] \
         [--goose-root <dir>] [--expect-rev <rev>]

  --source     primary upstream file, relative to <goose-root>
  --also       sibling file of the SAME upstream package, assembled below
               the primary (helpers); repeatable
  --dest       corpus path under Corpus/coverage/exec/imported-goose/
  --tags       extra feature tags appended after imported_goose
  --force      overwrite an existing destination case
  --allow-no-oracles
               land a case with ZERO auto-detected boolean oracles
               (unittest wrapper lane: rows + wrappers authored by hand
               below the marker). Without it, 0 oracles = hard error.
  --allow-import <pkg>
               permit an import path (phase-2 seam, spec-parity slice
               2; parser-vetted since round 4: the file's imports are
               enumerated by go/parser — tools/lsimports — and every
               parsed path must be allowed; the flag itself is pinned
               to the machine-modeled set, "sync" today). Repeatable;
               anything not explicitly allowed still fails.
  --goose-root default deps/goose
  --expect-rev default the pinned goose rev (fixtures override)
EOF
  exit 2
}

die() { echo "import-goose: $*" >&2; exit 1; }

GOOSE_ROOT="deps/goose"
EXPECT_REV="$PINNED_REV"
SOURCE=""
ALSO=()
DEST=""
TAGS=""
FORCE=0
ALLOW_NO_ORACLES=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --source) [[ $# -ge 2 ]] || usage; SOURCE="$2"; shift 2 ;;
    --also) [[ $# -ge 2 ]] || usage; ALSO+=("$2"); shift 2 ;;
    --dest) [[ $# -ge 2 ]] || usage; DEST="$2"; shift 2 ;;
    --tags) [[ $# -ge 2 ]] || usage; TAGS="$2"; shift 2 ;;
    --force) FORCE=1; shift ;;
    --allow-no-oracles) ALLOW_NO_ORACLES=1; shift ;;
    --allow-import)
      [[ $# -ge 2 ]] || usage
      # Grant WIDTH is constrained to the machine-modeled set
      # (delta-review round 2: a too-wide grant used to pass every
      # gate; widen this list deliberately, with the modeling).
      case "$2" in
        sync) ;;
        *) die "--allow-import $2: not in the machine-modeled import set (sync); widen the allowlist in this script deliberately, with the modeling" ;;
      esac
      ALLOW_IMPORTS+=("$2"); shift 2 ;;
    --goose-root) [[ $# -ge 2 ]] || usage; GOOSE_ROOT="$2"; shift 2 ;;
    --expect-rev) [[ $# -ge 2 ]] || usage; EXPECT_REV="$2"; shift 2 ;;
    *) usage ;;
  esac
done

[[ -n "$SOURCE" && -n "$DEST" ]] || usage
[[ -d "$GOOSE_ROOT" ]] || die "goose root not found: $GOOSE_ROOT"

# 1. Rev pin (fail closed: an import from a drifted checkout is a silent
# provenance lie).
actual_rev="$(git -C "$GOOSE_ROOT" rev-parse HEAD 2>/dev/null)" \
  || die "cannot read HEAD of $GOOSE_ROOT (not a git checkout?)"
[[ "$actual_rev" == "$EXPECT_REV" ]] \
  || die "$GOOSE_ROOT is not at the pinned rev: HEAD=$actual_rev expected=$EXPECT_REV"

# 2. Destination shape. Path ids must satisfy the manifest's
# validate_path_id (lowercase, no "__").
case "$DEST" in
  */*) ;;
  *) die "--dest must be <class>/<name> (got: $DEST)" ;;
esac
for part in ${DEST//\// }; do
  [[ "$part" =~ ^[a-z0-9][a-z0-9_-]*$ && "$part" != *__* ]] \
    || die "--dest component not a valid case-path id: $part"
done
DEST_DIR="Corpus/coverage/exec/imported-goose/$DEST"
if [[ -e "$DEST_DIR" && "$FORCE" -ne 1 ]]; then
  die "destination exists (use --force to overwrite): $DEST_DIR"
fi

# 3. Read and vet the upstream files.
# Build the parser-based import enumerator once (round 4; see
# tools/lsimports/main.go for the trust argument).
LSIMPORTS="$(mktemp "${TMPDIR:-/tmp}/golean-lsimports.XXXXXX")"
trap 'rm -f "$LSIMPORTS"' EXIT
if ! buildmsg="$(GO111MODULE=off GOCACHE="${GOCACHE:-$ROOT/artifacts/go-build-cache}" \
    go build -o "$LSIMPORTS" "$ROOT/tools/lsimports/main.go" 2>&1)"; then
  die "cannot build tools/lsimports (the import vet): $buildmsg"
fi
ALL_SOURCES=("$SOURCE")
[[ ${#ALSO[@]} -gt 0 ]] && ALL_SOURCES+=("${ALSO[@]}")
pkg=""
for rel in "${ALL_SOURCES[@]}"; do
  f="$GOOSE_ROOT/$rel"
  [[ -f "$f" ]] || die "missing upstream source: $f"
  case "$rel" in *.go) ;; *) die "not a .go file: $rel" ;; esac
  # THE IMPORT VET (delta-review round 4, STRUCTURAL — Go's OWN
  # grammar via go/parser, tools/lsimports, parser.ImportsOnly). Three
  # fix rounds patched ad-hoc line recognizers and each round a LEGAL
  # import form escaped (indented/one-line-block/no-space; comment-
  # prefixed; named/blank/dot). An ad-hoc recognizer is unsound unless
  # it is a superset of Go's import grammar, so the grammar itself is
  # the recognizer now. Runs UNCONDITIONALLY on every source (the
  # round-3 divergence: the importer's vet was conditional on a loose
  # grep while the standing guard's was not — the conditional is
  # gone). go/parser is the same toolchain already trusted as the
  # differential oracle — no new trust surface. Parse failure =
  # refuse; every parsed path must be --allow-import'ed (and the
  # allow-set is pinned to the machine-modeled {sync}); the landed
  # grant line records EXACTLY the parsed paths. The self-containment
  # `go build` below remains the backstop for anything after the
  # import section (parser.ImportsOnly stops there by design).
  if ! parsed_imports="$("$LSIMPORTS" "$f" 2>&1)"; then
    die "$rel failed the import parse (fail closed): $parsed_imports"
  fi
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    if [[ ${#ALLOW_IMPORTS[@]} -eq 0 ]]; then
      die "$rel has imports (parsed: $(printf '%s' "$parsed_imports" | tr '\n' ' ')) — only --allow-import'ed packages may be imported (park it)"
    fi
    allowed=0
    for a in "${ALLOW_IMPORTS[@]}"; do
      [[ "$p" == "$a" ]] && allowed=1
    done
    [[ "$allowed" -eq 1 ]] || die "$rel imports \"$p\", which is not --allow-import'ed (parsed set: $(printf '%s' "$parsed_imports" | tr '\n' ' ')) (park it)"
    GRANTED_PATHS+=("$p")
    GRANTED_USED=1
  done <<< "$parsed_imports"
  if grep -nE '^func[[:space:]]+main[[:space:]]*\(' "$f" >/dev/null; then
    die "$rel defines func main — refusing (harness owns main)"
  fi
  if grep -nE '^(//go:build|// \+build)' "$f" >/dev/null; then
    die "$rel has build constraints — cannot be imported verbatim (park it)"
  fi
  this_pkg="$(grep -m1 -E '^package[[:space:]]+[A-Za-z0-9_]+' "$f" | awk '{print $2}')"
  [[ -n "$this_pkg" ]] || die "$rel has no package clause"
  if [[ -z "$pkg" ]]; then pkg="$this_pkg"
  elif [[ "$pkg" != "$this_pkg" ]]; then
    die "package mismatch: $rel is package $this_pkg, expected $pkg"
  fi
done

# 4. Detect the boolean oracles (goose style: single-line signatures).
oracles=()
for rel in "${ALL_SOURCES[@]}"; do
  while IFS= read -r name; do
    oracles+=("$name")
  done < <(grep -oE '^func (test|failing_test)[A-Za-z0-9_]*\(\) bool' "$GOOSE_ROOT/$rel" \
           | sed -E 's/^func ([A-Za-z0-9_]+)\(\) bool$/\1/')
done
if [[ ${#oracles[@]} -eq 0 && "$ALLOW_NO_ORACLES" -ne 1 ]]; then
  die "zero detected oracles (no \`test*()/failing_test*() bool\` functions) \
— refusing to land an exercises-nothing case; pass --allow-no-oracles only \
for the hand-authored wrapper lane"
fi

# 5. Assemble main.go.
TMP="$(mktemp -d "${TMPDIR:-/tmp}/import-goose.XXXXXX")"
trap 'rm -rf "$TMP"; rm -f "$LSIMPORTS"' EXIT
out="$TMP/main.go"
{
  echo "// GoLean imported-goose corpus case — upstream bodies VERBATIM."
  for rel in "${ALL_SOURCES[@]}"; do
    echo "// source: $rel @ $actual_rev"
  done
  echo "// imported: $(date +%Y-%m-%d) by scripts/import-goose"
  echo "// transform: package clause -> main; assembly order as listed; all"
  echo "// GoLean-authored code sits below the harness marker."
  if [[ "$GRANTED_USED" -eq 1 ]]; then
    # Per-file grant record: EXACTLY the parsed import paths (round 4
    # — not the flag list; the standing guard re-derives the set via
    # the same parser and compares for equality).
    granted_sorted="$(printf '%s\n' "${GRANTED_PATHS[@]}" | sort -u | tr '\n' ' ' | sed 's/ $//')"
    echo "// imports-allowed: $granted_sorted (--allow-import)"
  fi
  echo "package main"
  for rel in "${ALL_SOURCES[@]}"; do
    echo ""
    # Verbatim content: the whole upstream file minus its package clause
    # line (replaced by the `package main` above).
    awk '!done && /^package[ \t]/ { done=1; next } { print }' "$GOOSE_ROOT/$rel"
  done
  echo ""
  echo "// --- GoLean harness ---"
  echo "// One int subject per upstream boolean oracle (true -> 1, false -> 0)."
  for name in ${oracles[@]+"${oracles[@]}"}; do
    wrapper="golean$(printf '%s' "${name:0:1}" | tr '[:lower:]' '[:upper:]')${name:1}"
    echo ""
    echo "func $wrapper() int {"
    echo "	if $name() {"
    echo "		return 1"
    echo "	}"
    echo "	return 0"
    echo "}"
  done
  echo ""
  echo "func main() {}"
} > "$out"

# 6. Self-containment: the assembled file must compile stand-alone.
export GOCACHE="${GOCACHE:-$ROOT/artifacts/go-build-cache}"
if ! buildout="$(cd "$TMP" && GO111MODULE=off go build -o /dev/null . 2>&1)"; then
  die "self-containment check failed — assembled file does not compile \
(missing sibling helpers? add --also): $buildout"
fi

# 7. Skeleton cases.tsv (red-first: every row starts as the mechanical
# ok-expectation; the differential run classifies it).
tags="imported_goose"
[[ -n "$TAGS" ]] && tags="$tags,$TAGS"
{
  printf '# id\tsubject\targs\texpected_status\texpected_reason\tfeatures\n'
  seen_ids=" "
  for name in ${oracles[@]+"${oracles[@]}"}; do
    base="$name"
    prefix=""
    case "$base" in
      failing_test*) base="${base#failing_test}"; prefix="failing-" ;;
      test*) base="${base#test}" ;;
    esac
    row_id="$prefix$(printf '%s' "$base" | sed -E 's/([A-Z])/-\l\1/g' | sed -E 's/^-//; s/--+/-/g')"
    [[ "$row_id" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "derived row id invalid: $row_id (from $name)"
    if [[ "$seen_ids" == *" $row_id "* ]]; then
      die "duplicate derived row id: $row_id"
    fi
    seen_ids="$seen_ids$row_id "
    wrapper="golean$(printf '%s' "${name:0:1}" | tr '[:lower:]' '[:upper:]')${name:1}"
    printf '%s\t%s\t-\tok\t-\t%s\n' "$row_id" "$wrapper" "$tags"
  done
} > "$TMP/cases.tsv"

# 8. Land it.
mkdir -p "$DEST_DIR"
cp "$out" "$DEST_DIR/main.go"
cp "$TMP/cases.tsv" "$DEST_DIR/cases.tsv"
echo "import-goose: landed $DEST_DIR (${#oracles[@]} oracle row(s); package $pkg @ ${actual_rev:0:7})"
