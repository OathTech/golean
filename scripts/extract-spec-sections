#!/usr/bin/env bash
# extract-spec-sections — the SECTION census of the PINNED Go spec and
# memory model (bug-fix arc slice 6: the whole-language bar). The
# language-coverage ledger's denominator: one row per h2/h3/h4 heading
# anchor, in document order, both docs. Verified property at the pin
# (go1.26.5, c19862e5f841): every `id="…"` in each doc is an h2-h4
# heading id — the anchor namespace IS the section census (158 spec +
# 18 mem) — and this script FAILS CLOSED if that ever stops being true,
# so a re-pin that introduces non-heading ids is a loud event, not a
# silently shrunk denominator.
#
# Output (tracked, regenerable): docs/spec-archaeology/section-census.tsv
#   doc  order  level  anchor  title
# `order` is the document position (1-based, per doc); `level` is the
# heading depth (h2 = chapter). Classification/status columns live in
# docs/language-coverage-ledger.md, never here — this file is the
# DENOMINATOR, regenerated only at a spec re-pin.
#
# Fail closed: deps/go must be present at the recorded pin.
set -euo pipefail
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

pin="$(sed -n '/^PINS=/,/^TABLE$/p' scripts/setup-deps | awk '$1 == "go" { print $2 }')"
have="$(git -C deps/go rev-parse HEAD 2>/dev/null || true)"
if [[ -z "$pin" || -z "$have" || "$have" != "$pin"* ]]; then
  echo "extract-spec-sections: FAIL — deps/go missing/off-pin or pin row unreadable (have ${have:0:9}, pin ${pin:0:9}); scripts/setup-deps --only go" >&2
  exit 1
fi

mkdir -p docs/spec-archaeology
exec python3 - "$pin" <<'PYEOF'
import html, re, sys

pin = sys.argv[1]
docs = [("spec", "deps/go/doc/go_spec.html"), ("mem", "deps/go/doc/go_mem.html")]
heading_re = re.compile(r'<h([2-4]) id="([^"]+)">(.*?)</h\1>', re.S)

rows = []
for name, path in docs:
    text = open(path, encoding="utf-8").read()
    all_ids = re.findall(r'id="([^"]+)"', text)
    headings = heading_re.findall(text)
    if sorted(set(all_ids)) != sorted({h[1] for h in headings}):
        extra = set(all_ids) - {h[1] for h in headings}
        sys.exit(f"extract-spec-sections: FAIL — {path} has non-heading ids {sorted(extra)}; "
                 "the anchor-namespace-is-the-census property broke (investigate before regenerating)")
    for order, (level, anchor, title) in enumerate(headings, 1):
        title = html.unescape(re.sub(r"<[^>]+>", "", title)).strip()
        title = re.sub(r"\s+", " ", title)
        rows.append((name, order, f"h{level}", anchor, title))

out = "docs/spec-archaeology/section-census.tsv"
with open(out, "w", encoding="utf-8") as f:
    f.write("# spec SECTION census — the language-coverage ledger's denominator\n")
    f.write(f"# regenerated by scripts/extract-spec-sections from deps/go @ {pin[:12]}\n")
    spec_n = sum(1 for r in rows if r[0] == "spec")
    mem_n = sum(1 for r in rows if r[0] == "mem")
    f.write(f"# rows: {spec_n} spec + {mem_n} mem (one per h2-h4 heading anchor, document order)\n")
    f.write("# verified at generation: every id= in each doc is a heading id, so this\n")
    f.write("# census and the anchor-lint namespace (scripts/check-spec-anchors) coincide\n")
    f.write("doc\torder\tlevel\tanchor\ttitle\n")
    for r in rows:
        f.write("\t".join(str(x) for x in r) + "\n")
print(f"extract-spec-sections: wrote {out} ({spec_n} spec + {mem_n} mem rows) at pin {pin[:9]}")
PYEOF
