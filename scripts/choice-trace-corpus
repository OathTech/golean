#!/usr/bin/env bash
# choice-trace-corpus — run the labeled-consumption tracer / menu-invariant
# validator (`golean choice-trace`, GoLean/ChoiceTrace.lean) over the whole
# executable corpus, read-only, and summarize.
#
# LANE TOOLING (membership-depth lane, 2026-09-01), NOT A GATE: it never
# touches baselines, manifests or the corpus. It answers two questions per
# (row, stream): how many choice consumptions the run makes (and whether a
# fixed stream was EXHAUSTED before a bound>=2 consumption — the strict
# lane's invisible order-sensitivity, assessment B4), and whether every
# consumption satisfied the site's menu invariants (assessment C3-F3).
#
#   scripts/choice-trace-corpus [--jobs N] [--fuel F] [--out DIR] [--streams SPEC]
#                               [--golean BIN] [<id> ...]
#
#   --jobs N       parallel golean processes (default 4)
#   --fuel F       machine fuel per run (default 10000000, native-json-run's)
#   --out DIR      artifact dir (default artifacts/choice-trace)
#   --streams SPEC ;-separated stream specs (default: the empty stream, the
#                  three strict-lane adversarial streams, two random 4096-
#                  entry streams — see GoLean/ChoiceTrace.lean parseStream)
#   --golean BIN   the golean binary (default .lake/build/bin/golean — build
#                  it via `scripts/capped lake build golean` first)
#   --exclude ID   leave this manifest id out of the batch (repeatable). The
#                  exclusion is RECORDED in $OUT/excluded.tsv and echoed in the
#                  summary header, never silent. Use for rows that spin to the
#                  fuel cap under the default stream (goroutines/send-then-spin,
#                  a membership row with nonterm=200: ~10 min per fuel-out
#                  stream at the default fuel) and trace them separately with
#                  a lower --fuel.
#   <id> ...       restrict to these manifest ids
#
# Exit status: 0 = every traced (row, stream) has zero menu-invariant
# violations, zero self-check alarms and driver agreement; 1 = at least one
# finding (listed by the summarizer); 2 = infrastructure.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

JOBS=4
FUEL=10000000
OUT="artifacts/choice-trace"
STREAMS='default;9,8,7,6,5,4,3,2,1,0;1,3,5,7,9,2,4,6,8,0;5,5,5,5,5,5,5,5;rand:1:4096;rand:2:4096'
GOLEAN_BIN="$ROOT/.lake/build/bin/golean"
IDS=()
EXCLUDE=()
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --jobs) JOBS="$2"; shift 2 ;;
    --exclude) EXCLUDE+=("$2"); shift 2 ;;
    --fuel) FUEL="$2"; shift 2 ;;
    --out) OUT="$2"; shift 2 ;;
    --streams) STREAMS="$2"; shift 2 ;;
    --golean) GOLEAN_BIN="$2"; shift 2 ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    --*) echo "choice-trace-corpus: unknown option $1" >&2; exit 2 ;;
    *) IDS+=("$1"); shift ;;
  esac
done
for v in JOBS FUEL; do
  if [[ ! "${!v}" =~ ^[1-9][0-9]*$ ]]; then
    echo "choice-trace-corpus: $v must be a positive integer" >&2; exit 2
  fi
done
if [[ ! -x "$GOLEAN_BIN" ]]; then
  echo "choice-trace-corpus: golean binary not executable: $GOLEAN_BIN (build with scripts/capped lake build golean)" >&2
  exit 2
fi
if ! "$GOLEAN_BIN" choice-trace --help >/dev/null 2>&1; then
  echo "choice-trace-corpus: $GOLEAN_BIN has no choice-trace subcommand (stale binary?)" >&2
  exit 2
fi
command -v go >/dev/null || { echo "choice-trace-corpus: go not on PATH" >&2; exit 2; }
GO_BUILD_CACHE="$ROOT/artifacts/go-build-cache"
mkdir -p "$OUT/wire" "$GO_BUILD_CACHE"

manifest_args=()
for id in ${IDS[@]+"${IDS[@]}"}; do manifest_args+=(--id "$id"); done
if ! scripts/coverage-manifest ${manifest_args[@]+"${manifest_args[@]}"} > "$OUT/manifest.tsv"; then
  echo "choice-trace-corpus: coverage-manifest failed" >&2; exit 2
fi

# Wire export, mirroring the gate's frontend invocation (the E7 allow is
# keyed to the one recorded case id, as in scripts/diff-coverage).
: > "$OUT/export-fail.tsv"
: > "$OUT/batch.tsv"
: > "$OUT/excluded.tsv"
while IFS=$'\t' read -r id go_dir fn args status features reason lane why params; do
  skip=0
  for ex in ${EXCLUDE[@]+"${EXCLUDE[@]}"}; do
    if [[ "$id" == "$ex" ]]; then skip=1; fi
  done
  if [[ "$skip" -eq 1 ]]; then
    printf '%s\t%s\n' "$id" "excluded by --exclude (trace separately)" >> "$OUT/excluded.tsv"
    continue
  fi
  w="$OUT/wire/${id//\//__}.json"
  fe_flags=()
  [[ "$id" == "init/hidden-dep-order" ]] && fe_flags+=(--allow-hidden-dep-init-order)
  if err="$(GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" go run ./tools/nativefrontend ${fe_flags[@]+"${fe_flags[@]}"} --dir "$go_dir" --out "$w" 2>&1)"; then
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$ROOT/$w" "$fn" "$args" "$STREAMS" >> "$OUT/batch.tsv"
  else
    printf '%s\t%s\n' "$id" "$(printf '%s' "$err" | head -1)" >> "$OUT/export-fail.tsv"
  fi
done < "$OUT/manifest.tsv"
total="$(wc -l < "$OUT/batch.tsv")"
echo "choice-trace-corpus: $total row(s) exported ($(wc -l < "$OUT/export-fail.tsv") frontend refusals listed in $OUT/export-fail.tsv; $(wc -l < "$OUT/excluded.tsv") row(s) EXCLUDED by --exclude, listed in $OUT/excluded.tsv)" >&2
if [[ "$total" -eq 0 ]]; then
  echo "choice-trace-corpus: nothing to trace (every selected row was excluded or refused export)" >&2; exit 2
fi

# Chunked, parallel tracing; each chunk's TSV is resumable.
per=$(( (total + JOBS - 1) / JOBS ))
pids=()
for ((k = 0; k < JOBS; k++)); do
  rm -f "$OUT/results-$k.tsv"
  "$GOLEAN_BIN" choice-trace --batch "$OUT/batch.tsv" --out "$OUT/results-$k.tsv" --fuel "$FUEL" --skip $((k * per)) --take "$per" 2> "$OUT/results-$k.log" &
  pids+=($!)
done
rc=0
for p in "${pids[@]}"; do wait "$p" || rc=2; done
if [[ "$rc" -ne 0 ]]; then
  echo "choice-trace-corpus: a tracer process failed (see $OUT/results-*.log)" >&2
  exit 2
fi

{
  if [[ -s "$OUT/excluded.tsv" ]]; then
    echo "EXCLUDED rows (not traced in this run — trace separately, e.g. with a lower --fuel):"
    sed 's/^/  /' "$OUT/excluded.tsv"
    echo
  fi
  scripts/choice-trace-summarize --manifest "$OUT/manifest.tsv" --tsv-out "$OUT" "$OUT"/results-*.tsv
} | tee "$OUT/summary.txt"
if grep -Eq '^    (VIOLATION|ALARM|MISMATCH|ERROR) ' "$OUT/summary.txt"; then
  echo "choice-trace-corpus: FINDINGS present (see above)" >&2
  exit 1
fi
exit 0
