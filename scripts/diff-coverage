#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

MANIFEST="${1:-}"
OUT="${GOLEAN_COVERAGE_ARTIFACTS:-artifacts/coverage}"
RESULTS_TSV="${GOLEAN_COVERAGE_RESULTS:-$OUT/latest.tsv}"
META_TSV="${GOLEAN_COVERAGE_META:-$OUT/latest.meta.tsv}"
FRONTEND="${GOLEAN_FRONTEND:-gobra}"
GO_BUILD_CACHE="$ROOT/artifacts/go-build-cache"
LAKE_BUILD_TIMEOUT_SECONDS="${LAKE_BUILD_TIMEOUT_SECONDS:-120}"
GOBRA_EXPORT_TIMEOUT_SECONDS="${GOBRA_EXPORT_TIMEOUT_SECONDS:-900}"
GO_TIMEOUT_SECONDS="${GO_TIMEOUT_SECONDS:-30}"
LEAN_TIMEOUT_SECONDS="${LEAN_TIMEOUT_SECONDS:-30}"

run_with_timeout() {
  local seconds="$1"
  shift
  perl -e 'my $t = shift @ARGV; my $pid = fork(); die "fork failed\n" unless defined $pid; if ($pid == 0) { exec @ARGV; exit 127 } $SIG{ALRM} = sub { kill "TERM", $pid; select undef, undef, undef, 1; kill "KILL", $pid; exit 124 }; alarm $t; waitpid $pid, 0; my $s = $?; exit($s == -1 ? 127 : ($s & 127 ? 128 + ($s & 127) : $s >> 8));' "$seconds" "$@"
}

lean() {
  run_with_timeout "$LEAN_TIMEOUT_SECONDS" lake exe golean "$@"
}

json_string_literal() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

panic_message() {
  awk '
    /^panic: / {
      sub(/^panic: /, "")
      print
      found = 1
      exit
    }
    END {
      if (!found) exit 1
    }
  '
}

package_go_file_count() {
  find "$1" -maxdepth 1 -name '*.go' ! -name '*_test.go' -print | wc -l | tr -d ' '
}

gobra_internal_json_path() {
  printf '%s/work/%s/main.go.internal.json' "$OUT" "$1"
}

if ! command -v go >/dev/null 2>&1; then
  echo "go not found on PATH; install Go or expose it in the shell to run differential coverage" >&2
  exit 2
fi

GENERATED_MANIFEST=""
if [[ -z "$MANIFEST" ]]; then
  GENERATED_MANIFEST="$(mktemp "${TMPDIR:-/tmp}/golean-coverage-manifest.XXXXXX")"
  if ! scripts/coverage-manifest --artifact-root "$OUT" > "$GENERATED_MANIFEST"; then
    exit 2
  fi
  MANIFEST="$GENERATED_MANIFEST"
fi

if [[ ! -f "$MANIFEST" ]]; then
  echo "differential manifest not found: $MANIFEST" >&2
  exit 2
fi

mkdir -p artifacts "$OUT" "$GO_BUILD_CACHE"

RESULTS_DIR="$(dirname "$RESULTS_TSV")"
RESULTS_BASE="$(basename "$RESULTS_TSV")"
META_DIR="$(dirname "$META_TSV")"
META_BASE="$(basename "$META_TSV")"
mkdir -p "$RESULTS_DIR" "$META_DIR"
RESULTS_TMP="$(mktemp "$RESULTS_DIR/.${RESULTS_BASE}.XXXXXX")"
META_TMP="$(mktemp "$META_DIR/.${META_BASE}.XXXXXX")"
printf 'result\tid\tfeatures\tstage\tdetail\n' > "$RESULTS_TMP"

manifest_sha="$(shasum -a 256 "$MANIFEST" | awk '{ print $1 }')"
manifest_cases="$(awk -F $'\t' 'NF > 0 && $1 !~ /^#/ { count += 1 } END { print count + 0 }' "$MANIFEST")"
git_commit="$(git rev-parse HEAD 2>/dev/null || printf 'unknown')"
if git diff --quiet -- . 2>/dev/null && git diff --cached --quiet -- . 2>/dev/null; then
  git_dirty=false
else
  git_dirty=true
fi
{
  printf 'key\tvalue\n'
  printf 'frontend\t%s\n' "$FRONTEND"
  printf 'manifest\t%s\n' "$MANIFEST"
  printf 'manifest_sha256\t%s\n' "$manifest_sha"
  printf 'manifest_cases\t%s\n' "$manifest_cases"
  printf 'total_corpus_cases\t%s\n' "${GOLEAN_COVERAGE_TOTAL_CASES:-unknown}"
  printf 'full_run\t%s\n' "${GOLEAN_COVERAGE_RUN_FULL:-unknown}"
  printf 'filters\t%s\n' "${GOLEAN_COVERAGE_FILTERS:-unknown}"
  printf 'git_commit\t%s\n' "$git_commit"
  printf 'git_dirty\t%s\n' "$git_dirty"
} > "$META_TMP"

EXPORT_MANIFEST="$(mktemp "${TMPDIR:-/tmp}/golean-gobra-export.XXXXXX")"
EXPORT_CANDIDATES="$(mktemp "${TMPDIR:-/tmp}/golean-gobra-export-candidates.XXXXXX")"
cleanup() {
  rm -f "$EXPORT_MANIFEST" "$EXPORT_CANDIDATES" "$RESULTS_TMP" "$META_TMP"
  if [[ -n "$GENERATED_MANIFEST" ]]; then
    rm -f "$GENERATED_MANIFEST"
  fi
}
trap cleanup EXIT

publish_results() {
  mv "$RESULTS_TMP" "$RESULTS_TSV"
  mv "$META_TMP" "$META_TSV"
}

if ! awk -v root="$ROOT" -F $'\t' '
BEGIN { ok = 1 }
/^#/ || NF == 0 { next }
NF != 7 {
  print "malformed differential manifest row: expected 7 tab-separated fields: " $0 > "/dev/stderr"
  ok = 0
  next
}
{
  id = $1
  go_dir = $2
  if (id == "" || go_dir == "") {
    print "malformed differential manifest row: missing id or go_dir: " $0 > "/dev/stderr"
    ok = 0
    next
  }
  if (go_dir ~ /^\//) {
    print id "\t" go_dir "/main.go" "\t" $3
  } else {
    print id "\t" root "/" go_dir "/main.go" "\t" $3
  }
}
END { if (!ok) exit 2 }
' "$MANIFEST" > "$EXPORT_CANDIDATES"; then
  exit 2
fi

while IFS=$'\t' read -r id go_file function_name; do
  go_dir="$(dirname "$go_file")"
  if [[ "$FRONTEND" != "gobra" ]]; then
    continue
  fi
  if [[ "$(package_go_file_count "$go_dir")" -ne 1 ]]; then
    continue
  fi
  if [[ -f "$go_file" ]] && rg -q "func[[:space:]]+$function_name[[:space:]]*\\(" "$go_file"; then
    printf '%s %s\n' "$id" "$go_file" >> "$EXPORT_MANIFEST"
  fi
done < "$EXPORT_CANDIDATES"

echo "building Lean executable..."
if ! run_with_timeout "$LAKE_BUILD_TIMEOUT_SECONDS" lake build; then
  echo "lake build failed" >&2
  exit 1
fi

EXPORT_LOG="$OUT/export.log"
if [[ "$FRONTEND" != "gobra" ]]; then
  echo "unsupported frontend '$FRONTEND'; continuing to classify every manifest row."
  export_status=2
elif [[ -s "$EXPORT_MANIFEST" ]]; then
  echo "exporting canonical Go inputs through frontend: gobra..."
elif [[ -s "$EXPORT_CANDIDATES" ]]; then
  echo "no litmus rows passed source/function preflight; skipping frontend export"
else
  echo "no differential rows found; skipping frontend export"
fi
if [[ "$FRONTEND" != "gobra" ]]; then
  :
elif [[ ! -s "$EXPORT_MANIFEST" ]]; then
  export_status=0
elif run_with_timeout "$GOBRA_EXPORT_TIMEOUT_SECONDS" lake exe golean gobra-export --manifest "$EXPORT_MANIFEST" --out "$OUT" > "$EXPORT_LOG" 2>&1; then
  export_status=0
else
  export_status=$?
  echo "Frontend export reported failures; continuing to classify every manifest row."
  echo "Full export log: $EXPORT_LOG"
fi

case_count=0
pass_count=0
fail_count=0

report_pass() {
  local id="$1"
  local features="$2"
  printf 'PASS\t%s\t%s\n' "$id" "$features"
  printf 'PASS\t%s\t%s\t-\t-\n' "$id" "$features" >> "$RESULTS_TMP"
  pass_count=$((pass_count + 1))
}

one_line() {
  local value="$1"
  value="${value//$'\t'/ }"
  value="${value//$'\r'/\\r}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

report_fail() {
  local id="$1"
  local features="$2"
  local stage="$3"
  local detail="$4"
  local flat_detail
  flat_detail="$(one_line "$detail")"
  printf 'FAIL\t%s\t%s\tstage=%s\tdetail=%s\n' "$id" "$features" "$stage" "$flat_detail"
  printf 'FAIL\t%s\t%s\t%s\t%s\n' "$id" "$features" "$stage" "$flat_detail" >> "$RESULTS_TMP"
  fail_count=$((fail_count + 1))
}

while IFS=$'\t' read -r id go_dir function_name arg_ints expected_status features expected_reason extra; do
  if [[ -z "${id:-}" || "$id" == \#* ]]; then
    continue
  fi

  case_count=$((case_count + 1))
  failed=0

  if [[ -n "${extra:-}" ]]; then
    report_fail "$id" "${features:-unknown}" "manifest" "too many tab-separated fields"
    continue
  fi
  if [[ -z "${go_dir:-}" || -z "${function_name:-}" || -z "${arg_ints:-}" || -z "${expected_status:-}" || -z "${features:-}" || -z "${expected_reason:-}" ]]; then
    report_fail "$id" "${features:-unknown}" "manifest" "expected 7 tab-separated fields"
    continue
  fi
  case "$expected_status" in
    ok|panic) ;;
    *)
      report_fail "$id" "$features" "manifest" "invalid expected Go status: $expected_status; use ok or panic"
      continue
      ;;
  esac
  case "$expected_status" in
    panic)
      if [[ "$expected_reason" == "-" ]]; then
        report_fail "$id" "$features" "manifest" "$expected_status requires an expected_reason"
        continue
      fi
      ;;
    *)
      if [[ "$expected_reason" != "-" ]]; then
        report_fail "$id" "$features" "manifest" "unexpected expected_reason for status $expected_status: $expected_reason"
        continue
      fi
      ;;
  esac

  go_file="$go_dir/main.go"
  if [[ ! -f "$go_file" ]]; then
    report_fail "$id" "$features" "go-source" "missing $go_file"
    continue
  fi
  if ! rg -q "func[[:space:]]+$function_name[[:space:]]*\\(" "$go_file"; then
    report_fail "$id" "$features" "litmus-contract" "manifest function $function_name is not defined in $go_file"
    continue
  fi

  go_run_dir="$OUT/go-run/$id"
  if [[ "$go_run_dir" == /* ]]; then
    go_run_pkg="$go_run_dir"
  else
    go_run_pkg="./$go_run_dir"
  fi
  if ! harness_output="$(run_with_timeout "$GO_TIMEOUT_SECONDS" env GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" go run ./tools/coverageharness \
      --input "$go_file" \
      --out "$go_run_dir" \
      --subject "$function_name" \
      --expected-status "$expected_status" \
      --args "$arg_ints" 2>&1)"; then
    report_fail "$id" "$features" "go-harness" "$harness_output"
    continue
  fi

  if go_observation="$(run_with_timeout "$GO_TIMEOUT_SECONDS" env GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" go run "$go_run_pkg" 2>&1)"; then
    if [[ "$expected_status" == "panic" ]]; then
      report_fail "$id" "$features" "go-observation" "expected panic, but Go exited successfully: $go_observation"
      failed=1
    elif ! lean observation-eq --left "$go_observation" --right "$go_observation" >/dev/null 2>&1; then
      report_fail "$id" "$features" "go-observation" "Go output is not a valid observation: $go_observation"
      failed=1
    elif [[ "$go_observation" != *"\"status\":\"$expected_status\""* ]]; then
      report_fail "$id" "$features" "go-observation" "expected status $expected_status, got $go_observation"
      failed=1
    fi
  else
    if [[ "$expected_status" == "panic" ]]; then
      if [[ "$go_observation" != *"panic:"* ]]; then
        report_fail "$id" "$features" "go-run" "expected Go panic, got: $go_observation"
        failed=1
      elif [[ "$go_observation" != *"$expected_reason"* ]]; then
        report_fail "$id" "$features" "go-observation" "Go panic did not contain expected reason $expected_reason: $go_observation"
        failed=1
      elif ! actual_panic_message="$(printf '%s\n' "$go_observation" | panic_message)"; then
        report_fail "$id" "$features" "go-observation" "could not extract Go panic message: $go_observation"
        failed=1
      else
        escaped_reason="$(json_string_literal "$actual_panic_message")"
        go_observation="{\"message\":$escaped_reason,\"schema\":\"golean-observation-v1\",\"status\":\"panic\"}"
      fi
    else
      report_fail "$id" "$features" "go-run" "$go_observation"
      failed=1
    fi
  fi
  if [[ "$failed" -ne 0 ]]; then
    continue
  fi

  package_go_files="$(package_go_file_count "$go_dir")"
  if [[ "$FRONTEND" != "gobra" ]]; then
    report_fail "$id" "$features" "frontend-export" "unsupported frontend '$FRONTEND'"
    continue
  fi
  if [[ "$package_go_files" -ne 1 ]]; then
    report_fail "$id" "$features" "frontend-export" "gobra frontend currently supports exactly one non-test Go file per package; found $package_go_files"
    continue
  fi

  gobra_json="$(gobra_internal_json_path "$id")"
  if [[ ! -f "$gobra_json" ]]; then
    result_path="$OUT/results/$id/result.json"
    if [[ -f "$result_path" ]]; then
      report_fail "$id" "$features" "frontend-export" "frontend=gobra; go=ok; no internal JSON at $gobra_json; see $result_path"
    else
      report_fail "$id" "$features" "frontend-export" "frontend=gobra; go=ok; no internal JSON at $gobra_json"
    fi
    continue
  fi

  if ! artifact_check_output="$(lean gobra-artifact-check --manifest "$OUT/manifest.json" --internal-json "$gobra_json" 2>&1)"; then
    report_fail "$id" "$features" "artifact-check" "$artifact_check_output"
    continue
  fi

  if ! json_check_output="$(lean gobra-json-check --input "$gobra_json" 2>&1)"; then
    report_fail "$id" "$features" "json-check" "$json_check_output"
    continue
  fi

  lean_args=(gobra-json-run --input "$gobra_json" --function "$function_name")
  if [[ "$arg_ints" != "-" ]]; then
    IFS=',' read -r -a ints <<< "$arg_ints"
    for value in "${ints[@]}"; do
      if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
        report_fail "$id" "$features" "manifest" "invalid integer argument: $value"
        failed=1
      else
        lean_args+=(--arg-int "$value")
      fi
    done
  fi
  if [[ "$failed" -ne 0 ]]; then
    continue
  fi

  if lean_observation="$(lean "${lean_args[@]}" 2>&1)"; then
    lean_status=0
  else
    lean_status=$?
  fi
  if [[ "$lean_observation" != *"\"status\":\"$expected_status\""* ]]; then
    report_fail "$id" "$features" "lean-observation" "expected status $expected_status, got $lean_observation"
    continue
  fi
  if [[ "$expected_status" == "ok" && "$lean_status" -ne 0 ]]; then
    report_fail "$id" "$features" "lean-run" "nonzero exit $lean_status despite ok observation: $lean_observation"
    continue
  fi

  if ! observation_diff="$(lean observation-eq --left "$lean_observation" --right "$go_observation" 2>&1)"; then
    report_fail "$id" "$features" "differential" "Lean=$lean_observation Go=$go_observation $observation_diff"
    continue
  fi

  report_pass "$id" "$features"
done < "$MANIFEST"

echo
echo "differential coverage summary: cases=$case_count pass=$pass_count fail=$fail_count export_status=$export_status"
publish_results
echo "results: $RESULTS_TSV"
echo "metadata: $META_TSV"

if [[ "${GOLEAN_COVERAGE_RUN_FULL:-unknown}" == "true" ]]; then
  cp "$RESULTS_TSV" "$OUT/latest-full.tsv"
  cp "$META_TSV" "$OUT/latest-full.meta.tsv"
fi

if [[ "$case_count" -eq 0 ]]; then
  echo "no differential cases found in $MANIFEST" >&2
  exit 2
fi
if [[ "$fail_count" -ne 0 || "$export_status" -ne 0 ]]; then
  exit 1
fi
