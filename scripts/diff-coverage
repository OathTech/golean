#!/usr/bin/env bash
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

MANIFEST="${1:-}"
OUT="${GOLEAN_COVERAGE_ARTIFACTS:-artifacts/coverage}"
RESULTS_TSV="${GOLEAN_COVERAGE_RESULTS:-$OUT/latest.tsv}"
META_TSV="${GOLEAN_COVERAGE_META:-$OUT/latest.meta.tsv}"
FRONTEND="${GOLEAN_FRONTEND:-native}"
GO_BUILD_CACHE="$ROOT/artifacts/go-build-cache"
LAKE_BUILD_TIMEOUT_SECONDS="${LAKE_BUILD_TIMEOUT_SECONDS:-120}"
GO_TIMEOUT_SECONDS="${GO_TIMEOUT_SECONDS:-30}"
LEAN_TIMEOUT_SECONDS="${LEAN_TIMEOUT_SECONDS:-30}"
# The membership/confluent/racy-lane enumerator explores the whole
# schedule tree in one process (up to millions of pool steps on the
# 3-goroutine litmus shapes), so it gets its own, larger budget.
LEAN_ENUM_TIMEOUT_SECONDS="${LEAN_ENUM_TIMEOUT_SECONDS:-300}"

run_with_timeout() {
  local seconds="$1"
  shift
  perl -e 'my $t = shift @ARGV; my $pid = fork(); die "fork failed\n" unless defined $pid; if ($pid == 0) { exec @ARGV; exit 127 } $SIG{ALRM} = sub { kill "TERM", $pid; select undef, undef, undef, 1; kill "KILL", $pid; exit 124 }; alarm $t; waitpid $pid, 0; my $s = $?; exit($s == -1 ? 127 : ($s & 127 ? 128 + ($s & 127) : $s >> 8));' "$seconds" "$@"
}

# Invokes the ONCE-BUILT golean binary directly: `lake exe` per case pays
# lake's startup (and a possible package lock) ~4x per case across the
# nondet-oracle re-runs — resolved after the up-front `lake build`.
GOLEAN_BIN="$ROOT/.lake/build/bin/golean"
lean() {
  run_with_timeout "$LEAN_TIMEOUT_SECONDS" "$GOLEAN_BIN" "$@"
}

json_string_literal() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

panic_message() {
  awk '
    /^panic: / {
      sub(/^panic: /, "")
      print
      found = 1
      exit
    }
    END {
      if (!found) exit 1
    }
  '
}

if ! command -v go >/dev/null 2>&1; then
  echo "go not found on PATH; install Go or expose it in the shell to run differential coverage" >&2
  exit 2
fi

GENERATED_MANIFEST=""
if [[ -z "$MANIFEST" ]]; then
  GENERATED_MANIFEST="$(mktemp "${TMPDIR:-/tmp}/golean-coverage-manifest.XXXXXX")"
  if ! scripts/coverage-manifest --artifact-root "$OUT" > "$GENERATED_MANIFEST"; then
    exit 2
  fi
  MANIFEST="$GENERATED_MANIFEST"
fi

if [[ ! -f "$MANIFEST" ]]; then
  echo "differential manifest not found: $MANIFEST" >&2
  exit 2
fi

mkdir -p artifacts "$OUT" "$GO_BUILD_CACHE"

RESULTS_DIR="$(dirname "$RESULTS_TSV")"
RESULTS_BASE="$(basename "$RESULTS_TSV")"
META_DIR="$(dirname "$META_TSV")"
META_BASE="$(basename "$META_TSV")"
mkdir -p "$RESULTS_DIR" "$META_DIR"
RESULTS_TMP="$(mktemp "$RESULTS_DIR/.${RESULTS_BASE}.XXXXXX")"
META_TMP="$(mktemp "$META_DIR/.${META_BASE}.XXXXXX")"
printf 'result\tid\tfeatures\tstage\tdetail\n' > "$RESULTS_TMP"

manifest_sha="$(shasum -a 256 "$MANIFEST" | awk '{ print $1 }')"
manifest_cases="$(awk -F $'\t' 'NF > 0 && $1 !~ /^#/ { count += 1 } END { print count + 0 }' "$MANIFEST")"
git_commit="$(git rev-parse HEAD 2>/dev/null || printf 'unknown')"
if git diff --quiet -- . 2>/dev/null && git diff --cached --quiet -- . 2>/dev/null; then
  git_dirty=false
else
  git_dirty=true
fi
{
  printf 'key\tvalue\n'
  printf 'frontend\t%s\n' "$FRONTEND"
  printf 'manifest\t%s\n' "$MANIFEST"
  printf 'manifest_sha256\t%s\n' "$manifest_sha"
  printf 'manifest_cases\t%s\n' "$manifest_cases"
  printf 'total_corpus_cases\t%s\n' "${GOLEAN_COVERAGE_TOTAL_CASES:-unknown}"
  printf 'full_run\t%s\n' "${GOLEAN_COVERAGE_RUN_FULL:-unknown}"
  printf 'filters\t%s\n' "${GOLEAN_COVERAGE_FILTERS:-unknown}"
  printf 'git_commit\t%s\n' "$git_commit"
  printf 'git_dirty\t%s\n' "$git_dirty"
} > "$META_TMP"

cleanup() {
  rm -f "$RESULTS_TMP" "$META_TMP"
  if [[ -n "$GENERATED_MANIFEST" ]]; then
    rm -f "$GENERATED_MANIFEST"
  fi
}
trap cleanup EXIT

publish_results() {
  mv "$RESULTS_TMP" "$RESULTS_TSV"
  mv "$META_TMP" "$META_TSV"
}

echo "building Lean executable..."
if ! run_with_timeout "$LAKE_BUILD_TIMEOUT_SECONDS" lake build; then
  echo "lake build failed" >&2
  exit 1
fi
if [[ ! -x "$GOLEAN_BIN" ]]; then
  echo "built golean binary not found at $GOLEAN_BIN" >&2
  exit 1
fi

export_status=0
if [[ "$FRONTEND" == "native" ]]; then
  echo "native frontend: per-case type-check + emit (no batch export)"
else
  echo "unsupported frontend '$FRONTEND' (only 'native' is supported); continuing to classify every manifest row." >&2
  export_status=2
fi


report_pass() {
  local id="$1"
  local features="$2"
  printf 'PASS\t%s\t%s\n' "$id" "$features"
  printf 'PASS\t%s\t%s\t-\t-\n' "$id" "$features" >> "$CASE_OUT"
}

# Membership-lane PASS rows carry stage "membership" (the baseline records
# result+stage, so the lane classification is part of the regression
# signal) and a detail with the WIDTH SIGNAL — |enumerated set|,
# |Go-exhibited subset| — which is recorded METADATA, never a pass
# criterion (docs/2026-08-04_membership-lane-design.md).
report_pass_lane() {
  local id="$1"
  local features="$2"
  local stage="$3"
  local detail="$4"
  local flat_detail
  flat_detail="$(one_line "$detail")"
  printf 'PASS\t%s\t%s\tstage=%s\tdetail=%s\n' "$id" "$features" "$stage" "$flat_detail"
  printf 'PASS\t%s\t%s\t%s\t%s\n' "$id" "$features" "$stage" "$flat_detail" >> "$CASE_OUT"
}

one_line() {
  local value="$1"
  value="${value//$'\t'/ }"
  value="${value//$'\r'/\\r}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

report_fail() {
  local id="$1"
  local features="$2"
  local stage="$3"
  local detail="$4"
  local flat_detail
  flat_detail="$(one_line "$detail")"
  printf 'FAIL\t%s\t%s\tstage=%s\tdetail=%s\n' "$id" "$features" "$stage" "$flat_detail"
  printf 'FAIL\t%s\t%s\t%s\t%s\n' "$id" "$features" "$stage" "$flat_detail" >> "$CASE_OUT"
}

# One manifest row, classified end to end. Writes its TSV row(s) to
# $CASE_OUT; progress goes to stdout (interleaved under parallelism —
# the assembled TSV is manifest-ordered regardless).
# ATOMIC PUBLISH (2026-07-30 pre-merge audit finding): rows accumulate in
# a .out.tmp and land at .out in one mv only after classification
# completes. A worker killed mid-case (OOM/kill under the nproc-wide
# pool) leaves NO .out, so the assembler's fail-closed fallback fires —
# previously the file was created empty up front and a dead worker's
# case vanished from the TSV silently.
run_case() {
  local rowfile="$1"
  CASE_OUT="${rowfile%.in}.out.tmp"
  : > "$CASE_OUT"
  run_case_rows "$rowfile"
  mv "$CASE_OUT" "${rowfile%.in}.out"
}

run_case_rows() {
  local rowfile="$1"
  local id go_dir function_name arg_ints expected_status features expected_reason lane why params extra
  IFS=$'\t' read -r id go_dir function_name arg_ints expected_status features expected_reason lane why params extra < "$rowfile"
  local failed=0

  if [[ -n "${extra:-}" ]]; then
    report_fail "$id" "${features:-unknown}" "manifest" "too many tab-separated fields"
    return 0
  fi
  if [[ -z "${go_dir:-}" || -z "${function_name:-}" || -z "${arg_ints:-}" || -z "${expected_status:-}" || -z "${features:-}" || -z "${expected_reason:-}" || -z "${lane:-}" || -z "${why:-}" || -z "${params:-}" ]]; then
    report_fail "$id" "${features:-unknown}" "manifest" "expected 10 tab-separated fields"
    return 0
  fi
  case "$lane" in
    strict|membership|confluent|racy) ;;
    *)
      report_fail "$id" "$features" "manifest" "invalid lane: $lane (use strict, membership, confluent, or racy)"
      return 0
      ;;
  esac
  # deadlock (channels arc slice 1): Go's whole-program detector aborts
  # with the FIXED "fatal error: all goroutines are asleep - deadlock!"
  # (exit status 2); expected_reason stays "-" (nothing case-specific to
  # pin). NEVER combine these cases with -race builds — the detector does
  # not fire there (probed; ground-truth note §5).
  # race (channels arc slice 3, racy-negative lane): the Go oracle is
  # `go run -race` (TSan; exit 66, "WARNING: DATA RACE" — no false
  # positives, so one red sample proves the race), and the machine must
  # refuse with status "race" under the default AND every adversarial
  # stream (the invariance loop below enforces per-stream refusal — the
  # slice-4 schedule enumerator will strengthen this to "every
  # enumerated path refuses"). Race and deadlock expectations are
  # mutually exclusive by construction (one status column): the -race
  # runtime suppresses the deadlock detector (ground-truth note §5).
  # THE THREE-WAY INVESTIGATION RULE (validation note §2.7/lane d): if
  # the machine refuses but every `-race` sample stays green, that is
  # NOT a pass — it is an investigation with exactly three outcomes:
  # (a) our race check is too eager (model bug — fix); (b) the race
  # needs a schedule the sampler never hits (strengthen with directed
  # sampling; record the conclusion in the case's why); (c) the program
  # is race-free and misclassified (model bug — fix).
  case "$expected_status" in
    ok|panic|deadlock|race) ;;
    *)
      report_fail "$id" "$features" "manifest" "invalid expected Go status: $expected_status; use ok, panic, deadlock, or race"
      return 0
      ;;
  esac
  case "$expected_status" in
    panic)
      if [[ "$expected_reason" == "-" ]]; then
        report_fail "$id" "$features" "manifest" "$expected_status requires an expected_reason"
        return 0
      fi
      ;;
    *)
      if [[ "$expected_reason" != "-" ]]; then
        report_fail "$id" "$features" "manifest" "unexpected expected_reason for status $expected_status: $expected_reason"
        return 0
      fi
      ;;
  esac

  go_file="$go_dir/main.go"
  if [[ ! -f "$go_file" ]]; then
    report_fail "$id" "$features" "go-source" "missing $go_file"
    return 0
  fi
  # grep -E, not rg (2026-08-02): ripgrep is absent on the GitHub runner, and
  # a missing tool's exit 127 was inverted into "no match" — every case
  # reported FAIL/litmus-contract and the nightly differential never actually
  # ran (12+ red nightlies misattributed to corpus drift). grep is in POSIX;
  # the pattern is plain ERE. A tool this check depends on must either be
  # universally present or preflighted like `go` is at the top of this script.
  if ! grep -Eq "func[[:space:]]+$function_name[[:space:]]*\\(" "$go_file"; then
    report_fail "$id" "$features" "litmus-contract" "manifest function $function_name is not defined in $go_file"
    return 0
  fi

  # FLATTENED per-id dir (id slashes -> __, like the negative runner's
  # binary names): the harness RemoveAll-s this dir per case, and with
  # id-shaped NESTED paths a parent id's harness deletes a child id's dir
  # in flight under the parallel runner (first hit: generics/generic-closure
  # vs generics/generic-closure/shared-capture, 2026-08-05 — a spurious
  # go-run FAIL). Flattening removes the hazard class.
  go_run_dir="$OUT/go-run/${id//\//__}"
  if ! harness_output="$(run_with_timeout "$GO_TIMEOUT_SECONDS" env GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" go run ./tools/coverageharness \
      --input "$go_file" \
      --out "$go_run_dir" \
      --subject "$function_name" \
      --expected-status "$expected_status" \
      --args "$arg_ints" 2>&1)"; then
    report_fail "$id" "$features" "go-harness" "$harness_output"
    return 0
  fi

  # Membership lane: for observables that genuinely depend on the Choices
  # stream, equality against one go run is the wrong oracle — dispatch to
  # the membership path (enumerated machine set ⊇ every Go sample). The
  # strict path below, INCLUDING its three-stream invariance check, is
  # untouched. Audit F6: the non-native-frontend fail-closed guard applies
  # to this lane exactly like the strict one, BEFORE the dispatch — the
  # membership path shells the native frontend and must never do so under
  # an unsupported frontend.
  if [[ "$lane" == "membership" ]]; then
    if [[ "$FRONTEND" != "native" ]]; then
      report_fail "$id" "$features" "frontend-export" "unsupported frontend '$FRONTEND' (only 'native' is supported)"
      return 0
    fi
    if [[ "$expected_status" == "deadlock" ]]; then
      report_fail "$id" "$features" "manifest" "deadlock-expectation cases are strict-lane only"
      return 0
    fi
    run_membership_case_rows
    return 0
  fi

  if go_observation="$(go_run_oracle 2>&1)"; then
    if [[ "$expected_status" == "race" ]]; then
      report_fail "$id" "$features" "go-observation" "expected a -race report, but go run -race exited green: $go_observation (three-way investigation: too-eager check / schedule-hidden race / misclassified case)"
      failed=1
    elif [[ "$expected_status" == "panic" || "$expected_status" == "deadlock" ]]; then
      report_fail "$id" "$features" "go-observation" "expected $expected_status, but Go exited successfully: $go_observation"
      failed=1
    elif ! lean observation-eq --left "$go_observation" --right "$go_observation" >/dev/null 2>&1; then
      report_fail "$id" "$features" "go-observation" "Go output is not a valid observation: $go_observation"
      failed=1
    elif [[ "$go_observation" != *"\"status\":\"$expected_status\""* ]]; then
      report_fail "$id" "$features" "go-observation" "expected status $expected_status, got $go_observation"
      failed=1
    fi
  else
    if [[ "$expected_status" == "deadlock" ]]; then
      # The detector's message is FIXED; the observation both sides
      # compare carries it verbatim (the Lean machine's deadlocked
      # terminal renders the identical status/message).
      if [[ "$go_observation" != *"fatal error: all goroutines are asleep - deadlock!"* ]]; then
        report_fail "$id" "$features" "go-run" "expected Go deadlock fatal error, got: $go_observation"
        failed=1
      else
        go_observation="{\"message\":\"all goroutines are asleep - deadlock!\",\"schema\":\"golean-observation-v1\",\"status\":\"deadlock\"}"
      fi
    elif [[ "$expected_status" == "race" ]]; then
      # TSan's report text is diagnostic detail (addresses, stacks); the
      # observation both sides compare is the FIXED refusal — the Lean
      # machine's raceDetected terminal renders the identical
      # status/message, deterministic per stream so the invariance loop
      # below doubles as the per-stream refusal check.
      if [[ "$go_observation" != *"WARNING: DATA RACE"* ]]; then
        report_fail "$id" "$features" "go-run" "expected a go run -race data-race report, got: $go_observation"
        failed=1
      else
        go_observation="{\"message\":\"data race detected\",\"schema\":\"golean-observation-v1\",\"status\":\"race\"}"
      fi
    elif [[ "$expected_status" == "panic" ]]; then
      if [[ "$go_observation" != *"panic:"* ]]; then
        report_fail "$id" "$features" "go-run" "expected Go panic, got: $go_observation"
        failed=1
      elif [[ "$go_observation" != *"$expected_reason"* ]]; then
        report_fail "$id" "$features" "go-observation" "Go panic did not contain expected reason $expected_reason: $go_observation"
        failed=1
      elif ! actual_panic_message="$(printf '%s\n' "$go_observation" | panic_message)"; then
        report_fail "$id" "$features" "go-observation" "could not extract Go panic message: $go_observation"
        failed=1
      else
        escaped_reason="$(json_string_literal "$actual_panic_message")"
        go_observation="{\"message\":$escaped_reason,\"schema\":\"golean-observation-v1\",\"status\":\"panic\"}"
      fi
    else
      report_fail "$id" "$features" "go-run" "$go_observation"
      failed=1
    fi
  fi
  if [[ "$failed" -ne 0 ]]; then
    return 0
  fi

  if [[ "$FRONTEND" != "native" ]]; then
    report_fail "$id" "$features" "frontend-export" "unsupported frontend '$FRONTEND' (only 'native' is supported)"
    return 0
  fi
  # Native Go frontend: type-check + emit the native wire JSON, then run it
  # through the native lowering. Multi-file packages are allowed (go/types
  # resolves them); no batch export step is needed.
  wire_json="$OUT/native/$id/wire.json"
  mkdir -p "$(dirname "$wire_json")"
  if ! native_export="$(run_with_timeout "$GO_TIMEOUT_SECONDS" env GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" go run ./tools/nativefrontend --dir "$go_dir" --out "$wire_json" 2>&1)"; then
    report_fail "$id" "$features" "frontend-export" "native frontend: $native_export"
    return 0
  fi

  # CONFLUENT lane (D9(b), slice 4): certify |set| = 1 over ALL
  # schedules FIRST — the strict pipeline below then verifies the one
  # member against the go oracle at full differential strength. The
  # certified member is additionally pinned against the strict path's
  # own observation further down.
  confluent_member=""
  confluent_detail=""
  if [[ "$lane" == "confluent" ]]; then
    local width sites obs_cap samples work members
    parse_lane_params || return 0
    local conf_dir="$OUT/membership/$id"
    mkdir -p "$conf_dir"
    local conf_args=(coverage-observations --input "$wire_json" --function "$function_name"
      --max-width "$width" --max-sites "$sites" --cap "$obs_cap" --work-cap "$work"
      --expect-status "$expected_status")
    if [[ "$arg_ints" != "-" ]]; then
      local v2
      IFS=',' read -r -a ints2 <<< "$arg_ints"
      for v2 in "${ints2[@]}"; do
        conf_args+=(--arg-int "$v2")
      done
    fi
    if ! run_with_timeout "$LEAN_ENUM_TIMEOUT_SECONDS" "$GOLEAN_BIN" "${conf_args[@]}" \
        > "$conf_dir/observations.txt" 2> "$conf_dir/enum-stats.txt"; then
      report_fail "$id" "$features" "confluent" "enumerator failed (schedule-confluence not certified): $(cat "$conf_dir/enum-stats.txt")"
      return 0
    fi
    local conf_count
    conf_count="$(grep -c . "$conf_dir/observations.txt" || true)"
    if [[ "$conf_count" -ne 1 ]]; then
      report_fail "$id" "$features" "confluent" "enumerated observation set has $conf_count member(s) — the observable is NOT schedule-confluent (declare membership with the admitted set, or fix the machine)"
      return 0
    fi
    confluent_member="$(head -1 "$conf_dir/observations.txt")"
    confluent_detail="$(one_line "$(cat "$conf_dir/enum-stats.txt")")"
  fi
  lean_args=(native-json-run --input "$wire_json" --function "$function_name")
  if [[ "$arg_ints" != "-" ]]; then
    IFS=',' read -r -a ints <<< "$arg_ints"
    for value in "${ints[@]}"; do
      if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
        report_fail "$id" "$features" "manifest" "invalid integer argument: $value"
        failed=1
      else
        lean_args+=(--arg-int "$value")
      fi
    done
  fi
  if [[ "$failed" -ne 0 ]]; then
    return 0
  fi

  if lean_observation="$(lean "${lean_args[@]}" 2>&1)"; then
    lean_status=0
  else
    lean_status=$?
  fi
  if [[ "$lean_observation" != *"\"status\":\"$expected_status\""* ]]; then
    # A call into a frontend-QUARANTINED stub (per-decl fail-closed for
    # declarations the frontend cannot lower) is a frontend coverage gap,
    # not a machine-fidelity failure — classify it as the export stage so
    # the untriaged ledger keeps meaning "machine gaps".
    if [[ "$lean_observation" == *'"status":"unsupported"'* && "$lean_observation" == *"frontend-quarantined: "* ]]; then
      report_fail "$id" "$features" "frontend-export" "$lean_observation"
      return 0
    fi
    report_fail "$id" "$features" "lean-observation" "expected status $expected_status, got $lean_observation"
    return 0
  fi
  if [[ "$expected_status" == "ok" && "$lean_status" -ne 0 ]]; then
    report_fail "$id" "$features" "lean-run" "nonzero exit $lean_status despite ok observation: $lean_observation"
    return 0
  fi

  if ! observation_diff="$(lean observation-eq --left "$lean_observation" --right "$go_observation" 2>&1)"; then
    report_fail "$id" "$features" "differential" "Lean=$lean_observation Go=$go_observation $observation_diff"
    return 0
  fi
  if [[ "$lane" == "confluent" ]]; then
    if ! lean observation-eq --left "$confluent_member" --right "$lean_observation" >/dev/null 2>&1; then
      report_fail "$id" "$features" "confluent" "the certified singleton member differs from the driver's observation (enumerator/driver drift): member=$confluent_member driver=$lean_observation"
      return 0
    fi
  fi

  # RACY lane (D9(d), slice 4 FULL STRENGTH): the enumerator proves
  # "every enumerated path refuses" — one value member anywhere fails
  # the expect-status check loudly — REPLACING the per-stream refusal
  # approximation (the old adversarial-stream loop is subsumed: every
  # stream's path is in the enumerated tree).
  if [[ "$lane" == "racy" ]]; then
    local width sites obs_cap samples work members
    parse_lane_params || return 0
    local racy_dir="$OUT/membership/$id"
    mkdir -p "$racy_dir"
    local racy_args=(coverage-observations --input "$wire_json" --function "$function_name"
      --max-width "$width" --max-sites "$sites" --cap "$obs_cap" --work-cap "$work"
      --expect-status race)
    if [[ "$arg_ints" != "-" ]]; then
      local v3
      IFS=',' read -r -a ints3 <<< "$arg_ints"
      for v3 in "${ints3[@]}"; do
        racy_args+=(--arg-int "$v3")
      done
    fi
    if ! run_with_timeout "$LEAN_ENUM_TIMEOUT_SECONDS" "$GOLEAN_BIN" "${racy_args[@]}" \
        > "$racy_dir/observations.txt" 2> "$racy_dir/enum-stats.txt"; then
      report_fail "$id" "$features" "racy" "enumerator failed — 'every enumerated path refuses' not certified: $(cat "$racy_dir/enum-stats.txt")"
      return 0
    fi
    report_pass_lane "$id" "$features" "racy" \
      "every enumerated path refuses: $(one_line "$(cat "$racy_dir/enum-stats.txt")")"
    return 0
  fi

  # Oracle-invariance check: re-run under several nondeterminism choice streams.
  # A deterministic-lane-eligible program has an observation that does not vary
  # with the oracle (e.g. map iteration order). Variance means the program is
  # genuinely nondeterministic and must not be a strict-lane pass. Only the
  # native path threads choices today.
  if [[ "$FRONTEND" == "native" ]]; then
    nondet=0
    for oracle in "9,8,7,6,5,4,3,2,1,0" "1,3,5,7,9,2,4,6,8,0" "5,5,5,5,5,5,5,5"; do
      if variant_obs="$(lean "${lean_args[@]}" --choices "$oracle" 2>&1)"; then :; fi
      if ! lean observation-eq --left "$lean_observation" --right "$variant_obs" >/dev/null 2>&1; then
        report_fail "$id" "$features" "nondet" "observation varies with iteration order (oracle [$oracle]): default=$lean_observation variant=$variant_obs"
        nondet=1
        break
      fi
    done
    if [[ "$nondet" -ne 0 ]]; then
      return 0
    fi
  fi

  if [[ "$lane" == "confluent" ]]; then
    report_pass_lane "$id" "$features" "confluent" \
      "|set|=1 certified over all schedules; $confluent_detail"
  else
    report_pass "$id" "$features"
  fi
}

# The go-run oracle invocation for the CURRENT case (uses run_case_rows'
# local go_run_dir). Arc-final audit F19 (2026-08-06): with an ABSOLUTE
# $OUT (GOLEAN_COVERAGE_ARTIFACTS set to an absolute path — exactly
# scripts/test-lane-validation's mktemp configuration), the old
# `go run $go_run_pkg` passed an absolute path, which GOPATH mode rejects
# with "cannot import absolute path": every case reaching this stage
# failed at stage go-run regardless of the property under test (and a
# panic-expected case reported the misleading "expected Go panic, got:
# ... cannot import absolute path"). Run from inside the package dir
# instead — `go run .` resolves in GOPATH mode for both path shapes.
# GODEBUG=panicnil=0 (arc-final audit F21, 2026-08-06): the machine
# models the MODERN (Go 1.21+) panic(nil) semantics — recover() returns
# *runtime.PanicNilError — while GOPATH mode defaults to the legacy
# behavior; the knob aligns the oracle with the model instead of
# agreeing by config coincidence (unwinding arc §A2's recorded knob).
go_run_oracle() {
  # Race-expectation cases build with -race (the TSan second oracle);
  # everything else runs plain — except that membership SAMPLING may
  # force a -race build ($1 = race): the slice-4 doctrine update makes
  # -race a default membership sample source (its runtime perturbs
  # scheduling — plain go run is a point-mass on schedule-dependent
  # shapes; probes: 0/700 vs 6/6 orderings). The two oracle MODES still
  # never mix in one deadlock case: -race suppresses the deadlock
  # detector (ground-truth note §5), and membership excludes deadlock.
  local race_flag=()
  if [[ "$expected_status" == "race" || "${1:-}" == "race" ]]; then
    race_flag=(-race)
  fi
  run_with_timeout "$GO_TIMEOUT_SECONDS" env GO111MODULE=off GODEBUG=panicnil=0 GOCACHE="$GO_BUILD_CACHE" \
    bash -c 'cd "$1" && shift && exec go run "$@" .' go-run-oracle "$go_run_dir" ${race_flag[@]+"${race_flag[@]}"}
}

# One `go run` of the generated harness, classified under the SAME status /
# panic policy as the strict lane. On success prints the sample's canonical
# observation JSON and returns 0; on any failure prints the error detail
# and returns 1. Uses run_case_rows' locals (go_run_dir, expected_status,
# expected_reason).
membership_go_observation() {
  local out
  if out="$(go_run_oracle "${1:-}" 2>&1)"; then
    if [[ "$expected_status" == "panic" ]]; then
      printf 'go sample: expected panic, but Go exited successfully: %s' "$out"
      return 1
    fi
    if ! lean observation-eq --left "$out" --right "$out" >/dev/null 2>&1; then
      printf 'go sample is not a valid observation: %s' "$out"
      return 1
    fi
    if [[ "$out" != *"\"status\":\"$expected_status\""* ]]; then
      printf 'go sample: expected status %s, got %s' "$expected_status" "$out"
      return 1
    fi
    printf '%s' "$out"
    return 0
  fi
  if [[ "$expected_status" == "panic" ]]; then
    if [[ "$out" != *"panic:"* ]]; then
      printf 'go sample: expected Go panic, got: %s' "$out"
      return 1
    fi
    if [[ "$out" != *"$expected_reason"* ]]; then
      printf 'go sample: Go panic did not contain expected reason %s: %s' "$expected_reason" "$out"
      return 1
    fi
    local msg escaped
    if ! msg="$(printf '%s\n' "$out" | panic_message)"; then
      printf 'go sample: could not extract Go panic message: %s' "$out"
      return 1
    fi
    escaped="$(json_string_literal "$msg")"
    printf '{"message":%s,"schema":"golean-observation-v1","status":"panic"}' "$escaped"
    return 0
  fi
  printf 'go sample run failed: %s' "$out"
  return 1
}

# The membership lane (arc slice 3, docs/2026-08-04_membership-lane-design.md).
# PASS = every Go sample ∈ the machine's enumerated observation set
# (possibilistic membership — the nondeterminism doctrine's testing half).
# Fail-closed guards: enumerator failure (width/depth/cap/work — coverage
# not certified) fails the case; a SINGLETON enumerated set fails
# classification (the case belongs in the strict lane); a Go sample outside
# the set is the too-narrow soundness alarm. The width signal
# (|enumerated|, |exhibited|, the unexhibited members) is recorded as
# metadata in the PASS detail and under $OUT/membership/<id>/ — never a
# pass criterion. Runs inside run_case_rows' scope (uses its locals).
# Parse the lane params into width/sites/obs_cap/samples/work/members.
# Validated by coverage-manifest AND re-validated here (audit F4: a value
# that reaches the harness malformed — e.g. samples=0 — must fail loud,
# never degrade to a zero-oracle pass). Width has NO default (audit F2a),
# and since slice 4 the assertion is checked MECHANICALLY per site by the
# enumerator. Returns nonzero after reporting on a bad shape.
parse_lane_params() {
  width="" sites=8 obs_cap=64 samples=5 work=200000 members=""
  if [[ "$params" != "-" ]]; then
    local kv key value
    IFS=',' read -r -a kvs <<< "$params"
    for kv in "${kvs[@]}"; do
      key="${kv%%=*}"
      value="${kv#*=}"
      if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
        report_fail "$id" "$features" "manifest" "lane param $key must be a positive integer: $kv"
        return 1
      fi
      case "$key" in
        width) width="$value" ;;
        sites) sites="$value" ;;
        cap) obs_cap="$value" ;;
        samples) samples="$value" ;;
        work) work="$value" ;;
        members) members="$value" ;;
        *)
          report_fail "$id" "$features" "manifest" "unknown lane param key: $kv"
          return 1
          ;;
      esac
    done
  fi
  if [[ -z "$width" ]]; then
    report_fail "$id" "$features" "manifest" "$lane case must declare an explicit width=<B> (author-asserted >= every consumption-site bound; mechanically checked per site)"
    return 1
  fi
  return 0
}

run_membership_case_rows() {
  local width sites obs_cap samples work members
  parse_lane_params || return 0

  local mem_dir="$OUT/membership/$id"
  mkdir -p "$mem_dir"

  # Go side: R samples PLAIN plus R samples under -race (slice-4 doctrine
  # update: the -race runtime perturbs goroutine scheduling, so it is a
  # default membership sample source — plain go run is a point-mass on
  # schedule-dependent shapes; samples=1 stays the version-tracking mode).
  local i sample mode
  : > "$mem_dir/samples.txt"
  for mode in "" "race"; do
    for ((i = 1; i <= samples; i++)); do
      if ! sample="$(membership_go_observation "$mode")"; then
        report_fail "$id" "$features" "membership" "${mode:+-race }$sample"
        return 0
      fi
      printf '%s\n' "$sample" >> "$mem_dir/samples.txt"
    done
  done
  # Audit F4: never pass with zero oracle — however the loop above was
  # reached, an empty samples file means no Go observation constrains the
  # machine set, and the case must fail loud, not report a lane PASS.
  if ! grep -q . "$mem_dir/samples.txt"; then
    report_fail "$id" "$features" "membership" "no Go samples produced (samples=$samples) — refusing to pass with zero oracle"
    return 0
  fi

  # Machine side: export the wire and enumerate the observation set.
  local wire_json="$OUT/native/$id/wire.json"
  mkdir -p "$(dirname "$wire_json")"
  local native_export
  if ! native_export="$(run_with_timeout "$GO_TIMEOUT_SECONDS" env GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" go run ./tools/nativefrontend --dir "$go_dir" --out "$wire_json" 2>&1)"; then
    report_fail "$id" "$features" "frontend-export" "native frontend: $native_export"
    return 0
  fi
  local int_flags=()
  if [[ "$arg_ints" != "-" ]]; then
    local ints value
    IFS=',' read -r -a ints <<< "$arg_ints"
    for value in "${ints[@]}"; do
      if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
        report_fail "$id" "$features" "manifest" "invalid integer argument: $value"
        return 0
      fi
      int_flags+=(--arg-int "$value")
    done
  fi
  # --expect-status (audit F1): a member whose status differs from the
  # case's expected status is a machine bug, not an envelope point — the
  # enumerator fails loud on it instead of burying it in the set.
  local enum_args=(coverage-observations --input "$wire_json" --function "$function_name"
    --max-width "$width" --max-sites "$sites" --cap "$obs_cap" --work-cap "$work"
    --expect-status "$expected_status" ${int_flags+"${int_flags[@]}"})
  if ! run_with_timeout "$LEAN_ENUM_TIMEOUT_SECONDS" "$GOLEAN_BIN" "${enum_args[@]}" \
      > "$mem_dir/observations.txt" 2> "$mem_dir/enum-stats.txt"; then
    report_fail "$id" "$features" "membership" "enumerator failed (coverage not certified): $(cat "$mem_dir/enum-stats.txt")"
    return 0
  fi

  local member_count
  member_count="$(grep -c . "$mem_dir/observations.txt" || true)"
  if [[ "$member_count" -le 1 ]]; then
    report_fail "$id" "$features" "membership" "enumerated observation set is a singleton ($member_count member) — the case belongs in the strict or confluent lane"
    return 0
  fi
  # The set-cardinality pin (slice 4, members=<n>): the certified set's
  # SIZE is part of the claim — e.g. sb-chan's {1,10,11} pins 3, so the
  # SC-forbidden 00 cannot appear without failing the case.
  if [[ -n "$members" && "$member_count" -ne "$members" ]]; then
    report_fail "$id" "$features" "membership" "enumerated set has $member_count member(s), the case pins members=$members — the certified set moved (widen/narrow deliberately or fix the machine)"
    return 0
  fi

  # Driver-coupling pin (audit F5): the enumerator COPIES native-json-run's
  # driver layer (entry wiring + run loop, see GoLean/CLI.lean). Pin the
  # copy against the original on every run: the single-run driver's
  # observation under the default and the three adversarial streams must
  # be a member of the enumerated set. A miss is copied-driver drift (or a
  # width the enumeration missed) — fail loud either way.
  local cs coupling_obs member m_found
  for cs in "" "9,8,7,6,5,4,3,2,1,0" "1,3,5,7,9,2,4,6,8,0" "5,5,5,5,5,5,5,5"; do
    local run_args=(native-json-run --input "$wire_json" --function "$function_name" ${int_flags+"${int_flags[@]}"})
    if [[ -n "$cs" ]]; then
      run_args+=(--choices "$cs")
    fi
    if coupling_obs="$(lean "${run_args[@]}" 2>&1)"; then :; fi
    m_found=0
    while IFS= read -r member; do
      if lean observation-eq --left "$member" --right "$coupling_obs" >/dev/null 2>&1; then
        m_found=1
        break
      fi
    done < "$mem_dir/observations.txt"
    if [[ "$m_found" -ne 1 ]]; then
      report_fail "$id" "$features" "membership" "driver-coupling pin: native-json-run observation under stream [$cs] is NOT in the enumerated set (copied-driver drift, or a behavior the enumeration missed): $coupling_obs"
      return 0
    fi
  done

  # Membership check: every Go sample must be a member. Track which members
  # Go exhibited (by member line number) for the width signal.
  local exhibited="" n member found
  while IFS= read -r sample; do
    found=0
    n=0
    while IFS= read -r member; do
      n=$((n + 1))
      if lean observation-eq --left "$member" --right "$sample" >/dev/null 2>&1; then
        found=1
        case " $exhibited " in
          *" $n "*) ;;
          *) exhibited="$exhibited $n" ;;
        esac
        break
      fi
    done < "$mem_dir/observations.txt"
    if [[ "$found" -ne 1 ]]; then
      report_fail "$id" "$features" "membership" "Go observation is NOT in the machine's enumerated set (the too-narrow soundness alarm): $sample enumerated=$member_count"
      return 0
    fi
  done < "$mem_dir/samples.txt"

  local exhibited_count unexhibited_count
  exhibited_count="$(printf '%s\n' $exhibited | grep -c . || true)"
  n=0
  : > "$mem_dir/unexhibited.txt"
  while IFS= read -r member; do
    n=$((n + 1))
    case " $exhibited " in
      *" $n "*) ;;
      *) printf '%s\n' "$member" >> "$mem_dir/unexhibited.txt" ;;
    esac
  done < "$mem_dir/observations.txt"
  unexhibited_count="$(grep -c . "$mem_dir/unexhibited.txt" || true)"

  report_pass_lane "$id" "$features" "membership" \
    "enumerated=$member_count exhibited=$exhibited_count unexhibited=$unexhibited_count samples=$samples (members in $mem_dir)"
}

# ---- the parallel driver: one row file per manifest case, a worker pool
# over them, results assembled in manifest order (byte-identical to the
# sequential runner's output). GOLEAN_COVERAGE_JOBS=1 restores strictly
# sequential execution.
if [[ -z "${GOLEAN_COVERAGE_JOBS:-}" ]]; then
  GOLEAN_COVERAGE_JOBS="$( (command -v nproc >/dev/null && nproc) || sysctl -n hw.ncpu 2>/dev/null || echo 4)"
fi
ROWDIR="$(mktemp -d "${TMPDIR:-/tmp}/golean-coverage-rows.XXXXXX")"
row_i=0
while IFS= read -r line; do
  if [[ -z "$line" || "$line" == \#* ]]; then
    continue
  fi
  row_i=$((row_i + 1))
  printf '%s\n' "$line" > "$ROWDIR/$(printf '%06d' "$row_i").in"
done < "$MANIFEST"
case_count="$row_i"

export CASE_OUT ROOT OUT FRONTEND GO_BUILD_CACHE GOLEAN_BIN \
  GO_TIMEOUT_SECONDS LEAN_TIMEOUT_SECONDS LEAN_ENUM_TIMEOUT_SECONDS
export -f run_case run_case_rows run_with_timeout lean json_string_literal \
  panic_message report_pass report_pass_lane report_fail one_line \
  membership_go_observation run_membership_case_rows go_run_oracle \
  parse_lane_params

# Record the concurrency the run used (audit finding: a load-induced
# timeout drift was indistinguishable from a real one after the fact).
printf 'jobs\t%s\n' "$GOLEAN_COVERAGE_JOBS" >> "$META_TMP"

if [[ "$GOLEAN_COVERAGE_JOBS" -le 1 ]]; then
  for f in "$ROWDIR"/*.in; do
    run_case "$f"
  done
else
  ls "$ROWDIR"/*.in | xargs -P "$GOLEAN_COVERAGE_JOBS" -n 1 bash -c 'run_case "$1"' _ \
    || echo "diff-coverage: WARNING — worker pool exited nonzero; unclassified cases fail closed below" >&2
fi

pass_count=0
fail_count=0
for f in "$ROWDIR"/*.in; do
  outf="${f%.in}.out"
  if [[ -s "$outf" ]]; then
    cat "$outf" >> "$RESULTS_TMP"
  else
    # No published result (worker died before its atomic mv) or an empty
    # one (no classification path can produce it) — fail closed, never
    # silent. The row itself carries the id in field 1.
    printf 'FAIL\t%s\tunknown\tharness\tworker produced no result\n' \
      "$(cut -f1 "$f")" >> "$RESULTS_TMP"
  fi
done
pass_count="$(awk -F '\t' '$1=="PASS"' "$RESULTS_TMP" | wc -l | tr -d ' ')"
fail_count="$(awk -F '\t' '$1=="FAIL"' "$RESULTS_TMP" | wc -l | tr -d ' ')"
rm -rf "$ROWDIR"

echo
echo "differential coverage summary: cases=$case_count pass=$pass_count fail=$fail_count export_status=$export_status"
publish_results
echo "results: $RESULTS_TSV"
echo "metadata: $META_TSV"

if [[ "${GOLEAN_COVERAGE_RUN_FULL:-unknown}" == "true" ]]; then
  cp "$RESULTS_TSV" "$OUT/latest-full.tsv"
  cp "$META_TSV" "$OUT/latest-full.meta.tsv"
fi

if [[ "$case_count" -eq 0 ]]; then
  echo "no differential cases found in $MANIFEST" >&2
  exit 2
fi
if [[ "$fail_count" -ne 0 || "$export_status" -ne 0 ]]; then
  exit 1
fi
