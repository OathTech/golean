#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

if [[ "$#" -lt 1 ]]; then
  echo "usage: scripts/diff-one <case-id> [<case-id> ...]" >&2
  exit 2
fi

args=()
for id in "$@"; do
  args+=(--id "$id")
done

scripts/coverage run "${args[@]}"
