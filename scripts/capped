#!/usr/bin/env bash
# Run a command inside its OWN cgroup with a hard memory cap, so a runaway
# build dies alone instead of taking the machine (and the caller) with it.
#
#   scripts/capped lake build
#   scripts/capped lake env lean SomeFile.lean
#   GOLEAN_MEM_MAX=96G scripts/capped lake build     # deliberate heavy run
#
# WHY THIS EXISTS (2026-08-09): `example : sumRoundTripOk := by decide +kernel`
# in compat/gobra reached 60 GB of RSS in ~2 minutes and killed the session
# twice — the OOM killer picks by badness score, and the terminal multiplexer
# and the agent are perfectly good candidates. Deleting that one line made the
# same file elaborate in 1.0 s. The cap turns "the box dies" into "the build
# fails", which is the outcome every gate in this repo is built around.
#
# THE CAP IS A BLAST RADIUS, NOT A BUDGET. Default 64G on a 125G machine: use
# the heavy machine when a job needs it, but never let one job take the box.
# Raise it deliberately with GOLEAN_MEM_MAX for a job you have reason to
# believe needs more.
#
# TWO MECHANISMS THAT DO NOT WORK — measured, do not "simplify" to either:
#   * `lean -M <mb>` is not enforced during KERNEL reduction. Audit-reproduced:
#     under `-M 4096`, lean's own VmRSS was 4953 MiB at t=10s and still
#     climbing, with no memory diagnostic ever emitted. It checks at elaborator
#     allocation points; `decide +kernel` is not one.
#   * `prlimit --as=<n>` kills Lean above a threshold ("failed to create
#     thread") — Lean reserves large address space per thread, so an
#     address-space limit is not a memory limit here. (--as=8G happened to run;
#     --as=2G died immediately. Threshold effect, not a usable knob.)
#     RSS via cgroup is the only honest knob.
# MemorySwapMax=0 is deliberate: with swap available the runaway thrashes
# ~19 GB of it first, which hangs the box in a slower, more confusing way.
set -uo pipefail

MEM="${GOLEAN_MEM_MAX:-64G}"

if [ "$#" -eq 0 ]; then
  echo "usage: scripts/capped <command> [args...]" >&2
  exit 2
fi

# Inside the scope: VERIFY the cap is real before running anything. Trusting
# GOLEAN_CAPPED alone was a silent, total fail-open (pre-merge audit F2/F3,
# 2026-08-09) — a stale inherited variable, or a host whose user manager has
# no delegated memory controller (cgroup v1, or user@.service without
# Delegate=memory, where systemd ACCEPTS -p MemoryMax and ignores it), meant
# the command ran uncapped in the CALLER'S OWN cgroup while printing nothing.
# The reproduction was the exact scenario this script exists to prevent: the
# terminal multiplexer's cgroup, memory.max=max. So: read the limit back.
#
# THE TOKEN VALUES ARE LOAD-BEARING (delta-review D1/D2, 2026-08-09) — three
# distinct states, because two of them were conflated and that WAS the bug:
#
#   (unset)  nothing has happened yet          -> wrap
#   none     the opt-out fired, WARN every time-> run, uncapped, loudly
#   verified the readback below PASSED here    -> run, capped
#
# Anything else (notably a stale `=1` from an unrelated shell) is UNTRUSTED and
# must reach the readback. The first attempt used `=none` as a bare "already
# handled" marker placed BEFORE the readback and printing nothing, which
# recreated the exact fail-open it was fixing: an inherited GOLEAN_CAPPED=none
# ran uncapped in the caller's own cgroup, silently, forever after — every
# descendant of one opted-out shell. Hence: `none` warns unconditionally, and
# only `verified` — which nothing but this script's own verified path sets —
# skips the check.
if [ "${GOLEAN_CAPPED:-}" = "none" ]; then
  echo "scripts/capped: WARNING — running UNCAPPED (inherited GOLEAN_CAPPED=none): $*" >&2
  exec "$@"
fi
if [ "${GOLEAN_CAPPED:-}" = "verified" ]; then
  exec "$@"
fi
if [ -n "${GOLEAN_CAPPED:-}" ]; then
  # Select the cgroup-v2 line explicitly ("0::"), and keep everything after
  # the second colon — cgroup PATHS may themselves contain colons (systemd
  # unit names allow them), and on a hybrid/v1 host `head -1` picks a v1
  # controller line whose path has no memory.max (D4). Both mistakes fail
  # CLOSED here (exit 3, never a false pass), but they refuse legitimate runs.
  cg="$(awk -F: '/^0::/{print substr($0, index($0,":")+2); exit}' /proc/self/cgroup 2>/dev/null)"
  lim="$(cat "/sys/fs/cgroup${cg}/memory.max" 2>/dev/null)"
  if [ -z "$lim" ] || [ "$lim" = "max" ]; then
    cat >&2 <<EOF
scripts/capped: REFUSING TO RUN — the memory cap is not in effect.
  cgroup:     ${cg:-<unreadable>}
  memory.max: ${lim:-<unreadable>}  (expected a byte count, not "max")
  GOLEAN_CAPPED=${GOLEAN_CAPPED} claimed this process is capped; the kernel
  disagrees. Causes: a stale GOLEAN_CAPPED inherited from an unrelated shell;
  a GOLEAN_MEM_MAX value systemd parsed as no limit (you asked for "$MEM");
  or a host whose systemd user manager has no delegated memory controller
  (check: cat /sys/fs/cgroup/user.slice/user-\$(id -u).slice/user@\$(id -u).service/cgroup.subtree_control).
  Run uncapped only if you mean it: GOLEAN_MEM_MAX=none $0 $*
EOF
    exit 3
  fi
  # Hand the verified token down, so a self-wrapping caller (scripts/ci) can
  # tell "a cap was PROVEN here" from "someone set a variable".
  exec env GOLEAN_CAPPED=verified "$@"
fi

# Explicit, visible opt-out. Fail-closed doctrine: an unavailable cap is an
# ERROR, not a silent uncapped run — a cap that quietly does nothing is worse
# than no cap, because it is believed.
if [ "$MEM" = "none" ]; then
  echo "scripts/capped: WARNING — GOLEAN_MEM_MAX=none, running UNCAPPED: $*" >&2
  exec env GOLEAN_CAPPED=none "$@"
fi

if ! command -v systemd-run >/dev/null 2>&1; then
  cat >&2 <<EOF
scripts/capped: systemd-run not found — refusing to run uncapped.
  An uncapped Lean build has taken this machine down before (see the header
  of this script). Either install systemd, or opt out explicitly and
  knowingly with:
      GOLEAN_MEM_MAX=none scripts/capped $*
EOF
  exit 127
fi

# PRE-FLIGHT: prove a capped scope can actually be created, before handing
# systemd-run the real command. Without this, the two commonest setup errors
# surface as a bare systemd message and exit 1 — indistinguishable from "the
# build failed" (delta-review D3/D5/D7):
#   * systemd-run present but no session D-Bus ("Failed to connect to bus") —
#     GitHub runners, sudo-ed shells, containers. This is the F1 environment,
#     so it is exactly the case that deserves the pointer to the opt-out.
#   * an unparseable GOLEAN_MEM_MAX ("64GB", "abc", "infinity") — systemd
#     rejects it, or silently means "no limit", which the readback would then
#     refuse with a misleading diagnosis.
# Costs one transient scope around `true` (~ms).
if ! probe="$(systemd-run --user --scope -q -p MemoryMax="$MEM" -p MemorySwapMax=0 -- true 2>&1)"; then
  cat >&2 <<EOF
scripts/capped: cannot create a capped cgroup — refusing to run uncapped.
  systemd-run said: ${probe:-<no output>}
  GOLEAN_MEM_MAX=$MEM
  Likely either a bad size (use 64G / 8192M / a plain byte count), or no
  systemd user session on this host (common on CI runners, in containers, and
  under sudo — check: systemctl --user is-system-running).
  If this host cannot cap, opt out explicitly and knowingly:
      GOLEAN_MEM_MAX=none $0 $*
EOF
  exit 4
fi

# --user --scope: the command runs as a transient scope in the caller's
# session, inheriting cwd/env/tty, but in its own cgroup. systemd-run --scope
# EXECS IN PLACE rather than forking, so exit status and signals are
# byte-identical to an unwrapped run (audit-verified: 0/1/2/42/127/137 all
# propagate, and the process keeps the caller's process group so Ctrl-C still
# reaches it). On breach the kernel OOM-kills inside THIS cgroup only; the
# caller is never a candidate.
#
# We re-enter THIS script inside the scope rather than exec'ing the command
# directly, so the readback check above runs on every capped invocation —
# one code path, no way to end up believing in a cap that isn't there.
exec env GOLEAN_CAPPED=1 \
  systemd-run --user --scope -q \
    -p MemoryMax="$MEM" \
    -p MemorySwapMax=0 \
    -- "$0" "$@"
