#!/usr/bin/env bash
# scripts/capped — a SHIM onto the box-wide `capped` (/usr/local/bin/capped).
#
# [USER] Mike, 2026-10-11 (relayed): the global capped script is the one to
# use, here and on the new box (which has the same affordance); and D2:
# conform to the box default, raising it during execution when needed being
# allowed. So, where the box tool exists, this
# script only translates the legacy environment and hands over:
#
#   GOLEAN_MEM_MAX  -> CAPPED_MEM_MAX   (only when the latter is unset)
#   GOLEAN_CAPPED   -> CAPPED_STATE     (only when the latter is unset; the
#                                        token values mean the same thing)
#   then: exec /usr/local/bin/capped "$@"   (-m SIZE / -- pass through)
#
# The limit is the BOX DEFAULT ($CAPPED_MEM_MAX, else 32G). Raise it per job
# when the job needs it — `capped -m 64G -- <cmd>` — and say why where you run
# it. The one measured case: a COLD full build / cold `scripts/ci` in a fresh
# worktree needs 64G+ (docs/operational-lessons.md, «Concurrency OOM»); a warm
# primary build does not. The box-wide build lock (artifacts/build-lock.d)
# stays: two raised builds over-commit a 125G box.
#
# Where the box tool is ABSENT (GitHub runners, a bare container) the body
# below — the original per-project wrapper, 2026-08-09..09-01, the ancestor
# of the box tool — runs unchanged except for its default (32G, the box
# default, since 2026-10-11). Its token is GOLEAN_CAPPED; its verified path
# exports CAPPED_STATE=verified too, so every reader can check one name.
# Nothing here ever runs uncapped silently: an absent cap is an error, the
# opt-out (`CAPPED_MEM_MAX=none` / `GOLEAN_MEM_MAX=none`) warns every time.
#
# Design notes of the fallback body (measured; do not "simplify"): `lean -M`
# is not enforced during kernel reduction; `prlimit --as` kills Lean
# spuriously; RSS via cgroup is the only honest knob; swap off on purpose;
# cgroup-direct sibling placement under app.slice (no D-Bus), systemd-run
# as the fallback, a kernel readback certifies the cap either way.
set -uo pipefail

if [ -x /usr/local/bin/capped ]; then
  if [ -z "${CAPPED_MEM_MAX:-}" ] && [ -n "${GOLEAN_MEM_MAX:-}" ]; then
    export CAPPED_MEM_MAX="$GOLEAN_MEM_MAX"
  fi
  if [ -z "${CAPPED_STATE:-}" ] && [ -n "${GOLEAN_CAPPED:-}" ]; then
    export CAPPED_STATE="$GOLEAN_CAPPED"
  fi
  exec /usr/local/bin/capped "$@"
fi

# ---- fallback: the box tool is absent ---------------------------------------
set -uo pipefail

# systemd suffix semantics: K/M/G/T are binary (1024^n). "max"/"infinity"
# are REJECTED here on purpose — a limit of "max" is not a cap, and the
# readback would refuse it anyway; the honest spelling of "no cap" is
# GOLEAN_MEM_MAX=none.
mem_to_bytes() {
  local v="$1" n u
  n="${v%[KkMmGgTt]}"; u="${v#"$n"}"
  [[ "$n" =~ ^[0-9]+$ ]] || return 1
  case "$u" in
    ''|B|b) echo "$n";;
    K|k) echo $((n*1024));;
    M|m) echo $((n*1024*1024));;
    G|g) echo $((n*1024*1024*1024));;
    T|t) echo $((n*1024*1024*1024*1024));;
    *) return 1;;
  esac
}

# The KILL banner (ported with the mechanism): a cgroup/OOM kill lands as
# exit 137 (128+SIGKILL), a TERM as 143. A killed child must SHOUT — three
# exit-code misreadings in the sibling project earned this. The banner goes
# to stderr; the exit code propagates unchanged (loudness, never a rescue).
kill_banner() {
  local rc="$1"
  if [ "$rc" -eq 137 ] || [ "$rc" -eq 143 ]; then
    echo "==============================================================" >&2
    echo "scripts/capped: KILLED (exit $rc — cgroup/OOM or signal; NOT a pass)" >&2
    echo "==============================================================" >&2
  fi
}

MEM="${GOLEAN_MEM_MAX:-${CAPPED_MEM_MAX:-32G}}"

if [ "$#" -eq 0 ]; then
  echo "usage: scripts/capped <command> [args...]" >&2
  exit 2
fi

# Inside the scope: VERIFY the cap is real before running anything. Trusting
# GOLEAN_CAPPED alone was a silent, total fail-open (pre-merge audit F2/F3,
# 2026-08-09) — a stale inherited variable, or a host whose user manager has
# no delegated memory controller (cgroup v1, or user@.service without
# Delegate=memory, where systemd ACCEPTS -p MemoryMax and ignores it), meant
# the command ran uncapped in the CALLER'S OWN cgroup while printing nothing.
# The reproduction was the exact scenario this script exists to prevent: the
# terminal multiplexer's cgroup, memory.max=max. So: read the limit back.
#
# THE TOKEN VALUES ARE LOAD-BEARING (delta-review D1/D2, 2026-08-09) — three
# distinct states, because two of them were conflated and that WAS the bug:
#
#   (unset)  nothing has happened yet          -> wrap
#   none     the opt-out fired, WARN every time-> run, uncapped, loudly
#   verified the readback below PASSED here    -> run, capped
#
# Anything else (notably a stale `=1` from an unrelated shell) is UNTRUSTED and
# must reach the readback. The first attempt used `=none` as a bare "already
# handled" marker placed BEFORE the readback and printing nothing, which
# recreated the exact fail-open it was fixing: an inherited GOLEAN_CAPPED=none
# ran uncapped in the caller's own cgroup, silently, forever after — every
# descendant of one opted-out shell. Hence: `none` warns unconditionally, and
# only `verified` — which nothing but this script's own verified path sets —
# skips the check.
if [ "${GOLEAN_CAPPED:-}" = "none" ]; then
  echo "scripts/capped: WARNING — running UNCAPPED (inherited GOLEAN_CAPPED=none): $*" >&2
  exec "$@"
fi
if [ "${GOLEAN_CAPPED:-}" = "verified" ] || [ "${CAPPED_STATE:-}" = "verified" ]; then
  exec "$@"
fi
if [ -n "${GOLEAN_CAPPED:-}" ]; then
  # Select the cgroup-v2 line explicitly ("0::"), and keep everything after
  # the second colon — cgroup PATHS may themselves contain colons (systemd
  # unit names allow them), and on a hybrid/v1 host `head -1` picks a v1
  # controller line whose path has no memory.max (D4). Both mistakes fail
  # CLOSED here (exit 3, never a false pass), but they refuse legitimate runs.
  cg="$(awk -F: '/^0::/{print substr($0, index($0,":")+2); exit}' /proc/self/cgroup 2>/dev/null)"
  lim="$(cat "/sys/fs/cgroup${cg}/memory.max" 2>/dev/null)"
  if [ -z "$lim" ] || [ "$lim" = "max" ]; then
    cat >&2 <<EOF
scripts/capped: REFUSING TO RUN — the memory cap is not in effect.
  cgroup:     ${cg:-<unreadable>}
  memory.max: ${lim:-<unreadable>}  (expected a byte count, not "max")
  GOLEAN_CAPPED=${GOLEAN_CAPPED} claimed this process is capped; the kernel
  disagrees. Causes: a stale GOLEAN_CAPPED inherited from an unrelated shell;
  a GOLEAN_MEM_MAX value systemd parsed as no limit (you asked for "$MEM");
  or a host whose systemd user manager has no delegated memory controller
  (check: cat /sys/fs/cgroup/user.slice/user-\$(id -u).slice/user@\$(id -u).service/cgroup.subtree_control).
  Run uncapped only if you mean it: GOLEAN_MEM_MAX=none $0 $*
EOF
    exit 3
  fi
  # Hand the verified token down, so a self-wrapping caller (scripts/ci) can
  # tell "a cap was PROVEN here" from "someone set a variable".
  exec env GOLEAN_CAPPED=verified CAPPED_STATE=verified "$@"
fi

# Explicit, visible opt-out. Fail-closed doctrine: an unavailable cap is an
# ERROR, not a silent uncapped run — a cap that quietly does nothing is worse
# than no cap, because it is believed.
if [ "$MEM" = "none" ]; then
  echo "scripts/capped: WARNING — GOLEAN_MEM_MAX=none, running UNCAPPED: $*" >&2
  exec env GOLEAN_CAPPED=none CAPPED_STATE=none "$@"
fi

# --- Placement 1: cgroup-direct (bus-free) -----------------------------------
# Create a sibling child cgroup under this process's parent, cap it, migrate
# THIS wrapper into it, and re-enter $0 as a CHILD (not exec) so we can
# migrate back and rmdir afterwards. The child inherits the cgroup, so the
# re-entered script's readback proves the cap exactly as in the systemd path.
cgroup_direct() {
  local mem_bytes self orig parent cg rc=0
  mem_bytes="$(mem_to_bytes "$MEM")" || {
    echo "scripts/capped: cannot parse GOLEAN_MEM_MAX='$MEM' (want e.g. 32G / 8192M / a plain byte count; 'none' for an explicit uncapped run)" >&2
    exit 2
  }
  self="$(awk -F: '/^0::/{print substr($0, index($0,":")+2); exit}' /proc/self/cgroup 2>/dev/null)"
  [ -n "$self" ] && [ "$self" != "/" ] || return 1
  orig="/sys/fs/cgroup${self}"; parent="$(dirname "$orig")"
  [ -d "$parent" ] && [ -f "$parent/cgroup.subtree_control" ] || return 1
  grep -qw memory "$parent/cgroup.subtree_control" 2>/dev/null || return 1
  cg="$parent/capped-$$-$(date +%s%N)"
  mkdir "$cg" 2>/dev/null || return 1
  if ! { echo "$mem_bytes" > "$cg/memory.max" && echo 0 > "$cg/memory.swap.max" \
         && echo $$ > "$cg/cgroup.procs"; } 2>/dev/null; then
    echo $$ > "$orig/cgroup.procs" 2>/dev/null || true
    rmdir "$cg" 2>/dev/null || true
    return 1
  fi
  # Placed. Re-enter for the readback (GOLEAN_CAPPED=1 = "untrusted, verify").
  env GOLEAN_CAPPED=1 "$0" "$@" || rc=$?
  echo $$ > "$orig/cgroup.procs" 2>/dev/null || true
  rmdir "$cg" 2>/dev/null \
    || echo "scripts/capped: WARNING — could not remove cgroup $cg (a process still inside? it stays capped there)" >&2
  kill_banner "$rc"
  exit "$rc"
}
cgroup_direct "$@"   # exits on success; returns 1 only if placement was refused

# --- Placement 2: systemd-run fallback ---------------------------------------
if ! command -v systemd-run >/dev/null 2>&1; then
  cat >&2 <<EOF
scripts/capped: cgroup-direct placement refused AND systemd-run not found — refusing to run uncapped.
  An uncapped Lean build has taken this machine down before (see the header
  of this script). Either grant cgroupfs writes under your app.slice / install
  systemd, or opt out explicitly and knowingly with:
      GOLEAN_MEM_MAX=none scripts/capped $*
EOF
  exit 127
fi

# PRE-FLIGHT: prove a capped scope can actually be created, before handing
# systemd-run the real command. Without this, the two commonest setup errors
# surface as a bare systemd message and exit 1 — indistinguishable from "the
# build failed" (delta-review D3/D5/D7):
#   * systemd-run present but no session D-Bus ("Failed to connect to bus") —
#     GitHub runners, sudo-ed shells, containers, sandboxes without a bus
#     grant. This is exactly the case that deserves the pointer to the opt-out
#     (and, since 2026-09-01, to the cgroup-direct grant that avoids the bus).
#   * an unparseable GOLEAN_MEM_MAX ("64GB", "abc", "infinity") — systemd
#     rejects it, or silently means "no limit", which the readback would then
#     refuse with a misleading diagnosis.
# Costs one transient scope around `true` (~ms).
if ! probe="$(systemd-run --user --scope -q -p MemoryMax="$MEM" -p MemorySwapMax=0 -- true 2>&1)"; then
  cat >&2 <<EOF
scripts/capped: cannot create a capped cgroup — refusing to run uncapped.
  cgroup-direct placement was refused (no writable delegated parent cgroup —
  in a sandbox, grant /sys/fs/cgroup/user.slice/user-\$(id -u).slice/user@\$(id -u).service/app.slice),
  and systemd-run said: ${probe:-<no output>}
  GOLEAN_MEM_MAX=$MEM
  Likely either a bad size (use 64G / 8192M / a plain byte count), or no
  reachable systemd user session on this host (common on CI runners, in
  containers, under sudo, and in sandboxes — check: systemctl --user is-system-running).
  If this host cannot cap, opt out explicitly and knowingly:
      GOLEAN_MEM_MAX=none $0 $*
EOF
  exit 4
fi

# --user --scope: the command runs as a transient scope in the caller's
# session, inheriting cwd/env/tty, but in its own cgroup. systemd-run --scope
# EXECS IN PLACE rather than forking, so exit status and signals are
# byte-identical to an unwrapped run (audit-verified: 0/1/2/42/127/137 all
# propagate, and the process keeps the caller's process group so Ctrl-C still
# reaches it). On breach the kernel OOM-kills inside THIS cgroup only; the
# caller is never a candidate.
#
# We re-enter THIS script inside the scope rather than exec'ing the command
# directly, so the readback check above runs on every capped invocation —
# one code path, no way to end up believing in a cap that isn't there.
exec env GOLEAN_CAPPED=1 \
  systemd-run --user --scope -q \
    -p MemoryMax="$MEM" \
    -p MemorySwapMax=0 \
    -- "$0" "$@"
