printf '%s\n' '{"schema":"golean-seed-v1","cells":[{"type":"int","value":1}]}' > "$crd/seed.json"
expect_report() {  # name want-exit expected-stderr-fragment-or-EMPTY mode(default|full) args...
  local name="$1" want_rc="$2" want="$3" mode="$4" rc=0 rcf=0 frag; shift 4
  local margs=(); [[ "$mode" == full ]] && margs=(--choice-report=full)
  "$GOLEAN" native-json-run --input "$gate_scratch/cr.json" "$@" ${margs[@]+"${margs[@]}"} > "$crd/$name.out" 2> "$crd/$name.err" || rc=$?
  "$GOLEAN" native-json-run --input "$gate_scratch/cr.json" "$@" --no-choice-report > "$crd/$name.fout" 2> "$crd/$name.ferr" || rcf=$?
  if [[ $rc -ne $want_rc || $rcf -ne $want_rc ]]; then
    echo "check-wire-boundary: FAIL [$name] — expected exit $want_rc with and without the report (exit $rc / $rcf): $(cat "$crd/$name.out" "$crd/$name.err")" >&2; exit 1
  fi
  if ! cmp -s "$crd/$name.out" "$crd/$name.fout"; then
    echo "check-wire-boundary: FAIL [$name] — stdout differs from the --no-choice-report run: $(cat "$crd/$name.out") vs $(cat "$crd/$name.fout")" >&2; exit 1
  fi
  if [[ -s "$crd/$name.ferr" ]]; then
    echo "check-wire-boundary: FAIL [$name] — --no-choice-report still wrote stderr: $(cat "$crd/$name.ferr")" >&2; exit 1
  fi
  if [[ "$want" == EMPTY ]]; then
    if [[ -s "$crd/$name.err" ]]; then
      echo "check-wire-boundary: FAIL [$name] — a pick-free run wrote stderr: $(cat "$crd/$name.err")" >&2; exit 1
    fi
    echo "ok [$name] no choice consulted: stderr empty, stdout identical to the --no-choice-report run"; return
  fi
  if [[ "$(wc -l < "$crd/$name.err")" -ne 1 ]]; then
    echo "check-wire-boundary: FAIL [$name] — expected exactly one stderr line: $(cat "$crd/$name.err")" >&2; exit 1
  fi
  for frag in "native-json-run: " "$want"; do
    if ! grep -qF -- "$frag" "$crd/$name.err"; then
      echo "check-wire-boundary: FAIL [$name] — the choice report does not say '$frag': $(cat "$crd/$name.err")" >&2; exit 1
    fi
  done
  echo "ok [$name] the choice report says '$want'; stdout identical to the --no-choice-report run"
}
expect_report cr-spill    0 'consulted 1 choice site(s); the observation is one member of a set — see coverage-observations (the certified set) and choice-trace (the sites)' \
  default --function spill
expect_report cr-plain    0 EMPTY default --function plain
