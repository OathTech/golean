echo "ok [cr-flag-twice] a second choice-report flag refused by name (exit 2)"
for sub in coverage-observations choice-trace; do
  for flag in --no-choice-report --choice-report=full; do
    rc=0; out="$("$GOLEAN" "$sub" --input "$gate_scratch/cr.json" --function spill "$flag" 2>&1)" || rc=$?
    if [[ $rc -ne 2 || "$out" != *"unknown or incomplete option: $flag"* ]]; then
      echo "check-wire-boundary: FAIL [cr-flag-$sub $flag] — expected exit 2 refusing $flag by name (exit $rc): $out" >&2; exit 1
    fi
    echo "ok [cr-flag-$sub $flag] refused by name (exit 2): native-json-run's flag alone"
  done
done
echo 'Wire boundary gate: PASS (11 byte-level controls + 2 entry-rule controls + 56 unseq-node controls + 13 promotion-record controls + 16 B6 numeric-locals controls + 5 rand-intn controls + 4 type-key controls + 10 entry-argument controls + 12 enumerator entry-argument controls + 5 missing-input controls + 2 unwritable-output controls + 7 dedup-flag controls + 4 readout-refusal controls + 31 func-refusal controls + 3 CLI-error-shape controls + 36 seeded-entry controls + 17 choice-report controls through the real CLI)'
