# PROMOTION RECORDS (G-P S1/S2, 2026-09-28; design docs/2026-09-28_gp-method-promotion-design.md §2 S2 (b), §4, §5 —
# G-P PASSED [USER] 2026-09-28, relayed): the wire's REQUIRED `promotions` array — one record per promoted method-set
# entry, validated by the decoder against the type/method tables; since S2 the machine's ONLY source for a promoted
# entry (no synthesized wrapper exists: `methods` carries declared methods, anchors and imported stubs, schema
# golean-native-v2). Fixture Tests/wire-boundary-promotion/main.go (every record shape: value/pointer embeds, two
# hops, an embedded interface field — re-dispatched as its own step —, *T-only entries, the sync-primitive stub
# records; `probe` answers 42 through the records). The positive control runs; eleven one-edit mutants — of the
# RECORDS, of the field's absence, of the schema string, of a method's key set, of a record's presence — must refuse
# through the same CLI path naming the cause (the decoder's, or the dispatch's at run time).
GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go run ./tools/nativefrontend --dir Tests/wire-boundary-promotion --out "$gate_scratch/prom.json"
python3 - "$gate_scratch" <<'PY'
import json, sys
from pathlib import Path
scratch = Path(sys.argv[1])
base = json.loads((scratch / 'prom.json').read_text('utf-8'))
assert len(base['promotions']) == 12, f"fixture carries {len(base['promotions'])} promotion records, expected 12"
assert not any('wrapper' in m for m in base['methods']), 'a method carries the retired wrapper key'
assert not any(str(m.get('unsupported', '')).startswith('promoted ') for m in base['methods']), 'a promoted stub survives in methods'
assert sum(1 for r in base['promotions'] if 'unsupported' in r) == 3, 'fixture stub-record count drifted'

def fresh():
    return json.loads(json.dumps(base))
def write(name, data):
    (scratch / f'{name}.json').write_text(json.dumps(data, separators=(',', ':')), 'utf-8')
def rec(w, typ, member):
    hits = [r for r in w['promotions'] if r['type'] == typ and r['member']['name'] == member]
    assert len(hits) == 1, (typ, member, len(hits))
    return hits[0]
def method(w, recv, member):
    hits = [m for m in w['methods'] if m['recvType'] == recv and m['id']['name'] == member]
    assert len(hits) == 1, (recv, member, len(hits))
    return hits[0]
def find_nodes(v, pred):
    out = []
    if isinstance(v, dict):
        if pred(v): out.append(v)
        for c in v.values(): out += find_nodes(c, pred)
    elif isinstance(v, list):
        for c in v: out += find_nodes(c, pred)
    return out

m = fresh(); del m['promotions']; write('prom-absent', m)
m = fresh(); rec(m, 'main.locked', 'Lock')['path'][0]['field'] = 'n'; write('prom-bad-hop', m)          # n is not embedded
m = fresh(); rec(m, 'main.mid', 'val')['path'][0]['ptr'] = True; write('prom-wrong-ptr', m)              # base is a value field
m = fresh(); rec(m, 'main.mid', 'val')['inPtrSetOnly'] = True; write('prom-wrong-set', m)                # value receiver: both sets
m = fresh(); rec(m, 'main.mid', 'val')['adjust'] = 'deref'; write('prom-wrong-adjust', m)                # value field, value receiver: asIs
m = fresh(); rec(m, 'main.mid', 'val')['target'] = dict(rec(m, 'main.mid', 'inc')['target']); write('prom-target-mismatch', m)
m = fresh(); del rec(m, 'main.locked', 'Lock')['unsupported']; write('prom-sig-without-unsupported', m)
m = fresh(); m['schema'] = 'golean-native-v1'; write('prom-wire-v1', m)                                  # a v1 wire (wrappers era) refuses by name
m = fresh(); m['schema'] = 'golean-native-v2'; write('prom-wire-v2', m)                                  # a v2 wire (spelled locals, pre-B6) refuses by name
m = fresh(); method(m, 'main.base', 'val')['wrapper'] = True; write('prom-wrapper-key', m)               # the retired marker on a declared method
m = fresh(); m['promotions'] = [r for r in m['promotions'] if not (r['type'] == 'main.outer' and r['member']['name'] == 'val')]; write('prom-record-removed', m)  # v.val() has no record and no wrapper: the dispatch refuses
m = fresh(); m['promotions'].append(dict(rec(m, 'main.mid', 'val'))); write('prom-duplicate', m)
m = fresh(); forged = dict(rec(m, 'main.solo', 'own')); forged['type'] = 'main.mid'; forged['path'] = [{'owner': 'main.mid', 'field': 'base', 'ptr': False}]
m['promotions'].append(forged); write('prom-declared-conflict', m)                                       # mid.own is DECLARED (shadows base.own)
print('promotion mutants written')
PY
