# ---- B6, numeric locals (2026-09-30; design note docs/2026-09-30_numeric-locals-design.md D5) ----
# Fixture Tests/wire-boundary-locals/main.go (a shadowed `x`, a capture pointer, a named result and a
# `:=` reuse, a range pair, a type-switch binder) lowered FRESH; one field forged per mutant, each refused
# BY NAME by the decoder's checks c1 (index in range, spelling agreement), c2 (table kinds/spellings, the
# signature's distinct ids), c3 (a reference in scope), c4 (the frontend's resolution and the decoder's
# lexical walk agree), the temporaries' reservation, and the required `locals` table. The positive control
# runs `shadow(2)`: the inner `x` prints 4, the outer `x` returns 2.
GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go run ./tools/nativefrontend --dir Tests/wire-boundary-locals --out "$gate_scratch/locals.json"
python3 - "$gate_scratch" <<'PY'
import json, sys
from pathlib import Path
scratch = Path(sys.argv[1])
base = json.loads((scratch / 'locals.json').read_text('utf-8'))
assert base['schema'] == 'golean-native-v3', base['schema']
def fresh():
    return json.loads(json.dumps(base))
def write(name, data):
    (scratch / f'{name}.json').write_text(json.dumps(data, separators=(',', ':')), 'utf-8')
def func(w, name):
    hits = [f for f in w['funcs'] if f['name'] == name]
    assert len(hits) == 1, (name, len(hits))
    return hits[0]
def find_nodes(v, pred):
    out = []
    if isinstance(v, dict):
        if pred(v): out.append(v)
        for c in v.values(): out += find_nodes(c, pred)
    elif isinstance(v, list):
        for c in v: out += find_nodes(c, pred)
    return out
def idents(w, fn, name):
    return find_nodes(func(w, fn)['body'], lambda n: n.get('expr') == 'ident' and n.get('name') == name)
sh = func(base, 'shadow')
assert [e['name'] for e in sh['locals']] == ['n', 'x', 'x'], sh['locals']          # two objects spelled x
outer_x, inner_x = 1, 2
xs = idents(base, 'shadow', 'x')
assert sorted({n['local'] for n in xs}) == [outer_x, inner_x], xs
assert func(base, 'capture$lit0')['locals'][0]['kind'] == 'capture' and func(base, 'capture$lit0')['locals'][0]['wire'] == 'x$cap'
assert [e['kind'] for e in func(base, 'named')['locals']] == ['param', 'result', 'result']
it = func(base, 'iter')
rng = find_nodes(it['body'], lambda n: n.get('stmt') == 'range')[0]
assert rng['keyLocal'] == 3 and rng['valLocal'] == 4, (rng.get('keyLocal'), rng.get('valLocal'))

write('locals-base', fresh())
# c1: a reference without its index; an index past the table; an index naming another spelling
m = fresh(); del idents(m, 'shadow', 'x')[0]['local']; write('b6-local-missing', m)
m = fresh(); idents(m, 'shadow', 'x')[0]['local'] = 99; write('b6-local-range', m)
m = fresh(); idents(m, 'shadow', 'x')[0]['local'] = 0; write('b6-local-spelling', m)                      # 0 spells n
# c4: the inner x's reference re-pointed at the OUTER declaration (in scope, same spelling, wrong object)
m = fresh()
inner_refs = [n for n in idents(m, 'shadow', 'x') if n['local'] == inner_x]
assert inner_refs, 'no inner reference'
inner_refs[0]['local'] = outer_x; write('b6-local-disagree', m)
# c3: a reference to a declaration that is not in scope (the OUTER x referenced inside `capture`, whose table has no such object: forge the table too)
m = fresh(); cap = func(m, 'capture'); cap['locals'].append({'kind': 'local', 'name': 'q'})
ref = find_nodes(cap['body'], lambda n: n.get('expr') == 'ref' and n.get('id') == 'x')[0]; ref['id'] = 'q'; ref['local'] = len(cap['locals']) - 1; write('b6-local-scope', m)
# the temporaries' reservation: a `$`-spelled node carrying an index; a table entry spelled `$`
m = fresh(); temps = find_nodes(m['funcs'], lambda n: n.get('expr') == 'ident' and str(n.get('name', '')).startswith('$')); assert temps, 'no frontend temporary in the fixture'; temps[0]['local'] = 0; write('b6-temp-indexed', m)
m = fresh(); func(m, 'shadow')['locals'][1]['name'] = '$x'; write('b6-table-dollar', m)
# c2: a wire entry of the decoder's kind; a parameter recorded as a result; the signature binding one id twice; the table absent
m = fresh(); func(m, 'shadow')['locals'][1]['kind'] = 'temp'; write('b6-table-temp', m)
m = fresh(); func(m, 'shadow')['locals'][0]['kind'] = 'result'; write('b6-table-kind', m)
m = fresh(); nm = func(m, 'named'); nm['results'][1]['local'] = nm['results'][0]['local']; nm['results'][1]['id'] = 'r'; write('b6-sig-dup', m)
m = fresh(); del func(m, 'shadow')['locals']; write('b6-table-absent', m)
# ---- fix round (the audit's M1/M6/M13/M14/M16; F1 a/b/c) ----
# M1/M12: the inner `x` DECLARE re-pointed at the OUTER x's id, its references following — entry 2 is then unused (F1 b)
m = fresh()
for n in find_nodes(func(m, 'shadow')['body'], lambda n: (n.get('target') in ('declare', 'var') and n.get('id') == 'x' and n.get('local') == inner_x) or (n.get('expr') == 'ident' and n.get('name') == 'x' and n.get('local') == inner_x)):
    n['local'] = outer_x
write('b6-decl-reuses-outer-id', m)
# M6: a body local's kind forged to recv (F1 c)
m = fresh(); func(m, 'shadow')['locals'][1]['kind'] = 'recv'; write('b6-body-kind-recv', m)
# M13: the identifier behind a `wire` renaming forged (F1 a)
m = fresh(); func(m, 'capture$lit0')['locals'][0]['name'] = 'q'; write('b6-wire-base-mismatch', m)
# M14: `pos` malformed (format only — content is unverifiable at the boundary)
m = fresh(); func(m, 'shadow')['locals'][0]['pos'] = '/abs/main.go:22'; write('b6-pos-malformed', m)
# M16: an unused table entry (F1 b)
m = fresh(); func(m, 'shadow')['locals'].append({'kind': 'local', 'name': 'ghost'}); write('b6-unused-entry', m)
print('B6 mutants written')
PY
run_shadow() { "$GOLEAN" native-json-run --input "$1" --function shadow --arg-int 2 2>&1; }
