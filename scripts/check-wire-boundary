expect_report cr-choices  0 'consulted 1 choice site(s); the observation is the member the stream [31,0] selects of a set' default --function spill --choices 31,0
expect_report cr-exhaust  0 'the member the stream [1] selects of a set — see coverage-observations (the certified set) and choice-trace (the sites) (stream exhausted at consultation #2; the rest drew the canonical 0)' \
  default --function goro --choices 1
expect_report cr-seed     0 'consulted 1 choice site(s); the observation is the member the stream [5] selects of a set' \
  default --function spillSeed --seed "$crd/seed.json" --arg-ref 0 --choices 5
expect_report cr-stop     1 'choice consultations not counted — the run ended with status panic, for which the driver returns no leftover tape' \
  default --function spillPanic
expect_report cr-full     0 "consulted 1 choice site(s) — appendSpill=1 (bound 32); the observation is the canonical member of a set — the certified set is coverage-observations'" \
  full --function spill
expect_report cr-full-plain 0 EMPTY full --function plain
