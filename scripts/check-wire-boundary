# RAND-INTN (window unit 5b, 2026-09-30; design docs/2026-09-30_intn-pick-design.md D2/D3): the `[0, n)` draw's
# wire node `{"expr":"rand-intn","callee":<Intn|IntN>,"n":<expr>,"resultTypes":[int]}` — the decoder expands it into
# upstream's guard + `Stmt.randIntn` (`asRandIntnOp?` / `expandRandIntn`, GoLean/NativeToIR.lean). Fixture
# Tests/wire-boundary-randintn/main.go (`probe` answers 42 through a bound-1 draw — the one member, no pop). Four
# one-edit mutants of the node's BYTES must refuse through the real CLI naming the cause: a forged callee tag (the
# closed callee table), a non-int result type, an absent resultTypes vector, and a two-target assignment.
GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go run ./tools/nativefrontend --dir Tests/wire-boundary-randintn --out "$gate_scratch/ri.json"
python3 - "$gate_scratch" <<'PY'
import json, sys
from pathlib import Path
scratch = Path(sys.argv[1])
base = json.loads((scratch / 'ri.json').read_text('utf-8'))
def fresh():
    return json.loads(json.dumps(base))
def write(name, data):
    (scratch / f'{name}.json').write_text(json.dumps(data, separators=(',', ':')), 'utf-8')
def find_assign(w):
    hits = []
    def walk(v):
        if isinstance(v, dict):
            if v.get('stmt') == 'assign' and isinstance(v.get('rhs'), list) and len(v['rhs']) == 1 \
               and isinstance(v['rhs'][0], dict) and v['rhs'][0].get('expr') == 'rand-intn':
                hits.append(v)
            for c in v.values(): walk(c)
        elif isinstance(v, list):
            for c in v: walk(c)
    walk(w)
    assert len(hits) == 1, f'fixture carries {len(hits)} rand-intn assignments, expected 1'
    return hits[0]
node = find_assign(base)['rhs'][0]
assert node['callee'] == 'Intn' and node['resultTypes'] == [{'int': 'int', 'kind': 'int'}], node
m = fresh(); find_assign(m)['rhs'][0]['callee'] = 'IntZ'; write('ri-bad-callee', m)
m = fresh(); find_assign(m)['rhs'][0]['resultTypes'] = [{'kind': 'bool'}]; write('ri-result-not-int', m)
m = fresh(); del find_assign(m)['rhs'][0]['resultTypes']; write('ri-absent-resultTypes', m)
m = fresh(); a = find_assign(m); a['lhs'] = a['lhs'] + [{'target': 'blank'}]; write('ri-two-targets', m)
print('rand-intn mutants written')
PY
expect_42 ri
expect_refusal ri-bad-callee          'unsupported rand-intn callee' 'IntZ'
expect_refusal ri-result-not-int      'rand-intn result type is not int'
expect_refusal ri-absent-resultTypes  'resultTypes'
expect_refusal ri-two-targets         'rand-intn assigned to 2 targets'
# THE `type` KEY (release-readiness punch list item 2, 2026-10-12): an expression node's `type` is REQUIRED where the
# decoder declares a temporary from it — the blank assignment's discard temporary (`_ = n + 1`, the rhs node) and the
# range's collection temporary (`for range s`, the collection node) — and never reconstructed (`exprTypeOf`,
# GoLean/NativeToIR.lean; before, an absent key declared the temporary `int`). Fixture Tests/wire-boundary-exprtype/main.go
# (`probe` answers 42 through both). Two one-edit mutants delete the key from each node's BYTES and must refuse through
# the real CLI naming the node kind and its position; a third deletes it from a node NO temporary is typed from (the
# binary's left operand) and must still RUN — the key is demanded where it is read, not everywhere.
GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go run ./tools/nativefrontend --dir Tests/wire-boundary-exprtype --out "$gate_scratch/et.json"
python3 - "$gate_scratch" <<'PY'
import json, sys
from pathlib import Path
scratch = Path(sys.argv[1])
base = json.loads((scratch / 'et.json').read_text('utf-8'))
def fresh():
    return json.loads(json.dumps(base))
def write(name, data):
    (scratch / f'{name}.json').write_text(json.dumps(data, separators=(',', ':')), 'utf-8')
def find_one(w, pred, what):
    hits = []
    def walk(v):
        if isinstance(v, dict):
            if pred(v): hits.append(v)
            for c in v.values(): walk(c)
        elif isinstance(v, list):
            for c in v: walk(c)
    walk(w)
    assert len(hits) == 1, f'fixture carries {len(hits)} {what}, expected 1'
    return hits[0]
def blank_rhs(w):
    a = find_one(w, lambda v: v.get('stmt') == 'assign' and isinstance(v.get('lhs'), list)
                 and len(v['lhs']) == 1 and v['lhs'][0].get('target') == 'blank', 'blank assignments')
    return a['rhs'][0]
def range_coll(w):
    return find_one(w, lambda v: v.get('stmt') == 'range', 'range statements')['collection']
assert blank_rhs(base)['expr'] == 'binary' and blank_rhs(base)['type'] == {'int': 'int', 'kind': 'int'}, blank_rhs(base)
assert range_coll(base)['expr'] == 'ident' and range_coll(base)['type']['kind'] == 'slice', range_coll(base)
m = fresh(); del blank_rhs(m)['type']; write('et-blank-no-type', m)
m = fresh(); del range_coll(m)['type']; write('et-range-no-type', m)
m = fresh(); del blank_rhs(m)['x']['type']; write('et-operand-no-type', m)
print('type-key mutants written')
PY
expect_42 et
expect_42 et-operand-no-type
expect_refusal et-blank-no-type  'expression node `binary`' 'rhs[0]' 'carries no `type`' 'never reconstructed'
expect_refusal et-range-no-type  'expression node `ident`' '.collection' 'carries no `type`' 'never reconstructed'
# ENTRY ARGUMENTS (`--arg-bool`, 2026-10-07; [USER] Mike agreed, relayed — gc-verified's request): `--arg-int` and
# `--arg-bool` interleave and bind the entry's parameters POSITIONALLY, each checked against its parameter's type at
# the CLI (`entryArgValues`, GoLean/CLI.lean) before any step. Fixture Tests/wire-boundary-argbool/main.go
# (`pick(n int, b bool, f Flag, s Small)`, Flag/Small declared over bool/uint8). Two mixed positive calls (both bool
# orders, so a swapped binding cannot pass), then refusals by name: --arg-bool at an int parameter, --arg-int at a
# bool parameter and at a DECLARED-bool parameter (once a later `stuck`, or nothing), an out-of-range --arg-int at a
# declared uint8 (once a silent wrap), an arity mismatch (exit 1, JSON refusal), and a malformed bool literal (a
# parse-time usage refusal, exit 2 — `--arg-int`'s malformed-literal exit code); a quarantined entry's stub parameter is
# deferred to the machine's `unsupported` refusal (both flags).
GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go run ./tools/nativefrontend --dir Tests/wire-boundary-argbool --out "$gate_scratch/ab.json"
run_pick() { "$GOLEAN" native-json-run --input "$gate_scratch/ab.json" --function pick "$@" 2>&1; }
expect_pick() {  # name expected-value args...
  local name="$1" want="$2" out rc=0; shift 2
  out="$(run_pick "$@")" || rc=$?
  if [[ $rc -ne 0 || "$out" != *'"status":"ok"'* || "$out" != *"\"value\":$want}"* ]]; then
    echo "check-wire-boundary: FAIL [$name] — expected pick($*) to answer $want (exit $rc): $out" >&2; exit 1
  fi
  echo "ok [$name] pick $* answers $want"
}
expect_pick_refusal() {  # name exit-code args... -- cause-fragment...
  local name="$1" want_rc="$2" out rc=0 cause; shift 2
  local args=()
  while [[ "$1" != -- ]]; do args+=("$1"); shift; done; shift
  out="$(run_pick "${args[@]}")" || rc=$?
  if [[ $rc -ne $want_rc ]]; then
    echo "check-wire-boundary: FAIL [$name] — exit $rc, expected the refusal code $want_rc: $out" >&2; exit 1
  fi
  for cause in "$@"; do
    if [[ "$out" != *"$cause"* ]]; then
      echo "check-wire-boundary: FAIL [$name] — refused, but the refusal does not name '$cause': $out" >&2; exit 1
    fi
  done
  echo "ok [$name] refused (exit $rc), naming: $*"
}
expect_pick arg-mixed-tf   103  --arg-int 1 --arg-bool true --arg-bool false --arg-int 2
expect_pick arg-mixed-ft   1003 --arg-int 1 --arg-bool false --arg-bool true --arg-int 2
expect_pick_refusal arg-bool-at-int    1 --arg-bool true --arg-bool true --arg-bool false --arg-int 2 -- \
  '--arg-bool (argument 1)' 'parameter n' 'has type int'
expect_pick_refusal arg-int-at-bool    1 --arg-int 1 --arg-int 1 --arg-bool false --arg-int 2 -- \
  '--arg-int (argument 2)' 'parameter b' 'has type bool'
expect_pick_refusal arg-int-at-flag    1 --arg-int 1 --arg-bool true --arg-int 0 --arg-int 2 -- \
  '--arg-int (argument 3)' 'parameter f' 'has type Flag'
expect_pick_refusal arg-int-range      1 --arg-int 1 --arg-bool true --arg-bool false --arg-int 256 -- \
  '--arg-int (argument 4)' '256 is out of range' 'parameter s' 'Small (uint8)'
expect_pick_refusal arg-arity          1 --arg-int 1 --arg-bool true --arg-bool false -- \
  'takes 4 parameter(s), got 3'
expect_pick_refusal arg-bool-malformed 2 --arg-int 1 --arg-bool yes --arg-bool false --arg-int 2 -- \
  '--arg-bool: not a bool literal' 'yes'
# A frontend-quarantined entry's stub parameter: the CLI defers, the machine refuses as `unsupported` naming the
# quarantine (the refusal keeps its class — the harness stages it frontend-export, as before the check existed).
for qarg in '--arg-int 1' '--arg-bool true'; do
  out="$("$GOLEAN" native-json-run --input "$gate_scratch/ab.json" --function quarantined $qarg 2>&1)" && {
    echo "check-wire-boundary: FAIL [arg-quarantined $qarg] — the quarantined entry RAN: $out" >&2; exit 1; }
  if [[ "$out" != *'"status":"unsupported"'* || "$out" != *'frontend-quarantined'* ]]; then
    echo "check-wire-boundary: FAIL [arg-quarantined $qarg] — expected the machine's unsupported refusal naming the quarantine: $out" >&2; exit 1
  fi
  echo "ok [arg-quarantined $qarg] deferred to the machine: unsupported, naming the quarantine"
done
# BUG-119 (2026-10-08): the ENUMERATOR subcommands (`coverage-observations`, `choice-trace`) pass their entry
# arguments through the same `entryArgValues` check as `native-json-run` — the same command lines refuse with the
# same causes (exit 1; their refusals print on stderr, their stdout is the observation set / trace table) — and take
# `--arg-bool` in the same positional order (the mixed call answers 103 on both). Before the fix an out-of-range
# `--arg-int` wrapped silently (256 at a uint8 parameter was 0) and an `--arg-int` at a bool parameter reached the
# machine unchecked.
run_enum() {  # subcommand args... (the enumerator's cheapest bound: one pick per site)
  local sub="$1"; shift
  case "$sub" in
    coverage-observations) "$GOLEAN" coverage-observations --input "$gate_scratch/ab.json" --function pick --max-width 1 "$@" 2>&1 ;;
    choice-trace) "$GOLEAN" choice-trace --input "$gate_scratch/ab.json" --function pick "$@" 2>&1 ;;
  esac
}
for sub in coverage-observations choice-trace; do
  out="$(run_enum "$sub" --arg-int 1 --arg-bool true --arg-bool false --arg-int 2)" || {
    echo "check-wire-boundary: FAIL [$sub arg-mixed] — the mixed positional call did not run (exit $?): $out" >&2; exit 1; }
  if [[ "$sub" == coverage-observations && "$out" != *'"value":103}'* ]] \
     || [[ "$sub" == choice-trace && "$out" != *$'\tdefault\tok\t'* ]]; then
    echo "check-wire-boundary: FAIL [$sub arg-mixed] — expected pick(1, true, false, 2) to answer (103 / an ok trace): $out" >&2; exit 1
  fi
  echo "ok [$sub arg-mixed] pick --arg-int 1 --arg-bool true --arg-bool false --arg-int 2 answers"
  for control in \
      'arg-int-range|--arg-int 1 --arg-bool true --arg-bool false --arg-int 256|--arg-int (argument 4)|256 is out of range|parameter s|Small (uint8)' \
      'arg-int-at-bool|--arg-int 1 --arg-int 1 --arg-bool false --arg-int 2|--arg-int (argument 2)|parameter b|has type bool' \
      'arg-int-at-flag|--arg-int 1 --arg-bool true --arg-int 0 --arg-int 2|--arg-int (argument 3)|parameter f|has type Flag' \
      'arg-bool-at-int|--arg-bool true --arg-bool true --arg-bool false --arg-int 2|--arg-bool (argument 1)|parameter n|has type int' \
      'arg-arity|--arg-int 1 --arg-bool true --arg-bool false|takes 4 parameter(s), got 3'; do
    IFS='|' read -r -a parts <<< "$control"
    name="${parts[0]}"; read -r -a cargs <<< "${parts[1]}"
    rc=0; out="$(run_enum "$sub" "${cargs[@]}")" || rc=$?
    if [[ $rc -ne 1 ]]; then
      echo "check-wire-boundary: FAIL [$sub $name] — exit $rc, expected the refusal code 1: $out" >&2; exit 1
    fi
    for cause in "${parts[@]:2}"; do
      if [[ "$out" != *"$cause"* ]]; then
        echo "check-wire-boundary: FAIL [$sub $name] — refused, but the refusal does not name '$cause': $out" >&2; exit 1
      fi
    done
    echo "ok [$sub $name] refused (exit 1), naming: ${parts[*]:2}"
  done
done
# Release-readiness item 27 (review F3, 2026-10-12): `--engine dedup` reads only `--work-cap` and `--expect-status`.
# The DFS's `--fuel`/`--max-width`/`--max-sites`/`--cap`/`--backedge` were accepted and silently ignored on that
# path; now each is refused by name (exit 2, a usage error — the certificate is about the whole state graph, not a
# budgeted exploration). Positive control: the bare dedup call certifies pick(1, true, false, 2) = 103.
rc=0; out="$("$GOLEAN" coverage-observations --input "$gate_scratch/ab.json" --function pick --engine dedup \
  --arg-int 1 --arg-bool true --arg-bool false --arg-int 2 2>&1)" || rc=$?
if [[ $rc -ne 0 || "$out" != *'"value":103}'* || "$out" != *'engine=dedup'*'certified=checkCert'* ]]; then
  echo "check-wire-boundary: FAIL [dedup positive] — the bare --engine dedup call did not certify 103 (exit $rc): $out" >&2; exit 1
fi
echo "ok [dedup positive] --engine dedup certifies pick(1, true, false, 2) = 103"
for control in \
    'dedup-fuel|--fuel 1000|--fuel' \
    'dedup-max-width|--max-width 1|--max-width' \
    'dedup-max-sites|--max-sites 8|--max-sites' \
    'dedup-cap|--cap 64|--cap' \
    'dedup-backedge|--backedge full|--backedge' \
    'dedup-two-flags|--max-width 1 --cap 64|--max-width, --cap'; do
  IFS='|' read -r -a parts <<< "$control"
  name="${parts[0]}"; read -r -a cargs <<< "${parts[1]}"
  rc=0; out="$("$GOLEAN" coverage-observations --input "$gate_scratch/ab.json" --function pick --engine dedup \
    "${cargs[@]}" --arg-int 1 --arg-bool true --arg-bool false --arg-int 2 2>&1)" || rc=$?
  if [[ $rc -ne 2 || "$out" != *'--engine dedup reads only --work-cap'* || "$out" != *"${parts[2]} given"* ]]; then
    echo "check-wire-boundary: FAIL [$name] — expected exit 2 naming '${parts[2]}' as refused under --engine dedup (exit $rc): $out" >&2; exit 1
  fi
  echo "ok [$name] refused (exit 2), naming ${parts[2]}"
done
# The runtime lane's adversarial review (2026-10-12, MEDIUM): a readout the seam refuses (BUG-099's recovered runtime
# error observed as `any`) is the ENUMERATION's refusal on both engines — exit 1, «cannot certify the observation set»,
# naming BUG-099 — never a member printed under exit 0 (before: without --expect-status the DFS recorded it as a leaf
# and the dedup path listed it beside certified=checkCert). Positive control: `plain` certifies {7} on both engines.
# Fixture Tests/wire-boundary-readout/main.go.
GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go run ./tools/nativefrontend --dir Tests/wire-boundary-readout --out "$gate_scratch/readout.json"
for eng in dfs dedup; do
  eargs=(); [[ "$eng" == dedup ]] && eargs=(--engine dedup)
  rc=0; out="$("$GOLEAN" coverage-observations --input "$gate_scratch/readout.json" --function plain ${eargs[@]+"${eargs[@]}"} 2>&1)" || rc=$?
  if [[ $rc -ne 0 || "$out" != *'"value":7}'* ]]; then
    echo "check-wire-boundary: FAIL [readout positive $eng] — plain did not certify 7 (exit $rc): $out" >&2; exit 1
  fi
  echo "ok [readout positive $eng] plain certifies 7"
  rc=0; out="$("$GOLEAN" coverage-observations --input "$gate_scratch/readout.json" --function recoveredAsAny ${eargs[@]+"${eargs[@]}"} 2>&1)" || rc=$?
  if [[ $rc -ne 1 || "$out" != *'cannot certify the observation set'* || "$out" != *'BUG-099'* || "$out" == *'"status":"unsupported"'* ]]; then
    echo "check-wire-boundary: FAIL [readout refusal $eng] — expected exit 1 and the enumeration's refusal naming BUG-099, no member line (exit $rc): $out" >&2; exit 1
  fi
  echo "ok [readout refusal $eng] the BUG-099 readout is the enumeration's refusal (exit 1), no member printed"
done
# Release-readiness item 22 (2026-10-12; [USER] Mike (item 22: fix), relayed; the decisions [AGENT]). (b) A func-typed
# position, static or dynamic, has no observation: `retFunc`/`retBoxed`/`retAny` (bare, a struct field, an interface box)
# and the NIL shapes `retNilFunc`/`retNamedFuncNilBare`/`retNamedFuncNilBoxed`/`retNilFuncInStruct`/`retNilFuncInArray`
# (fixture Tests/wire-boundary-readout/main.go; the pre-merge review's MEDIUM-1/2) refuse BY NAME at the readout —
# `native-json-run` exit 1, status `unsupported`, never a `func` tag, and the refusal decodes through observation-eq —
# on the enumerator (exit 1, «cannot certify the observation set») and on the tracer (status `unsupported`, the drivers
# agreeing); the Go observer refuses the same results by name (`reflect.Func`, the generated harness under the pinned
# `go run`).
# Positive control: `plain` answers 7 and decodes.
rc=0; out="$("$GOLEAN" native-json-run --input "$gate_scratch/readout.json" --function plain 2>&1)" || rc=$?
if [[ $rc -ne 0 || "$out" != *'"value":7}'* ]] || ! "$GOLEAN" observation-eq --left "$out" --right "$out"; then
  echo "check-wire-boundary: FAIL [func positive] — plain did not answer a decodable 7 (exit $rc): $out" >&2; exit 1
fi
echo "ok [func positive] plain answers 7 and decodes"
for fn in retFunc retBoxed retAny retNilFunc retNamedFuncNilBare retNamedFuncNilBoxed retNilFuncInStruct retNilFuncInArray; do
  rc=0; out="$("$GOLEAN" native-json-run --input "$gate_scratch/readout.json" --function "$fn" 2>&1)" || rc=$?
  if [[ $rc -ne 1 || "$out" != *'"status":"unsupported"'* || "$out" != *'a Go func value has no observable identity'* \
        || "$out" == *'"tag":"func"'* ]]; then
    echo "check-wire-boundary: FAIL [func refusal $fn] — expected exit 1 and the readout's func refusal by name, no func tag (exit $rc): $out" >&2; exit 1
  fi
  "$GOLEAN" observation-eq --left "$out" --right "$out" || {
    echo "check-wire-boundary: FAIL [func refusal $fn] — observation-eq did not decode the refusal: $out" >&2; exit 1; }
  rc=0; out="$("$GOLEAN" coverage-observations --input "$gate_scratch/readout.json" --function "$fn" 2>&1)" || rc=$?
  if [[ $rc -ne 1 || "$out" != *'cannot certify the observation set'* || "$out" != *'a Go func value has no observable identity'* ]]; then
    echo "check-wire-boundary: FAIL [func refusal $fn enumerator] — expected exit 1 and the enumeration's func refusal by name (exit $rc): $out" >&2; exit 1
  fi
  rc=0; out="$("$GOLEAN" choice-trace --input "$gate_scratch/readout.json" --function "$fn" 2>&1)" || rc=$?
  if [[ $rc -ne 0 || "$(printf '%s\n' "$out" | awk -F'\t' 'NR > 1 && $3 == "unsupported" && $NF == "ok"' | wc -l)" -ne 1 ]]; then
    echo "check-wire-boundary: FAIL [func refusal $fn tracer] — expected the traced status unsupported with driverAgreement ok (exit $rc): $out" >&2; exit 1
  fi
  echo "ok [func refusal $fn] refused by name on native-json-run (decodable), the enumerator and the tracer"
done
GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off go build -o "$gate_scratch/coverageharness" ./tools/coverageharness
