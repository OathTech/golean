    GODEBUG=panicnil=0 go run . 2>/dev/null)" || rc=$?
  if [[ $rc -ne 0 || "$out" != *'"status":"error"'* || "$out" != *'unsupported Go observation kind func (a Go func value has no observable identity'* ]]; then
    echo "check-wire-boundary: FAIL [func refusal go-observer $fn] — expected the Go observer's func refusal by name (exit $rc): $out" >&2; exit 1
  fi
  echo "ok [func refusal go-observer $fn] the Go observer refuses the func-typed result by name"
done
# (a) The CLI-level `status:error` observation carries `output` (empty: no step ran) and decodes through
# observation-eq — an unreadable input, an entry-argument refusal, a seed-file refusal.
for control in \
    "missing-input|native-json-run --input $gate_scratch/no-such-wire.json --function probe" \
    "arg-arity|native-json-run --input $gate_scratch/ab.json --function pick --arg-int 1" \
    "seed-file|native-json-run --input $gate_scratch/readout.json --function plain --seed $gate_scratch/no-such-seed.json"; do
  name="${control%%|*}"; read -r -a cargs <<< "${control#*|}"
  rc=0; out="$("$GOLEAN" "${cargs[@]}" 2>/dev/null)" || rc=$?
  if [[ $rc -ne 1 || "$out" != *'"status":"error"'* || "$out" != *'"output":""'* ]]; then
    echo "check-wire-boundary: FAIL [cli-error $name] — expected exit 1 and a status:error observation with an empty output (exit $rc): $out" >&2; exit 1
  fi
  "$GOLEAN" observation-eq --left "$out" --right "$out" || {
    echo "check-wire-boundary: FAIL [cli-error $name] — observation-eq did not decode the CLI-level error observation: $out" >&2; exit 1; }
  echo "ok [cli-error $name] the status:error observation carries output and decodes"
done
# BUG-120 (2026-10-08): a MISSING input file is a named refusal on every subcommand that reads one — never an
# uncaught IO exception. native-json-run: a status:error JSON naming the path; the enumerators: their stderr line;
# choice-trace --batch: its manifest. Each must exit 1 and name the path and the cause.
missing="$gate_scratch/no-such-wire.json"
[[ ! -e "$missing" ]] || { echo "check-wire-boundary: FAIL [missing-input] — $missing exists" >&2; exit 1; }
for sub in native-json-run coverage-observations choice-trace; do
  rc=0; out="$("$GOLEAN" "$sub" --input "$missing" --function probe 2>&1)" || rc=$?
  if [[ $rc -ne 1 || "$out" != *"$missing: cannot read input"* || "$out" == *'uncaught'* ]]; then
    echo "check-wire-boundary: FAIL [$sub missing-input] — expected exit 1 and a refusal naming the path (exit $rc): $out" >&2; exit 1
  fi
  if [[ "$sub" == native-json-run && "$out" != *'"status":"error"'* ]]; then
    echo "check-wire-boundary: FAIL [$sub missing-input] — the refusal is not a status:error JSON: $out" >&2; exit 1
  fi
  echo "ok [$sub missing-input] refused (exit 1), naming the path"
done
rc=0; out="$("$GOLEAN" choice-trace --batch "$gate_scratch/no-such-manifest.tsv" --out "$gate_scratch/batch-out.tsv" 2>&1)" || rc=$?
if [[ $rc -ne 1 || "$out" != *"no-such-manifest.tsv: cannot read input"* || -e "$gate_scratch/batch-out.tsv" ]]; then
  echo "check-wire-boundary: FAIL [choice-trace missing-manifest] — expected exit 1, a refusal naming the manifest, and no results file (exit $rc): $out" >&2; exit 1
fi
echo "ok [choice-trace missing-manifest] refused (exit 1), naming the path"
# A batch case whose wire is missing is that case's named ERROR line, the batch continuing.
printf 'missing-wire\t%s\tprobe\t-\tdefault\n' "$missing" > "$gate_scratch/batch.tsv"
rc=0; out="$("$GOLEAN" choice-trace --batch "$gate_scratch/batch.tsv" --out "$gate_scratch/batch-out.tsv" 2>&1)" || rc=$?
