run_seed() { "$GOLEAN" native-json-run --input "$gate_scratch/seedw.json" "$@" 2>&1; }
expect_seed() {  # name args... -- fragment...   (exit 0, status ok, every fragment present)
  local name="$1" out rc=0 frag; shift
  local args=()
  while [[ "$1" != -- ]]; do args+=("$1"); shift; done; shift
  out="$(run_seed "${args[@]}")" || rc=$?
  if [[ $rc -ne 0 || "$out" != *'"status":"ok"'* ]]; then
    echo "check-wire-boundary: FAIL [$name] — expected the seeded run to answer ok (exit $rc): $out" >&2; exit 1
  fi
  for frag in "$@"; do
    if [[ "$out" != *"$frag"* ]]; then
      echo "check-wire-boundary: FAIL [$name] — the seeded observation lacks '$frag': $out" >&2; exit 1
    fi
  done
  echo "ok [$name] answers, observing: $*"
}
expect_seed_refusal() {  # name exit-code args... -- fragment...
  local name="$1" want_rc="$2" out rc=0 frag; shift 2
  local args=()
  while [[ "$1" != -- ]]; do args+=("$1"); shift; done; shift
  out="$(run_seed "${args[@]}")" || rc=$?
  if [[ $rc -ne $want_rc ]]; then
    echo "check-wire-boundary: FAIL [$name] — exit $rc, expected the refusal code $want_rc: $out" >&2; exit 1
  fi
  for frag in "$@"; do
    if [[ "$out" != *"$frag"* ]]; then
      echo "check-wire-boundary: FAIL [$name] — refused, but the refusal does not name '$frag': $out" >&2; exit 1
    fi
  done
  echo "ok [$name] refused (exit $rc), naming: $*"
}
