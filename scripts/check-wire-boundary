#!/usr/bin/env bash
# check-wire-boundary — the production wire decoder's BYTE-input controls,
# driven through the REAL CLI binary (BUG-110; whole-project review
# 2026-09-11 F3 = 2026-09-05 gate audit F9; lane fix/review-boundary-0911,
# [AGENT]). A test on an already-parsed `Json` value does not count here:
# the defect was that `Lean.Json.parse` collapsed duplicate object keys and
# substituted U+FFFD for malformed surrogate escapes BEFORE any validator
# ran, and that `resultTypes[i]?.getD .int` reconstructed a discard temp's
# type when the vector was absent. So every control below is a MUTATION OF
# THE WIRE'S BYTES, fed to `golean native-json-run --input <file>` exactly
# as scripts/diff-coverage feeds a corpus wire.
#
#   positive control     the fresh wire runs and answers 42
#   dup-schema           a forged leading `"schema"` duplicate → refused, cause named
#   dup-deep-key         a duplicate key inside a call node → refused
#   absent-resultTypes   the discard call's `resultTypes` vector removed → refused, `resultTypes` named
#   arity-resultTypes    a 2-entry vector on a 1-target discard call → refused, arity named
#   absent-buildContext  the file-selection target removed → refused (BUG-108's decoder pin)
#   high-surrogate       an unpaired \uD800 in an UNREAD string field → refused
#   low-surrogate        an unpaired \uDC00 likewise → refused
#   invalid-utf8         a raw 0xFF byte inside a string → refused
#   paired-surrogate     a VALID surrogate pair in an unread field → accepted (the parser is strict, not over-strict)
#   over-depth           `buildTags` wrapped in 1100 nested arrays → refused by the wire nesting bound (1024)
#
# Fixture: Tests/wire-boundary/main.go (the review's discard-call probe).
# Fail closed: a missing binary, a failed emit, a control that runs where
# it must refuse, a refusal that does not name its cause, or a positive
# control that does not answer 42 all exit 1 naming the control.
set -uo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
[[ $# = 0 ]] || { echo 'check-wire-boundary: expected no arguments' >&2; exit 2; }
. "$ROOT/scripts/typed-gate-scratch.sh"
set -e
GOLEAN=".lake/build/bin/golean"
scripts/capped lake build golean > /dev/null
[[ -x "$GOLEAN" ]] || { echo "check-wire-boundary: no $GOLEAN (fail closed)" >&2; exit 1; }
GOCACHE="$ROOT/artifacts/go-build-cache" GO111MODULE=off \
  go run ./tools/nativefrontend --dir Tests/wire-boundary --out "$gate_scratch/program.json"
python3 - "$gate_scratch" <<'PY'
import json, sys
from pathlib import Path
scratch = Path(sys.argv[1])
raw = (scratch / 'program.json').read_bytes()
text = raw.decode('utf-8')
base = json.loads(text)
compact = json.dumps(base, separators=(',', ':'))

def write(name, data):
    (scratch / f'{name}.json').write_bytes(data if isinstance(data, bytes) else data.encode('utf-8'))

# The discard call `_ = val()`: the ONE assign statement whose lhs is a blank
# target and whose rhs is a single call node carrying resultTypes.
def find_discard_call(v):
    if isinstance(v, dict):
        if v.get('stmt') == 'assign' and isinstance(v.get('lhs'), list) and len(v['lhs']) == 1 \
           and isinstance(v.get('rhs'), list) and len(v['rhs']) == 1 \
           and isinstance(v['rhs'][0], dict) and v['rhs'][0].get('expr') == 'call' \
           and 'resultTypes' in v['rhs'][0] and v['lhs'][0].get('target') == 'blank':
            return v['rhs'][0]
        for c in v.values():
            r = find_discard_call(c)
            if r is not None: return r
    elif isinstance(v, list):
        for c in v:
            r = find_discard_call(c)
            if r is not None: return r
    return None

assert compact.count('"schema":"golean-native-v1"') == 1
assert '"package":"main"' in compact, 'fixture wire has no package field to mutate'
assert 'buildContext' in base, 'fixture wire has no buildContext (BUG-108 record)'

# dup-schema: a forged leading duplicate of the top-level schema key
write('dup-schema', '{"schema":"forged-schema",' + compact[1:])

# dup-deep-key: duplicate the `expr` key inside the first call node
m = json.loads(compact); call = find_discard_call(m)
assert call is not None, 'fixture wire has no `_ = call()` statement'
call_text = json.dumps(call, separators=(',', ':'))
assert compact.count(call_text) == 1, 'discard call node text is not unique in the wire'
write('dup-deep-key', compact.replace(call_text, '{"expr":"call",' + call_text[1:], 1))

# absent-resultTypes: remove the vector from the discard call only
m = json.loads(compact); call = find_discard_call(m); del call['resultTypes']
write('absent-resultTypes', json.dumps(m, separators=(',', ':')))

# arity-resultTypes: two result types on a one-target discard call
m = json.loads(compact); call = find_discard_call(m); call['resultTypes'] = call['resultTypes'] * 2
write('arity-resultTypes', json.dumps(m, separators=(',', ':')))

# absent-buildContext
m = json.loads(compact); del m['buildContext']
write('absent-buildContext', json.dumps(m, separators=(',', ':')))

# surrogates in the UNREAD `package` field (the decoder deliberately does not read it —
# so only the byte parser can refuse these)
write('high-surrogate', compact.replace('"package":"main"', '"package":"ma\\ud800in"', 1))
write('low-surrogate', compact.replace('"package":"main"', '"package":"ma\\udc00in"', 1))
write('paired-surrogate', compact.replace('"package":"main"', '"package":"ma\\ud83d\\ude00in"', 1))
write('invalid-utf8', compact.replace('"package":"main"', '"package":"ma\xff"', 1).encode('utf-8', 'surrogateescape').replace(b'\xc3\xbf', b'\xff'))
raw_bytes = (scratch / 'invalid-utf8.json').read_bytes()
# over-depth: 1100 nested arrays inside an otherwise valid wire — beyond the wire bound (1024)
write('over-depth', compact.replace('"buildTags":[]', '"buildTags":' + '[' * 1100 + ']' * 1100, 1))
assert b'\xff' in raw_bytes and raw_bytes.count(b'\xff') == 1, 'invalid-utf8 mutant lost its raw byte'
print('mutants written')
PY

run_cli() { "$GOLEAN" native-json-run --input "$1" --function probe 2>&1; }
expect_refusal() {  # name cause-fragment... (every fragment must appear in the CLI's message;
                    # the message travels JSON-encoded, so quoted keys arrive as \"key\" — match
                    # the words and the key separately, never a literal quote)
  local name="$1" out rc=0 cause; shift
  out="$(run_cli "$gate_scratch/$name.json")" || rc=$?
  if [[ $rc -eq 0 ]]; then
    echo "check-wire-boundary: FAIL [$name] — the mutated wire RAN (exit 0): $out" >&2; exit 1
  fi
  if [[ $rc -ne 1 ]]; then
    echo "check-wire-boundary: FAIL [$name] — exit $rc is not the CLI's refusal code 1 (did not decide): $out" >&2; exit 1
  fi
  for cause in "$@"; do
    if [[ "$out" != *"$cause"* ]]; then
      echo "check-wire-boundary: FAIL [$name] — refused, but the refusal does not name '$cause': $out" >&2; exit 1
    fi
  done
  echo "ok [$name] refused, naming: $*"
}
expect_42() {
  local name="$1" out rc=0
  out="$(run_cli "$gate_scratch/$name.json")" || rc=$?
  if [[ $rc -ne 0 || "$out" != *'"status":"ok"'* || "$out" != *'"value":42'* ]]; then
    echo "check-wire-boundary: FAIL [$name] — expected the positive control to answer 42 (exit $rc): $out" >&2; exit 1
  fi
  echo "ok [$name] runs, answers 42"
}
expect_42 program
expect_42 paired-surrogate
expect_refusal dup-schema         'JSON parse error' 'duplicate JSON object key' 'schema'
expect_refusal dup-deep-key       'JSON parse error' 'duplicate JSON object key' 'expr'
expect_refusal absent-resultTypes "missing field 'resultTypes'"
expect_refusal arity-resultTypes  'resultTypes arity 2 does not match the 1 target(s)' 'BUG-110'
expect_refusal absent-buildContext 'program.buildContext is missing' 'BUG-108'
expect_refusal high-surrogate     'JSON parse error' 'unpaired high surrogate'
expect_refusal low-surrogate      'JSON parse error' 'unpaired low surrogate'
expect_refusal invalid-utf8       'JSON parse error' 'not valid UTF-8'
expect_refusal over-depth         'JSON parse error' 'JSON nesting deeper than'

# THE `unseq` NODE (evaluation-order model v2.1 Stage C, 2026-09-19; design
# docs/2026-09-19_unseq-stage-c-design.md §5): the hand-built W1 wire
# (Tests/unseq-wire/w1.json, build.py) is the positive control — on the canonical
# tape the sweep runs mut first and answers 2 — and six one-edit mutants of the
# `unseq` node must refuse through the same CLI path naming the decoder's cause:
# a duplicate binder, a cycle (a forward reference in the rank order), a use of a
# skipped-branch value without a join, a sort mismatch (a load through a VALUE
# cell), a binder without the `$` reservation, an unknown slot. The Stage C audit
# fix round (2026-09-20) added two controls: the CONSTANT-HEAD positive (audit F2 —
# Tests/unseq-wire/cguard.json, `ok := true && f()`: the frontend's copy of a
# constant into a cell, which the C1 decoder refused by name; it must run and
# answer 2) and the NESTED-COMPLETION refusal (audit F3 — a nested guard's
# completion binder consumed outside its enclosing region, refused STATICALLY as
# an invalid branch join). The full mutant list (19) and the exact-set checks are
# scripts/check-unseq-wire's.
run_cli_fn() { "$GOLEAN" native-json-run --input "$1" --function "$2" 2>&1; }
out="$(run_cli_fn Tests/unseq-wire/w1.json w1)" || { echo "check-wire-boundary: FAIL [unseq w1] — the hand-built wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":2'* ]] || { echo "check-wire-boundary: FAIL [unseq w1] — expected ok/2 on the canonical tape: $out" >&2; exit 1; }
echo "ok [unseq w1] runs, answers 2 (canonical tape: mut first)"
expect_unseq_refusal() {  # name file-stem fn cause...
  local name="$1" stem="$2" fn="$3" out rc=0 cause; shift 3
  out="$(run_cli_fn "Tests/unseq-wire/$stem.json" "$fn")" || rc=$?
  if [[ $rc -eq 0 ]]; then echo "check-wire-boundary: FAIL [$name] — the mutated unseq wire RAN (exit 0): $out" >&2; exit 1; fi
  if [[ $rc -ne 1 ]]; then echo "check-wire-boundary: FAIL [$name] — exit $rc is not the CLI's refusal code 1 (did not decide): $out" >&2; exit 1; fi
  for cause in "$@"; do
    if [[ "$out" != *"$cause"* ]]; then echo "check-wire-boundary: FAIL [$name] — refused, but the refusal does not name '$cause': $out" >&2; exit 1; fi
  done
  echo "ok [$name] refused, naming: $*"
}
expect_unseq_refusal unseq-dup-binder    mut-dup-binder    w1      'duplicate result'
expect_unseq_refusal unseq-cycle         mut-cycle         w1      'not a linear extension'
expect_unseq_refusal unseq-skipped-join  mut-skipped-join  r2aTrue 'invalid branch join'
expect_unseq_refusal unseq-sort-mismatch mut-sort          w3      'sort mismatch'
expect_unseq_refusal unseq-nondollar     mut-nondollar     w1      'not a reserved'
expect_unseq_refusal unseq-unknown-slot  mut-unknown-slot  w1      'unknown slot'
out="$(run_cli_fn Tests/unseq-wire/cguard.json cguard)" || { echo "check-wire-boundary: FAIL [unseq const-head] — the constant-head wire (a constant copied into a cell) did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":2'* ]] || { echo "check-wire-boundary: FAIL [unseq const-head] — expected ok/2 (ok := true && f(), f sets a = 2): $out" >&2; exit 1; }
echo "ok [unseq const-head] runs, answers 2 (a constant guard test copied into a bool cell — audit F2)"
expect_unseq_refusal unseq-nested-completion mut-nested-completion-join r2cTrue 'invalid branch join'
# Stage E E1 (2026-09-21): a PACKAGE-LEVEL variable's read as an occurrence — the `deref(globaladdr)`
# head (Tests/unseq-wire/e1.json, `v := mut() + g`): runs, canonical tape = mut first → 2; the
# hidden-read mutant in the pointer position refuses by name.
out="$(run_cli_fn Tests/unseq-wire/e1.json e1)" || { echo "check-wire-boundary: FAIL [unseq global-read] — the package-level-read wire (deref(globaladdr) head) did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":2'* ]] || { echo "check-wire-boundary: FAIL [unseq global-read] — expected ok/2 (v := mut() + g, mut sets g = 2, canonical = call first): $out" >&2; exit 1; }
echo "ok [unseq global-read] runs, answers 2 (a package-level variable read as a deref(globaladdr) occurrence — Stage E E1)"
expect_unseq_refusal unseq-deref-hidden mut-deref-hidden e1 'hidden read in a pure node'
# Stage E E2 (2026-09-21): a MAP-ELEMENT target plan (Tests/unseq-wire/e2map.json, `m[1] += mut()` with
# mut rebinding m): runs, canonical tape = the call first → the new map's entry, 10101; the non-atom-key
# mutant refuses by name (D13); the non-atom deref-plan mutant refuses by name.
out="$(run_cli_fn Tests/unseq-wire/e2map.json e2map)" || { echo "check-wire-boundary: FAIL [unseq map-plan] — the map-element plan wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":10101'* ]] || { echo "check-wire-boundary: FAIL [unseq map-plan] — expected ok/10101 (m[1] += mut(), mut rebinds m; canonical = call first): $out" >&2; exit 1; }
echo "ok [unseq map-plan] runs, answers 10101 (a frozen map-element target plan — Stage E E2)"
expect_unseq_refusal unseq-map-target-key mut-map-target-key e2map 'non-atom base or key'
expect_unseq_refusal unseq-deref-target-nonatom mut-deref-target-nonatom e2ptr 'outside the admitted fragment'
# Stage E E3 (2026-09-21): a RECEIVE occurrence (Tests/unseq-wire/e3recv.json, `x[f()] += <-ch`): runs on the
# canonical tape — f, the receive, then the load's `[9]` panic with the witness `len 0`; the non-atom channel and
# the two-binder mutants refuse by name.
out="$(run_cli_fn Tests/unseq-wire/e3recv.json e3recv)" || true
[[ "$out" == *'"status":"panic"'* && "$out" == *'len 0'* ]] || { echo "check-wire-boundary: FAIL [unseq recv] — expected the canonical tape's panic [9] after the receive (witness len 0): $out" >&2; exit 1; }
echo "ok [unseq recv] runs, the canonical tape receives first then panics [9] (witness len 0) — Stage E E3"
expect_unseq_refusal unseq-recv-nonatom mut-recv-nonatom e3recv 'hidden read in a receive'
expect_unseq_refusal unseq-recv-two-binds mut-recv-two-binds e3recv 'comma-ok flag cell'   # E5b: two binders admitted; the flag cell's type refuses
# Stage E E4 (2026-09-21): an ALLOCATION (`allocate`) occurrence (Tests/unseq-wire/e4alloc.json, `[]int{s[i]}[0] + wit5()`):
# runs on the canonical tape — wit5 first (calls first), then the payload's `[9]` panic after `wit 5`; the
# non-atom payload and the out-of-fragment statement kind refuse by name.
out="$(run_cli_fn Tests/unseq-wire/e4alloc.json e4alloc)" || true
[[ "$out" == *'"status":"panic"'* && "$out" == *'wit 5'* ]] || { echo "check-wire-boundary: FAIL [unseq alloc] — expected the canonical tape's panic [9] after wit 5: $out" >&2; exit 1; }
echo "ok [unseq alloc] runs, the canonical tape calls first then panics [9] on the literal's payload — Stage E E4"
expect_unseq_refusal unseq-alloc-nonatom mut-alloc-nonatom e4alloc 'hidden read in an allocation payload'
expect_unseq_refusal unseq-alloc-kind mut-alloc-kind e4alloc 'outside the admitted fragment'
# The Stage E audit fix round (2026-09-21). F1: Go 1.26 `new(x)` (Tests/unseq-wire/e4new.json, `*new(m()) + x +
# h() + g()`): runs on the canonical tape — m, new (storing m's value), h, g, then the residual reads — `m` `g`
# 110 (the first E4 cut answered `g` 103: the initializer and m's call dropped); a value typed against the
# allocation's element type refuses by name. F2: `ref` of a `$` binder cell as an invocation argument or a
# func-value capture refuses by name (the audit's M10b decoded and RAN). F3: a slice literal's index outside
# its length / duplicated, a constant make length that is negative or over a constant cap — refused at decode
# by name (the audit's M6/M11/M12 answered with Go-observable panics or ran).
out="$(run_cli_fn Tests/unseq-wire/e4new.json e4new)" || { echo "check-wire-boundary: FAIL [unseq new-expr] — the new(x) wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":110'* && "$out" == *'m\ng\n'* ]] || { echo "check-wire-boundary: FAIL [unseq new-expr] — expected ok/110 with the output m, g (canonical tape: the calls first, new stores m's value): $out" >&2; exit 1; }
echo "ok [unseq new-expr] runs, answers 110 after m and g (new(x) stores the argument's value — audit fix round F1)"
expect_unseq_refusal unseq-new-value-type    mut-new-value-type    e4new   'disagrees with the allocation'"'"'s element type'
expect_unseq_refusal unseq-arg-ref-binder    mut-arg-ref-binder    w1      'address of a binder cell'
expect_unseq_refusal unseq-capture-ref-binder mut-capture-ref-binder r2aTrue 'address of a binder cell'
expect_unseq_refusal unseq-slicelit-index-oob mut-slicelit-index-oob e4alloc 'outside the literal'"'"'s length'
expect_unseq_refusal unseq-slicelit-dup-index mut-slicelit-dup-index e4alloc 'duplicate slice-literal index'
expect_unseq_refusal unseq-make-negative-len mut-make-negative-len e4make  'negative constant len'
expect_unseq_refusal unseq-make-len-over-cap mut-make-len-over-cap e4make  'larger than constant cap'
# Stage E5 E5a (2026-09-22): a WIDE built-in occurrence (Tests/unseq-wire/e5copy.json, `d[0] + copy(d, s)` — the
# reading-(a) built-ins, RATIFIED [USER] 2026-09-22): runs on the canonical tape — the copy first (gc's), then the
# read: 9; the kind's refusals by name — a statement tag outside the fragment, a non-atom operand (a hidden read), a
# binder arity the statement does not write, a cell typed against the statement's result; a `min` head over a
# non-atom operand.
out="$(run_cli_fn Tests/unseq-wire/e5copy.json e5copy)" || { echo "check-wire-boundary: FAIL [unseq wide] — the wide copy wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":9'* ]] || { echo "check-wire-boundary: FAIL [unseq wide] — expected ok/9 (d[0] + copy(d, s); canonical = the copy first): $out" >&2; exit 1; }
echo "ok [unseq wide] runs, answers 9 (the copy a wide body, an effectful E1 participant — Stage E5 E5a)"
expect_unseq_refusal unseq-wide-kind      mut-wide-kind      e5append 'outside the admitted fragment'
expect_unseq_refusal unseq-wide-nonatom   mut-wide-nonatom   e5copy   'hidden read in a wide built-in'
expect_unseq_refusal unseq-wide-binds     mut-wide-binds     e5copy   'writes exactly one'
expect_unseq_refusal unseq-wide-cell-type mut-wide-cell-type e5copy   'the copied count'
expect_unseq_refusal unseq-min-nonatom    mut-min-nonatom    e5minmax 'hidden read in a pure node'
# Stage E5 E5b (2026-09-22): MULTI-TARGET assignments (Tests/unseq-wire/e5btuple.json, `s[0], x = m(), 3` with m rebinding
# the captured s): runs on the canonical tape — m first, then the header read: the store lands in the NEW array, 15
# (gc's); the comma-ok forms' refusals by name — one binder for a two-result wide statement, a receive's comma-ok flag
# cell not bool, a hidden read in the assertion's operand.
out="$(run_cli_fn Tests/unseq-wire/e5btuple.json e5btuple)" || { echo "check-wire-boundary: FAIL [unseq multi] — the multi-target wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":15'* ]] || { echo "check-wire-boundary: FAIL [unseq multi] — expected ok/15 (s[0], x = m(), 3; canonical = m first, the new header): $out" >&2; exit 1; }
echo "ok [unseq multi] runs, answers 15 (every target a sibling plan; the stores in order — Stage E5 E5b)"
expect_unseq_refusal unseq-wide-two-binds     mut-wide-two-binds     e5bassert 'writes exactly two'
expect_unseq_refusal unseq-recv-ok-type       mut-recv-ok-type       e5brecv2  'comma-ok flag cell'
expect_unseq_refusal unseq-wide-assert-nonatom mut-wide-assert-nonatom e5bassert 'hidden read in a wide built-in'
# Stage E5 E5c (2026-09-22): a MAP literal as an `allocate` body (Tests/unseq-wire/e5cmaplit.json, `map[int]int{1: x}[1] +
# m()`): runs on the canonical tape — m first, the literal's entry read after: 15; a duplicate CONSTANT key (a compile-time
# error in Go) and a hidden read in an entry refuse by name.
out="$(run_cli_fn Tests/unseq-wire/e5cmaplit.json e5cmaplit)" || { echo "check-wire-boundary: FAIL [unseq maplit] — the map-literal wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":15'* ]] || { echo "check-wire-boundary: FAIL [unseq maplit] — expected ok/15 (canonical = m first, the entry read after): $out" >&2; exit 1; }
echo "ok [unseq maplit] runs, answers 15 (the map literal an allocate body without an E1 edge — Stage E5 E5c)"
expect_unseq_refusal unseq-maplit-dup-key mut-maplit-dup-key e5cmaplit 'duplicate constant key'
expect_unseq_refusal unseq-maplit-nonatom mut-maplit-nonatom e5cmaplit 'hidden read in an allocation payload'
# Stage E5 E5e (2026-09-22): a STRING substring and its byte read as failing pure ops (Tests/unseq-wire/e5estr.json,
# `int(s[i:][0]) + m()`): runs on the canonical tape — m first (i = 1), then the substring "b" and its byte: 98 + 5 = 103 (gc's).
out="$(run_cli_fn Tests/unseq-wire/e5estr.json e5estr)" || { echo "check-wire-boundary: FAIL [unseq string] — the string wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":103'* ]] || { echo "check-wire-boundary: FAIL [unseq string] — expected ok/103 (canonical = m first, the substring and its byte after): $out" >&2; exit 1; }
echo "ok [unseq string] runs, answers 103 (a substring and its byte read bounds-checked pure ops on the string value — Stage E5 E5e)"
# Stage E5 E5d (2026-09-22): the ADDRESS of a variable as an invocation argument (Tests/unseq-wire/e5daddr.json, `use(&x) + x`)
# and as an allocation payload (e5dlit.json, `*(&PT{p: &x}).p + m()`): run on the canonical tape — the call first: 8 / 15;
# the address of a BINDER cell as a payload and `ref` as a head refuse by name.
out="$(run_cli_fn Tests/unseq-wire/e5daddr.json e5daddr)" || { echo "check-wire-boundary: FAIL [unseq addr-arg] — the address-argument wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":8'* ]] || { echo "check-wire-boundary: FAIL [unseq addr-arg] — expected ok/8 (canonical = use first, x's read after): $out" >&2; exit 1; }
echo "ok [unseq addr-arg] runs, answers 8 (the address of a variable an invocation argument, no occurrence — Stage E5 E5d)"
out="$(run_cli_fn Tests/unseq-wire/e5dlit.json e5dlit)" || { echo "check-wire-boundary: FAIL [unseq addr-payload] — the address-payload wire did not run: $out" >&2; exit 1; }
[[ "$out" == *'"status":"ok"'* && "$out" == *'"value":15'* ]] || { echo "check-wire-boundary: FAIL [unseq addr-payload] — expected ok/15 (canonical = m first, the deref after): $out" >&2; exit 1; }
echo "ok [unseq addr-payload] runs, answers 15 (the address of a variable a struct-literal payload inside new — Stage E5 E5d)"
expect_unseq_refusal unseq-addr-payload-binder mut-addr-payload-binder e5dlit 'address of a binder cell'
expect_unseq_refusal unseq-addr-head mut-addr-head e5daddr 'outside the admitted fragment'
echo 'Wire boundary gate: PASS (11 byte-level controls + 46 unseq-node controls through the real CLI)'
