#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

OUT="artifacts/gobra-smoke"
MANIFEST="${1:-Differential/manifest.tsv}"
GO_BUILD_CACHE="$ROOT/artifacts/go-build-cache"
GOBRA_SMOKE_TIMEOUT_SECONDS="${GOBRA_SMOKE_TIMEOUT_SECONDS:-240}"
GO_TIMEOUT_SECONDS="${GO_TIMEOUT_SECONDS:-30}"
LEAN_TIMEOUT_SECONDS="${LEAN_TIMEOUT_SECONDS:-30}"

run_with_timeout() {
  local seconds="$1"
  shift
  perl -e 'my $t = shift @ARGV; my $pid = fork(); die "fork failed\n" unless defined $pid; if ($pid == 0) { exec @ARGV; exit 127 } $SIG{ALRM} = sub { kill "TERM", $pid; select undef, undef, undef, 1; kill "KILL", $pid; exit 124 }; alarm $t; waitpid $pid, 0; my $s = $?; exit($s == -1 ? 127 : ($s & 127 ? 128 + ($s & 127) : $s >> 8));' "$seconds" "$@"
}

lean() {
  run_with_timeout "$LEAN_TIMEOUT_SECONDS" lake exe golean "$@"
}

if ! command -v go >/dev/null 2>&1; then
  echo "go not found on PATH; install Go or expose it in the shell to run differential smoke tests" >&2
  exit 2
fi

if [[ ! -f "$MANIFEST" ]]; then
  echo "differential manifest not found: $MANIFEST" >&2
  exit 2
fi

if [[ ! -d "$OUT/work" ]]; then
  run_with_timeout "$GOBRA_SMOKE_TIMEOUT_SECONDS" scripts/gobra-smoke
fi
mkdir -p "$GO_BUILD_CACHE"

case_count=0

while IFS=$'\t' read -r id go_dir gobra_json function_name arg_ints ignore_assert_at expected_status features expected_reason extra; do
  if [[ -z "${id:-}" || "$id" == \#* ]]; then
    continue
  fi

  if [[ -n "${extra:-}" ]]; then
    echo "malformed differential manifest row for $id: too many fields" >&2
    exit 2
  fi
  if [[ -z "${go_dir:-}" || -z "${gobra_json:-}" || -z "${function_name:-}" || -z "${arg_ints:-}" || -z "${ignore_assert_at:-}" || -z "${expected_status:-}" || -z "${features:-}" || -z "${expected_reason:-}" ]]; then
    echo "malformed differential manifest row for $id: expected 9 tab-separated fields" >&2
    exit 2
  fi

  case "$expected_status" in
    ok|panic|assertion_error|unsupported|stuck|error) ;;
    *)
      echo "unknown expected status for $id: $expected_status" >&2
      exit 2
      ;;
  esac
  case "$expected_status" in
    unsupported|stuck)
      if [[ "$expected_reason" == "-" ]]; then
        echo "$id expects $expected_status but has no manifest reason" >&2
        exit 2
      fi
      ;;
    *)
      if [[ "$expected_reason" != "-" ]]; then
        echo "$id has unexpected reason for status $expected_status: $expected_reason" >&2
        exit 2
      fi
      ;;
  esac

  if [[ ! -d "$go_dir" ]]; then
    echo "Go fixture directory not found for $id: $go_dir" >&2
    exit 2
  fi
  if [[ ! -f "$gobra_json" ]]; then
    run_with_timeout "$GOBRA_SMOKE_TIMEOUT_SECONDS" scripts/gobra-smoke
  fi
  if [[ ! -f "$gobra_json" ]]; then
    echo "Gobra JSON artifact not found for $id: $gobra_json" >&2
    exit 2
  fi
  lean gobra-artifact-check --manifest "$OUT/manifest.json" --internal-json "$gobra_json" >/dev/null

  lean_args=(gobra-json-run --input "$gobra_json" --function "$function_name")
  if [[ "$arg_ints" != "-" ]]; then
    IFS=',' read -r -a ints <<< "$arg_ints"
    for value in "${ints[@]}"; do
      if [[ ! "$value" =~ ^-?[0-9]+$ ]]; then
        echo "invalid integer argument for $id: $value" >&2
        exit 2
      fi
      lean_args+=(--arg-int "$value")
    done
  fi
  if [[ "$ignore_assert_at" != "-" ]]; then
    if [[ ! "$ignore_assert_at" =~ ^[0-9]+:[0-9]+$ ]]; then
      echo "invalid ignore_assert_at for $id: $ignore_assert_at" >&2
      exit 2
    fi
    lean_args+=(--ignore-assert-at "$ignore_assert_at")
  fi

  if lean_observation="$(lean "${lean_args[@]}")"; then
    lean_status=0
  else
    lean_status=$?
  fi
  if ! go_observation="$(run_with_timeout "$GO_TIMEOUT_SECONDS" env GO111MODULE=off GOCACHE="$GO_BUILD_CACHE" go run "./$go_dir")"; then
    echo "Go fixture failed for $id" >&2
    echo "$go_observation" >&2
    exit 1
  fi

  if [[ "$lean_observation" != *"\"status\":\"$expected_status\""* ]]; then
    echo "Lean observation for $id did not have expected status $expected_status" >&2
    echo "Lean: $lean_observation" >&2
    exit 1
  fi
  if [[ "$go_observation" != *"\"status\":\"$expected_status\""* ]]; then
    echo "Go observation for $id did not have expected status $expected_status" >&2
    echo "Go: $go_observation" >&2
    exit 1
  fi
  if [[ "$expected_status" == "ok" && "$lean_status" -ne 0 ]]; then
    echo "Lean execution for $id returned nonzero status $lean_status despite ok observation" >&2
    echo "Lean: $lean_observation" >&2
    exit 1
  fi

  if ! observation_diff="$(lean observation-eq --left "$lean_observation" --right "$go_observation" 2>&1)"; then
    echo "differential mismatch for $id" >&2
    echo "Lean: $lean_observation" >&2
    echo "Go:   $go_observation" >&2
    if [[ -n "$observation_diff" ]]; then
      echo "$observation_diff" >&2
    fi
    exit 1
  fi

  echo "ok: $id matched Go and Lean observations [$features]"
  case_count=$((case_count + 1))
done < "$MANIFEST"

if [[ "$case_count" -eq 0 ]]; then
  echo "no differential cases found in $MANIFEST" >&2
  exit 2
fi

echo "executed $case_count differential smoke case(s)"
