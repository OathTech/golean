#!/usr/bin/env bash
# Golden-lowering staleness guard (arc exit-infra; multi-program since the
# proof-corpus catch-up arc, 2026-07-30).
# For EACH pinned program, verifies BOTH links of the chain
# "proof subject = decoded(frontend(source))":
#   1. fresh frontend emit + decode of the golden source reproduces the
#      checked-in repr baseline (frontend/decoder drift detection);
#   2. the checked-in Lean term prints the same repr (Lean-term vs
#      baseline drift detection).
# Any mismatch fails CLOSED: re-pin deliberately (regenerate baseline + term
# in the same commit as the frontend/decoder change, with the reason).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"

# The pinned programs: source dir | repr baseline | Lean term.
# All terms live in the pure-syntax module GoLeanProofs.Specs.GoldenProgram
# (built once below) so the guard stays armed independent of the proof layer.
PINS=(
  "Corpus/coverage/exec/pointers/inc-via-call|baselines/golden/slice-lowered.repr|GoLean.Iris.GoldenSlice.sliceLowered"
  "Corpus/coverage/exec/panic-recover/recover-direct|baselines/golden/recover-lowered.repr|GoLean.Iris.GoldenRecover.recoverLowered"
  "Corpus/coverage/exec/quorum/committed-index-real|baselines/golden/quorum-lowered.repr|GoLean.Iris.GoldenQuorum.quorumLowered"
  "Corpus/coverage/exec/examples/fib|baselines/golden/fib-lowered.repr|GoLean.Examples.Fib.fibLowered"
  "Corpus/coverage/exec/examples/reverse|baselines/golden/reverse-lowered.repr|GoLean.Examples.Reverse.reverseLowered"
  "Corpus/coverage/exec/examples/gcd|baselines/golden/gcd-lowered.repr|GoLean.Examples.Gcd.gcdLowered"
  "Corpus/coverage/exec/examples/minmax|baselines/golden/minmax-lowered.repr|GoLean.Examples.MinMax.minMaxLowered"
  "Corpus/coverage/exec/examples/binsearch|baselines/golden/binsearch-lowered.repr|GoLean.Examples.BinSearch.searchLowered"
  "Corpus/coverage/exec/examples/isort|baselines/golden/isort-lowered.repr|GoLean.Examples.InsertionSort.isortLowered"
  "Corpus/coverage/exec/examples/wordcount|baselines/golden/wordcount-lowered.repr|GoLean.Examples.WordCount.wordCountLowered"
  "Corpus/coverage/exec/examples/histogram|baselines/golden/histogram-lowered.repr|GoLean.Examples.Histogram.histogramLowered"
  # The gallery-campaign G1 guardrails wave (2026-08-15): the corpus half
  # of each remaining G1 example lands here BEFORE its proof exists, so
  # the lowering each proof lane will reason about is pinned from birth.
  "Corpus/coverage/exec/examples/selsort|baselines/golden/selsort-lowered.repr|GoLean.Examples.SelectionSort.selsortLowered"
)

WORK="${TMPDIR:-/tmp}/golden-check.$$"
mkdir -p "$WORK"
trap 'rm -f "$WORK"/* 2>/dev/null; rmdir "$WORK" 2>/dev/null || true' EXIT

export GOCACHE="${GOCACHE:-$ROOT/artifacts/go-build-cache}"

# Build BOTH sides once: `lake env lean --run` loads existing .oleans,
# which can be stale relative to same-run edits (2026-07-21 audit
# hardening for the pin module; extended to the DECODER 2026-07-30 after
# the pre-merge audit found link 1 ran against a possibly stale
# GoLean.NativeToIR .olean — the exact decoder-drift class the link
# exists to catch could pass in the run that introduced it. Fail-closed
# means not relying on the next run's self-heal, on either link.)
lake build GoLean.NativeToIR > /dev/null \
  || { echo "check-golden: FAIL — NativeToIR (decoder) build failed (fail closed)" >&2; exit 1; }
(cd proofs && lake build GoLeanProofs.Specs.GoldenProgram GoLeanProofs.Specs.GoldenQuorum GoLeanProofs.Examples.FibProgram GoLeanProofs.Examples.ReverseProgram GoLeanProofs.Examples.GcdProgram GoLeanProofs.Examples.MinMaxProgram GoLeanProofs.Examples.BinSearchProgram GoLeanProofs.Examples.InsertionSortProgram GoLeanProofs.Examples.WordCountProgram GoLeanProofs.Examples.HistogramProgram GoLeanProofs.Examples.SelectionSortProgram > /dev/null) \
  || { echo "check-golden: FAIL — pin module build failed (fail closed)" >&2; exit 1; }

for pin in "${PINS[@]}"; do
  IFS='|' read -r SRC_DIR BASE TERM <<< "$pin"
  NAME="$(basename "$SRC_DIR")"

  [ -f "$BASE" ] || { echo "check-golden: FAIL — no baseline at $BASE" >&2; exit 1; }

  # Link 1: frontend + decoder reproduce the baseline
  GO111MODULE=off go run ./tools/nativefrontend --dir "$SRC_DIR" --out "$WORK/wire.json" \
    || { echo "check-golden: FAIL [$NAME] — frontend emit failed (fail closed)" >&2; exit 1; }
  cat > "$WORK/decode.lean" <<LEAN
import GoLean.NativeToIR
def main : IO Unit := do
  let raw ← IO.FS.readFile "$WORK/wire.json"
  match Lean.Json.parse raw with
  | .error e => IO.println s!"PARSE ERROR: {e}"
  | .ok json =>
    match GoLean.NativeToIR.decodeProgram json with
    | .error e => IO.println s!"DECODE ERROR: {e}"
    | .ok prog => IO.println (repr prog)
LEAN
  lake env lean --run "$WORK/decode.lean" > "$WORK/fresh.repr" \
    || { echo "check-golden: FAIL [$NAME] — decode run failed (fail closed)" >&2; exit 1; }
  grep -q "ERROR" "$WORK/fresh.repr" && { echo "check-golden: FAIL [$NAME] — decoder error:"; cat "$WORK/fresh.repr"; exit 1; }
  if ! diff -q "$BASE" "$WORK/fresh.repr" > /dev/null; then
    echo "check-golden: FAIL [$NAME] — frontend/decoder output drifted from $BASE:" >&2
    diff "$BASE" "$WORK/fresh.repr" | head -20 >&2
    exit 1
  fi

  # Link 2: the checked-in Lean term prints the same repr.
  cat > "$WORK/term.lean" <<LEAN
import GoLeanProofs.Specs.GoldenProgram
import GoLeanProofs.Specs.GoldenQuorum
import GoLeanProofs.Examples.FibProgram
import GoLeanProofs.Examples.ReverseProgram
import GoLeanProofs.Examples.GcdProgram
import GoLeanProofs.Examples.MinMaxProgram
import GoLeanProofs.Examples.BinSearchProgram
import GoLeanProofs.Examples.InsertionSortProgram
import GoLeanProofs.Examples.WordCountProgram
import GoLeanProofs.Examples.HistogramProgram
import GoLeanProofs.Examples.SelectionSortProgram
def main : IO Unit :=
  IO.println (repr $TERM)
LEAN
  (cd proofs && lake env lean --run "$WORK/term.lean" > "$WORK/term.repr") \
    || { echo "check-golden: FAIL [$NAME] — term print failed (fail closed)" >&2; exit 1; }
  if ! diff -q "$BASE" "$WORK/term.repr" > /dev/null; then
    echo "check-golden: FAIL [$NAME] — Lean term drifted from $BASE:" >&2
    diff "$BASE" "$WORK/term.repr" | head -20 >&2
    exit 1
  fi
  echo "check-golden: ok [$NAME] — proof subject = decoded(frontend(source)), both links"
done

# ---- Deviation-observation pin (init slice audit response 2026-08-05, C2) ----
# init/hidden-dep-order is the recorded hidden-dependency initialization-order
# deviation: the spec leaves the order unspecified, our realized order
# (go/types InitOrder) differs from gc's, and the differential red only says
# "≠ gc" — a drift to ANY third order would read identically there. This pin
# asserts the order WE realize, end-to-end (frontend InitOrder emission →
# decoder → seeded driver run), against the checked-in observation (4242).
# Re-pin deliberately, with the reason, only on a DECIDED order change.
DEV_SRC="Corpus/coverage/exec/init/hidden-dep-order"
DEV_BASE="baselines/golden/hidden-dep-order.observation.json"
DEV_FUNC="hiddenDepOrder"
[ -f "$DEV_BASE" ] || { echo "check-golden: FAIL — no baseline at $DEV_BASE" >&2; exit 1; }
lake build golean > /dev/null \
  || { echo "check-golden: FAIL — golean build failed (fail closed)" >&2; exit 1; }
GO111MODULE=off go run ./tools/nativefrontend --dir "$DEV_SRC" --out "$WORK/deviation.wire.json" \
  || { echo "check-golden: FAIL [hidden-dep-order] — frontend emit failed (fail closed)" >&2; exit 1; }
.lake/build/bin/golean native-json-run --input "$WORK/deviation.wire.json" --function "$DEV_FUNC" \
  > "$WORK/deviation.obs" \
  || { echo "check-golden: FAIL [hidden-dep-order] — machine run failed (fail closed)" >&2; exit 1; }
if ! diff -q "$DEV_BASE" "$WORK/deviation.obs" > /dev/null; then
  echo "check-golden: FAIL [hidden-dep-order] — the REALIZED hidden-dependency init order drifted from the recorded deviation pin:" >&2
  diff "$DEV_BASE" "$WORK/deviation.obs" | head -10 >&2
  exit 1
fi
echo "check-golden: ok [hidden-dep-order] — realized deviation order matches the recorded pin"
